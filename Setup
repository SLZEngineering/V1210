# Solutionz RMM traffic model:
# - Monitoring traffic originates from this RMM Agent toward monitored AV devices.
# - Domotz/RMM cloud connections are outbound-initiated by this Agent.
# - No unsolicited Internet-initiated inbound connection is required.
# - Host UFW permits inbound TCP 22 and TCP 3000 from any reachable source, per
#   the requested Solutionz baseline. Perimeter/network policy remains responsible
#   for preventing unsolicited Internet exposure.
# - UFW uses "default allow outgoing". Therefore outbound TCP and UDP traffic is
#   permitted without separate per-port UFW allow rules. Network/perimeter firewalls
#   must still permit the required traffic described below.
# - Required outbound TCP: 443, 5671, 32700-57699, 4505-4506, 55022, 11371.
# - Required/expected UDP: 53 for DNS when UDP transport is used; 123 for NTP;
#   67/68 for DHCP when eth0 obtains addressing by DHCP; and UDP 161 from the RMM
#   Agent to monitored devices when SNMP polling is configured.
# - DNS may also use TCP 53 for fallback/large responses.
# - Additional TCP/UDP ports may be required by specific monitored AV devices or
#   manufacturer protocols. ICMP is used for monitoring/reachability where allowed.

usage() {
  cat <<EOF
Usage:
  sudo ./${SCRIPT_NAME} [options]

Options:
  --non-interactive             Mass-production/unattended mode; skip the two manual confirmation prompts.
  --network-profile <json>      Stage, validate, and render the supplied WAN/LAN/VLAN
                                JSON profile before it is committed to the appliance.
  --preserve-existing-network-profile
                                Preserve/re-render an existing valid Solutionz network
                                profile instead of resetting to the factory default.
                                Refurb/manual rebuilds otherwise use a fresh baseline.
  --activation-status           Show build and Domotz activation/deployment status only.
  --prepare-deployment          Stage Domotz registration settings for on-site submission, then power off.
  --prepare-deployment --no-poweroff
                                Stage registration settings and keep the appliance powered on.
  -h, --help                    Show this help.

Domotz update model:
  Domotz is not revision-pinned by this script. New installations use the
  Snap Store stable/default release and the installed revision is logged.
EOF
}

parse_args() {
  while (($#)); do
    case "$1" in
      --non-interactive)
        NON_INTERACTIVE=1
        ;;
      --network-profile)
        shift
        [[ $# -gt 0 ]] || { echo "--network-profile requires a JSON file path." >&2; exit 2; }
        NETWORK_PROFILE_SOURCE="$1"
        ;;
      --network-profile=*)
        NETWORK_PROFILE_SOURCE="${1#*=}"
        ;;
      --preserve-existing-network-profile)
        PRESERVE_EXISTING_NETWORK_PROFILE=1
        ;;
      --activation-status)
        ACTION_MODE="activation_status"
        ;;
      --prepare-deployment)
        ACTION_MODE="prepare_deployment"
        ;;
      --no-poweroff)
        NO_POWEROFF=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "ERROR: Run this script with sudo or as root." >&2
    exit 1
  fi
}

init_logging() {
  mkdir -p "${LOG_DIR}" "${STATE_DIR}"
  chmod 750 "${LOG_DIR}" "${STATE_DIR}"
  touch "${LOG_FILE}"
  chmod 640 "${LOG_FILE}"

  # Display command output normally while also preserving a plain-text copy in
  # the installation log. Nothing is intentionally hidden from the console.
  exec > >(tee -i >(sed -u 's/\x1B\[[0-9;]*[mK]//g' >> "${LOG_FILE}")) 2>&1
}

info_message() {
  printf ' %s[i] %s%s\n' "${COLOR_CYAN}" "$1" "${COLOR_RESET}"
}

progress_message() {
  printf ' %s[+] %s%s\n' "${COLOR_GREEN}" "$1" "${COLOR_RESET}"
}

warning_message() {
  printf ' %s[!] WARNING: %s%s\n' "${COLOR_YELLOW}" "$1" "${COLOR_RESET}"
}

step_message() {
  local step="$1"
  local description="$2"
  local percent=$(( (step - 1) * 100 / TOTAL_INSTALL_STEPS ))
  CURRENT_STEP="${step} - ${description}"

  printf '\n%s[%3d%%] Step %02d/%02d | %s%s\n' \
    "${COLOR_CYAN}" "${percent}" "${step}" "${TOTAL_INSTALL_STEPS}" \
    "${description}" "${COLOR_RESET}"
}

completion_message() {
  printf '\n%s[100%%] Installation phase complete%s\n' "${COLOR_GREEN}" "${COLOR_RESET}"
}

write_state() {
  local status="$1"
  shift || true
  local tmp="${STATE_FILE}.tmp.$$"

  {
    printf '%s\n' "${status}"
    printf 'revision=%s\n' "${REVISION}"
    printf 'script=%s\n' "${SCRIPT_NAME}"
    printf 'timestamp_utc=%s\n' "$(date -u +%FT%TZ)"
    printf 'step=%s\n' "${CURRENT_STEP}"
    for line in "$@"; do
      printf '%s\n' "${line}"
    done
  } > "${tmp}"

  chmod 640 "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
}

backup_previous_state() {
  if [[ -f "${STATE_FILE}" ]]; then
    cp -a "${STATE_FILE}" "${STATE_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
}

# Determine whether Setup is building a new mass-production appliance or
# rebuilding/refurbishing an existing Solutionz RMM Agent. This is informational
# and controls cleanup/audit messaging; both paths remain fully automatable.
detect_setup_context() {
  local detected=0
  [[ -s "${STATE_FILE}" ]] && detected=1
  [[ -s "${NETWORK_PROFILE_FILE}" ]] && detected=1
  [[ -x "${LOCAL_CONFIG_TOOL}" ]] && detected=1
  [[ -s "${SERIAL_PROFILE_FILE}" ]] && detected=1
  if compgen -G '/usr/local/share/solutionz-rmm/*' >/dev/null 2>&1; then
    detected=1
  fi

  if (( detected )); then
    PREEXISTING_SOLUTIONZ_INSTALL=1
    SETUP_CONTEXT="refurbish_or_manual_rebuild"
    progress_message "Setup context: existing Solutionz RMM installation detected; refurbishment/manual rebuild safeguards enabled."
  else
    PREEXISTING_SOLUTIONZ_INSTALL=0
    SETUP_CONTEXT="factory_new"
    progress_message "Setup context: new/mass-production V1210 build."
  fi
}

record_network_requirements() {
  cat > "${NETWORK_REQUIREMENTS_FILE}" <<'EOF'
Solutionz RMM Agent Network Requirements - Revision SOC2-V07111226

Dual-homed interface model
- eth0 = WAN/cloud uplink. eth0 is the only interface allowed to own the IPv4
  default route and system DNS.
- eth1 = AV/control LAN. eth1 has no default route. Tagged AV/control VLANs are
  created on eth1 and likewise have no default route.
- IPv4 forwarding between WAN and LAN is disabled. The collector is not a router.
- USB-C COM is the independent recovery/configuration path.

Traffic model
- Domotz/RMM cloud sessions originate outbound through WAN/eth0.
- Monitoring traffic originates locally from the RMM Agent through LAN/eth1 or
  an eth1 VLAN toward monitored AV devices.
- No unsolicited Internet-initiated inbound connection is required for normal
  RMM/Domotz cloud communication.

Outbound TCP - WAN/cloud
- TCP 443          Domotz portal/API/orchestration and Ubuntu/Canonical/Snap HTTPS
- TCP 5671         Domotz secure messaging/orchestration
- TCP 32700-57699  Domotz remote relay/secure remote connectivity
- TCP 4505-4506    Domotz provisioning
- TCP 55022        Domotz tunnel/remote support
- TCP 11371        Key-server/package provisioning or maintenance where required
- TCP 53           DNS fallback/large responses when the resolver requires TCP

Outbound/local UDP
- UDP 53           DNS queries when UDP transport is used
- UDP 123          NTP/time synchronization
- UDP 67/68        DHCP on eth0 and/or eth1/VLANs when DHCP is selected
- UDP 161          SNMP polling from LAN/eth1 or an eth1 VLAN to monitored devices
- Additional UDP   As required by manufacturer-specific monitored-device protocols

Other required traffic
- ICMP             Device heartbeat/reachability, latency and packet-loss testing
                   where the customer security policy permits ICMP

Local monitored-device traffic - LAN side
- HTTP/HTTPS       TCP 80/443 when used by monitored devices
- SSH              TCP 22 when used for device monitoring/management
- SNMP             UDP 161 when SNMP polling is configured
- Manufacturer-specific TCP/UDP ports as required by each monitored device
- LAN/VLAN ACLs must permit the RMM Agent to reach each monitored device on the
  protocol/port required for that device.

Agent host firewall inbound allowances
- TCP 22           SSH administration
- TCP 3000         Local Domotz Agent service

UFW baseline
- Default incoming: deny
- Default outgoing: allow
- Default routed/forwarded traffic: deny
- TCP 22: allow from any reachable source because Domotz/SSH requires it
- TCP 3000: allow from any reachable source because the Domotz Agent service requires it
- Host UFW allowances do not publish either service through Internet NAT.
- UFW logging is enabled at a low level for host-firewall audit visibility.

Host security baseline
- IPv4 forwarding is disabled and eth0/eth1 are not permitted to become bridge members.
- ICMP redirects and source routing are disabled; martian packet logging is enabled.
- SSH root login is disabled; MaxAuthTries=3; LoginGraceTime=30; X11 forwarding is disabled.
- Domotz-sensitive global SSH tunneling/authentication settings are not disabled until regression tested.
- Dedicated solutionz-rmm-tech and solutionz-rmm-engineering groups separate controlled field configuration from engineering administration.
- The field configuration menu does not expose an unrestricted Linux shell option.
- auditd records changes to Solutionz-controlled network, SSH, firewall, sysctl, systemd, utility and state paths.
- AppArmor is enabled with Solutionz role-specific enforcing profiles for all Solutionz-developed executables.
- snapd manages the Domotz package. Setup checks the package and required operational connections.
- A SHA-256 integrity baseline protects Solutionz scripts and security/network configuration files.
- The security validator flags unexpected network-reachable TCP listeners beyond approved TCP 22/3000.
- Security updates use a controlled maintenance policy: unattended installation and automatic reboot are disabled.

Automatic WAN/LAN/VLAN behavior
- Netplan is generated from /etc/solutionz-rmm/network-profile.json.
- Default profile: WAN eth0 DHCP; LAN eth1 DHCP with DHCP routes and DNS ignored.
- WAN eth0 supports DHCP or true static IPv4. Static WAN requires gateway and DNS.
- LAN eth1 supports DHCP, static IPv4, unnumbered trunk-parent mode, or explicit unused mode.
- Tagged VLANs are IEEE 802.1Q subinterfaces linked to eth1, not eth0.
- VLANs support DHCP or static IPv4, but may not own a default route or DNS.
- VLAN IDs are never guessed; customer/engineering values must be supplied.
- Exactly one IPv4 default route is allowed and it must use eth0.
- DHCP on eth1/VLAN interfaces suppresses DHCP-provided routes and DNS.
- IPv4 forwarding must remain disabled (net.ipv4.ip_forward=0).
- After every network change, automatic validation verifies the active WAN/LAN
  profile. Local configuration failures trigger rollback to the previous Netplan.
- DNS/Domotz reachability failures are reported separately so a valid customer
  static configuration is not discarded merely because an upstream firewall is
  still blocking a required service.

Security boundary note
- Global TCP 22/TCP 3000 allowance on the RMM Agent host does not mean either port
  should be exposed through Internet NAT. Perimeter policy remains responsible.
- Upstream firewalls must allow required WAN/cloud traffic and LAN monitoring
  traffic for the monitored AV devices.
EOF
  chmod 640 "${NETWORK_REQUIREMENTS_FILE}"
  progress_message "Recorded dual-homed WAN/LAN network requirements: ${NETWORK_REQUIREMENTS_FILE}"
}

record_failure_and_exit() {
  local rc="$1"
  local line="$2"
  local command="$3"
  trap - ERR
  set +e

  {
    echo "result=FAIL"
    echo "phase=phase1_installation"
    echo "revision=${REVISION}"
    echo "script=${SCRIPT_NAME}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "step=${CURRENT_STEP}"
    echo "line=${line}"
    echo "exit_code=${rc}"
    echo "command=${command}"
    echo "log=${LOG_FILE}"
  } > "${PHASE1_FAILURE_RESULT_FILE}"
  chmod 640 "${PHASE1_FAILURE_RESULT_FILE}"

  write_state "phase1_failed" \
    "exit_code=${rc}" \
    "line=${line}" \
    "command=${command}" \
    "result_file=${PHASE1_FAILURE_RESULT_FILE}" \
    "log=${LOG_FILE}"

  printf ' %s[!] INSTALLATION FAILED%s\n' "${COLOR_RED}" "${COLOR_RESET}" >&2
  printf ' %s[!] Step: %s%s\n' "${COLOR_RED}" "${CURRENT_STEP}" "${COLOR_RESET}" >&2
  printf ' %s[!] Line: %s%s\n' "${COLOR_RED}" "${line}" "${COLOR_RESET}" >&2
  printf ' %s[!] Exit code: %s%s\n' "${COLOR_RED}" "${rc}" "${COLOR_RESET}" >&2
  printf ' %s[!] Command: %s%s\n' "${COLOR_RED}" "${command}" "${COLOR_RESET}" >&2
  printf ' %s[!] Failure result: %s%s\n' "${COLOR_RED}" "${PHASE1_FAILURE_RESULT_FILE}" "${COLOR_RESET}" >&2
  printf ' %s[!] Log: %s%s\n' "${COLOR_RED}" "${LOG_FILE}" "${COLOR_RESET}" >&2
  exit "${rc}"
}

on_error() {
  local rc=$?
  local line="$1"
  local command="$2"
  record_failure_and_exit "${rc}" "${line}" "${command}"
}

error_exit() {
  local message="$1"
  trap - ERR
  set +e

  {
    echo "result=FAIL"
    echo "phase=phase1_installation"
    echo "revision=${REVISION}"
    echo "script=${SCRIPT_NAME}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "step=${CURRENT_STEP}"
    echo "error=${message}"
    echo "log=${LOG_FILE}"
  } > "${PHASE1_FAILURE_RESULT_FILE}"
  chmod 640 "${PHASE1_FAILURE_RESULT_FILE}"

  printf ' %s[!] ERROR: %s%s\n' "${COLOR_RED}" "${message}" "${COLOR_RESET}" >&2
  printf ' %s[!] Step: %s%s\n' "${COLOR_RED}" "${CURRENT_STEP}" "${COLOR_RESET}" >&2
  printf ' %s[!] Failure result: %s%s\n' "${COLOR_RED}" "${PHASE1_FAILURE_RESULT_FILE}" "${COLOR_RESET}" >&2
  printf ' %s[!] Log: %s%s\n' "${COLOR_RED}" "${LOG_FILE}" "${COLOR_RESET}" >&2

  write_state "phase1_failed" \
    "error=${message}" \
    "result_file=${PHASE1_FAILURE_RESULT_FILE}" \
    "log=${LOG_FILE}"
  exit 1
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

prompt_confirmation() {
  if (( NON_INTERACTIVE == 1 )); then
    progress_message "Non-interactive mode selected; confirmation prompts skipped."
    return 0
  fi

  echo -e "\e[36m
  _____   ____    _      _    _   _____   _    ____   _     _
 / ____| / __ \  | |    | |  | | |_   _| | |  / __ \ | \   | |  _____
| (___  | |  | | | |    | |  | |   | |   | | | |  | ||  \  | | |___ /
 \___ \ | |  | | | |    | |  | |   | |   | | | |  | || |\ \| |   / /
 ____) || |__| | | |___ | |__| |   | |   | | | |__| || |  \  |  / /__
|_____/  \____/  |_____| \____/    |_|   |_|  \____/ |_|   \_| /_____|

Solutionz RMM Agent Build - Revision ${REVISION}
Created by Reiko Seneathia Williams
\e[0m" >&2

  cat >&2 <<EOF
This script will:
  1. Validate the Ubuntu 24.04 LTS OS family and Protectli V1210 hardware.
  2. Record the manufacturer-delivered OS/package state before modification.
  3. Install only missing required packages; no general apt upgrade is performed.
  4. Verify SSH, TUN, Snap, Domotz, and required Domotz permissions.
  5. Configure UFW with inbound TCP 22/TCP 3000 permitted and default-allow outbound TCP/UDP traffic.
  6. Stage dual-homed networking: eth0 WAN/cloud default route and eth1 AV/control LAN with no default route.
  7. Generate optional 802.1Q LAN VLANs on eth1 from a guided or saved profile.
  8. Disable IPv4 forwarding so the collector does not route between WAN and LAN.
  9. Repair and validate system DNS behavior.
 10. Normalize Solutionz hostname entries.
 11. Configure GRUB interface naming and the V1210 USB-C COM serial console.
 12. Install the USB-C COM WAN/LAN/VLAN utility with automatic post-change validation and rollback.
 13. Install post-reboot production validation.
 14. Stage all changes without automatically rebooting.

USB-C COM direct laptop configuration:
  After reboot, connect a laptop to the V1210 USB-C port labeled COM.
  Use 115200 baud, 8 data bits, no parity, 1 stop bit (8N1).
  Log in normally. When the login is through ttyS0, the Solutionz RMM local
  configuration menu launches automatically. No Linux command is required.

Domotz note:
  Domotz is intentionally not revision-pinned. The installed Snap revision is
  recorded for audit and support.
EOF

  printf "Type 'yes' to proceed: " >&2
  read -r confirmation1
  [[ "${confirmation1}" == "yes" ]] || error_exit "Confirmation not received."

  printf "Type 'yes' again to confirm production configuration changes: " >&2
  read -r confirmation2
  [[ "${confirmation2}" == "yes" ]] || error_exit "Second confirmation not received."
}

read_dmi_value() {
  local path="$1"
  if [[ -r "${path}" ]]; then
    tr -d '\0' < "${path}" | xargs
  else
    printf 'unknown'
  fi
}


dns_resolves_ipv4() {
  local host="$1"
  getent ahostsv4 "${host}" 2>/dev/null | awk '{print $1}' | grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

ntp_is_synchronized() {
  local synced=""
  synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"

  # systemd-timesyncd creates this runtime marker only after a successful sync.
  # /run is recreated at boot, so this is fresh evidence for the current boot.
  if [[ "${synced}" == "yes" || -e /run/systemd/timesync/synchronized ]]; then
    return 0
  fi

  return 1
}

wait_for_ntp_sync() {
  local attempts="${1:-36}"
  local delay_seconds="${2:-5}"
  local attempt

  for ((attempt=1; attempt<=attempts; attempt++)); do
    if ntp_is_synchronized; then
      return 0
    fi

    if (( attempt < attempts )); then
      sleep "${delay_seconds}"
    fi
  done

  return 1
}

report_ntp_diagnostics() {
  echo "INFO - NTP diagnostics:"
  timedatectl status 2>/dev/null | sed -n '1,20p' || true
  timedatectl timesync-status --no-pager 2>/dev/null | sed -n '1,40p' || true
  systemctl status systemd-timesyncd.service --no-pager -l 2>/dev/null | sed -n '1,40p' || true
}

validate_engineering_access_preflight() {
  local key="${ENGINEERING_SSH_PUBLIC_KEY}" key_blob
  [[ -n "${key}" ]] || error_exit "Solutionz engineering SSH public key is not configured."
  [[ "${key}" == ssh-ed25519\ * ]] || error_exit "Engineering SSH key must be a single OpenSSH ED25519 public-key line beginning with 'ssh-ed25519 '."
  [[ "${key}" != *$'\n'* && "${key}" != *$'\r'* ]] || error_exit "Engineering SSH public key must be a single line."
  [[ "${key}" != *"PRIVATE KEY"* ]] || error_exit "A private SSH key was supplied where a public key is required. Never place the engineering private key in Setup."
  key_blob="$(awk '{print $2}' <<<"${key}")"
  [[ -n "${key_blob}" ]] || error_exit "Engineering SSH public key is missing its key data."
  printf '%s' "${key_blob}" | base64 -d >/dev/null 2>&1 || error_exit "Engineering SSH public key data is not valid base64/OpenSSH key material."

  [[ -n "${ENGINEERING_DEFAULT_PASSWORD_HASH}" ]] || error_exit "Default engineering password hash is empty."
  [[ "${ENGINEERING_DEFAULT_PASSWORD_HASH}" == '$6$'* ]] || error_exit "Default engineering password hash must be a SHA-512 crypt hash beginning with \$6\$."
  progress_message "Engineering SSH public-key and local-password-hash preflight validation passed."
}

preflight_checks() {
  step_message 1 "Preflight validation"

  validate_engineering_access_preflight
  [[ -r /etc/os-release ]] || error_exit "/etc/os-release not found."
  # shellcheck disable=SC1091
  source /etc/os-release

  [[ "${ID:-}" == "${SUPPORTED_OS_ID}" ]] || \
    error_exit "Unsupported OS ID '${ID:-unknown}'. Expected ${SUPPORTED_OS_ID}."
  [[ "${VERSION_ID:-}" == "${SUPPORTED_UBUNTU_VERSION_ID}" ]] || \
    error_exit "Unsupported Ubuntu VERSION_ID '${VERSION_ID:-unknown}'. Expected the Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS family."

  if [[ -n "${VERSION_CODENAME:-}" && "${VERSION_CODENAME}" != "${SUPPORTED_UBUNTU_CODENAME}" ]]; then
    error_exit "Unsupported Ubuntu codename '${VERSION_CODENAME}'. Expected ${SUPPORTED_UBUNTU_CODENAME}."
  fi

  progress_message "Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS OS family verified (Ubuntu 24.04.x Noble point releases, including 24.04.4 LTS, are supported)."
  progress_message "Detected runtime release: ${PRETTY_NAME:-${VERSION:-unknown}}"
  # /etc/os-release is commonly a relative symlink to /usr/lib/os-release.
  # Never copy or redirect directly onto the final baseline path because an
  # older run may have left that path as a dangling symlink. Build a regular
  # temporary file first, then atomically replace the destination itself.
  local os_baseline_tmp
  os_baseline_tmp="$(mktemp "${STATE_DIR}/.os-baseline-${REVISION}.XXXXXX")"
  cat /etc/os-release > "${os_baseline_tmp}"
  chmod 640 "${os_baseline_tmp}"
  chown root:root "${os_baseline_tmp}"
  mv -Tf "${os_baseline_tmp}" "${OS_BASELINE_FILE}"
  [[ -f "${OS_BASELINE_FILE}" && ! -L "${OS_BASELINE_FILE}" && -s "${OS_BASELINE_FILE}" ]] || \
    error_exit "Unable to create regular OS baseline record at ${OS_BASELINE_FILE}."
  progress_message "OS runtime baseline recorded as a regular file: ${OS_BASELINE_FILE}"

  local sys_vendor product_name
  sys_vendor="$(read_dmi_value /sys/class/dmi/id/sys_vendor)"
  product_name="$(read_dmi_value /sys/class/dmi/id/product_name)"

  progress_message "Detected hardware vendor: ${sys_vendor}"
  progress_message "Detected hardware model: ${product_name}"

  if [[ "${sys_vendor,,}" != *"${SUPPORTED_VENDOR,,}"* || "${product_name}" != "${SUPPORTED_MODEL}" ]]; then
    error_exit "Unsupported hardware. Production revision ${REVISION} is approved only for ${SUPPORTED_VENDOR} ${SUPPORTED_MODEL}; detected '${sys_vendor} ${product_name}'."
  fi
  progress_message "Protectli V1210 hardware preflight passed."

  if [[ ! -c "${SERIAL_DEVICE}" ]]; then
    error_exit "Required V1210 serial device ${SERIAL_DEVICE} was not detected."
  fi
  progress_message "Detected V1210 serial device ${SERIAL_DEVICE}."

  local free_kb
  free_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
  if [[ -z "${free_kb}" || "${free_kb}" -lt 2097152 ]]; then
    error_exit "Less than 2 GB free space is available on the root filesystem."
  fi
  progress_message "Disk-space preflight passed."

  local default_iface default_gateway current_cidr
  default_iface="$(ip -4 route show default | awk 'NR==1 {print $5}')"
  default_gateway="$(ip -4 route show default | awk 'NR==1 {print $3}')"
  [[ -n "${default_iface}" ]] || error_exit "No IPv4 default route is present."
  current_cidr="$(ip -o -4 addr show dev "${default_iface}" scope global | awk 'NR==1 {print $4}')"
  [[ -n "${current_cidr}" ]] || error_exit "Default-route interface ${default_iface} has no global IPv4 address."
  progress_message "Network preflight: ${default_iface} ${current_cidr}, gateway ${default_gateway:-not-reported}."

  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS cannot resolve archive.ubuntu.com to IPv4."
  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS cannot resolve api.snapcraft.io to IPv4."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS cannot resolve security.ubuntu.com to IPv4."

  timeout 8 bash -c '</dev/tcp/archive.ubuntu.com/80' || \
    error_exit "Cannot establish TCP connectivity to archive.ubuntu.com:80 for package bootstrap."
  timeout 8 bash -c '</dev/tcp/api.snapcraft.io/443' || \
    error_exit "Cannot establish TCP connectivity to api.snapcraft.io:443."
  timeout 8 bash -c '</dev/tcp/security.ubuntu.com/443' || \
    warning_message "TCP 443 to security.ubuntu.com could not be confirmed; apt source configuration may use another transport/mirror."

  if command -v timedatectl >/dev/null 2>&1; then
    local synced
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    if [[ "${synced}" != "yes" ]]; then
      warning_message "System time is not currently reported as NTP synchronized."
    else
      progress_message "System time synchronization verified."
    fi
  fi
}

capture_manufacturer_baseline() {
  CURRENT_STEP="1A - Capture manufacturer-delivered baseline"
  echo "------------------------------------------------------------"
  echo "Step 1A: Capture manufacturer-delivered baseline"
  echo "------------------------------------------------------------"

  progress_message "Recording manufacturer-delivered system state before package modification."

  # Preserve the first manufacturer baseline across retries/reruns. Once the
  # baseline exists, validate its checksum rather than replacing it with an
  # already-modified system state.
  if [[ -s "${MANUFACTURER_BASELINE_FILE}" && \
        -s "${MANUFACTURER_PACKAGE_BASELINE_FILE}" && \
        -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" ]]; then
    if [[ ! -s "${MANUFACTURER_BASELINE_SHA256_FILE}" ]]; then
      sha256sum \
        "${MANUFACTURER_BASELINE_FILE}" \
        "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
        "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
        > "${MANUFACTURER_BASELINE_SHA256_FILE}"
      chmod 640 "${MANUFACTURER_BASELINE_SHA256_FILE}"
      warning_message "Existing manufacturer baseline had no checksum record; checksum created without replacing the preserved baseline."
    fi

    if ! sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" >/dev/null 2>&1; then
      error_exit "Existing manufacturer baseline integrity validation failed. Do not overwrite the original baseline; investigate ${STATE_DIR}."
    fi

    progress_message "Existing manufacturer baseline is intact and will be preserved."
    return 0
  fi

  # If a partial prior baseline exists, preserve it for investigation before
  # creating a complete baseline set.
  local partial_backup_dir=""
  if [[ -e "${MANUFACTURER_BASELINE_FILE}" || \
        -e "${MANUFACTURER_PACKAGE_BASELINE_FILE}" || \
        -e "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || \
        -e "${MANUFACTURER_BASELINE_SHA256_FILE}" ]]; then
    partial_backup_dir="${STATE_DIR}/manufacturer-baseline-partial-$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "${partial_backup_dir}"
    for existing in \
      "${MANUFACTURER_BASELINE_FILE}" \
      "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
      "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
      "${MANUFACTURER_BASELINE_SHA256_FILE}"; do
      [[ -e "${existing}" ]] && cp -a "${existing}" "${partial_backup_dir}/"
    done
    warning_message "Partial manufacturer baseline records were preserved at ${partial_backup_dir} before recapture."
  fi

  {
    echo "Solutionz RMM Manufacturer Baseline"
    echo "Revision: ${REVISION}"
    echo "Captured UTC: $(date -u +%FT%TZ)"
    echo
    echo "===== Operating System ====="
    cat /etc/os-release 2>/dev/null || true
    echo "Kernel: $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo
    echo "===== Protectli / DMI ====="
    for field in sys_vendor product_name product_version board_name board_vendor bios_vendor bios_version bios_date; do
      path="/sys/class/dmi/id/${field}"
      if [[ -r "${path}" ]]; then
        printf '%s: %s\n' "${field}" "$(tr -d '\0' < "${path}" | xargs)"
      fi
    done
    echo
    echo "===== Storage ====="
    lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL,SERIAL 2>/dev/null || true
    echo
    echo "===== Network Interfaces ====="
    ip -br link 2>/dev/null || true
    ip -br addr 2>/dev/null || true
    ip route 2>/dev/null || true
    echo
    echo "===== Snap Inventory ====="
    if command -v snap >/dev/null 2>&1; then
      snap list 2>/dev/null || true
    else
      echo "snap command not present at manufacturer-baseline capture"
    fi
  } > "${MANUFACTURER_BASELINE_FILE}"
  chmod 640 "${MANUFACTURER_BASELINE_FILE}"

  # Record every dpkg package exactly as received before this setup script
  # performs apt-get update or installs anything.
  dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Abbrev}\n' 2>/dev/null \
    | LC_ALL=C sort > "${MANUFACTURER_PACKAGE_BASELINE_FILE}"
  chmod 640 "${MANUFACTURER_PACKAGE_BASELINE_FILE}"

  local installed_count=0
  local missing_count=0
  local pkg version
  {
    echo "Solutionz RMM Manufacturer Required-Package Validation"
    echo "Revision: ${REVISION}"
    echo "Captured UTC: $(date -u +%FT%TZ)"
    echo "Supported OS family: Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS"
    echo
    for pkg in "${REQUIRED_PACKAGES[@]}"; do
      if dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null | grep -q '^ii'; then
        version="$(dpkg-query -W -f='${Version}' "${pkg}" 2>/dev/null || true)"
        printf 'PASS\t%s\t%s\n' "${pkg}" "${version:-unknown}"
        installed_count=$((installed_count + 1))
      else
        printf 'MISSING\t%s\t-\n' "${pkg}"
        missing_count=$((missing_count + 1))
      fi
    done
    echo
    echo "installed_required_packages=${installed_count}"
    echo "missing_required_packages=${missing_count}"
    if (( missing_count == 0 )); then
      echo "manufacturer_package_validation=PASS"
    else
      echo "manufacturer_package_validation=DEVIATION"
    fi
  } > "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"
  chmod 640 "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"

  sha256sum \
    "${MANUFACTURER_BASELINE_FILE}" \
    "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
    "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
    > "${MANUFACTURER_BASELINE_SHA256_FILE}"
  chmod 640 "${MANUFACTURER_BASELINE_SHA256_FILE}"

  if ! sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" >/dev/null 2>&1; then
    error_exit "Manufacturer baseline checksum validation failed immediately after capture."
  fi

  if (( missing_count == 0 )); then
    progress_message "Manufacturer package validation passed: all required packages were already present."
  else
    warning_message "Manufacturer package validation found ${missing_count} missing required package(s). The deviation is recorded; the setup script will install only the missing packages."
  fi

  progress_message "Manufacturer baseline: ${MANUFACTURER_BASELINE_FILE}"
  progress_message "Manufacturer package inventory: ${MANUFACTURER_PACKAGE_BASELINE_FILE}"
  progress_message "Manufacturer package validation: ${MANUFACTURER_PACKAGE_VALIDATION_FILE}"
  progress_message "Manufacturer baseline checksums: ${MANUFACTURER_BASELINE_SHA256_FILE}"
}

install_required_packages() {
  step_message 2 "Validate/install missing required packages without a general system upgrade"

  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a

  local -a missing_packages=()
  local pkg
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null | grep -q '^ii'; then
      missing_packages+=("${pkg}")
    fi
  done

  if (( ${#missing_packages[@]} == 0 )); then
    progress_message "All required packages were supplied by the manufacturer; apt package installation is not required."
  else
    warning_message "${#missing_packages[@]} required package(s) are missing from the manufacturer baseline: ${missing_packages[*]}"
    progress_message "Updating package indexes only because required packages are missing..."
    if ! apt-get update; then
      error_exit "apt-get update failed. Review ${LOG_FILE} for repository, DNS, or network errors."
    fi
    progress_message "Package index update completed successfully."

    progress_message "Installing only the missing approved package(s)..."
    if ! apt-get install -y --no-install-recommends "${missing_packages[@]}"; then
      error_exit "Required package installation failed. Review ${LOG_FILE} for the package that failed and the apt/dpkg error."
    fi
    progress_message "Missing required package installation completed successfully."
  fi

  progress_message "Recording final required-package versions after setup package handling..."
  : > "${BASELINE_FILE}"
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${Package}\t${Version}\n' "${pkg}" >> "${BASELINE_FILE}" 2>/dev/null; then
      error_exit "Required package ${pkg} is still missing after package handling."
    fi
  done
  chmod 640 "${BASELINE_FILE}"
}

verify_required_packages() {
  step_message 3 "Verify final required-package state"

  local pkg
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    dpkg -s "${pkg}" >/dev/null 2>&1 || error_exit "Required package missing after setup package handling: ${pkg}"
    progress_message "Verified: ${pkg}"
  done

  command -v nano >/dev/null 2>&1 || error_exit "nano command not found."
  command -v ping >/dev/null 2>&1 || error_exit "ping command not found."
  command -v ufw >/dev/null 2>&1 || error_exit "ufw command not found."
  command -v python3 >/dev/null 2>&1 || error_exit "python3 command not found."
}

verify_ssh_service() {
  step_message 4 "Enable and verify SSH service"

  systemctl enable --now ssh
  systemctl is-enabled ssh >/dev/null 2>&1 || error_exit "SSH service is not enabled."
  systemctl is-active ssh >/dev/null 2>&1 || error_exit "SSH service is not active."
  progress_message "SSH service is enabled and active."
}

configure_time_sync() {
  CURRENT_STEP="4A - Enable and verify NTP time synchronization"
  echo "------------------------------------------------------------"
  echo "Step 4A: Enable and verify NTP time synchronization"
  echo "------------------------------------------------------------"

  command -v timedatectl >/dev/null 2>&1 || error_exit "timedatectl is unavailable; NTP synchronization cannot be managed."
  systemctl list-unit-files systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service is unavailable; the required systemd-timesyncd package is not installed correctly."

  # Revision SOC2-V07111226 standardizes Ubuntu time synchronization on
  # systemd-timesyncd. timedatectl enables network time, while the explicit
  # service commands make the runtime/startup state deterministic.
  timedatectl set-ntp true >/dev/null 2>&1 || \
    error_exit "Unable to enable network time synchronization with timedatectl."
  systemctl enable systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service could not be enabled."
  systemctl restart systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service could not be started/restarted."

  # Phase 2 must never be blocked behind time-sync.target. On networks where
  # UDP/123 is delayed or blocked, systemd-time-wait-sync can hold time-sync.target
  # indefinitely and prevent the post-reboot validator from running at all.
  # Revision SOC2-V07111226 therefore lets the validator start after network-online and
  # systemd-timesyncd, then performs its own bounded 180-second synchronization
  # wait and records a PASS/FAIL result in install.state.
  systemctl is-enabled --quiet systemd-timesyncd.service || \
    error_exit "systemd-timesyncd.service is not enabled after configuration."
  systemctl is-active --quiet systemd-timesyncd.service || \
    error_exit "systemd-timesyncd.service is not active after configuration."

  progress_message "NTP service configured. Waiting up to 180 seconds for initial synchronization."
  if wait_for_ntp_sync 36 5; then
    progress_message "System clock is synchronized to a network time source."
  else
    report_ntp_diagnostics
    warning_message "System clock has not synchronized within 180 seconds. Final pre-reboot validation will retry; UDP 123, DNS, DHCP-provided NTP, and upstream firewall policy should be reviewed if it remains unsynchronized."
  fi
}

configure_tun() {
  step_message 5 "Load and validate TUN support"

  modprobe tun
  grep -qxF 'tun' /etc/modules || echo 'tun' >> /etc/modules
  [[ -c /dev/net/tun ]] || error_exit "/dev/net/tun is not available after loading the tun module."
  progress_message "TUN support validated."
}

ensure_snapd() {
  step_message 6 "Enable and verify Snap service"

  systemctl enable --now snapd.socket
  systemctl start snapd.service
  systemctl is-active snapd.service >/dev/null 2>&1 || error_exit "snapd service is not active."

  snap version >/dev/null 2>&1 || error_exit "snap command is not operational."
  progress_message "Snap service is operational."
}

install_domotz() {
  step_message 7 "Install and validate Domotz Pro Agent"

  local installed=0
  if snap list "${DOMOTZ_SNAP_NAME}" >/dev/null 2>&1; then
    installed=1
    progress_message "Domotz is already installed. Revision pinning is not used by policy."
  fi

  if (( installed == 0 )); then
    if ! snap install "${DOMOTZ_SNAP_NAME}"; then
error_exit "Domotz Snap installation failed."
    fi
  fi

  if ! snap list "${DOMOTZ_SNAP_NAME}" > "${SNAP_BASELINE_FILE}"; then
    error_exit "Domotz installation could not be verified after snap install."
  fi
  chmod 640 "${SNAP_BASELINE_FILE}"
  progress_message "Domotz installation verified; installed revision recorded at ${SNAP_BASELINE_FILE}."
  cat "${SNAP_BASELINE_FILE}"
}

configure_domotz_permissions() {
  step_message 8 "Connect and verify required Domotz permissions"

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    progress_message "Connecting Domotz permission: ${permission}"
    if ! snap connect "${DOMOTZ_SNAP_NAME}:${permission}"; then
      error_exit "Failed to connect required Domotz permission: ${permission}"
    fi

    if ! snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      error_exit "Required Domotz permission is not connected: ${permission}"
    fi
  done
}

configure_ufw() {
  step_message 9 "Configure firewall and host security baseline"

  if ! ufw default deny incoming; then
    error_exit "Unable to set UFW default incoming policy."
  fi
  if ! ufw default allow outgoing; then
    error_exit "Unable to set UFW default outgoing policy. RMM/Domotz and monitoring traffic must be able to originate from the Agent."
  fi
  if ! ufw default deny routed; then
    error_exit "Unable to set UFW default routed/forwarded policy to deny."
  fi
  ufw logging low >/dev/null 2>&1 || warning_message "Unable to set UFW logging level to low; continuing with existing UFW logging policy."

  # Production requirement supplied by Solutionz: SSH and local Domotz service
  # ports are permitted globally on the Agent host firewall. This does not mean
  # unsolicited Internet inbound traffic is required; upstream/perimeter controls
  # remain responsible for Internet exposure.
  if ! ufw allow 22/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 22 (SSH)."
  fi
  if ! ufw allow 3000/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 3000 (local Domotz Agent service)."
  fi
  if ! ufw --force enable; then
    error_exit "UFW could not be enabled."
  fi

  ufw status | grep -q "Status: active" || error_exit "UFW did not become active."
  ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW' || error_exit "Expected global SSH UFW rule was not found."
  ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW' || error_exit "Expected global TCP 3000 UFW rule was not found."
  grep -Eq '^DEFAULT_FORWARD_POLICY="?DROP"?$' /etc/default/ufw || error_exit "UFW routed/forwarded default policy is not DROP."

  progress_message "UFW validated: inbound TCP 22/TCP 3000 are permitted, routed traffic is denied, and outbound TCP/UDP traffic is allowed by default."
  ufw status verbose
}

install_security_integrity_tool() {
  install -d -m 755 /usr/local/sbin
  install -d -m 750 /usr/local/share/solutionz-rmm
  cat > "${INTEGRITY_TOOL}" <<'INTEGRITYTOOL'
#!/usr/bin/env bash
set -Eeuo pipefail
REVISION="SOC2-V07111226"
BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-SOC2-V07111226.sha256"
FILES=(
  "/usr/local/share/solutionz-rmm/SOC2-V07111226"
  "/usr/local/sbin/solutionz-rmm-network-profile"
  "/usr/local/sbin/solutionz-rmm-network-validate"
  "/usr/local/sbin/solutionz-rmm-live-network-discovery"
  "/usr/local/sbin/solutionz-rmm-security-validate"
  "/usr/local/sbin/solutionz-rmm-integrity-baseline"
  "/usr/local/sbin/solutionz-rmm-local-config"
  "/usr/local/sbin/solutionz-rmm-setup"
  "/usr/local/sbin/solutionz-domotz-activate"
  "/usr/local/sbin/solutionz-rmm-engineering-shell"
  "/usr/local/sbin/solutionz-rmm-engineering-password"
  "/usr/local/sbin/rswsolutionz-rmm-postreboot-validate"
  "/etc/solutionz-rmm/network-profile.json"
  "/etc/netplan/00-installer-config.yaml"
  "/etc/ssh/sshd_config.d/99-solutionz-rmm-hardening.conf"
  "/etc/sysctl.d/90-solutionz-rmm-no-forwarding.conf"
  "/etc/sysctl.d/91-solutionz-rmm-security.conf"
  "/etc/audit/rules.d/99-solutionz-rmm.rules"
  "/etc/apt/apt.conf.d/52solutionz-rmm-security-updates"
  "/etc/default/ufw"
  "/etc/ufw/user.rules"
  "/etc/profile.d/solutionz-rmm-access.sh"
  "/etc/sudoers.d/solutionz-rmm-local-config"
  "/etc/systemd/system/solutionz-domotz-activate.service"
  "/etc/systemd/system/solutionz-domotz-activate.timer"
  "/home/solz_eng/.ssh/authorized_keys"
  "/var/lib/rswsolutionz-rmm/engineering-ssh-key-SOC2-V07111226.fingerprint"
  "/etc/apparmor.d/abstractions/solutionz-rmm-common"
  "/etc/apparmor.d/solutionz-rmm-setup"
  "/etc/apparmor.d/solutionz-rmm-local-config"
  "/etc/apparmor.d/solutionz-rmm-network-profile"
  "/etc/apparmor.d/solutionz-rmm-network-validate"
  "/etc/apparmor.d/solutionz-rmm-live-network-discovery"
  "/etc/apparmor.d/solutionz-rmm-security-validate"
  "/etc/apparmor.d/solutionz-rmm-integrity-baseline"
  "/etc/apparmor.d/solutionz-rmm-postreboot-validate"
  "/etc/apparmor.d/solutionz-domotz-activate"
  "/etc/apparmor.d/solutionz-rmm-engineering-shell"
  "/etc/apparmor.d/solutionz-rmm-engineering-password"
)
usage(){ echo "Usage: $(basename "$0") --refresh|--verify"; }
case "${1:-}" in
  --refresh)
    install -d -m 750 "$(dirname "$BASELINE")"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    for f in "${FILES[@]}"; do
      [[ -e "$f" ]] || { echo "ERROR - Required integrity target missing: $f" >&2; exit 1; }
      sha256sum "$f" >> "$tmp"
    done
    install -o root -g root -m 640 "$tmp" "$BASELINE"
    echo "Security integrity baseline refreshed: $BASELINE"
    ;;
  --verify)
    [[ -s "$BASELINE" ]] || { echo "ERROR - Security integrity baseline missing: $BASELINE" >&2; exit 1; }
    sha256sum -c "$BASELINE"
    ;;
  *) usage; exit 2 ;;
esac
INTEGRITYTOOL
  chmod 750 "${INTEGRITY_TOOL}"
  chown root:root "${INTEGRITY_TOOL}"
}

install_security_validator() {
  install -d -m 755 /usr/local/sbin
  cat > "${SECURITY_VALIDATOR}" <<'SECURITYVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail
REVISION="SOC2-V07111226"
RESULT="/var/lib/rswsolutionz-rmm/security-validation-SOC2-V07111226.result"
SYSCTL_FILE="/etc/sysctl.d/91-solutionz-rmm-security.conf"
SSH_FILE="/etc/ssh/sshd_config.d/99-solutionz-rmm-hardening.conf"
AUDIT_FILE="/etc/audit/rules.d/99-solutionz-rmm.rules"
APT_POLICY="/etc/apt/apt.conf.d/52solutionz-rmm-security-updates"
INTEGRITY="/usr/local/sbin/solutionz-rmm-integrity-baseline"
BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-SOC2-V07111226.sha256"
TECH_GROUP="solutionz-rmm-tech"
ENG_GROUP="solutionz-rmm-engineering"
ENG_USER="solz_eng"
ENG_KEYS="/home/solz_eng/.ssh/authorized_keys"
ENG_FP_EXPECTED="SHA256:F8aZDgPAP4X7ofp2wjQSed9rWzhs7xcCLMas39JFWa0"
ENG_FP_FILE="/var/lib/rswsolutionz-rmm/engineering-ssh-key-SOC2-V07111226.fingerprint"
ENG_PASSWORD_MARKER="/var/lib/rswsolutionz-rmm/engineering-password-provisioned"
ACCESS_PROFILE="/etc/profile.d/solutionz-rmm-access.sh"
LOCALCFG="/usr/local/sbin/solutionz-rmm-local-config"
LIVE="/usr/local/sbin/solutionz-rmm-live-network-discovery"
LIVE_RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-SOC2-V07111226.result"
APPARMOR_POLICY_REVISION="AA-SOC2-V07111226-R3"
APPARMOR_REQUIRED_PROFILES=(solutionz-rmm-setup solutionz-rmm-local-config solutionz-rmm-network-profile solutionz-rmm-network-validate solutionz-rmm-live-network-discovery solutionz-rmm-security-validate solutionz-rmm-integrity-baseline solutionz-rmm-postreboot-validate solutionz-domotz-activate solutionz-rmm-engineering-shell solutionz-rmm-engineering-password)
APPARMOR_REQUIRED_FILES=(/etc/apparmor.d/abstractions/solutionz-rmm-common /etc/apparmor.d/solutionz-rmm-setup /etc/apparmor.d/solutionz-rmm-local-config /etc/apparmor.d/solutionz-rmm-network-profile /etc/apparmor.d/solutionz-rmm-network-validate /etc/apparmor.d/solutionz-rmm-live-network-discovery /etc/apparmor.d/solutionz-rmm-security-validate /etc/apparmor.d/solutionz-rmm-integrity-baseline /etc/apparmor.d/solutionz-rmm-postreboot-validate /etc/apparmor.d/solutionz-domotz-activate /etc/apparmor.d/solutionz-rmm-engineering-shell /etc/apparmor.d/solutionz-rmm-engineering-password)
F=(); W=()
pass(){ echo "PASS - $*"; }
fail(){ echo "FAIL - $*"; F+=("$*"); }
warn(){ echo "WARN - $*"; W+=("$*"); }
check_sysctl(){ local k="$1" v="$2" a; a="$(sysctl -n "$k" 2>/dev/null || true)"; [[ "$a" == "$v" ]] && pass "$k=$v" || fail "$k is '${a:-missing}', expected '$v'"; }
mkdir -p "$(dirname "$RESULT")"

echo "============================================================"
echo "Solutionz RMM Security Validation"
echo "Revision: $REVISION"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"

[[ -s "$SYSCTL_FILE" ]] && pass "Security sysctl policy installed." || fail "Security sysctl policy missing."
check_sysctl net.ipv4.ip_forward 0
check_sysctl net.ipv4.conf.all.accept_redirects 0
check_sysctl net.ipv4.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.send_redirects 0
check_sysctl net.ipv4.conf.default.send_redirects 0
check_sysctl net.ipv4.conf.all.accept_source_route 0
check_sysctl net.ipv4.conf.default.accept_source_route 0
check_sysctl net.ipv4.icmp_echo_ignore_broadcasts 1
check_sysctl net.ipv4.conf.all.log_martians 1
check_sysctl net.ipv4.conf.default.log_martians 1
check_sysctl net.ipv4.conf.all.proxy_arp 0
check_sysctl net.ipv4.conf.default.proxy_arp 0
check_sysctl net.ipv6.conf.all.forwarding 0
check_sysctl net.ipv6.conf.default.forwarding 0
check_sysctl net.ipv6.conf.all.accept_redirects 0
check_sysctl net.ipv6.conf.default.accept_redirects 0
check_sysctl net.ipv6.conf.all.accept_source_route 0
check_sysctl net.ipv6.conf.default.accept_source_route 0

for iface in eth0 eth1; do
  if ip -o link show dev "$iface" 2>/dev/null | grep -q ' master '; then
    fail "$iface is enslaved to a bridge/bond/master; WAN/LAN bridging is prohibited."
  else
    pass "$iface is not attached to a bridge/bond/master."
  fi
done

if ufw_status="$(ufw status 2>&1)"; then
  grep -q '^Status: active' <<<"$ufw_status" && pass "UFW active." || fail "UFW inactive."
  grep -Eq '^22/tcp[[:space:]]+ALLOW' <<<"$ufw_status" && pass "Domotz-required TCP 22 permitted." || fail "Required UFW TCP 22 rule missing."
  grep -Eq '^3000/tcp[[:space:]]+ALLOW' <<<"$ufw_status" && pass "Domotz-required TCP 3000 rule missing."
else
  fail "UFW status could not be read: $ufw_status"
fi
grep -Eq '^DEFAULT_INPUT_POLICY="?DROP"?$' /etc/default/ufw 2>/dev/null && pass "UFW default inbound policy is DROP." || fail "UFW default inbound policy is not DROP."
grep -Eq '^DEFAULT_OUTPUT_POLICY="?ACCEPT"?$' /etc/default/ufw 2>/dev/null && pass "UFW default outbound policy is ACCEPT." || fail "UFW default outbound policy is not ACCEPT."
grep -Eq '^DEFAULT_FORWARD_POLICY="?DROP"?$' /etc/default/ufw 2>/dev/null && pass "UFW forwarded/routed policy is DROP." || fail "UFW forwarded/routed policy is not DROP."

if command -v sshd >/dev/null 2>&1 && sshd -t >/dev/null 2>&1; then
  pass "sshd configuration parses successfully."
  SSH_EFFECTIVE="$(sshd -T 2>/dev/null || true)"
  grep -q '^permitrootlogin no$' <<<"$SSH_EFFECTIVE" && pass "SSH root login disabled." || fail "SSH PermitRootLogin is not 'no'."
  grep -q '^maxauthtries 3$' <<<"$SSH_EFFECTIVE" && pass "SSH MaxAuthTries=3." || fail "SSH MaxAuthTries is not 3."
  grep -q '^logingracetime 30$' <<<"$SSH_EFFECTIVE" && pass "SSH LoginGraceTime=30." || fail "SSH LoginGraceTime is not 30 seconds."
  grep -q '^x11forwarding no$' <<<"$SSH_EFFECTIVE" && pass "SSH X11 forwarding disabled." || fail "SSH X11Forwarding is not disabled."
  TECH_SSH_EFFECTIVE="$(sshd -T -C user=solz_rmm,host=localhost,addr=127.0.0.1 2>/dev/null || true)"
  grep -q '^forcecommand sudo -n /usr/local/sbin/solutionz-rmm-local-config$' <<<"$TECH_SSH_EFFECTIVE" && pass "solz_rmm SSH is forced into the network configuration menu." || fail "solz_rmm SSH is not forced into the network configuration menu."
  ENG_SSH_EFFECTIVE="$(sshd -T -C user=solz_eng,host=localhost,addr=127.0.0.1 2>/dev/null || true)"
  grep -q '^forcecommand sudo -n /usr/local/sbin/solutionz-rmm-local-config --engineering-auto$' <<<"$ENG_SSH_EFFECTIVE" && pass "solz_eng SSH is forced into authenticated Engineering menu mode." || fail "solz_eng SSH ForceCommand is not the Engineering menu."
  grep -q '^passwordauthentication no$' <<<"$ENG_SSH_EFFECTIVE" && pass "solz_eng SSH password authentication disabled." || fail "solz_eng SSH password authentication is not disabled."
  grep -q '^authenticationmethods publickey$' <<<"$ENG_SSH_EFFECTIVE" && pass "solz_eng SSH requires public-key authentication." || fail "solz_eng SSH does not require public-key authentication."
else
  fail "sshd configuration validation failed."
fi
getent group "$TECH_GROUP" >/dev/null 2>&1 && pass "Restricted field-tech group exists." || fail "Field-tech group missing."
getent group "$ENG_GROUP" >/dev/null 2>&1 && pass "Engineering group exists." || fail "Engineering group missing."
if id "$ENG_USER" >/dev/null 2>&1; then
  pass "Engineering account $ENG_USER exists."
  [[ "$(getent passwd "$ENG_USER" | cut -d: -f7)" == "/bin/bash" ]] && pass "Engineering account uses Bash shell." || fail "Engineering account does not use Bash shell."
  id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx "$ENG_GROUP" && pass "Engineering account is in $ENG_GROUP." || fail "Engineering account is not in $ENG_GROUP."
else
  fail "Engineering account $ENG_USER missing."
fi
if [[ -s "$ENG_KEYS" ]]; then
  eng_fp="$(ssh-keygen -lf "$ENG_KEYS" -E sha256 2>/dev/null | awk 'NR==1{print $2}')"
  [[ "$eng_fp" == "$ENG_FP_EXPECTED" ]] && pass "Engineering SSH public-key fingerprint matches approved key." || fail "Engineering SSH public-key fingerprint mismatch: ${eng_fp:-missing}."
else
  fail "Engineering authorized_keys missing."
fi
[[ -s "$ENG_FP_FILE" ]] && grep -qx "$ENG_FP_EXPECTED" "$ENG_FP_FILE" && pass "Engineering SSH fingerprint audit record matches approved key." || fail "Engineering SSH fingerprint audit record missing/mismatched."
[[ "$(passwd -S "$ENG_USER" 2>/dev/null | awk '{print $2}')" == "P" ]] && pass "Engineering local password is configured for console/sudo recovery." || fail "Engineering local password is not configured."
[[ -s "$ENG_PASSWORD_MARKER" ]] && pass "Engineering password provisioning marker exists." || fail "Engineering password provisioning marker missing."
[[ -s "$ACCESS_PROFILE" ]] && grep -q -- '--engineering-auto' "$ACCESS_PROFILE" && grep -q -- '--serial-auto' "$ACCESS_PROFILE" && pass "All-interactive login policy routes Engineering and technician logins through the menu." || fail "All-interactive login menu policy missing/incomplete."
if [[ -x "$LOCALCFG" ]] && ! grep -q 'Open Linux shell' "$LOCALCFG"; then
  pass "Field configuration menu does not expose an unrestricted Linux shell option."
else
  fail "Field configuration menu exposes or cannot verify Linux shell access."
fi
grep -q 'Engineering Login / Password Setup' "$LOCALCFG" 2>/dev/null && pass "Engineering Login / Password Setup menu option installed." || fail "Engineering Login / Password Setup menu option missing."
grep -q 'Engineering Tools / Setup Script' "$LOCALCFG" 2>/dev/null && pass "Engineering Tools / Setup Script menu option installed." || fail "Engineering Tools / Setup Script menu option missing."
grep -q 'Open Engineering Shell (solz_eng only)' "$LOCALCFG" 2>/dev/null && pass "Direct Engineering shell menu option installed and labeled solz_eng-only." || fail "Direct Engineering shell menu option missing."
grep -q 'LIVE NIC / CABLING STATUS' "$LOCALCFG" 2>/dev/null && pass "Live NIC/cabling status banner installed." || fail "Live NIC/cabling status banner missing."
grep -q 'Register NEW Domotz Collector Now' "$LOCALCFG" 2>/dev/null && pass "NEW Domotz Collector registration menu option installed." || fail "NEW Domotz Collector registration menu option missing."
[[ -x "$LIVE" ]] && pass "Live network discovery utility installed." || fail "Live network discovery utility missing."
[[ -s "$LIVE_RESULT" ]] && pass "Live network discovery result record exists." || warn "Live network discovery result record is not present yet."

if service_status="$(systemctl is-active auditd 2>&1)"; then
  pass "auditd active."
else
  fail "auditd status check failed: ${service_status:-no status returned}"
fi
[[ -s "$AUDIT_FILE" ]] && pass "Solutionz audit rules installed." || fail "Solutionz audit rules missing."
grep -q 'solutionz_apparmor' "$AUDIT_FILE" 2>/dev/null && pass "AppArmor policy directory changes are audited." || fail "AppArmor audit watch is missing."
if loaded_audit_rules="$(auditctl -l 2>/dev/null)"; then
  grep -Eq '(/etc/apparmor[.]d/|/etc/apparmor[.]d )[[:space:]]*.*solutionz_apparmor' <<<"$loaded_audit_rules" && pass "AppArmor audit watch loaded." || fail "AppArmor audit watch is not loaded."
  grep -q 'solutionz_netplan' <<<"$loaded_audit_rules" && pass "Netplan audit watch loaded." || fail "Netplan audit watch is not loaded."
else
  fail "Loaded audit rules could not be read."
fi
if service_status="$(systemctl is-active apparmor 2>&1)"; then
  pass "AppArmor service active."
else
  fail "AppArmor service status check failed: ${service_status:-no status returned}"
fi
if [[ -r /sys/kernel/security/apparmor/profiles ]]; then
  for aa_file in "${APPARMOR_REQUIRED_FILES[@]}"; do
    [[ -s "$aa_file" ]] && pass "AppArmor policy file installed: $aa_file" || fail "Required AppArmor policy file missing: $aa_file"
  done
  for aa_profile in "${APPARMOR_REQUIRED_PROFILES[@]}"; do
    grep -Fq "${aa_profile} (enforce)" /sys/kernel/security/apparmor/profiles && \
      pass "AppArmor profile enforced: ${aa_profile}" || fail "AppArmor profile missing or not in enforce mode: ${aa_profile}"
  done
else
  fail "AppArmor loaded-profile inventory is unavailable."
fi
[[ -s "$APT_POLICY" ]] && grep -q 'Automatic-Reboot "false"' "$APT_POLICY" && pass "Controlled security-update policy installed with automatic reboot disabled." || fail "Controlled security-update policy missing/invalid."
grep -q 'APT::Periodic::Unattended-Upgrade "0"' "$APT_POLICY" 2>/dev/null && pass "Unattended package installation disabled; security updates require an approved maintenance action." || fail "Unattended package installation is not disabled by Solutionz policy."

[[ -x "$INTEGRITY" && -s "$BASELINE" ]] && pass "Security integrity baseline and verifier present." || fail "Security integrity baseline/tool missing."

listener_tmp="$(mktemp /tmp/solutionz-rmm-listeners.XXXXXX)"
trap 'rm -f "$listener_tmp"' EXIT
if ! ss -lntH 2>/dev/null | while read -r state recvq sendq local peer rest; do
  port="${local##*:}"; addr="${local%:*}"
  [[ "$port" =~ ^[0-9]+$ ]] || continue
  case "$addr" in 127.*|'[::1]'|'::1') continue ;; esac
  case "$port" in 22|3000) ;; *) echo "UNAPPROVED_LISTENER|$local" ;; esac
done > "$listener_tmp"; then
  fail "TCP listener inventory could not be read."
elif [[ -s "$listener_tmp" ]]; then
  while IFS='|' read -r _ l; do fail "Unexpected network-reachable TCP listener detected: $l"; done < "$listener_tmp"
else
  pass "No unexpected network-reachable TCP listeners detected beyond approved TCP 22/3000."
fi
rm -f "$listener_tmp"
trap - EXIT
ss -lntH 2>/dev/null | awk '$4 ~ /:22$/ {f=1} END{exit f?0:1}' && pass "TCP 22 is listening." || fail "TCP 22 is not listening."
ss -lntH 2>/dev/null | awk '$4 ~ /:3000$/ {f=1} END{exit f?0:1}' && pass "TCP 3000 is listening." || warn "TCP 3000 is not currently listening; Domotz activation/service state may not yet expose it."

if command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -Eiq '\b(masquerade|snat|dnat)\b'; then
  warn "NAT rule detected. IPv4 forwarding remains the enforcement boundary; review rule ownership before production acceptance."
else
  pass "No NAT action detected in the active nftables ruleset."
fi

[[ -e /dev/tpmrm0 || -e /dev/tpm0 ]] && pass "TPM device present for future measured-boot/attestation use." || warn "TPM device not visible; hardware-backed security remains a future-phase item."
if command -v mokutil >/dev/null 2>&1; then
  mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled' && pass "Secure Boot enabled." || warn "Secure Boot is not enabled; enable only after V1210 regression validation."
else
  warn "Secure Boot state not evaluated because mokutil is not installed."
fi

f=${#F[@]}; w=${#W[@]}; r=PASS; (( f > 0 )) && r=FAIL
{
  echo "result=$r"
  echo "revision=$REVISION"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "failures=$f"
  echo "warnings=$w"
  echo "security_baseline=$BASELINE"
  echo
  echo "FAILED_CHECKS:"
  (( f > 0 )) && printf -- '- %s\n' "${F[@]}" || echo '- none'
  echo
  echo "WARNING_CHECKS:"
  (( w > 0 )) && printf -- '- %s\n' "${W[@]}" || echo '- none'
} > "$RESULT" || exit 1
chmod 640 "$RESULT" || exit 1
(( f == 0 ))
SECURITYVALIDATOR
  chmod 750 "${SECURITY_VALIDATOR}"
  chown root:root "${SECURITY_VALIDATOR}"
}

install_engineering_identity() {
  local key_tmp actual_fp engineering_password_state password_source

  groupadd -f "${ENGINEERING_GROUP}"
  groupadd -f "${ENGINEERING_USER}"

  if ! id "${ENGINEERING_USER}" >/dev/null 2>&1; then
    useradd -m -d "${ENGINEERING_HOME}" -s /bin/bash -g "${ENGINEERING_USER}" -G "sudo,${ENGINEERING_GROUP}" -c "Solutionz RMM Engineering" "${ENGINEERING_USER}" || \
      error_exit "Unable to create ${ENGINEERING_USER}."
    progress_message "Created ${ENGINEERING_USER} engineering account."
  else
    usermod -d "${ENGINEERING_HOME}" -s /bin/bash -g "${ENGINEERING_USER}" -aG "sudo,${ENGINEERING_GROUP}" "${ENGINEERING_USER}" || \
      error_exit "Unable to normalize ${ENGINEERING_USER} engineering account."
  fi

  # The Engineering account must never be classified as a technician account.
  if id -nG "${ENGINEERING_USER}" 2>/dev/null | tr ' ' '\n' | grep -qx "${FIELD_TECH_GROUP}"; then
    gpasswd -d "${ENGINEERING_USER}" "${FIELD_TECH_GROUP}" >/dev/null 2>&1 || \
      error_exit "Unable to remove ${ENGINEERING_USER} from ${FIELD_TECH_GROUP}."
  fi

  install -d -o "${ENGINEERING_USER}" -g "${ENGINEERING_USER}" -m 700 "${ENGINEERING_HOME}/.ssh"
  printf '%s\n' "${ENGINEERING_SSH_PUBLIC_KEY}" > "${ENGINEERING_AUTHORIZED_KEYS}"
  chown "${ENGINEERING_USER}:${ENGINEERING_USER}" "${ENGINEERING_AUTHORIZED_KEYS}"
  chmod 600 "${ENGINEERING_AUTHORIZED_KEYS}"

  key_tmp="$(mktemp)"
  printf '%s\n' "${ENGINEERING_SSH_PUBLIC_KEY}" > "${key_tmp}"
  if command -v ssh-keygen >/dev/null 2>&1; then
    actual_fp="$(ssh-keygen -lf "${key_tmp}" -E sha256 2>/dev/null | awk '{print $2}')"
  else
    actual_fp="$(python3 - "${key_tmp}" <<'PYFP'
import base64,hashlib,sys
parts=open(sys.argv[1],encoding='utf-8').read().strip().split()
blob=base64.b64decode(parts[1])
print('SHA256:'+base64.b64encode(hashlib.sha256(blob).digest()).decode().rstrip('='))
PYFP
)"
  fi
  rm -f "${key_tmp}"

  [[ "${actual_fp}" == "${ENGINEERING_SSH_FINGERPRINT_EXPECTED}" ]] || \
    error_exit "Engineering SSH public-key fingerprint mismatch: got ${actual_fp:-missing}."
  printf '%s\n' "${actual_fp}" > "${ENGINEERING_KEY_FINGERPRINT_FILE}"
  chmod 640 "${ENGINEERING_KEY_FINGERPRINT_FILE}"
  chown root:root "${ENGINEERING_KEY_FINGERPRINT_FILE}"

  # Preserve an already configured local Engineering password. Fresh or otherwise
  # unprovisioned accounts receive the approved baseline local password through a
  # one-way SHA-512 crypt hash. SSH remains public-key-only in sshd regardless.
  engineering_password_state="$(passwd -S "${ENGINEERING_USER}" 2>/dev/null | awk '{print $2}' || true)"
  password_source=""
  if [[ "${engineering_password_state}" == "P" ]]; then
    password_source="existing_engineering_password_preserved"
    progress_message "Existing ${ENGINEERING_USER} local password preserved unchanged."
  else
    usermod -p "${ENGINEERING_DEFAULT_PASSWORD_HASH}" "${ENGINEERING_USER}" || \
      error_exit "Unable to provision the approved default local password for ${ENGINEERING_USER}."
    password_source="default_engineering_password_hash"
    progress_message "Approved default local engineering password hash provisioned for ${ENGINEERING_USER}; plaintext was not stored or logged."
  fi

  install -d -m 750 "$(dirname "${ENGINEERING_PASSWORD_MARKER}")"
  {
    echo "engineering_login=${ENGINEERING_USER}"
    echo "status=configured"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "source=${password_source}"
    echo "ssh_authentication=public_key_only"
    echo "engineering_key_fingerprint=${actual_fp}"
  } > "${ENGINEERING_PASSWORD_MARKER}"
  chmod 640 "${ENGINEERING_PASSWORD_MARKER}"
  chown root:root "${ENGINEERING_PASSWORD_MARKER}"

  progress_message "Engineering SSH key installed and verified: ${actual_fp}. Local console password is configured; SSH remains public-key only."
}

configure_security_hardening() {
  progress_message "Applying Solutionz host security hardening baseline."

  install -d -m 750 /usr/local/share/solutionz-rmm
  if [[ -r "$0" ]]; then
    install -o root -g root -m 640 "$0" "${INSTALLED_SCRIPT_COPY}"
    if [[ ! "$0" -ef "${INSTALLED_SETUP_COMMAND}" ]]; then
      install -o root -g root -m 750 "$0" "${INSTALLED_SETUP_COMMAND}"
    fi
  else
    warning_message "Unable to preserve/install the Setup script for engineering access and integrity validation."
  fi

  groupadd -f "${FIELD_TECH_GROUP}"
  groupadd -f "${ENGINEERING_GROUP}"
  install_engineering_identity

  cat > "${SECURITY_SYSCTL_FILE}" <<'EOF'
# Solutionz RMM host-network hardening. Do not enable IP forwarding on the dual-homed collector.
net.ipv4.ip_forward=0
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.default.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.default.send_redirects=0
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.default.accept_source_route=0
net.ipv4.icmp_echo_ignore_broadcasts=1
net.ipv4.conf.all.log_martians=1
net.ipv4.conf.default.log_martians=1
net.ipv4.conf.all.proxy_arp=0
net.ipv4.conf.default.proxy_arp=0
net.ipv6.conf.all.forwarding=0
net.ipv6.conf.default.forwarding=0
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.default.accept_redirects=0
net.ipv6.conf.all.accept_source_route=0
net.ipv6.conf.default.accept_source_route=0
EOF
  chmod 644 "${SECURITY_SYSCTL_FILE}"
  sysctl --system >/dev/null || error_exit "Failed to apply Solutionz kernel/network hardening sysctl policy."

  install -d -m 755 /etc/ssh/sshd_config.d
  cat > "${SSH_HARDENING_FILE}" <<'EOF'
# Solutionz RMM SSH hardening.
PermitRootLogin no
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no
PubkeyAuthentication yes

# Engineering SSH is key-only. A successful key-authenticated solz_eng login is
# forced into the Solutionz menu in ENGINEERING mode; Engineering shell access
# is available only through explicit authenticated menu selections.
Match User solz_eng
    AuthenticationMethods publickey
    PasswordAuthentication no
    PubkeyAuthentication yes
    ForceCommand sudo -n /usr/local/sbin/solutionz-rmm-local-config --engineering-auto
    X11Forwarding no
    DisableForwarding yes
    PermitUserRC no
    PermitTunnel no
Match all

# The factory-provisioned technician account is left unchanged. Restrict it by
# username so its existing Unix group memberships do not determine shell access.
Match User solz_rmm
    ForceCommand sudo -n /usr/local/sbin/solutionz-rmm-local-config
    X11Forwarding no
    DisableForwarding yes
    PermitUserRC no
    PermitTunnel no
Match all

# Any additional approved field-tech accounts placed in the restricted group
# receive the same menu-only SSH behavior.
Match Group solutionz-rmm-tech
    ForceCommand sudo -n /usr/local/sbin/solutionz-rmm-local-config
    X11Forwarding no
    DisableForwarding yes
    PermitUserRC no
    PermitTunnel no
Match all
EOF
  chmod 644 "${SSH_HARDENING_FILE}"
  sshd -t || error_exit "SSH hardening configuration failed sshd syntax validation."
  systemctl reload ssh || error_exit "Unable to reload SSH after hardening."

  cat > "${SECURITY_APT_POLICY_FILE}" <<'EOF'
// Solutionz RMM controlled security-update policy.
// Security packages are installed only during an approved maintenance action.
APT::Periodic::Unattended-Upgrade "0";
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-security";
};
EOF
  chmod 644 "${SECURITY_APT_POLICY_FILE}"

  install -d -m 750 /etc/audit/rules.d
  cat > "${AUDIT_RULES_FILE}" <<'EOF'
-w /etc/netplan/ -p wa -k solutionz_netplan
-w /etc/solutionz-rmm/ -p wa -k solutionz_rmm_config
-w /etc/ssh/ -p wa -k solutionz_ssh
-w /etc/ufw/ -p wa -k solutionz_ufw
-w /etc/sysctl.d/ -p wa -k solutionz_sysctl
-w /etc/systemd/system/ -p wa -k solutionz_systemd
-w /etc/apparmor.d/ -p wa -k solutionz_apparmor
-w /usr/local/sbin/ -p wa -k solutionz_sbin
-w /var/lib/rswsolutionz-rmm/ -p wa -k solutionz_state
EOF
  chmod 640 "${AUDIT_RULES_FILE}"
  systemctl enable --now auditd >/dev/null 2>&1 || error_exit "Unable to enable/start auditd."
  augenrules --load >/dev/null 2>&1 || error_exit "Unable to load required auditd rules."

  systemctl enable --now apparmor >/dev/null 2>&1 || error_exit "Unable to enable/start AppArmor."
  install_security_integrity_tool
  install_security_validator

  progress_message "Security hardening installed: forwarding/redirect/source-route protections, SSH hardening, auditd, AppArmor, integrity tooling, and security validation."
}

install_solutionz_apparmor_profiles() {
  progress_message "Installing Solutionz role-specific AppArmor enforcement policies (${APPARMOR_POLICY_REVISION})."
  install -d -m 755 "${APPARMOR_DIR}" "${APPARMOR_DIR}/abstractions"

  cat > "${ENGINEERING_SHELL_TOOL}" <<'ENGSHELL'
#!/usr/bin/env bash
set -Eeuo pipefail
ENGINEERING_USER="solz_eng"
[[ "$(id -un)" == "${ENGINEERING_USER}" ]] || { echo "Engineering shell requires the ${ENGINEERING_USER} identity." >&2; exit 77; }
ENGINEERING_HOME="$(getent passwd "${ENGINEERING_USER}" | awk -F: '{print $6}')"
[[ -n "${ENGINEERING_HOME}" && -d "${ENGINEERING_HOME}" ]] || ENGINEERING_HOME="/home/${ENGINEERING_USER}"
export HOME="${ENGINEERING_HOME}"
export USER="${ENGINEERING_USER}"
export LOGNAME="${ENGINEERING_USER}"
export SHELL="/bin/bash"
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export SOLUTIONZ_RMM_MENU_ACTIVE=1
export SOLUTIONZ_RMM_SERIAL_MENU_ACTIVE=1
cd "${HOME}" 2>/dev/null || cd /
echo "Solutionz Engineering shell. Type 'exit' to return to the RMM menu."
exec /bin/bash --noprofile --norc -i
ENGSHELL
  chown root:${ENGINEERING_GROUP} "${ENGINEERING_SHELL_TOOL}"
  chmod 750 "${ENGINEERING_SHELL_TOOL}"

  cat > "${ENGINEERING_PASSWORD_TOOL}" <<'ENGPASS'
#!/usr/bin/env bash
