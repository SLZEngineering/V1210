setup_collector_identity() {
  step_message 16 "Create dedicated collector service identity"

  getent group "${COLLECTOR_GROUP}" >/dev/null 2>&1 || groupadd --system "${COLLECTOR_GROUP}"
  getent group "${OPERATOR_GROUP}" >/dev/null 2>&1 || groupadd --system "${OPERATOR_GROUP}"

  if ! id "${COLLECTOR_USER}" >/dev/null 2>&1; then
    useradd --system \
      --gid "${COLLECTOR_GROUP}" \
      --home-dir "${COLLECTOR_HOME}" \
      --create-home \
      --shell /usr/sbin/nologin \
      "${COLLECTOR_USER}"
  fi

  if id "${OPERATOR_USER}" >/dev/null 2>&1; then
    usermod -a -G "${OPERATOR_GROUP}" "${OPERATOR_USER}"
    progress_message "Added ${OPERATOR_USER} to ${OPERATOR_GROUP}."
  else
    warning_message "Operator user ${OPERATOR_USER} does not exist. Collector remote wrapper access was not assigned to that user."
  fi

  install -d -o "${COLLECTOR_USER}" -g "${COLLECTOR_GROUP}" -m 700 "${COLLECTOR_SSH_DIR}"

  if [[ ! -f "${COLLECTOR_SSH_KEY}" ]]; then
    runuser -u "${COLLECTOR_USER}" -- \
      ssh-keygen -q -t rsa -b 4096 -N '' -f "${COLLECTOR_SSH_KEY}"
  fi
  chmod 600 "${COLLECTOR_SSH_KEY}"
  chmod 644 "${COLLECTOR_SSH_KEY}.pub"
  chown "${COLLECTOR_USER}:${COLLECTOR_GROUP}" "${COLLECTOR_SSH_KEY}" "${COLLECTOR_SSH_KEY}.pub"

  cat > "${COLLECTOR_WRAPPER}" <<EOF
#!/usr/bin/env bash
set -euo pipefail
mode="\${1:-stdout}"
case "\${mode}" in
  stdout|file|both|--help|-h) ;;
  *)
    echo "Invalid collector mode: \${mode}" >&2
    exit 2
    ;;
esac
exec /usr/bin/python3 "${RMM_COLLECTOR}" "\${mode}"
EOF
  chmod 755 "${COLLECTOR_WRAPPER}"
  chown root:root "${COLLECTOR_WRAPPER}"

  cat > "${COLLECTOR_SUDOERS}" <<EOF
%${OPERATOR_GROUP} ALL=(${COLLECTOR_USER}) NOPASSWD: ${COLLECTOR_WRAPPER} *
EOF
  chmod 440 "${COLLECTOR_SUDOERS}"
  visudo -cf "${COLLECTOR_SUDOERS}" >/dev/null || error_exit "Collector sudoers validation failed."
}

validate_config_json() {
  python3 - "${RMM_CONFIG}" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
with path.open("r", encoding="utf-8") as f:
    data = json.load(f)

required = {
    "common_tags": dict,
    "crestron_devices": list,
}
for key, expected_type in required.items():
    if key not in data:
        raise SystemExit(f"Missing required config key: {key}")
    if not isinstance(data[key], expected_type):
        raise SystemExit(f"Config key {key!r} must be {expected_type.__name__}")

if "output_file" in data and not isinstance(data["output_file"], str):
    raise SystemExit("output_file must be a string when present")

print("config.json syntax and required top-level structure are valid")
PY
}

migrate_collector_identity_path() {
  python3 - "${RMM_CONFIG}" "${COLLECTOR_SSH_KEY}" <<'PY'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
new_key = sys.argv[2]

with path.open("r", encoding="utf-8") as f:
    data = json.load(f)

changed = False
for device in data.get("crestron_devices", []):
    ssh = device.get("ssh")
    if not isinstance(ssh, dict):
        continue
    identity = str(ssh.get("identity_file", "") or "")
    if not identity or identity == "/root/.ssh/id_rsa":
        ssh["identity_file"] = new_key
        changed = True

if changed:
    with path.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    print(f"Updated collector SSH identity path to {new_key}")
else:
    print("Collector SSH identity path did not require migration")
PY
}


validate_collector_identity_and_permissions() {
  id "${COLLECTOR_USER}" >/dev/null 2>&1 || error_exit "Collector service account ${COLLECTOR_USER} is missing."
  [[ "$(stat -c '%U:%G' "${COLLECTOR_HOME}" 2>/dev/null || true)" == "${COLLECTOR_USER}:${COLLECTOR_GROUP}" ]] || \
    error_exit "Collector home ownership is incorrect: ${COLLECTOR_HOME}"
  [[ -f "${COLLECTOR_SSH_KEY}" ]] || error_exit "Collector SSH private key is missing: ${COLLECTOR_SSH_KEY}"
  [[ "$(stat -c '%U:%G' "${COLLECTOR_SSH_KEY}")" == "${COLLECTOR_USER}:${COLLECTOR_GROUP}" ]] || \
    error_exit "Collector SSH private key ownership is incorrect."
  [[ "$(stat -c '%a' "${COLLECTOR_SSH_KEY}")" == "600" ]] || error_exit "Collector SSH private key must be mode 600."
  runuser -u "${COLLECTOR_USER}" -- test -r "${RMM_CONFIG}" || error_exit "Collector account cannot read ${RMM_CONFIG}."
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_STATE_DIR}" || error_exit "Collector account cannot write ${RMM_STATE_DIR}."
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_LOG_DIR}" || error_exit "Collector account cannot write ${RMM_LOG_DIR}."
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_OUTPUT_DIR}" || error_exit "Collector account cannot write ${RMM_OUTPUT_DIR}."
  visudo -cf "${COLLECTOR_SUDOERS}" >/dev/null || error_exit "Collector sudoers file is invalid."
  progress_message "Collector identity and permission model validated."
}

deploy_xio_collector() {
  step_message 17 "Deploy XiO-style collector with controlled ownership"

  [[ -f "${BUNDLED_COLLECTOR}" ]] || error_exit "Bundled collector not found: ${BUNDLED_COLLECTOR}"
  [[ -f "${BUNDLED_CONFIG}" ]] || error_exit "Bundled config not found: ${BUNDLED_CONFIG}"

  install -d -o root -g "${COLLECTOR_GROUP}" -m 750 "${RMM_ROOT}" "${RMM_BACKUP_DIR}"

  local rollback_dir
  rollback_dir="${RMM_BACKUP_DIR}/rollback-$(date -u +%Y%m%dT%H%M%SZ)"
  install -d -o root -g "${COLLECTOR_GROUP}" -m 750 "${rollback_dir}"
  for existing in "${RMM_COLLECTOR}" "${RMM_CONFIG}" "${RMM_CONFIG_SCHEMA_FILE}" "${COLLECTOR_WRAPPER}" "${COLLECTOR_SUDOERS}"; do
    if [[ -e "${existing}" ]]; then
      cp -a "${existing}" "${rollback_dir}/"
    fi
  done
  printf 'revision=%s\ntimestamp_utc=%s\n' "${REVISION}" "$(date -u +%FT%TZ)" > "${rollback_dir}/rollback.manifest"
  chmod 640 "${rollback_dir}/rollback.manifest"
  progress_message "Created collector rollback snapshot: ${rollback_dir}"
  install -d -o "${COLLECTOR_USER}" -g "${COLLECTOR_GROUP}" -m 750 \
    "${RMM_OUTPUT_DIR}" "${RMM_STATE_DIR}" "${RMM_LOG_DIR}"

  if [[ -f "${RMM_COLLECTOR}" ]]; then
    cp -a "${RMM_COLLECTOR}" \
      "${RMM_BACKUP_DIR}/crestron_4series_xio_style_collector.py.$(date -u +%Y%m%dT%H%M%SZ)"
  fi

  install -o root -g "${COLLECTOR_GROUP}" -m 750 \
    "${BUNDLED_COLLECTOR}" "${RMM_COLLECTOR}"

  if [[ -f "${RMM_CONFIG}" ]]; then
    cp -a "${RMM_CONFIG}" \
      "${RMM_BACKUP_DIR}/config.json.$(date -u +%Y%m%dT%H%M%SZ)"
    progress_message "Preserving existing config.json after backup."
  else
    install -o root -g "${COLLECTOR_GROUP}" -m 640 \
      "${BUNDLED_CONFIG}" "${RMM_CONFIG}"
    progress_message "Installed example config as ${RMM_CONFIG}."
  fi

  migrate_collector_identity_path
  chown root:"${COLLECTOR_GROUP}" "${RMM_CONFIG}"
  chmod 640 "${RMM_CONFIG}"

  printf '%s\n' "${RMM_CONFIG_SCHEMA_VERSION}" > "${RMM_CONFIG_SCHEMA_FILE}"
  chown root:"${COLLECTOR_GROUP}" "${RMM_CONFIG_SCHEMA_FILE}"
  chmod 640 "${RMM_CONFIG_SCHEMA_FILE}"

  validate_config_json

  if [[ ! -f "${RMM_HISTORY}" ]]; then
    printf '{}\n' > "${RMM_HISTORY}"
  fi
  touch "${RMM_COLLECTOR_LOG}"
  chown "${COLLECTOR_USER}:${COLLECTOR_GROUP}" "${RMM_HISTORY}" "${RMM_COLLECTOR_LOG}"
  chmod 640 "${RMM_HISTORY}" "${RMM_COLLECTOR_LOG}"

  progress_message "Collector deployed under ${RMM_ROOT}."
  progress_message "Collector SSH public key: ${COLLECTOR_SSH_KEY}.pub"
}

verify_python_modules() {
  python3 - <<'PY'
import requests
import psutil
import urllib3
print("requests, psutil, urllib3 OK")
PY
}


validate_configured_collector_targets() {
  step_message 18 "Test configured collector target reachability"

  local tmp_devices example_flag target_count failures
  tmp_devices="$(mktemp)"
  target_count=0
  failures=0

  if ! python3 - "${RMM_CONFIG}" >"${tmp_devices}" <<'PY'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
with path.open("r", encoding="utf-8") as fh:
    data = json.load(fh)
common = data.get("common_tags", {})
customer = str(common.get("customer", "") or "")
deployment = str(common.get("deployment_id", "") or "")
example = customer.strip().lower() in {"customer name", "example", "sample"} or deployment.strip() == "RMM-DEPLOY-001"
print(f"#example\t{1 if example else 0}")
for idx, dev in enumerate(data.get("crestron_devices", []), start=1):
    if not isinstance(dev, dict):
        continue
    ssh = dev.get("ssh")
    if not isinstance(ssh, dict) or not ssh.get("enabled", False):
        continue
    name = str(dev.get("device_name") or dev.get("name") or f"device-{idx}")
    host = str(dev.get("host") or "").strip()
    port = ssh.get("port", 22)
    print("\t".join([name.replace("\t"," "), host.replace("\t"," "), str(port)]))
PY
  then
    rm -f "${tmp_devices}"
    error_exit "Unable to parse collector config for target-connectivity test."
  fi

  example_flag="$(awk -F'\t' '$1=="#example" {print $2; exit}' "${tmp_devices}")"
  [[ "${example_flag}" == "1" ]] && warning_message "Collector configuration is still an example template; target failures are informational until field configuration is completed."

  while IFS=$'\t' read -r name host port; do
    [[ "${name}" == "#example" ]] && continue
    [[ -z "${name}${host}${port}" ]] && continue
    target_count=$((target_count + 1))
    if [[ -z "${host}" || ! "${port}" =~ ^[0-9]+$ || ${port} -lt 1 || ${port} -gt 65535 ]]; then
      echo "FAIL - ${name}: invalid host/port in collector configuration."
      failures=$((failures + 1))
      continue
    fi
    if getent ahostsv4 "${host}" >/dev/null 2>&1 || [[ "${host}" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
      :
    else
      echo "FAIL - ${name}: target hostname cannot be resolved: ${host}"
      failures=$((failures + 1))
      continue
    fi
    if nc -z -w5 "${host}" "${port}" >/dev/null 2>&1; then
      echo "PASS - ${name}: TCP ${port} reachable from RMM Agent."
    elif [[ "${example_flag}" == "1" ]]; then
      warning_message "${name}: TCP ${port} not reachable while example config is installed."
    else
      echo "FAIL - ${name}: TCP ${port} is not reachable from RMM Agent."
      failures=$((failures + 1))
    fi
  done < <(grep -v '^#example' "${tmp_devices}")

  rm -f "${tmp_devices}"

  if (( target_count == 0 )); then
    warning_message "No SSH-enabled Crestron targets are configured; field-device connectivity test is deferred."
    return 0
  fi
  if (( failures > 0 && example_flag != 1 )); then
    error_exit "Configured collector target connectivity failed for ${failures} target(s)."
  fi
  progress_message "Configured collector target connectivity test completed."
}

validate_collector_runtime() {
  step_message 19 "Validate collector runtime and permissions"

  verify_python_modules
  python3 -m py_compile "${RMM_COLLECTOR}"
  validate_config_json
  validate_collector_identity_and_permissions

  runuser -u "${COLLECTOR_USER}" -- "${COLLECTOR_WRAPPER}" --help >/dev/null
  runuser -u "${COLLECTOR_USER}" -- test -r "${RMM_CONFIG}"
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_STATE_DIR}"
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_LOG_DIR}"
  runuser -u "${COLLECTOR_USER}" -- test -w "${RMM_OUTPUT_DIR}"

  progress_message "Collector runtime test passed. This is not a field device-connectivity test."
}

install_postreboot_validation() {
  step_message 20 "Install post-reboot production validation"

  cat > "${POSTREBOOT_VALIDATOR}" <<'POSTVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail

REVISION="5091126"
SUPPORTED_OS_ID="ubuntu"
SUPPORTED_UBUNTU_VERSION_ID="24.04"
SUPPORTED_UBUNTU_PRETTY_FRAGMENT="24.04.3 LTS"
SUPPORTED_VENDOR="Protectli"
SUPPORTED_MODEL="V1210"

STATE_FILE="/var/lib/rswsolutionz-rmm/install.state"
PACKAGE_BASELINE_FILE="/var/lib/rswsolutionz-rmm/package-baseline-5091126.tsv"
OS_BASELINE_FILE="/var/lib/rswsolutionz-rmm/os-baseline-5091126.txt"
SNAP_BASELINE_FILE="/var/lib/rswsolutionz-rmm/snap-baseline-5091126.txt"
LOG_DIR="/var/log/solutionz-rmm/setup"
LOG_FILE="${LOG_DIR}/postreboot-validation.log"
DOMOTZ_SNAP_NAME="domotzpro-agent-publicstore"
SERIAL_SERVICE="serial-getty@ttyS0.service"
SERIAL_DEVICE="/dev/ttyS0"
COLLECTOR_USER="solutionz-rmm"
COLLECTOR_GROUP="solutionz-rmm"
COLLECTOR_WRAPPER="/usr/local/bin/solutionz-rmm-collector"
COLLECTOR_CONFIG="/opt/solutionz-rmm/config.json"
COLLECTOR_SSH_KEY="/var/lib/solutionz-rmm/.ssh/id_rsa"
COLLECTOR_STATE_DIR="/opt/solutionz-rmm/state"
COLLECTOR_LOG_DIR="/opt/solutionz-rmm/logs"
COLLECTOR_OUTPUT_DIR="/opt/solutionz-rmm/output"
ROLLBACK_DIR="/opt/solutionz-rmm/backups"
LOCAL_CONFIG_TOOL="/usr/local/sbin/solutionz-rmm-local-config"
NETPLAN_FILE="/etc/netplan/00-installer-config.yaml"
GRUB_FILE="/etc/default/grub"

mkdir -p "${LOG_DIR}"
exec >> "${LOG_FILE}" 2>&1

status="$(head -n1 "${STATE_FILE}" 2>/dev/null || true)"
case "${status}" in
  phase1_complete|phase2_validation_failed)
    ;;
  *)
    exit 0
    ;;
esac

echo "============================================================"
echo "Solutionz RMM production post-reboot validation"
echo "Revision: ${REVISION}"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"

failures=0
warnings=0

pass() { echo "PASS - $*"; }
warn() { echo "WARN - $*"; warnings=$((warnings + 1)); }
fail() { echo "FAIL - $*"; failures=$((failures + 1)); }

check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    pass "${description}"
  else
    fail "${description}"
  fi
}

dns_resolves_ipv4() {
  local host="$1"
  getent ahostsv4 "${host}" 2>/dev/null | awk '{print $1}' | grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

state_value() {
  local key="$1"
  awk -F= -v key="${key}" '$1 == key {print substr($0, index($0,"=")+1); exit}' "${STATE_FILE}" 2>/dev/null || true
}

# Platform baseline
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  [[ "${ID:-}" == "${SUPPORTED_OS_ID}" ]] && pass "Operating system is Ubuntu." || fail "Operating system ID is ${ID:-unknown}; expected Ubuntu."
  [[ "${VERSION_ID:-}" == "${SUPPORTED_UBUNTU_VERSION_ID}" ]] && pass "Ubuntu LTS family is ${SUPPORTED_UBUNTU_VERSION_ID}." || fail "Ubuntu VERSION_ID is ${VERSION_ID:-unknown}; expected ${SUPPORTED_UBUNTU_VERSION_ID}."
  [[ "${VERSION:-}" == *"${SUPPORTED_UBUNTU_PRETTY_FRAGMENT}"* ]] && pass "Ubuntu 24.04.3 LTS build-image baseline is present." || fail "Ubuntu point-release baseline is ${VERSION:-unknown}; expected 24.04.3 LTS for this production build."
else
  fail "/etc/os-release is unavailable."
fi

vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | xargs || true)"
model="$(cat /sys/class/dmi/id/product_name 2>/dev/null | xargs || true)"
[[ "${vendor,,}" == *"${SUPPORTED_VENDOR,,}"* ]] && pass "Hardware vendor is Protectli." || fail "Hardware vendor is ${vendor:-unknown}; expected Protectli."
[[ "${model}" == "${SUPPORTED_MODEL}" ]] && pass "Hardware model is V1210." || fail "Hardware model is ${model:-unknown}; expected V1210."

[[ "$(state_value revision)" == "${REVISION}" ]] && pass "State-file revision matches ${REVISION}." || fail "State-file revision does not match ${REVISION}."
[[ -s "${PACKAGE_BASELINE_FILE}" ]] && pass "Package baseline record exists." || fail "Package baseline record is missing."
[[ -s "${OS_BASELINE_FILE}" ]] && pass "Original OS build-image baseline record exists." || fail "Original OS build-image baseline record is missing."
[[ -s "${SNAP_BASELINE_FILE}" ]] && pass "Domotz Snap audit record exists." || fail "Domotz Snap audit record is missing."

# Network baseline
check "eth0 exists" ip link show eth0
if ip -4 addr show dev eth0 2>/dev/null | grep -q 'inet '; then pass "eth0 has an IPv4 address."; else fail "eth0 has no IPv4 address."; fi
if ip -4 route show default | grep -q ' dev eth0 '; then pass "Default IPv4 route uses eth0."; else fail "Default IPv4 route does not use eth0."; fi
if ip -4 route show default | grep -q ' dev eth1 '; then fail "eth1 has an IPv4 default route."; else pass "eth1 has no IPv4 default route."; fi
check "Netplan configuration generates successfully" netplan generate
[[ -s "${NETPLAN_FILE}" ]] && pass "Solutionz Netplan file exists." || fail "Solutionz Netplan file is missing."

# DNS and time
if dns_resolves_ipv4 api.snapcraft.io; then pass "DNS resolves api.snapcraft.io to IPv4."; else fail "DNS does not resolve api.snapcraft.io to IPv4."; fi
if dns_resolves_ipv4 archive.ubuntu.com; then pass "DNS resolves archive.ubuntu.com to IPv4."; else fail "DNS does not resolve archive.ubuntu.com to IPv4."; fi
if dns_resolves_ipv4 security.ubuntu.com; then pass "DNS resolves security.ubuntu.com to IPv4."; else fail "DNS does not resolve security.ubuntu.com to IPv4."; fi
ntp_sync="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
[[ "${ntp_sync}" == "yes" ]] && pass "System clock is NTP synchronized." || fail "System clock is not NTP synchronized."

# SSH and firewall
check "SSH service is active" systemctl is-active --quiet ssh
check "SSH service is enabled" systemctl is-enabled --quiet ssh
if ss -lnt 2>/dev/null | awk '$4 ~ /:22$/ {found=1} END {exit found?0:1}'; then pass "TCP 22 is listening locally."; else fail "TCP 22 is not listening locally."; fi
if ufw status | grep -q 'Status: active'; then pass "UFW is active."; else fail "UFW is not active."; fi
if ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW'; then pass "UFW globally permits inbound TCP 22."; else fail "UFW global TCP 22 rule is missing."; fi
if ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW'; then pass "UFW globally permits inbound TCP 3000."; else fail "UFW global TCP 3000 rule is missing."; fi
if ufw status verbose | grep -Eq '^Default: deny \(incoming\), allow \(outgoing\)'; then pass "UFW default outbound policy is allow."; else fail "UFW default outbound policy is not allow."; fi
if ss -lnt 2>/dev/null | awk '$4 ~ /:3000$/ {found=1} END {exit found?0:1}'; then pass "TCP 3000 is listening locally."; else warn "TCP 3000 is not currently listening; Domotz local service may require activation/startup state review."; fi

# TUN and Domotz local state
[[ -c /dev/net/tun ]] && pass "TUN device is available." || fail "TUN device is unavailable."
if snap list "${DOMOTZ_SNAP_NAME}" >/dev/null 2>&1; then pass "Domotz Snap is installed."; else fail "Domotz Snap is not installed."; fi
for permission in firewall-control network-observe raw-usb shutdown system-observe; do
  if snap connections "${DOMOTZ_SNAP_NAME}" 2>/dev/null | awk -v p="${permission}" '$1 == p && $3 != "-" {found=1} END {exit found ? 0 : 1}'; then
    pass "Domotz permission ${permission} is connected."
  else
    fail "Domotz permission ${permission} is not connected."
  fi
done

# Serial/COM recovery path
[[ -c "${SERIAL_DEVICE}" ]] && pass "V1210 ttyS0 serial device is present." || fail "V1210 ttyS0 serial device is missing."
check "Serial console service is active" systemctl is-active --quiet "${SERIAL_SERVICE}"
check "Serial console service is enabled" systemctl is-enabled --quiet "${SERIAL_SERVICE}"
pgrep -a agetty 2>/dev/null | grep -q 'ttyS0' && pass "agetty is running on ttyS0." || fail "agetty is not running on ttyS0."
[[ -x "${LOCAL_CONFIG_TOOL}" ]] && pass "USB-C COM local configuration utility is installed." || fail "USB-C COM local configuration utility is missing."
if grep -Eq '^GRUB_CMDLINE_LINUX=.*net\.ifnames=0' "${GRUB_FILE}" && grep -Eq '^GRUB_CMDLINE_LINUX=.*biosdevname=0' "${GRUB_FILE}"; then pass "GRUB interface-naming parameters are present."; else fail "Required GRUB interface-naming parameters are missing."; fi
if grep -Eq '^GRUB_CMDLINE_LINUX_DEFAULT=.*console=ttyS0,115200n8' "${GRUB_FILE}"; then pass "GRUB serial-console parameter is present."; else fail "GRUB serial-console parameter is missing."; fi

# Collector ownership/runtime
if id "${COLLECTOR_USER}" >/dev/null 2>&1; then pass "Collector service account exists."; else fail "Collector service account is missing."; fi
[[ -x "${COLLECTOR_WRAPPER}" ]] && pass "Collector wrapper is installed." || fail "Collector wrapper is missing."
[[ -r "${COLLECTOR_CONFIG}" ]] && pass "Collector config exists." || fail "Collector config is missing."
if runuser -u "${COLLECTOR_USER}" -- test -r "${COLLECTOR_CONFIG}"; then pass "Collector account can read config.json."; else fail "Collector account cannot read config.json."; fi
for dir in "${COLLECTOR_STATE_DIR}" "${COLLECTOR_LOG_DIR}" "${COLLECTOR_OUTPUT_DIR}"; do
  if runuser -u "${COLLECTOR_USER}" -- test -w "${dir}"; then pass "Collector account can write ${dir}."; else fail "Collector account cannot write ${dir}."; fi
done
if [[ -f "${COLLECTOR_SSH_KEY}" ]]; then
  owner="$(stat -c '%U:%G' "${COLLECTOR_SSH_KEY}" 2>/dev/null || true)"
  mode="$(stat -c '%a' "${COLLECTOR_SSH_KEY}" 2>/dev/null || true)"
  [[ "${owner}" == "${COLLECTOR_USER}:${COLLECTOR_GROUP}" ]] && pass "Collector SSH key ownership is correct." || fail "Collector SSH key ownership is ${owner:-unknown}."
  [[ "${mode}" == "600" ]] && pass "Collector SSH key mode is 600." || fail "Collector SSH key mode is ${mode:-unknown}; expected 600."
else
  fail "Collector SSH private key is missing."
fi
if runuser -u "${COLLECTOR_USER}" -- "${COLLECTOR_WRAPPER}" --help >/dev/null 2>&1; then pass "Collector runtime starts as the service account."; else fail "Collector runtime does not start as the service account."; fi
if find "${ROLLBACK_DIR}" -maxdepth 1 -type d -name 'rollback-*' -print -quit 2>/dev/null | grep -q .; then pass "Collector rollback snapshot exists."; else fail "Collector rollback snapshot is missing."; fi

# Configured monitored-device reachability. Example/no-target configurations warn,
# but a populated production configuration must pass ICMP and configured SSH TCP.
if [[ -r "${COLLECTOR_CONFIG}" ]]; then
  tmp_devices="$(mktemp)"
  if python3 - "${COLLECTOR_CONFIG}" >"${tmp_devices}" <<'PYTARGETS'
import json, pathlib, sys
path = pathlib.Path(sys.argv[1])
with path.open("r", encoding="utf-8") as fh:
    data = json.load(fh)
common = data.get("common_tags", {})
customer = str(common.get("customer", "") or "")
deployment = str(common.get("deployment_id", "") or "")
example = customer.strip().lower() in {"customer name", "example", "sample"} or deployment.strip() == "RMM-DEPLOY-001"
print(f"#example\t{1 if example else 0}")
for idx, dev in enumerate(data.get("crestron_devices", []), start=1):
    if not isinstance(dev, dict):
        continue
    ssh = dev.get("ssh")
    if not isinstance(ssh, dict) or not ssh.get("enabled", False):
        continue
    name = str(dev.get("device_name") or dev.get("name") or f"device-{idx}")
    host = str(dev.get("host") or "").strip()
    port = ssh.get("port", 22)
    print("\t".join([name.replace("\t"," "), host.replace("\t"," "), str(port)]))
PYTARGETS
  then
    example_flag="$(awk -F'\t' '$1=="#example" {print $2; exit}' "${tmp_devices}")"
    target_count=0
    while IFS=$'\t' read -r name host port; do
      [[ "${name}" == "#example" ]] && continue
      [[ -z "${name}${host}${port}" ]] && continue
      target_count=$((target_count + 1))
      if [[ -z "${host}" || ! "${port}" =~ ^[0-9]+$ ]]; then
        [[ "${example_flag}" == "1" ]] && warn "${name}: example target host/port is incomplete." || fail "${name}: production target host/port is invalid."
        continue
      fi
      if ping -c 2 -W 2 "${host}" >/dev/null 2>&1; then
        pass "${name}: ICMP reachability passed."
      elif [[ "${example_flag}" == "1" ]]; then
        warn "${name}: ICMP unavailable while example config is installed."
      else
        fail "${name}: ICMP reachability failed."
      fi
      if nc -z -w5 "${host}" "${port}" >/dev/null 2>&1; then
        pass "${name}: configured TCP ${port} is reachable."
      elif [[ "${example_flag}" == "1" ]]; then
        warn "${name}: TCP ${port} unavailable while example config is installed."
      else
        fail "${name}: configured TCP ${port} is unreachable."
      fi
    done < <(grep -v '^#example' "${tmp_devices}")
    (( target_count == 0 )) && warn "No production AV targets are configured yet; monitored-device reachability is deferred."
  else
    fail "Collector config could not be parsed for monitored-device validation."
  fi
  rm -f "${tmp_devices}"
fi

echo "------------------------------------------------------------"
echo "Production validation failures: ${failures}"
echo "Production validation warnings: ${warnings}"
echo "Log: ${LOG_FILE}"
echo "============================================================"

if (( failures == 0 )); then
  {
    echo "phase2_system_validated"
    echo "revision=${REVISION}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "failures=0"
    echo "warnings=${warnings}"
  } > "${STATE_FILE}"
  chmod 640 "${STATE_FILE}"
  echo "POST-REBOOT PRODUCTION VALIDATION PASSED"
  exit 0
fi

{
  echo "phase2_validation_failed"
  echo "revision=${REVISION}"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "failures=${failures}"
  echo "warnings=${warnings}"
} > "${STATE_FILE}"
chmod 640 "${STATE_FILE}"
echo "POST-REBOOT PRODUCTION VALIDATION FAILED: ${failures} check(s)"
exit 1
POSTVALIDATOR

  chmod 750 "${POSTREBOOT_VALIDATOR}"
  chown root:root "${POSTREBOOT_VALIDATOR}"

  cat > "${POSTREBOOT_SERVICE}" <<EOF
[Unit]
Description=Solutionz RMM Post-Reboot Production Validation
After=network-online.target ssh.service snapd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${POSTREBOOT_VALIDATOR}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable rswsolutionz-rmm-postreboot-validation.service
}

check_final_requirement() {
  local description="$1"
  shift
  if "$@"; then
    echo "PASS - ${description}"
    return 0
  fi
  echo "FAIL - ${description}"
  return 1
}

final_summary_check() {
  step_message 21 "Run mandatory pre-reboot validation"

  local failures=0

  echo
  echo "============================================================"
  echo "FINAL PRE-REBOOT VALIDATION - REVISION ${REVISION}"
  echo "============================================================"

  check_final_requirement "Ubuntu ${SUPPORTED_UBUNTU_POINT_RELEASE} LTS build-image baseline" \
    bash -c ". /etc/os-release; [[ \"\$ID\" == ubuntu && \"\$VERSION_ID\" == ${SUPPORTED_UBUNTU_VERSION_ID} && \"\$VERSION\" == *\"${SUPPORTED_UBUNTU_PRETTY_FRAGMENT}\"* ]]" || failures=$((failures + 1))

  check_final_requirement "V1210 ttyS0 serial device present" test -c "${SERIAL_DEVICE}" || failures=$((failures + 1))
  check_final_requirement "serial getty active" systemctl is-active --quiet "${SERIAL_SERVICE}" || failures=$((failures + 1))
  check_final_requirement "USB-C COM local config utility installed" test -x "${LOCAL_CONFIG_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Protectli V1210 hardware" bash -c 'vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null); model=$(cat /sys/class/dmi/id/product_name 2>/dev/null); [[ "${vendor,,}" == *protectli* && "$model" == "V1210" ]]' || failures=$((failures + 1))
  check_final_requirement "SSH active" systemctl is-active --quiet ssh || failures=$((failures + 1))
  check_final_requirement "UFW active" bash -c "ufw status | grep -q 'Status: active'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 22" bash -c "ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 3000" bash -c "ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "DNS resolves api.snapcraft.io to IPv4" dns_resolves_ipv4 api.snapcraft.io || failures=$((failures + 1))
  check_final_requirement "DNS resolves archive.ubuntu.com to IPv4" dns_resolves_ipv4 archive.ubuntu.com || failures=$((failures + 1))
  check_final_requirement "NTP synchronization active" bash -c "[[ \"$(timedatectl show -p NTPSynchronized --value 2>/dev/null)\" == yes ]]" || failures=$((failures + 1))
  check_final_requirement "OS build-image baseline record exists" test -s "${OS_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Network requirements record exists" test -s "${NETWORK_REQUIREMENTS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Netplan generates successfully" netplan generate || failures=$((failures + 1))
  check_final_requirement "Domotz installed" snap list "${DOMOTZ_SNAP_NAME}" || failures=$((failures + 1))
  check_final_requirement "Collector config valid" validate_config_json || failures=$((failures + 1))
  check_final_requirement "Collector identity and permissions valid" validate_collector_identity_and_permissions || failures=$((failures + 1))
  check_final_requirement "Collector runtime valid as service account" \
    runuser -u "${COLLECTOR_USER}" -- "${COLLECTOR_WRAPPER}" --help || failures=$((failures + 1))
  check_final_requirement "Collector rollback snapshot exists" bash -c "find '${RMM_BACKUP_DIR}' -maxdepth 1 -type d -name 'rollback-*' -print -quit | grep -q ." || failures=$((failures + 1))
  check_final_requirement "Post-reboot production validator installed" test -x "${POSTREBOOT_VALIDATOR}" || failures=$((failures + 1))

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    if snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      echo "PASS - Domotz permission ${permission} connected"
    else
      echo "FAIL - Domotz permission ${permission} not connected"
      failures=$((failures + 1))
    fi
  done

  progress_message "Domotz is intentionally not revision-pinned; installed revision is recorded for audit."

  echo "------------------------------------------------------------"
  echo "Pre-reboot mandatory failures: ${failures}"
  echo "============================================================"

  (( failures == 0 ))
}

main() {
  parse_args "$@"
  require_root
  init_logging

  echo "Solutionz RMM Agent build starting."
  echo "Script: ${SCRIPT_NAME}"
  echo "Revision: ${REVISION}"
  echo "Release date: ${RELEASE_DATE}"
  echo "Log: ${LOG_FILE}"

  backup_previous_state
  write_state "phase1_in_progress"
  record_network_requirements

  prompt_confirmation
  preflight_checks
  install_required_packages
  verify_required_packages
  verify_ssh_service
  configure_tun
  ensure_snapd
  install_domotz
  configure_domotz_permissions
  configure_ufw
  stage_network_config
  repair_resolv_conf
  normalize_host_entries
  configure_grub_and_serial
  install_local_serial_config_tool
  update_banner
  setup_collector_identity
  deploy_xio_collector
  validate_configured_collector_targets
  validate_collector_runtime
  install_postreboot_validation

  if ! final_summary_check; then
    error_exit "Mandatory pre-reboot validation failed."
  fi

  write_state "phase1_complete" \
    "reboot_required=1" \
    "postreboot_validator=${POSTREBOOT_VALIDATOR}" \
    "log=${LOG_FILE}"

  echo
  echo "------------------------------------------------------------"
  echo " [+] Phase 1 completed successfully."
  echo " [+] Completion Time: $(date -u +%FT%TZ)"
  echo " [+] Hostname: $(hostname)"
  echo " [+] Script Revision: ${REVISION}"
  echo " [+] State File: ${STATE_FILE}"
  echo " [+] Log File: ${LOG_FILE}"
  echo "------------------------------------------------------------"
  echo "Manual reboot is required."
  echo "After reboot, systemd will run the post-reboot validation automatically."
  echo
  echo "V1210 direct laptop configuration:"
  echo "  1. Connect the laptop to the V1210 USB-C port labeled COM."
  echo "  2. Open a serial terminal at 115200 baud, 8 data bits, no parity, 1 stop bit."
  echo "  3. Log in with an authorized local account."
  echo "  4. Run: sudo ${LOCAL_CONFIG_TOOL}"
  echo
  echo "Collector operator command after login/SSH:"
  echo "  sudo -u ${COLLECTOR_USER} ${COLLECTOR_WRAPPER} stdout"
  echo
  echo "Collector SSH public key to install on supported target processors:"
  echo "  ${COLLECTOR_SSH_KEY}.pub"
  echo
  echo "Domotz update policy: not revision-pinned; installed revision recorded in ${SNAP_BASELINE_FILE}."
}

main "$@"
