install_postreboot_validation() {
  step_message 16 "Install post-reboot production validation"
  cat > "${POSTREBOOT_VALIDATOR}" <<'POSTVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail

REVISION="V06.100626N"
STATE="/var/lib/rswsolutionz-rmm/install.state"
RESULT="/var/lib/rswsolutionz-rmm/postreboot-validation-V06.100626N.result"
LOG="/var/log/solutionz-rmm/setup/postreboot-validation.log"
NV="/usr/local/sbin/solutionz-rmm-network-validate"
NVR="/var/lib/rswsolutionz-rmm/network-validation-V06.100626N.result"
LD="/usr/local/sbin/solutionz-rmm-live-network-discovery"
LDR="/var/lib/rswsolutionz-rmm/network-live-discovery-V06.100626N.result"
PF="/etc/solutionz-rmm/network-profile.json"
PT="/usr/local/sbin/solutionz-rmm-network-profile"
PR="/var/lib/rswsolutionz-rmm/network-profile-V06.100626N.result"
DOM="domotzpro-agent-publicstore"
SER="serial-getty@ttyS0.service"
CFG="/usr/local/sbin/solutionz-rmm-local-config"
AP="/etc/profile.d/solutionz-rmm-access.sh"
SD="/etc/sudoers.d/solutionz-rmm-local-config"
ENGPASS="/usr/local/sbin/solutionz-rmm-engineering-password-setup"
ENGPASS_SD="/etc/sudoers.d/solutionz-rmm-engineering-password-setup"
ENGKEY_FP="/var/lib/rswsolutionz-rmm/engineering-ssh-key-V06.100626N.fingerprint"
SSHCFG="/etc/ssh/sshd_config.d/99-solutionz-rmm-hardening.conf"
TECH_USER="solz_rmm"
ENG_USER="solz_eng"
TECH_GROUP="solutionz-rmm-tech"
ENG_GROUP="solutionz-rmm-engineering"
ENGPASS_MARKER="/var/lib/rswsolutionz-rmm/engineering-password-provisioned"
GRUB="/etc/default/grub"
IPF="/etc/sysctl.d/90-solutionz-rmm-no-forwarding.conf"
SV="/usr/local/sbin/solutionz-rmm-security-validate"
SVR="/var/lib/rswsolutionz-rmm/security-validation-V06.100626N.result"
IB="/var/lib/rswsolutionz-rmm/security-baseline-V06.100626N.sha256"
FORCE=0

if [[ "${1:-}" == "--force" ]]; then
  FORCE=1
elif [[ $# -ne 0 ]]; then
  echo "Usage: $(basename "$0") [--force]"
  exit 2
fi

mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1

if (( ! FORCE )); then
  st="$(head -n1 "$STATE" 2>/dev/null || true)"
  case "$st" in
    phase1_complete|phase2_validation_failed) ;;
    *) exit 0 ;;
  esac
fi

F=()
W=()
pass() { echo "PASS - $*"; }
fail() { echo "FAIL - $*"; F+=("$*"); }
warn() { echo "WARN - $*"; W+=("$*"); }
check() { local d="$1"; shift; "$@" && pass "$d" || fail "$d"; }
ntp() { [[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)" == "yes" || -e /run/systemd/timesync/synchronized ]]; }
waitntp() { local i; for i in {1..36}; do ntp && return 0; [[ $i -lt 36 ]] && sleep 5; done; return 1; }

echo "============================================================"
echo "Solutionz RMM Post-Reboot Production Validation"
echo "Revision: $REVISION"
echo "Forced validation: $FORCE"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"

. /etc/os-release 2>/dev/null || true
[[ "${ID:-}" == "ubuntu" && "${VERSION_ID:-}" == "24.04" ]] && pass "Ubuntu 24.04 LTS." || fail "Unsupported OS."
v="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)"
m="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
[[ "${v,,}" == *protectli* && "$m" == "V1210" ]] && pass "Protectli V1210." || fail "Unsupported hardware."

if [[ -x "$PT" && -s "$PF" ]] && "$PT" validate "$PF" >/dev/null 2>&1; then
  pass "WAN/LAN/VLAN profile valid."
else
  fail "Network profile invalid or missing."
fi
[[ -s "$PR" ]] && grep -q '^result=PASS$' "$PR" && pass "Profile render result PASS." || fail "Profile render result missing/not PASS."
netplan generate >/dev/null 2>&1 && pass "Netplan generates." || fail "Netplan generation failed."
[[ -s "$IPF" ]] && grep -Eq '^net\.ipv4\.ip_forward=0$' "$IPF" && pass "Persistent IPv4 forwarding disable policy installed." || fail "Persistent IPv4 forwarding disable policy missing."
[[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 1)" == "0" ]] && pass "IPv4 forwarding disabled." || fail "IPv4 forwarding enabled."

if [[ -x "$LD" ]]; then
  "$LD" || warn "Live network discovery utility returned a non-zero status."
  [[ -s "$LDR" ]] && pass "Live network discovery state captured." || warn "Live network discovery result file was not created."
else
  fail "Live network discovery utility missing."
fi

if [[ -x "$NV" ]]; then
  set +e
  "$NV"
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    pass "Automatic WAN/LAN/VLAN network validation passed."
  elif [[ $rc -eq 10 ]]; then
    fail "Local WAN/LAN/VLAN configuration validation failed; see $NVR."
  else
    fail "WAN connectivity validation failed; see $NVR."
  fi
else
  fail "Network validator missing."
fi

if [[ -x "$SV" ]]; then
  set +e
  "$SV"
  src=$?
  set -e
  [[ $src -eq 0 ]] && pass "Solutionz security validation passed." || fail "Solutionz security validation failed; see $SVR."
else
  fail "Security validator missing."
fi

check "SSH active" systemctl is-active --quiet ssh
ufw status | grep -q 'Status: active' && pass "UFW active." || fail "UFW inactive."
[[ -c /dev/net/tun ]] && pass "TUN available." || fail "TUN unavailable."
snap list "$DOM" >/dev/null 2>&1 && pass "Domotz installed." || fail "Domotz missing."
for p in firewall-control network-observe raw-usb shutdown system-observe; do
  snap connections "$DOM" 2>/dev/null | awk -v p="$p" '$1==p && $3!="-" {f=1} END {exit f?0:1}' && \
    pass "Domotz ${p} connected." || fail "Domotz ${p} missing."
done
systemctl is-active --quiet systemd-timesyncd.service && pass "systemd-timesyncd active." || fail "systemd-timesyncd inactive."
waitntp && pass "NTP synchronized." || fail "NTP synchronization failed."
[[ -c /dev/ttyS0 ]] && pass "ttyS0 present." || fail "ttyS0 missing."
check "Serial service active" systemctl is-active --quiet "$SER"
[[ -x "$CFG" && -s "$AP" ]] && grep -q 'solutionz-rmm-tech' "$AP" && grep -q 'solutionz-rmm-engineering' "$AP" && grep -q -- '--restricted-login' "$AP" && grep -q -- '--engineering-login' "$AP" && pass "Unified technician/engineering interactive menu policy installed." || fail "Unified interactive menu policy missing."
[[ -s "$SSHCFG" ]] && grep -q '^Match Group solutionz-rmm-tech,!solutionz-rmm-engineering$' "$SSHCFG" && grep -q -- '--restricted-login' "$SSHCFG" && pass "SSH technician menu policy with engineering exception installed." || fail "SSH technician menu policy missing/invalid."
if id "$TECH_USER" >/dev/null 2>&1; then
  id -nG "$TECH_USER" | tr ' ' '\n' | grep -qx "$TECH_GROUP" && pass "$TECH_USER field-tech membership present." || fail "$TECH_USER field-tech membership missing."
  if id -nG "$TECH_USER" | tr ' ' '\n' | grep -qx "$ENG_GROUP"; then fail "$TECH_USER incorrectly has engineering-group shell bypass."; else pass "$TECH_USER engineering shell bypass absent."; fi
  if id -nG "$TECH_USER" | tr ' ' '\n' | grep -qx sudo; then fail "$TECH_USER incorrectly has unrestricted sudo membership."; else pass "$TECH_USER unrestricted sudo membership absent."; fi
else
  warn "Default technician account $TECH_USER does not exist."
fi
if id "$ENG_USER" >/dev/null 2>&1; then
  id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx "$ENG_GROUP" && pass "$ENG_USER engineering membership present." || fail "$ENG_USER engineering membership missing."
  id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx 'sudo' && pass "$ENG_USER sudo membership present." || fail "$ENG_USER sudo membership missing."
  if id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx "$TECH_GROUP"; then fail "$ENG_USER incorrectly has field-tech classification."; else pass "$ENG_USER field-tech classification absent."; fi
  [[ "$(getent passwd "$ENG_USER" | awk -F: '{print $7}')" == "/bin/bash" ]] && pass "$ENG_USER Bash shell present." || fail "$ENG_USER Bash shell missing."
  ENG_HOME="$(getent passwd "$ENG_USER" | awk -F: '{print $6}')"
  if [[ -s "$ENG_HOME/.ssh/authorized_keys" ]]; then
    pass "$ENG_USER engineering SSH public key installed."
    if [[ -s "$ENGKEY_FP" ]]; then
      EXPECTED_FP="$(awk -F= '$1=="fingerprint" {print $2}' "$ENGKEY_FP" | head -n1)"
      ACTUAL_FP="$(ssh-keygen -lf "$ENG_HOME/.ssh/authorized_keys" -E sha256 2>/dev/null | awk 'NR==1 {print $2}')"
      [[ -n "$EXPECTED_FP" && "$ACTUAL_FP" == "$EXPECTED_FP" ]] && pass "$ENG_USER engineering SSH key fingerprint verified." || fail "$ENG_USER engineering SSH key fingerprint mismatch."
    else
      fail "Engineering SSH key fingerprint record missing."
    fi
  else
    fail "$ENG_USER engineering SSH public key missing."
  fi
else
  fail "Default engineering account $ENG_USER does not exist."
fi
[[ -x "$ENGPASS" ]] && pass "Engineering password provisioning helper installed." || fail "Engineering password provisioning helper missing."
[[ -s "$ENGPASS_SD" ]] && visudo -cf "$ENGPASS_SD" >/dev/null 2>&1 && pass "Engineering password provisioning sudoers policy valid." || fail "Engineering password provisioning sudoers policy invalid."
[[ -s "$SD" ]] && visudo -cf "$SD" >/dev/null 2>&1 && pass "sudoers policy valid." || fail "sudoers policy invalid."
grep -Eq '^GRUB_CMDLINE_LINUX_DEFAULT=.*console=ttyS0,115200n8' "$GRUB" && pass "GRUB serial console configured." || fail "GRUB serial console missing."

f=${#F[@]}
w=${#W[@]}
res="PASS"
(( f > 0 )) && res="FAIL"
{
  echo "result=$res"
  echo "revision=$REVISION"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "forced_validation=$FORCE"
  echo "failures=$f"
  echo "warnings=$w"
  echo "network_validation_result=$NVR"
  echo "network_live_discovery_result=$LDR"
  echo "security_validation_result=$SVR"
  echo "security_baseline=$IB"
  echo
  echo "FAILED_CHECKS:"
  if (( f > 0 )); then printf -- '- %s\n' "${F[@]}"; else echo '- none'; fi
  echo
  echo "WARNING_CHECKS:"
  if (( w > 0 )); then printf -- '- %s\n' "${W[@]}"; else echo '- none'; fi
} > "$RESULT"
chmod 640 "$RESULT"

if (( f == 0 )); then
  {
    echo "phase2_system_validated"
    echo "revision=$REVISION"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "failures=0"
    echo "warnings=$w"
    echo "result_file=$RESULT"
    echo "network_validation_result=$NVR"
    echo "network_live_discovery_result=$LDR"
    echo "security_validation_result=$SVR"
    echo "security_baseline=$IB"
    echo "engineering_login=$ENG_USER"
    echo "engineering_ssh_key_fingerprint=$(awk -F= '$1=="fingerprint" {print $2}' "$ENGKEY_FP" 2>/dev/null | head -n1)"
    if [[ -s "$ENGPASS_MARKER" ]]; then
      echo "engineering_password_status=configured"
    else
      echo "engineering_password_status=pending_engineering_menu_setup"
    fi
    echo "engineering_password_provisioning=authenticated_solz_eng_menu_setup_after_phase2"
    echo "log=$LOG"
  } > "$STATE"
  chmod 640 "$STATE"
  echo "POST-REBOOT PRODUCTION VALIDATION PASSED"
  exit 0
fi

{
  echo "phase2_validation_failed"
  echo "revision=$REVISION"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "failures=$f"
  echo "warnings=$w"
  echo "result_file=$RESULT"
  echo "network_validation_result=$NVR"
  echo "network_live_discovery_result=$LDR"
  echo "security_validation_result=$SVR"
  echo "security_baseline=$IB"
  echo "log=$LOG"
} > "$STATE"
chmod 640 "$STATE"
echo "POST-REBOOT PRODUCTION VALIDATION FAILED: $f"
exit 1
POSTVALIDATOR
  chmod 750 "${POSTREBOOT_VALIDATOR}"
  chown root:root "${POSTREBOOT_VALIDATOR}"

  cat > "${POSTREBOOT_SERVICE}" <<EOF
[Unit]
Description=Solutionz RMM Post-Reboot Production Validation
After=network-online.target systemd-timesyncd.service ssh.service snapd.service
Wants=network-online.target systemd-timesyncd.service

[Service]
Type=oneshot
ExecStart=${POSTREBOOT_VALIDATOR}
RemainAfterExit=yes
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable rswsolutionz-rmm-postreboot-validation.service
}

install_domotz_activation() {
  step_message 17 "Install integrated Domotz activation workflow"

  install -d -m 750 /etc/solutionz-rmm "${DOMOTZ_ACTIVATION_STATE_DIR}"

  cat > "${DOMOTZ_ACTIVATION_HELPER}" <<'PYACTIVATION'
#!/usr/bin/env python3
import argparse
import getpass
import json
import os
import re
import socket
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG = Path('/etc/solutionz-rmm/domotz-activation.json')
STATE_DIR = Path('/var/lib/solutionz-domotz-activation')
RESULT = STATE_DIR / 'result.json'
LOCAL_STATUS = 'http://127.0.0.1:3000/api/v1/status'
LOCAL_AGENT = 'http://127.0.0.1:3000/api/v1/agent'
TERMINAL_STATUSES = {
    'activation_request_accepted',
    'existing_configuration_review',
    'submission_started',
    'review_required',
}


def atomic_json(path: Path, data: dict, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + '.', dir=str(path.parent))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def load_json(path: Path):
    with path.open('r', encoding='utf-8') as f:
        return json.load(f)


def version_tuple(value: str):
    nums = [int(x) for x in re.findall(r'\d+', value or '')[:3]]
    while len(nums) < 3:
        nums.append(0)
    return tuple(nums)


def validate_endpoint(endpoint: str):
    u = urllib.parse.urlparse(endpoint)
    if u.scheme != 'https' or not u.hostname:
        raise ValueError('Domotz API endpoint must be an https:// URL.')
    if '/public-api/' not in (u.path or ''):
        raise ValueError('Domotz API endpoint must be the Public API endpoint supplied with the activation key.')
    return u


def validate_config(c: dict):
    if not isinstance(c, dict):
        raise ValueError('Activation configuration must be a JSON object.')
    for key in ('enabled', 'name', 'endpoint', 'activation_key', 'deny_all_interfaces'):
        if key not in c:
            raise ValueError(f'Missing activation configuration field: {key}')
    if not isinstance(c['enabled'], bool) or not isinstance(c['deny_all_interfaces'], bool):
        raise ValueError('enabled and deny_all_interfaces must be JSON booleans.')
    if not isinstance(c['name'], str) or not c['name'].strip():
        raise ValueError('Collector name is required.')
    if not isinstance(c['activation_key'], str) or not c['activation_key'].strip():
        raise ValueError('Collector Activation Key is required.')
    validate_endpoint(c['endpoint'])
    return c


def read_config():
    if not CONFIG.exists():
        return None
    c = load_json(CONFIG)
    validate_config(c)
    return c


def read_result():
    if not RESULT.exists():
        return None
    try:
        return load_json(RESULT)
    except Exception:
        return {'status': 'review_required', 'reason': 'result_file_unreadable'}


def local_status(timeout=12):
    req = urllib.request.Request(LOCAL_STATUS, method='GET')
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read(65536)
    data = json.loads(raw.decode('utf-8'))
    if not isinstance(data, dict):
        raise ValueError('Local Domotz status did not return a JSON object.')
    return data


def cloud_preflight(endpoint: str, timeout=7):
    u = validate_endpoint(endpoint)
    port = u.port or 443
    infos = socket.getaddrinfo(u.hostname, port, type=socket.SOCK_STREAM)
    last = None
    for family, socktype, proto, _, addr in infos:
        s = socket.socket(family, socktype, proto)
        s.settimeout(timeout)
        try:
            s.connect(addr)
            return
        except OSError as e:
            last = e
        finally:
            s.close()
    raise OSError(f'Unable to connect to {u.hostname}:{port}: {last}')


def configure():
    print('Solutionz Domotz activation configuration')
    print('The activation key is hidden and is never written to the setup log.')
    name = input('Collector name: ').strip()
    endpoint = input('Domotz API endpoint (include https:// and /public-api/v1/): ').strip()
    key = getpass.getpass('Collector Activation Key: ').strip()
    deny = input('Keep network scanning disabled after activation? [y/N]: ').strip().lower() in {'y', 'yes'}
    c = {
        'enabled': False,
        'name': name,
        'endpoint': endpoint,
        'activation_key': key,
        'deny_all_interfaces': deny,
    }
    validate_config(c)
    atomic_json(CONFIG, c)
    print(f'Configuration saved securely to {CONFIG}. Activation remains DISARMED.')


def arm(enabled: bool):
    c = read_config()
    if c is None:
        raise RuntimeError('Activation configuration does not exist. Run --configure first.')
    existing = read_result()
    if enabled and existing and existing.get('status') in TERMINAL_STATUSES:
        raise RuntimeError(f"Activation result already requires review: {existing.get('status')}. Refusing to arm automatically.")
    c['enabled'] = enabled
    atomic_json(CONFIG, c)
    print('Domotz activation ARMED for a future boot.' if enabled else 'Domotz activation DISARMED.')


def check():
    print('Solutionz Domotz activation status')
    print(f'Configuration: {CONFIG}')
    try:
        c = read_config()
    except Exception as e:
        print(f'Configuration: INVALID ({e})')
        return 1
    if c is None:
        print('Configuration: NOT CREATED')
    else:
        mode = oct(CONFIG.stat().st_mode & 0o777)
        print(f"Collector name: {c['name']}")
        print(f"Endpoint: {c['endpoint']}")
        print(f"Armed: {c['enabled']}")
        print(f"Scanning disabled after activation: {c['deny_all_interfaces']}")
        print(f'Config permissions: {mode}')
    r = read_result()
    print(f"Result: {r.get('status') if r else 'none'}")
    try:
        s = local_status(timeout=5)
        print(f"Local collector mode: {s.get('mode', 'unknown')}")
        print(f"Local collector version: {s.get('agent_version', 'unknown')}")
    except Exception as e:
        print(f'Local collector status: unavailable ({type(e).__name__})')
    return 0


def attempt():
    try:
        c = read_config()
    except Exception as e:
        atomic_json(RESULT, {'status': 'review_required', 'reason': 'invalid_configuration', 'detail': str(e)})
        print(f'Activation configuration invalid: {e}', file=sys.stderr)
        return 2
    if c is None:
        print('Domotz activation not configured; nothing to do.')
        return 0
    if not c['enabled']:
        print('Domotz activation is configured but disarmed; nothing to do.')
        return 0

    existing = read_result()
    if existing and existing.get('status') in TERMINAL_STATUSES:
        print(f"Existing activation result '{existing.get('status')}' prevents another POST.")
        return 0

    try:
        status = local_status()
    except Exception as e:
        print(f'Local Domotz API not ready; retry later: {type(e).__name__}: {e}', file=sys.stderr)
        return 75

    mode = str(status.get('mode', ''))
    agent_version = str(status.get('agent_version', ''))
    if mode != 'RESTRICTED':
        atomic_json(RESULT, {
            'status': 'existing_configuration_review',
            'reason': 'collector_not_restricted',
            'collector_mode': mode or 'unknown',
            'agent_version': agent_version or 'unknown',
        })
        print('Collector is not in RESTRICTED mode. No activation POST was sent.')
        return 0

    vt = version_tuple(agent_version)
    if vt < (3, 3, 0):
        atomic_json(RESULT, {
            'status': 'review_required',
            'reason': 'unsupported_collector_version',
            'agent_version': agent_version or 'unknown',
        })
        print('Collector version is older than the supported command-line activation minimum.', file=sys.stderr)
        return 2
    if c['deny_all_interfaces'] and vt < (3, 9, 3):
        atomic_json(RESULT, {
            'status': 'review_required',
            'reason': 'scanning_flag_requires_newer_collector',
            'agent_version': agent_version or 'unknown',
        })
        print('Scanning-disabled activation requires Collector 3.9.3 or newer.', file=sys.stderr)
        return 2

    try:
        cloud_preflight(c['endpoint'])
    except Exception as e:
        print(f'Domotz cloud endpoint not reachable yet; retry later: {type(e).__name__}: {e}', file=sys.stderr)
        return 75

    payload = {'name': c['name'], 'endpoint': c['endpoint']}
    if vt >= (3, 9, 3):
        payload['deny_all_interfaces'] = c['deny_all_interfaces']

    atomic_json(RESULT, {
        'status': 'submission_started',
        'collector_name': c['name'],
        'agent_version': agent_version or 'unknown',
    })

    body = json.dumps(payload).encode('utf-8')
    req = urllib.request.Request(
        LOCAL_AGENT,
        data=body,
        headers={
            'x-api-key': c['activation_key'],
        },
        method='POST',
    )
    try:
        with urllib.request.urlopen(req, timeout=25) as resp:
            response_body = resp.read(8192).decode('utf-8', 'replace')
            code = int(resp.getcode())
        if not 200 <= code < 300:
            raise RuntimeError(f'Unexpected local API HTTP status {code}')
        atomic_json(RESULT, {
            'status': 'activation_request_accepted',
            'collector_name': c['name'],
            'agent_version': agent_version or 'unknown',
            'http_status': code,
            'response': response_body[:4096],
        })
        print('Domotz local activation API accepted the request. Verify the collector in the Domotz portal.')
        return 0
    except Exception as e:
        detail = f'{type(e).__name__}: {e}'
        if isinstance(e, urllib.error.HTTPError):
            try:
                detail += ' | ' + e.read(2048).decode('utf-8', 'replace')
            except Exception:
                pass
        atomic_json(RESULT, {
            'status': 'review_required',
            'reason': 'post_submission_error_or_uncertain_response',
            'collector_name': c['name'],
            'agent_version': agent_version or 'unknown',
            'detail': detail[:4096],
        })
        print('Activation POST was attempted but the result is uncertain or failed. Automatic POST retries are paused.', file=sys.stderr)
        return 2


def main():
    p = argparse.ArgumentParser(description='Solutionz Domotz collector activation helper')
    g = p.add_mutually_exclusive_group()
    g.add_argument('--configure', action='store_true')
    g.add_argument('--arm', action='store_true')
    g.add_argument('--disarm', action='store_true')
    g.add_argument('--check', action='store_true')
    g.add_argument('--attempt', action='store_true')
    a = p.parse_args()
    try:
        if a.configure:
            configure(); return 0
        if a.arm:
            arm(True); return 0
        if a.disarm:
            arm(False); return 0
        if a.check:
            return check()
        return attempt()
    except (ValueError, RuntimeError, OSError, json.JSONDecodeError) as e:
        print(f'ERROR: {e}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    raise SystemExit(main())
PYACTIVATION
  chmod 750 "${DOMOTZ_ACTIVATION_HELPER}"
  chown root:root "${DOMOTZ_ACTIVATION_HELPER}"

  cat > "${DOMOTZ_ACTIVATION_SERVICE}" <<'EOF'
[Unit]
Description=Solutionz Domotz Collector Activation
After=network-online.target snapd.service
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/solutionz-domotz-activate

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/solutionz-domotz-activate --attempt
SuccessExitStatus=0 75
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/solutionz-domotz-activation
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
EOF

  cat > "${DOMOTZ_ACTIVATION_TIMER}" <<'EOF'
[Unit]
Description=Retry Solutionz Domotz Collector Activation Until Ready

[Timer]
OnBootSec=90s
OnUnitInactiveSec=2min
AccuracySec=10s
Persistent=true
Unit=solutionz-domotz-activate.service

[Install]
WantedBy=timers.target
EOF

  chmod 644 "${DOMOTZ_ACTIVATION_SERVICE}" "${DOMOTZ_ACTIVATION_TIMER}"
  chown root:root "${DOMOTZ_ACTIVATION_SERVICE}" "${DOMOTZ_ACTIVATION_TIMER}"
  python3 -m py_compile "${DOMOTZ_ACTIVATION_HELPER}" || error_exit "Integrated Domotz activation helper failed Python syntax validation."
  systemd-analyze verify "${DOMOTZ_ACTIVATION_SERVICE}" "${DOMOTZ_ACTIVATION_TIMER}" >/dev/null || error_exit "Integrated Domotz activation systemd units failed validation."
  systemctl daemon-reload

  # Installation is deliberately dormant. The deployment-preparation mode only
  # arms activation after the mandatory post-reboot validation has passed.
  systemctl disable --now solutionz-domotz-activate.timer >/dev/null 2>&1 || true
  systemctl stop solutionz-domotz-activate.service >/dev/null 2>&1 || true

  cat > "${SETUP_COMMAND}" <<EOF
#!/usr/bin/env bash
exec bash "${INSTALLED_SCRIPT_COPY}" "\$@"
EOF
  chmod 750 "${SETUP_COMMAND}"
  chown root:root "${SETUP_COMMAND}"

  progress_message "Integrated Domotz activation workflow installed but left disarmed until Phase 2 passes."
}

activation_status() {
  echo "============================================================"
  echo "Solutionz RMM build and activation status"
  echo "============================================================"
  if [[ -s "${STATE_FILE}" ]]; then
    cat "${STATE_FILE}"
  else
    echo "install.state: missing"
  fi
  echo "------------------------------------------------------------"
  if [[ -x "${DOMOTZ_ACTIVATION_HELPER}" ]]; then
    "${DOMOTZ_ACTIVATION_HELPER}" --check || true
  else
    echo "Domotz activation helper: not installed"
  fi
  echo "------------------------------------------------------------"
  echo "Activation timer enabled: $(systemctl is-enabled solutionz-domotz-activate.timer 2>/dev/null || echo no)"
  echo "Activation timer active:  $(systemctl is-active solutionz-domotz-activate.timer 2>/dev/null || echo no)"
}

prepare_deployment() {
  local phase answer
  phase="$(head -n1 "${STATE_FILE}" 2>/dev/null || true)"
  [[ "${phase}" == "phase2_system_validated" ]] || error_exit "Deployment preparation requires phase2_system_validated. Current state: ${phase:-missing}."
  [[ -s "${ENGINEERING_PASSWORD_MARKER}" ]] || \
    error_exit "Deployment preparation requires the ${ENGINEERING_USER} password to be provisioned by an authenticated ${ENGINEERING_USER} engineering-key login after Phase 2."
  [[ -x "${DOMOTZ_ACTIVATION_HELPER}" ]] || error_exit "Integrated Domotz activation helper is not installed."

  systemctl stop solutionz-domotz-activate.timer solutionz-domotz-activate.service >/dev/null 2>&1 || true

  if [[ ! -s "${DOMOTZ_ACTIVATION_CONFIG}" ]]; then
    (( NON_INTERACTIVE == 0 )) || error_exit "No Domotz activation configuration exists. Run --prepare-deployment interactively once."
    "${DOMOTZ_ACTIVATION_HELPER}" --configure || error_exit "Domotz activation configuration failed."
  else
    "${DOMOTZ_ACTIVATION_HELPER}" --check || error_exit "Existing Domotz activation configuration is invalid."
    if (( NON_INTERACTIVE == 0 )); then
      read -r -p "Use the existing protected Domotz activation configuration? Type yes to continue: " answer
      if [[ "${answer}" != "yes" ]]; then
        "${DOMOTZ_ACTIVATION_HELPER}" --configure || error_exit "Domotz activation reconfiguration failed."
      fi
    fi
  fi

  "${DOMOTZ_ACTIVATION_HELPER}" --check || error_exit "Domotz activation pre-arm check failed."

  if (( NON_INTERACTIVE == 0 )); then
    echo
    warning_message "This will arm this appliance to activate as a NEW Domotz collector on its next boot."
    warning_message "Do not use this mode for an RMA/migration that must retain an existing collector identity."
    read -r -p "Type DEPLOY to arm this appliance for its next boot: " answer
    [[ "${answer}" == "DEPLOY" ]] || error_exit "Deployment preparation cancelled before arming."
  fi

  "${DOMOTZ_ACTIVATION_HELPER}" --arm || error_exit "Unable to arm Domotz activation."
  systemctl enable solutionz-domotz-activate.timer >/dev/null || error_exit "Unable to enable Domotz activation timer for the next boot."
  systemctl stop solutionz-domotz-activate.timer solutionz-domotz-activate.service >/dev/null 2>&1 || true

  progress_message "Domotz activation is armed for the next boot. The timer is enabled but intentionally stopped now."
  info_message "At the customer site, connect the approved WAN to eth0 and power on. The first activation attempt starts after approximately 90 seconds."

  if (( NO_POWEROFF == 1 )); then
    warning_message "Appliance remains powered on. Do not manually start the activation timer in the lab."
    return 0
  fi

  sync
  progress_message "Deployment preparation complete. Powering off to prevent lab activation."
  systemctl poweroff
}

check_final_requirement() {
  local description="$1"
  shift
  if "$@"; then
    printf '%sPASS - %s%s\n' "${COLOR_GREEN}" "${description}" "${COLOR_RESET}"
    return 0
  fi
  printf '%sFAIL - %s%s\n' "${COLOR_RED}" "${description}" "${COLOR_RESET}"
  PRE_REBOOT_FAILED_CHECKS+=("${description}")
  return 1
}

write_prereboot_result() {
  local failures="$1"
  local result="PASS"
  local message
  (( failures > 0 )) && result="FAIL"

  {
    echo "result=${result}"
    echo "phase=phase1_prereboot_validation"
    echo "revision=${REVISION}"
    echo "script=${SCRIPT_NAME}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "failures=${failures}"
    echo "log=${LOG_FILE}"
    echo
    echo "FAILED_CHECKS:"
    if (( ${#PRE_REBOOT_FAILED_CHECKS[@]} == 0 )); then
      echo "- none"
    else
      for message in "${PRE_REBOOT_FAILED_CHECKS[@]}"; do
        printf -- '- %s\n' "${message}"
      done
    fi
  } > "${PREREBOOT_RESULT_FILE}"
  chmod 640 "${PREREBOOT_RESULT_FILE}"
}

final_summary_check() {
  step_message 18 "Run mandatory pre-reboot validation"

  local failures=0
  PRE_REBOOT_FAILED_CHECKS=()

  echo
  echo "============================================================"
  echo "FINAL PRE-REBOOT VALIDATION - REVISION ${REVISION}"
  echo "============================================================"

  if ! "${INTEGRITY_TOOL}" --refresh; then
    PRE_REBOOT_FAILED_CHECKS+=("Security integrity baseline refresh failed")
    failures=$((failures + 1))
  fi

  check_final_requirement "Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS OS family" \
    bash -c ". /etc/os-release; [[ \"\$ID\" == ubuntu && \"\$VERSION_ID\" == ${SUPPORTED_UBUNTU_VERSION_ID} && ( -z \"\${VERSION_CODENAME:-}\" || \"\$VERSION_CODENAME\" == ${SUPPORTED_UBUNTU_CODENAME} ) ]]" || failures=$((failures + 1))

  check_final_requirement "V1210 ttyS0 serial device present" test -c "${SERIAL_DEVICE}" || failures=$((failures + 1))
  check_final_requirement "serial getty active" systemctl is-active --quiet "${SERIAL_SERVICE}" || failures=$((failures + 1))
  check_final_requirement "serial getty enabled" systemctl is-enabled --quiet "${SERIAL_SERVICE}" || failures=$((failures + 1))
  check_final_requirement "GRUB serial console configured for ttyS0 at 115200 8N1"     grep -Eq '^GRUB_CMDLINE_LINUX_DEFAULT=.*console=ttyS0,115200n8' "${GRUB_FILE}" || failures=$((failures + 1))
  check_final_requirement "Local network configuration utility installed" test -x "${LOCAL_CONFIG_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Live network discovery utility installed" test -x "${LIVE_DISCOVERY_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Technician interactive-login access profile installed" test -s "${ACCESS_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Technician access profile checks field-tech group" grep -q "${FIELD_TECH_GROUP}" "${ACCESS_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Interactive access profile recognizes engineering group" grep -q "${ENGINEERING_GROUP}" "${ACCESS_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Technician access profile launches restricted-login mode" grep -q -- '--restricted-login' "${ACCESS_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Engineering access profile launches engineering-login mode" grep -q -- '--engineering-login' "${ACCESS_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "SSH field-tech policy excludes engineering group" grep -q '^Match Group solutionz-rmm-tech,!solutionz-rmm-engineering$' "${SSH_HARDENING_FILE}" || failures=$((failures + 1))
  check_final_requirement "Local config sudoers policy installed" test -s "${LOCAL_CONFIG_SUDOERS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Local config sudoers policy valid" visudo -cf "${LOCAL_CONFIG_SUDOERS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Engineering password provisioning helper installed" test -x "${ENGINEERING_PASSWORD_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Engineering password provisioning sudoers policy valid" visudo -cf "${ENGINEERING_PASSWORD_SUDOERS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Protectli V1210 hardware" bash -c 'vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null); model=$(cat /sys/class/dmi/id/product_name 2>/dev/null); [[ "${vendor,,}" == *protectli* && "$model" == "V1210" ]]' || failures=$((failures + 1))
  check_final_requirement "SSH active" systemctl is-active --quiet ssh || failures=$((failures + 1))
  check_final_requirement "UFW active" bash -c "ufw status | grep -q 'Status: active'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 22" bash -c "ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 3000" bash -c "ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "UFW denies routed/forwarded traffic by default" grep -Eq '^DEFAULT_FORWARD_POLICY="?DROP"?$' /etc/default/ufw || failures=$((failures + 1))
  check_final_requirement "UFW persists martian logging for all interfaces" grep -Eq '^[[:space:]]*net[./]ipv4[./]conf[./]all[./]log_martians[[:space:]]*=[[:space:]]*1[[:space:]]*$' "${UFW_SYSCTL_FILE}" || failures=$((failures + 1))
  check_final_requirement "UFW persists default martian logging" grep -Eq '^[[:space:]]*net[./]ipv4[./]conf[./]default[./]log_martians[[:space:]]*=[[:space:]]*1[[:space:]]*$' "${UFW_SYSCTL_FILE}" || failures=$((failures + 1))
  check_final_requirement "SSH hardening policy installed" test -s "${SSH_HARDENING_FILE}" || failures=$((failures + 1))
  check_final_requirement "SSH configuration valid" sshd -t || failures=$((failures + 1))
  check_final_requirement "SSH root login disabled" bash -c "sshd -T | grep -q '^permitrootlogin no$'" || failures=$((failures + 1))
  check_final_requirement "Restricted field-tech group exists" getent group "${FIELD_TECH_GROUP}" || failures=$((failures + 1))
  check_final_requirement "Engineering group exists" getent group "${ENGINEERING_GROUP}" || failures=$((failures + 1))
  check_final_requirement "Default engineering account exists" id "${ENGINEERING_USER}" || failures=$((failures + 1))
  if id "${ENGINEERING_USER}" >/dev/null 2>&1; then
    check_final_requirement "Default engineering account is in engineering group" bash -c "id -nG '${ENGINEERING_USER}' | tr ' ' '\\n' | grep -qx '${ENGINEERING_GROUP}'" || failures=$((failures + 1))
    check_final_requirement "Default engineering account has sudo membership" bash -c "id -nG '${ENGINEERING_USER}' | tr ' ' '\\n' | grep -qx sudo" || failures=$((failures + 1))
    check_final_requirement "Default engineering account is not in field-tech group" bash -c "! id -nG '${ENGINEERING_USER}' | tr ' ' '\\n' | grep -qx '${FIELD_TECH_GROUP}'" || failures=$((failures + 1))
    check_final_requirement "Default engineering account uses Bash shell" bash -c '[[ "$(getent passwd "$1" | cut -d: -f7)" == /bin/bash ]]' _ "${ENGINEERING_USER}" || failures=$((failures + 1))
    check_final_requirement "Default engineering account has authorized SSH key" bash -c 'home="$(getent passwd "$1" | cut -d: -f6)"; [[ -n "$home" && -s "$home/.ssh/authorized_keys" ]]' _ "${ENGINEERING_USER}" || failures=$((failures + 1))
    check_final_requirement "Engineering SSH key fingerprint record present" test -s "${ENGINEERING_SSH_FINGERPRINT_FILE}" || failures=$((failures + 1))
    check_final_requirement "Engineering SSH public-key authentication enabled" bash -c "sshd -T | grep -q '^pubkeyauthentication yes$'" || failures=$((failures + 1))
  fi
  if id "${TECHNICIAN_USER}" >/dev/null 2>&1; then
    check_final_requirement "Default technician account is in field-tech group" bash -c "id -nG '${TECHNICIAN_USER}' | tr ' ' '\\n' | grep -qx '${FIELD_TECH_GROUP}'" || failures=$((failures + 1))
    check_final_requirement "Default technician account does not have engineering shell bypass" bash -c "! id -nG '${TECHNICIAN_USER}' | tr ' ' '\\n' | grep -qx '${ENGINEERING_GROUP}'" || failures=$((failures + 1))
    check_final_requirement "Default technician account has no unrestricted sudo membership" bash -c "! id -nG '${TECHNICIAN_USER}' | tr ' ' '\\n' | grep -qx sudo" || failures=$((failures + 1))
  else
    warning_message "Default technician account ${TECHNICIAN_USER} does not exist; group-based policy remains installed for later technician accounts."
  fi
  check_final_requirement "Field network menu has no unrestricted Linux shell option" bash -c "! grep -q 'Open Linux shell' '${LOCAL_CONFIG_TOOL}'" || failures=$((failures + 1))
  check_final_requirement "auditd active" systemctl is-active --quiet auditd || failures=$((failures + 1))
  check_final_requirement "Solutionz audit rules installed" test -s "${AUDIT_RULES_FILE}" || failures=$((failures + 1))
  check_final_requirement "AppArmor active" systemctl is-active --quiet apparmor || failures=$((failures + 1))
  check_final_requirement "Controlled security-update policy installed" test -s "${SECURITY_APT_POLICY_FILE}" || failures=$((failures + 1))
  check_final_requirement "Automatic security reboot disabled" grep -q 'Automatic-Reboot "false"' "${SECURITY_APT_POLICY_FILE}" || failures=$((failures + 1))
  check_final_requirement "Unattended package installation disabled" grep -q 'APT::Periodic::Unattended-Upgrade "0"' "${SECURITY_APT_POLICY_FILE}" || failures=$((failures + 1))
  check_final_requirement "Security integrity baseline exists" test -s "${SECURITY_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Security integrity baseline validates" "${INTEGRITY_TOOL}" --verify || failures=$((failures + 1))
check_final_requirement "Solutionz security validator installed" test -x "${SECURITY_VALIDATOR}" || failures=$((failures + 1))
  check_final_requirement "Solutionz security validation passes" "${SECURITY_VALIDATOR}" || failures=$((failures + 1))
  check_final_requirement "DNS resolves api.snapcraft.io to IPv4" dns_resolves_ipv4 api.snapcraft.io || failures=$((failures + 1))
  check_final_requirement "DNS resolves archive.ubuntu.com to IPv4" dns_resolves_ipv4 archive.ubuntu.com || failures=$((failures + 1))
  check_final_requirement "systemd-timesyncd enabled" systemctl is-enabled --quiet systemd-timesyncd.service || failures=$((failures + 1))
  check_final_requirement "systemd-timesyncd active" systemctl is-active --quiet systemd-timesyncd.service || failures=$((failures + 1))
  check_final_requirement "systemd-time-wait-sync enabled" systemctl is-enabled --quiet systemd-time-wait-sync.service || failures=$((failures + 1))
  echo "INFO - Waiting up to 180 seconds for NTP synchronization before Phase 1 completion."
  if ! check_final_requirement "NTP synchronization active" wait_for_ntp_sync 36 5; then
    failures=$((failures + 1))
    report_ntp_diagnostics
  fi
  check_final_requirement "Initial OS runtime baseline record exists" test -s "${OS_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer system baseline record exists" test -s "${MANUFACTURER_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer package inventory exists" test -s "${MANUFACTURER_PACKAGE_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer required-package validation exists" test -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer baseline checksum record exists" test -s "${MANUFACTURER_BASELINE_SHA256_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer baseline integrity is valid" \
    sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer package validation has a recognized result" \
    grep -Eq '^manufacturer_package_validation=(PASS|DEVIATION)$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || failures=$((failures + 1))
  if grep -q '^manufacturer_package_validation=DEVIATION$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" 2>/dev/null; then
    warning_message "Manufacturer package baseline contained a recorded deviation. Final required-package state is validated separately and must pass."
  fi
  check_final_requirement "Final required-package baseline record exists" test -s "${BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Network requirements record exists" test -s "${NETWORK_REQUIREMENTS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Netplan generates successfully" netplan generate || failures=$((failures + 1))
  check_final_requirement "Automatic Netplan/VLAN profile helper installed" test -x "${NETWORK_PROFILE_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Production network profile installed" test -s "${NETWORK_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Production network profile validates" "${NETWORK_PROFILE_TOOL}" validate "${NETWORK_PROFILE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Production network profile render result exists" test -s "${NETWORK_PROFILE_RESULT_FILE}" || failures=$((failures + 1))
  check_final_requirement "Production network profile render result is PASS" grep -q '^result=PASS$' "${NETWORK_PROFILE_RESULT_FILE}" || failures=$((failures + 1))
  check_final_requirement "Automatic dual-homed network validator installed" test -x "${NETWORK_VALIDATOR}" || failures=$((failures + 1))
  check_final_requirement "Persistent IPv4 forwarding disable policy installed" grep -Eq '^net\.ipv4\.ip_forward=0$' "${IP_FORWARD_SYSCTL_FILE}" || failures=$((failures + 1))
  check_final_requirement "Current IPv4 forwarding is disabled" bash -c '[[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" == "0" ]]' || failures=$((failures + 1))
  check_final_requirement "Integrated Domotz activation helper installed" test -x "${DOMOTZ_ACTIVATION_HELPER}" || failures=$((failures + 1))
  check_final_requirement "Domotz activation service unit installed" test -s "${DOMOTZ_ACTIVATION_SERVICE}" || failures=$((failures + 1))
  check_final_requirement "Domotz activation timer unit installed" test -s "${DOMOTZ_ACTIVATION_TIMER}" || failures=$((failures + 1))
  check_final_requirement "Domotz activation helper syntax valid" python3 -m py_compile "${DOMOTZ_ACTIVATION_HELPER}" || failures=$((failures + 1))
  check_final_requirement "Domotz activation systemd units valid" systemd-analyze verify "${DOMOTZ_ACTIVATION_SERVICE}" "${DOMOTZ_ACTIVATION_TIMER}" || failures=$((failures + 1))
  check_final_requirement "Unified setup command installed" test -x "${SETUP_COMMAND}" || failures=$((failures + 1))
  check_final_requirement "Domotz installed" snap list "${DOMOTZ_SNAP_NAME}" || failures=$((failures + 1))
  check_final_requirement "Post-reboot production validator installed" test -x "${POSTREBOOT_VALIDATOR}" || failures=$((failures + 1))

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    if snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      printf '%sPASS - Domotz permission %s connected%s\n' "${COLOR_GREEN}" "${permission}" "${COLOR_RESET}"
    else
      printf '%sFAIL - Domotz permission %s not connected%s\n' "${COLOR_RED}" "${permission}" "${COLOR_RESET}"
      PRE_REBOOT_FAILED_CHECKS+=("Domotz permission ${permission} not connected")
      failures=$((failures + 1))
    fi
  done

  progress_message "Domotz is intentionally not revision-pinned; installed revision is recorded for audit."

  echo "------------------------------------------------------------"
  echo "Pre-reboot mandatory failures: ${failures}"
  echo "Validation result: ${PREREBOOT_RESULT_FILE}"
  echo "============================================================"

  write_prereboot_result "${failures}"
  (( failures == 0 ))
}

main() {
  parse_args "$@"
  require_root
  init_logging

  case "${RUN_MODE}" in
    activation_status)
      activation_status
      return 0
      ;;
    prepare_deployment)
      prepare_deployment
      return 0
      ;;
  esac

  printf '\n%sSolutionz RMM Agent Installation%s\n' "${COLOR_CYAN}" "${COLOR_RESET}"
  info_message "Revision ${REVISION} | Release ${RELEASE_DATE}"
  info_message "Command output is displayed on the console and recorded in ${LOG_FILE}."

  backup_previous_state
  write_state "phase1_in_progress"
  record_network_requirements

  prompt_confirmation
  preflight_checks
  capture_manufacturer_baseline
  install_required_packages
  verify_required_packages
  verify_ssh_service
  configure_time_sync
  configure_tun
  ensure_snapd
  install_domotz
  configure_domotz_permissions
  configure_ufw
  configure_security_hardening
  stage_network_config
  repair_resolv_conf
  normalize_host_entries
  configure_grub_and_serial
  install_local_serial_config_tool
  update_banner
  install_postreboot_validation
  install_domotz_activation

  if ! final_summary_check; then
    error_exit "Mandatory pre-reboot validation failed. Review ${PREREBOOT_RESULT_FILE} for failed check names."
  fi

  write_state "phase1_complete" \
    "reboot_required=1" \
    "prereboot_result=${PREREBOOT_RESULT_FILE}" \
    "postreboot_validator=${POSTREBOOT_VALIDATOR}" \
    "postreboot_result=${POSTREBOOT_RESULT_FILE}" \
    "network_profile=${NETWORK_PROFILE_FILE}" \
    "network_profile_result=${NETWORK_PROFILE_RESULT_FILE}" \
    "network_validation_result=${NETWORK_VALIDATION_RESULT_FILE}" \
    "network_live_discovery_result=${LIVE_DISCOVERY_RESULT_FILE}" \
    "security_validation_result=${SECURITY_VALIDATION_RESULT_FILE}" \
    "security_baseline=${SECURITY_BASELINE_FILE}" \
    "domotz_activation_helper=${DOMOTZ_ACTIVATION_HELPER}" \
    "domotz_activation_config=${DOMOTZ_ACTIVATION_CONFIG}" \
    "engineering_login=${ENGINEERING_USER}" \
    "engineering_ssh_key_fingerprint=$(awk -F= '$1=="fingerprint" {print $2}' "${ENGINEERING_SSH_FINGERPRINT_FILE}" 2>/dev/null | head -n1)" \
    "engineering_password_status=pending_engineering_menu_setup" \
    "engineering_password_provisioning=authenticated_solz_eng_menu_setup_after_phase2" \
    "setup_command=${SETUP_COMMAND}" \
    "log=${LOG_FILE}"

  completion_message
  progress_message "Phase 1 completed successfully."
  progress_message "Completion Time: $(date -u +%FT%TZ)"
  progress_message "Hostname: $(hostname)"
  progress_message "Script Revision: ${REVISION}"
  progress_message "Default technician login: ${TECHNICIAN_USER} (restricted configuration menu)."
  progress_message "Default engineering login: ${ENGINEERING_USER} (engineering shell + sudo)."
  if [[ -s "${ENGINEERING_PASSWORD_MARKER}" ]]; then
    progress_message "Engineering password status: configured; existing credential preserved by Setup."
  else
    progress_message "Engineering password status: pending authenticated engineering menu provisioning."
    info_message "Reboot normally. After Phase 2 passes, both technician and engineering interactive logins open the Solutionz RMM configuration menu. Engineering authenticates as ${ENGINEERING_USER} with the configured Solutionz private key, then selects option 9 to create the local engineering password."
  fi
  progress_message "Network mode after reboot is generated from ${NETWORK_PROFILE_FILE}. Default profile: eth0 WAN DHCP + optional eth1 LAN DHCP with LAN routes/DNS suppressed."
  progress_message "eth0 is WAN/cloud and owns the only default route. eth1 is optional AV/control LAN unless a static LAN or VLAN profile requires it; 802.1Q VLANs, when used, are linked to eth1."
  progress_message "Automatic network validation tool: ${NETWORK_VALIDATOR}"
  progress_message "Automatic security validation tool: ${SECURITY_VALIDATOR}"
  progress_message "Security integrity baseline: ${SECURITY_BASELINE_FILE}"
  progress_message "State File: ${STATE_FILE}"
  progress_message "Log File: ${LOG_FILE}"
  warning_message "Manual reboot is required. Post-reboot validation will run automatically after restart."
  info_message "After Phase 2 reaches phase2_system_validated, engineering logs in as ${ENGINEERING_USER} with the Solutionz engineering SSH private key. The same Solutionz RMM menu opens in engineering mode; option 9 performs the one-time local password setup."
  info_message "Technician account ${TECHNICIAN_USER} cannot create or change the ${ENGINEERING_USER} password and remains restricted to the technician menu."
  info_message "Deployment preparation is blocked until the engineering password has been provisioned; then run: sudo solutionz-rmm-setup --prepare-deployment"
  info_message "That same Setup source configures and arms Domotz activation for the next boot, then powers the appliance off by default."
  info_message "Interactive access: ${FIELD_TECH_GROUP} and ${ENGINEERING_GROUP} members both enter the Solutionz RMM configuration menu. Only an authenticated ${ENGINEERING_USER} session can create/change the engineering password or open the unrestricted engineering shell."
  info_message "USB-C COM recovery/configuration remains available at 115200 8N1."
  info_message "After every network change the script validates WAN eth0, LAN eth1/VLANs, default-route ownership, DNS/Domotz reachability, IPv4 forwarding, firewall/SSH hardening, audit state, and file integrity."
  info_message "Automated VLAN deployment: use --network-profile <json> or network-menu option 3/4 onsite; VLANs are created on eth1."
  info_message "Domotz is not revision-pinned; the installed revision is recorded in ${SNAP_BASELINE_FILE}."
}

main "$@"
