  local profile_file profile_name
  for profile_file in "${APPARMOR_PROFILE_FILES[@]}"; do
    apparmor_parser -Q -K "$profile_file" >/dev/null 2>&1 || error_exit "AppArmor syntax validation failed: $profile_file"
    apparmor_parser -r -K "$profile_file" >/dev/null 2>&1 || error_exit "Unable to load AppArmor profile: $profile_file"
  done

  [[ -r /sys/kernel/security/apparmor/profiles ]] || error_exit "AppArmor profile inventory is not readable after profile load."
  for profile_name in "${APPARMOR_REQUIRED_PROFILES[@]}"; do
    grep -Fq "${profile_name} (enforce)" /sys/kernel/security/apparmor/profiles || \
      error_exit "Required AppArmor profile is not loaded in enforce mode: ${profile_name}"
  done

  progress_message "Solutionz AppArmor policy ${APPARMOR_POLICY_REVISION} loaded: ${#APPARMOR_REQUIRED_PROFILES[@]} role-specific profiles in enforce mode."
}

write_default_network_profile() {
  local target="${1:-${NETWORK_PROFILE_FILE}}"
  install -d -m 750 "$(dirname "${target}")"
  cat > "${target}" <<'JSON'
{
  "revision": "SOC2-V07111226",
  "wan": {"interface": "eth0", "mode": "dhcp", "dns": []},
  "lan": {"interface": "eth1", "mode": "dhcp"},
  "vlans": []
}
JSON
  chmod 600 "${target}"
}

install_network_profile_tool() {
  install -d -m 755 /usr/local/sbin
  cat > "${NETWORK_PROFILE_TOOL}" <<'PYNETPROFILE'
#!/usr/bin/env python3
import argparse, ipaddress, json, os, sys
from pathlib import Path
REVISION="SOC2-V07111226"; WAN_IFACE="eth0"; LAN_IFACE="eth1"; MAX_VLANS=32
class ProfileError(ValueError): pass
def fail(msg): raise ProfileError(msg)
def normalize_dns(values,label):
    if values is None:return []
    if not isinstance(values,list):fail(f"{label} dns must be a JSON array.")
    out=[]
    for value in values:
        try: ip=ipaddress.ip_address(str(value).strip())
        except ValueError: fail(f"{label} contains invalid DNS address: {value}")
        if ip.version!=4:fail(f"{label} DNS must be IPv4: {value}")
        out.append(str(ip))
    return out
def parse_static(entry,label):
    address=str(entry.get("address","")).strip()
    if not address:fail(f"{label} static mode requires address in CIDR notation.")
    try:iface=ipaddress.ip_interface(address)
    except ValueError:fail(f"{label} has invalid address/CIDR: {address}")
    if iface.version!=4:fail(f"{label} must use IPv4.")
    if iface.ip in (iface.network.network_address,iface.network.broadcast_address):fail(f"{label} host address cannot be network/broadcast.")
    return iface
def validate_profile(raw):
    if not isinstance(raw,dict):fail("Profile root must be a JSON object.")
    rev=raw.get("revision")
    if rev not in (None,"","V06.100626N",REVISION):fail(f"Profile revision {rev!r} does not match {REVISION}.")
    wan=raw.get("wan");lan=raw.get("lan")
    if not isinstance(wan,dict):fail("wan must be a JSON object.")
    if not isinstance(lan,dict):fail("lan must be a JSON object.")
    if str(wan.get("interface",WAN_IFACE)).strip()!=WAN_IFACE:fail("wan.interface must be eth0.")
    if str(lan.get("interface",LAN_IFACE)).strip()!=LAN_IFACE:fail("lan.interface must be eth1.")
    wm=str(wan.get("mode","dhcp")).strip().lower(); wd=normalize_dns(wan.get("dns",[]),"wan"); wi=None; wg=str(wan.get("gateway","")).strip()
    if wm not in {"dhcp","static"}:fail("wan.mode must be dhcp or static.")
    if wm=="static":
        wi=parse_static(wan,"wan")
        if not wg:fail("wan static mode requires gateway.")
        try:g=ipaddress.ip_address(wg)
        except ValueError:fail(f"wan has invalid gateway: {wg}")
        if g.version!=4 or g not in wi.network:fail("wan gateway must be inside WAN subnet.")
        if not wd:fail("wan static mode requires at least one DNS server.")
    elif wan.get("address") or wg:fail("wan DHCP mode cannot define address or gateway.")
    lm=str(lan.get("mode","dhcp")).strip().lower(); li=None
    if lm not in {"dhcp","static","none","unused"}:fail("lan.mode must be dhcp, static, none, or unused.")
    if lan.get("gateway") or lan.get("default_route"):fail("LAN eth1 may not define gateway/default route.")
    if lan.get("dns"):fail("LAN eth1 may not define system DNS.")
    if lm=="static":li=parse_static(lan,"lan")
    elif lan.get("address"):fail(f"lan address invalid when mode={lm}.")
    vlans=raw.get("vlans",[])
    if not isinstance(vlans,list):fail("vlans must be a JSON array.")
    if len(vlans)>MAX_VLANS:fail(f"Maximum {MAX_VLANS} VLANs supported.")
    if lm=="none" and not vlans:fail("lan.mode=none requires at least one VLAN.")
    if lm=="unused" and vlans:fail("lan.mode=unused cannot define VLANs because eth1 is intentionally disabled for this deployment.")
    nets=[]
    if wi:nets.append(("wan/eth0",wi.network))
    if li:nets.append(("lan/eth1",li.network))
    if wi and li and wi.network.overlaps(li.network):fail(f"WAN subnet {wi.network} overlaps LAN subnet {li.network}.")
    seen=set();nv=[]
    for idx,item in enumerate(vlans,1):
        if not isinstance(item,dict):fail(f"vlan entry {idx} must be object.")
        try:vid=int(item.get("id"))
        except Exception:fail(f"vlan entry {idx} id must be integer.")
        if not 1<=vid<=4094:fail(f"VLAN {vid} id must be 1-4094.")
        if vid in seen:fail(f"Duplicate VLAN ID {vid}.")
        seen.add(vid);mode=str(item.get("mode","static")).strip().lower()
        if mode not in {"dhcp","static"}:fail(f"VLAN {vid} mode must be dhcp or static.")
        if item.get("gateway") or item.get("default_route"):fail(f"VLAN {vid} may not define gateway/default route.")
        if item.get("dns"):fail(f"VLAN {vid} may not define system DNS.")
        vi=None
        if mode=="static":
            vi=parse_static(item,f"VLAN {vid}")
            for label,net in nets:
                if vi.network.overlaps(net):fail(f"VLAN {vid} subnet {vi.network} overlaps {label} subnet {net}.")
            nets.append((f"vlan{vid}",vi.network))
        elif item.get("address"):fail(f"VLAN {vid} address invalid for DHCP mode.")
        nv.append({"id":vid,"mode":mode,"address":str(vi) if vi else ""})
    return {"revision":REVISION,"wan":{"interface":"eth0","mode":wm,"address":str(wi) if wi else "","gateway":wg,"dns":wd},"lan":{"interface":"eth1","mode":lm,"address":str(li) if li else ""},"vlans":nv,"default_interface":"eth0"}
def load_profile(path):
    try:raw=json.loads(Path(path).read_text())
    except FileNotFoundError:fail(f"Profile not found: {path}")
    except json.JSONDecodeError as e:fail(f"Invalid JSON line {e.lineno}: {e.msg}")
    return validate_profile(raw)
def common(lines,p):lines += [f"{p}dhcp6: false",f"{p}accept-ra: false",f"{p}optional: true"]
def render(pf):
    L=["network:","  version: 2","  renderer: networkd","  ethernets:"]
    w=pf["wan"];L.append("    eth0:");p="      "
    if w["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  route-metric: 100"];common(L,p)
    else:L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {w['address']}",p+"routes:",p+"  - to: default",p+f"    via: {w['gateway']}",p+"nameservers:",p+f"  addresses: [{', '.join(w['dns'])}]" ]
    l=pf["lan"];L.append("    eth1:");p="      "
    if l["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  use-routes: false",p+"  use-dns: false"];common(L,p)
    elif l["mode"]=="static":L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {l['address']}" ]
    else:L += [p+"dhcp4: false",p+"link-local: []"];common(L,p)
    if pf["vlans"]:
        L.append("  vlans:")
        for v in pf["vlans"]:
            p="      ";L += [f"    vlan{v['id']}:",p+f"id: {v['id']}",p+"link: eth1"]
            if v["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  use-routes: false",p+"  use-dns: false"];common(L,p)
            else:L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {v['address']}" ]
    return "\n".join(L)+"\n"
def atomic(path,content,mode=0o600):
    p=Path(path);p.parent.mkdir(parents=True,exist_ok=True);t=p.with_name(p.name+".tmp");t.write_text(content);os.chmod(t,mode);os.replace(t,p)
def result(path,res,reason,pfpath=None,pf=None,np=None):
    L=[f"result={res}",f"revision={REVISION}",f"reason={reason}"]
    if pfpath:L.append(f"profile={pfpath}")
    if pf:L += [f"wan_mode={pf['wan']['mode']}",f"lan_mode={pf['lan']['mode']}","default_interface=eth0","vlans="+",".join(str(v["id"]) for v in pf["vlans"])]
    if np:L.append(f"netplan={np}")
    atomic(path,"\n".join(L)+"\n",0o640)
def choice(prompt,opts,default):
    while True:
        v=input(f"{prompt} [{'/' .join(opts)}] (default {default}): ").strip().lower() or default
        if v in opts:return v
        print("Invalid choice.")
def cidr(prompt):
    while True:
        v=input(prompt+": ").strip()
        try:i=ipaddress.ip_interface(v);assert i.version==4 and i.ip not in (i.network.network_address,i.network.broadcast_address);return str(i)
        except Exception:print("Enter valid IPv4/CIDR.")
def ipv4(prompt):
    while True:
        v=input(prompt+": ").strip()
        try:i=ipaddress.ip_address(v);assert i.version==4;return str(i)
        except Exception:print("Enter valid IPv4 address.")
def wizard(path):
    print("Solutionz dual-homed profile builder - eth0 WAN / eth1 AV LAN")
    wm=choice("WAN eth0 mode",["dhcp","static"],"dhcp");wan={"interface":"eth0","mode":wm,"dns":[]}
    if wm=="static":wan.update(address=cidr("WAN IPv4/CIDR"),gateway=ipv4("WAN gateway"),dns=[x.strip() for x in input("WAN DNS comma separated: ").split(',') if x.strip()])
    lm=choice("LAN eth1 native mode",["dhcp","static","none","unused"],"dhcp");lan={"interface":"eth1","mode":lm}
    if lm=="static":lan["address"]=cidr("LAN eth1 IPv4/CIDR")
    if lm=="unused":
        n=0
        print("LAN eth1 marked unused; tagged VLAN count forced to 0.")
    else:
        while True:
            try:n=int(input(f"Tagged VLAN count 0-{MAX_VLANS}: ").strip() or 0);assert 0<=n<=MAX_VLANS;break
            except Exception:print("Invalid count.")
    vs=[];seen=set()
    for x in range(n):
        while True:
            try:vid=int(input(f"VLAN #{x+1} ID: "));assert 1<=vid<=4094 and vid not in seen;seen.add(vid);break
            except Exception:print("Invalid/duplicate VLAN ID.")
        m=choice(f"VLAN {vid} mode",["dhcp","static"],"static");v={"id":vid,"mode":m}
        if m=="static":v["address"]=cidr(f"VLAN {vid} IPv4/CIDR")
        vs.append(v)
    pf=validate_profile({"revision":REVISION,"wan":wan,"lan":lan,"vlans":vs});atomic(path,json.dumps({"revision":REVISION,"wan":pf["wan"],"lan":pf["lan"],"vlans":pf["vlans"]},indent=2)+"\n");print("Profile written; WAN eth0 owns the only default route.")
def main():
    a=argparse.ArgumentParser();sub=a.add_subparsers(dest="cmd",required=True)
    for c in ("validate","default-interface","summary"):q=sub.add_parser(c);q.add_argument("profile")
    q=sub.add_parser("render");q.add_argument("profile");q.add_argument("netplan");q.add_argument("result")
    q=sub.add_parser("wizard");q.add_argument("profile");args=a.parse_args()
    try:
        if args.cmd=="wizard":wizard(args.profile);return 0
        pf=load_profile(args.profile)
        if args.cmd=="validate":print("PASS");return 0
        if args.cmd=="default-interface":print("eth0");return 0
        if args.cmd=="summary":print(json.dumps(pf,indent=2));return 0
        atomic(args.netplan,render(pf));result(args.result,"PASS","PROFILE_RENDERED",args.profile,pf,args.netplan);print("eth0");return 0
    except ProfileError as e:
        if getattr(args,"cmd",None)=="render":
            try:result(args.result,"FAIL",str(e),getattr(args,"profile",None))
            except Exception:pass
        print("ERROR:",e,file=sys.stderr);return 1
if __name__=="__main__":raise SystemExit(main())
PYNETPROFILE
  chmod 750 "${NETWORK_PROFILE_TOOL}"; chown root:root "${NETWORK_PROFILE_TOOL}"
}

install_live_network_discovery_tool() {
  install -d -m 755 /usr/local/sbin
  cat > "${LIVE_DISCOVERY_TOOL}" <<'LIVEDISCOVERY'
#!/usr/bin/env bash
set -uo pipefail

REVISION="SOC2-V07111226"
WAN="eth0"
LAN="eth1"
RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-SOC2-V07111226.result"

mkdir -p "$(dirname "$RESULT")"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

record(){ printf '%s=%s\n' "$1" "$2" >> "$tmp"; }
upper(){ tr '[:lower:]' '[:upper:]'; }

iface_exists(){ ip link show dev "$1" >/dev/null 2>&1; }
iface_mac(){ cat "/sys/class/net/$1/address" 2>/dev/null || echo "UNKNOWN"; }
iface_operstate(){ cat "/sys/class/net/$1/operstate" 2>/dev/null | upper || echo "UNKNOWN"; }
iface_carrier(){
  local c
  c="$(cat "/sys/class/net/$1/carrier" 2>/dev/null || true)"
  case "$c" in 1) echo "YES";; 0) echo "NO";; *) echo "UNKNOWN";; esac
}
iface_speed(){
  local sp
  sp="$(cat "/sys/class/net/$1/speed" 2>/dev/null || true)"
  if [[ "$sp" =~ ^[0-9]+$ ]] && (( sp > 0 )); then echo "${sp} Mb/s"; else echo "UNKNOWN"; fi
}
iface_ipv4_all(){
  ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk '{print $4}' | paste -sd, - || true
}
iface_assignment(){
  local iface="$1" lines idx lease
  lines="$(ip -o -4 addr show dev "$iface" scope global 2>/dev/null || true)"
  if [[ -z "$lines" ]]; then
    echo "NONE"
    return
  fi
  if grep -qw dynamic <<<"$lines"; then
    echo "DHCP"
    return
  fi
  idx="$(cat "/sys/class/net/$iface/ifindex" 2>/dev/null || true)"
  lease="/run/systemd/netif/leases/${idx}"
  if [[ -n "$idx" && -s "$lease" ]] && grep -q '^ADDRESS=' "$lease" 2>/dev/null; then
    echo "DHCP"
    return
  fi
  echo "STATIC_OR_MANUAL"
}
iface_default(){
  if ip -4 route show default 2>/dev/null | grep -Eq " dev $1( |$)"; then echo "YES"; else echo "NO"; fi
}
iface_gateway(){
  ip -4 route show default 2>/dev/null | awk -v i="$1" '$0 ~ (" dev " i "( |$)") {print $3; exit}'
}
iface_dns(){
  if command -v resolvectl >/dev/null 2>&1; then
    local d
    d="$(resolvectl dns "$1" 2>/dev/null | sed -n 's/^[^:]*:[[:space:]]*//p' | head -n1)"
    [[ -n "$d" ]] && echo "$d" || echo "NONE"
  else
    echo "UNKNOWN"
  fi
}

show_iface(){
  local iface="$1" role="$2"
  echo
  echo "${role} / ${iface}"
  echo "------------------------------------------------"
  if ! iface_exists "$iface"; then
    echo "Interface:            NOT FOUND"
    record "${iface}_present" "NO"
    return
  fi
  local mac link carrier speed ipv4 source gateway def dns
  mac="$(iface_mac "$iface")"
  link="$(iface_operstate "$iface")"
  carrier="$(iface_carrier "$iface")"
  speed="$(iface_speed "$iface")"
  ipv4="$(iface_ipv4_all "$iface")"
  source="$(iface_assignment "$iface")"
  gateway="$(iface_gateway "$iface")"
  def="$(iface_default "$iface")"
  dns="$(iface_dns "$iface")"
  [[ -n "$ipv4" ]] || ipv4="NONE"
  [[ -n "$gateway" ]] || gateway="NONE"

  printf '%-22s %s\n' "MAC Address:" "$mac"
  printf '%-22s %s\n' "Link:" "$link"
  printf '%-22s %s\n' "Carrier:" "$carrier"
  printf '%-22s %s\n' "Negotiated Speed:" "$speed"
  printf '%-22s %s\n' "Detected IPv4:" "$ipv4"
  printf '%-22s %s\n' "Assignment:" "$source"
  printf '%-22s %s\n' "Gateway:" "$gateway"
  printf '%-22s %s\n' "Default Route:" "$def"
  printf '%-22s %s\n' "DNS:" "$dns"
  case "$source" in
    DHCP) printf '%-22s %s\n' "Status:" "ADDRESS DETECTED AUTOMATICALLY" ;;
    STATIC_OR_MANUAL) printf '%-22s %s\n' "Status:" "ACTIVE ADDRESS DETECTED" ;;
    NONE)
      if [[ "$carrier" == "YES" ]]; then
        printf '%-22s %s\n' "Status:" "NO ACTIVE IPv4 - DHCP OR STATIC CONFIGURATION REQUIRED"
      else
        printf '%-22s %s\n' "Status:" "NO PHYSICAL LINK / NO ACTIVE IPv4"
      fi
      ;;
  esac

  record "${iface}_present" "YES"
  record "${iface}_mac" "$mac"
  record "${iface}_link" "$link"
  record "${iface}_carrier" "$carrier"
  record "${iface}_speed" "$speed"
  record "${iface}_ipv4" "$ipv4"
  record "${iface}_assignment" "$source"
  record "${iface}_gateway" "$gateway"
  record "${iface}_default_route" "$def"
  record "${iface}_dns" "$dns"
}

show_vlans(){
  local count=0 line raw name parent vid addr source
  echo
  echo "LIVE DETECTED VLANs"
  echo "------------------------------------------------"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    raw="$(awk -F': ' '{print $2}' <<<"$line" | awk '{print $1}')"
    name="${raw%%@*}"
    if [[ "$raw" == *"@"* ]]; then parent="${raw#*@}"; else parent="UNKNOWN"; fi
    vid="$(sed -n 's/.* vlan protocol [^ ]* id \([0-9]\+\).*/\1/p' <<<"$line")"
    [[ -n "$vid" ]] || vid="UNKNOWN"
    addr="$(iface_ipv4_all "$name")"; [[ -n "$addr" ]] || addr="NONE"
    source="$(iface_assignment "$name")"
    printf 'VLAN %-5s %-16s parent=%-8s IPv4=%-20s source=%s\n' "$vid" "$name" "$parent" "$addr" "$source"
    count=$((count+1))
    record "vlan_${count}_id" "$vid"
    record "vlan_${count}_name" "$name"
    record "vlan_${count}_parent" "$parent"
    record "vlan_${count}_ipv4" "$addr"
    record "vlan_${count}_assignment" "$source"
  done < <(ip -d -o link show type vlan 2>/dev/null || true)
  if (( count == 0 )); then echo "None detected."; fi
  record "vlan_count" "$count"
}

echo "============================================================"
echo "Solutionz RMM Live Network Discovery"
echo "Revision: $REVISION"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"
echo "Observed state is read from the running Linux network stack."
echo "Netplan is not used to determine the live addresses shown below."

record "revision" "$REVISION"
record "timestamp_utc" "$(date -u +%FT%TZ)"
show_iface "$WAN" "WAN"
show_iface "$LAN" "LAN"
show_vlans

echo
echo "LIVE IPv4 ROUTE TABLE"
echo "------------------------------------------------"
ip -4 route 2>/dev/null || true

echo
echo "SYSTEM DNS"
echo "------------------------------------------------"
if command -v resolvectl >/dev/null 2>&1; then
  resolvectl dns 2>/dev/null || true
else
  cat /etc/resolv.conf 2>/dev/null || true
fi

if [[ $EUID -eq 0 ]]; then
  install -o root -g root -m 640 "$tmp" "$RESULT"
  echo
  echo "Live discovery result: $RESULT"
else
  echo
  echo "Live state displayed read-only. Run with sudo to persist the discovery result."
fi
LIVEDISCOVERY
  chmod 750 "${LIVE_DISCOVERY_TOOL}"
  chown root:root "${LIVE_DISCOVERY_TOOL}"
}

install_network_validator() {
  install -d -m 755 /usr/local/sbin
  cat > "${NETWORK_VALIDATOR}" <<'NETVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail

REVISION="SOC2-V07111226"
PROFILE="/etc/solutionz-rmm/network-profile.json"
PROFILE_TOOL="/usr/local/sbin/solutionz-rmm-network-profile"
RESULT="/var/lib/rswsolutionz-rmm/network-validation-SOC2-V07111226.result"
WAN="eth0"
LAN="eth1"
WAIT_SECONDS="${SOLUTIONZ_NETWORK_VALIDATION_WAIT_SECONDS:-30}"

CONFIG_FAILS=()
CONNECT_FAILS=()
PENDING=()

cf() { CONFIG_FAILS+=("$*"); echo "FAIL - $*"; }
xf() { CONNECT_FAILS+=("$*"); echo "FAIL - $*"; }
pend() { PENDING+=("$*"); echo "PENDING - $*"; }
ok() { echo "PASS - $*"; }

ip4() {
  ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {print $4}'
}

default_iface() {
  ip -4 route show default 2>/dev/null | awk 'NR==1 {for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}'
}

default_gateway() {
  ip -4 route show default 2>/dev/null | awk -v iface="$1" '$0 ~ (" dev " iface "( |$)") {print $3; exit}'
}

carrier() {
  [[ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null || echo 0)" == "1" ]]
}

tcp_open() {
  timeout 8 bash -c "</dev/tcp/$1/$2" >/dev/null 2>&1
}

profile_meta() {
  python3 - "$PROFILE" <<'PROFILEPY'
import json, sys
p=json.load(open(sys.argv[1]))
w=p.get('wan',{})
l=p.get('lan',{})
print(w.get('mode',''))
print(w.get('address',''))
print(w.get('gateway',''))
print(l.get('mode',''))
print(l.get('address',''))
PROFILEPY
}

profile_vlans() {
  python3 - "$PROFILE" <<'VLANPY'
import json, sys
for v in json.load(open(sys.argv[1])).get('vlans',[]):
    print(f"{v['id']}|{v.get('mode','')}|{v.get('address','')}")
VLANPY
}

PROFILE_VALID=0
WAN_MODE=""
WAN_EXPECTED=""
WAN_GATEWAY_EXPECTED=""
LAN_MODE=""
LAN_EXPECTED=""

mkdir -p "$(dirname "$RESULT")"

if [[ -x "$PROFILE_TOOL" ]]; then
  ok "Network profile helper installed."
else
  cf "Network profile helper missing."
fi

if [[ -s "$PROFILE" ]]; then
  ok "Network profile present."
else
  cf "Network profile missing."
fi

if [[ -x "$PROFILE_TOOL" && -s "$PROFILE" ]] && "$PROFILE_TOOL" validate "$PROFILE" >/dev/null 2>&1; then
  PROFILE_VALID=1
  ok "Network profile validates."
  mapfile -t META < <(profile_meta)
  WAN_MODE="${META[0]:-}"
  WAN_EXPECTED="${META[1]:-}"
  WAN_GATEWAY_EXPECTED="${META[2]:-}"
  LAN_MODE="${META[3]:-}"
  LAN_EXPECTED="${META[4]:-}"
else
  cf "Network profile validation failed."
fi

if netplan generate >/dev/null 2>&1; then
  ok "Netplan generates successfully."
else
  cf "Netplan generation failed."
fi

# Give systemd-networkd a bounded opportunity to obtain DHCP leases and create VLANs
# only when at least one physical Ethernet link is present. USB-C offline preload
# must not spend the full DHCP wait window on unplugged interfaces.
WAN_LINK=0
LAN_LINK=0
carrier "$WAN" && WAN_LINK=1
carrier "$LAN" && LAN_LINK=1

if (( WAN_LINK || LAN_LINK )) && command -v networkctl >/dev/null 2>&1; then
  networkctl reconfigure "$WAN" >/dev/null 2>&1 || true
  networkctl reconfigure "$LAN" >/dev/null 2>&1 || true
  [[ "$WAN_MODE" == "dhcp" && $WAN_LINK -eq 1 ]] && networkctl renew "$WAN" >/dev/null 2>&1 || true
  [[ "$LAN_MODE" == "dhcp" && $LAN_LINK -eq 1 ]] && networkctl renew "$LAN" >/dev/null 2>&1 || true
  if (( PROFILE_VALID && LAN_LINK )); then
    while IFS='|' read -r vid vmode vaddr; do
      [[ -n "$vid" ]] || continue
      [[ "$vmode" == "dhcp" ]] && networkctl renew "vlan${vid}" >/dev/null 2>&1 || true
    done < <(profile_vlans)
  fi
fi

ready_now() {
  # This helper is only for a connected runtime. Offline USB-C preload does not
  # need to become "ready" before the configuration can be accepted. WAN must be
  # connected for a Phase-2-ready runtime; eth1 is required only when the profile
  # actually uses the LAN/trunk side.
  (( WAN_LINK )) || return 1
  if [[ "$LAN_MODE" != "unused" ]]; then
    (( LAN_LINK )) || return 1
  fi
  [[ -n "$(ip4 "$WAN")" ]] || return 1
  mapfile -t defaults < <(ip -4 route show default 2>/dev/null)
  [[ ${#defaults[@]} -eq 1 && "$(default_iface)" == "$WAN" ]] || return 1

  if (( PROFILE_VALID )); then
    if [[ "$LAN_MODE" == "dhcp" || "$LAN_MODE" == "static" ]]; then
      [[ -n "$(ip4 "$LAN")" ]] || return 1
      [[ "$LAN_MODE" != "static" || "$(ip4 "$LAN")" == "$LAN_EXPECTED" ]] || return 1
    fi
    while IFS='|' read -r vid vmode vaddr; do
      [[ -n "$vid" ]] || continue
      local vname="vlan${vid}"
      ip link show "$vname" >/dev/null 2>&1 || return 1
      [[ -n "$(ip4 "$vname")" ]] || return 1
      [[ "$vmode" != "static" || "$(ip4 "$vname")" == "$vaddr" ]] || return 1
    done < <(profile_vlans)
  fi
  return 0
}

if (( WAN_LINK || LAN_LINK )); then
  attempts=$(( (WAIT_SECONDS + 1) / 2 ))
  (( attempts < 1 )) && attempts=1
  for ((i=1; i<=attempts; i++)); do
    ready_now && break
    (( i < attempts )) && sleep 2
  done
else
  pend "No Ethernet carrier detected; DHCP/live-connectivity wait skipped for USB-C offline preload."
fi

ip link show "$WAN" >/dev/null 2>&1 && ok "WAN eth0 exists." || cf "WAN eth0 missing."
ip link show "$LAN" >/dev/null 2>&1 && ok "LAN eth1 exists." || cf "LAN eth1 missing."
if (( WAN_LINK )); then
  ok "WAN eth0 carrier UP."
else
  pend "WAN eth0 carrier DOWN; configuration retained for offline USB-C preload."
fi
if [[ "$LAN_MODE" == "unused" ]]; then
  ok "LAN eth1 is explicitly UNUSED by profile; physical carrier is not required."
elif (( LAN_LINK )); then
  ok "LAN eth1 carrier UP."
else
  pend "LAN eth1 carrier DOWN; configuration retained for offline USB-C preload."
fi

wan_addr="$(ip4 "$WAN")"
if (( WAN_LINK )); then
  if [[ -n "$wan_addr" ]]; then
    ok "WAN eth0 IPv4 ${wan_addr}."
  elif [[ "$WAN_MODE" == "dhcp" ]]; then
    xf "WAN eth0 has carrier but DHCP has not supplied an IPv4 address."
  else
    cf "WAN eth0 has carrier but no IPv4 address after static configuration apply."
  fi
  if [[ "$WAN_MODE" == "static" && -n "$WAN_EXPECTED" && -n "$wan_addr" && "$wan_addr" != "$WAN_EXPECTED" ]]; then
    cf "WAN eth0 IPv4 ${wan_addr}; expected ${WAN_EXPECTED}."
  fi
else
  [[ -n "$wan_addr" ]] && ok "WAN eth0 currently retains IPv4 ${wan_addr} while link is down." || pend "WAN eth0 active IPv4 is pending physical link."
fi

mapfile -t DEFAULTS < <(ip -4 route show default 2>/dev/null)
if (( WAN_LINK )); then
  if [[ ${#DEFAULTS[@]} -eq 1 ]]; then
    ok "Exactly one IPv4 default route is installed."
  elif [[ "$WAN_MODE" == "dhcp" ]]; then
    xf "Expected one IPv4 default route after WAN DHCP; found ${#DEFAULTS[@]}."
  else
    cf "Expected exactly one IPv4 default route after static WAN apply; found ${#DEFAULTS[@]}."
  fi

  if [[ "$(default_iface)" == "$WAN" ]]; then
    ok "Default route uses WAN eth0."
  elif [[ "$WAN_MODE" == "dhcp" && ${#DEFAULTS[@]} -eq 0 ]]; then
    xf "WAN DHCP default route is not yet available."
  else
    cf "Default route does not use WAN eth0."
  fi
else
  if [[ ${#DEFAULTS[@]} -eq 0 ]]; then
    pend "WAN default route is pending physical link."
  elif [[ ${#DEFAULTS[@]} -eq 1 && "$(default_iface)" == "$WAN" ]]; then
    ok "Stored/live default route remains on WAN eth0 while link is down."
  else
    cf "Offline state contains an invalid default-route configuration."
  fi
fi

if ip -4 route show default 2>/dev/null | grep -Eq ' dev (eth1|vlan[0-9]+)( |$)'; then
  cf "LAN eth1 or an eth1 VLAN has a prohibited default route."
else
  ok "LAN eth1 and LAN VLANs have no default route."
fi

if [[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 1)" == "0" ]]; then
  ok "IPv4 forwarding disabled; collector is not routing WAN to LAN."
else
  cf "IPv4 forwarding enabled."
fi

if (( PROFILE_VALID )); then
  if [[ "$WAN_MODE" == "static" && -n "$WAN_GATEWAY_EXPECTED" ]]; then
    actual_gateway="$(default_gateway "$WAN")"
    if (( WAN_LINK )); then
      [[ "$actual_gateway" == "$WAN_GATEWAY_EXPECTED" ]] && \
        ok "WAN gateway ${actual_gateway} matches profile." || \
        cf "WAN gateway ${actual_gateway:-none}; expected ${WAN_GATEWAY_EXPECTED}."
    elif [[ -n "$actual_gateway" && "$actual_gateway" != "$WAN_GATEWAY_EXPECTED" ]]; then
      cf "Stored/live WAN gateway ${actual_gateway}; expected ${WAN_GATEWAY_EXPECTED}."
    else
      pend "WAN gateway activation is pending physical link."
    fi
  fi

  if [[ "$LAN_MODE" == "unused" ]]; then
    ok "LAN eth1 is intentionally unused; no IPv4 address, carrier, or VLAN path is required."
  elif [[ "$LAN_MODE" == "none" ]]; then
    ok "LAN eth1 is configured as an unnumbered VLAN trunk parent."
  elif [[ "$LAN_MODE" == "dhcp" || "$LAN_MODE" == "static" ]]; then
    lan_addr="$(ip4 "$LAN")"
    if (( LAN_LINK )); then
      if [[ -n "$lan_addr" ]]; then
        ok "LAN eth1 IPv4 ${lan_addr}."
      elif [[ "$LAN_MODE" == "dhcp" ]]; then
        xf "LAN eth1 has carrier but DHCP has not supplied an IPv4 address."
      else
        cf "LAN eth1 has carrier but no IPv4 address after static configuration apply."
      fi
      if [[ "$LAN_MODE" == "static" && -n "$LAN_EXPECTED" && -n "$lan_addr" && "$lan_addr" != "$LAN_EXPECTED" ]]; then
        cf "LAN eth1 IPv4 ${lan_addr}; expected ${LAN_EXPECTED}."
      fi
    else
      [[ -n "$lan_addr" ]] && ok "LAN eth1 currently retains IPv4 ${lan_addr} while link is down." || pend "LAN eth1 active IPv4 is pending physical link."
    fi
  fi

  while IFS='|' read -r vid vmode vexpected; do
    [[ -n "$vid" ]] || continue
    vname="vlan${vid}"
    if vlan_details="$(ip -d link show "$vname" 2>/dev/null)" &&
       grep -Eq "^[0-9]+: ${vname}@${LAN}:" <<<"$vlan_details" &&
       grep -Eq "vlan protocol 802\\.1Q id ${vid}( |$)" <<<"$vlan_details"; then
      ok "${vname} VLAN ID ${vid} is defined on LAN eth1."
    elif (( LAN_LINK )); then
      cf "${vname} missing or has the wrong parent interface or 802.1Q VLAN ID."
    else
      pend "${vname} live interface activation is pending LAN eth1 physical link."
    fi
    vaddr="$(ip4 "$vname")"
    if (( LAN_LINK )); then
      if [[ -n "$vaddr" ]]; then
        ok "${vname} IPv4 ${vaddr}."
      elif [[ "$vmode" == "dhcp" ]]; then
        xf "${vname} has carrier path but DHCP has not supplied an IPv4 address."
      else
        cf "${vname} has no IPv4 address after static configuration apply."
      fi
      if [[ "$vmode" == "static" && -n "$vexpected" && -n "$vaddr" && "$vaddr" != "$vexpected" ]]; then
        cf "${vname} IPv4 ${vaddr}; expected ${vexpected}."
      fi
    else
      [[ -n "$vaddr" ]] && ok "${vname} currently retains IPv4 ${vaddr} while LAN link is down." || pend "${vname} active IPv4 is pending LAN eth1 physical link."
    fi
  done < <(profile_vlans)
fi

# WAN/cloud checks are meaningful only when WAN has a physical link, an active
# IPv4 address and the expected WAN default route. Offline preload records these
# checks as PENDING instead of converting an unplugged cable into configuration failure.
WAN_RUNTIME_READY=0
if (( WAN_LINK )) && [[ -n "$(ip4 "$WAN")" && "$(default_iface)" == "$WAN" ]]; then
  WAN_RUNTIME_READY=1
fi

if (( WAN_RUNTIME_READY )); then
  getent ahostsv4 api.snapcraft.io >/dev/null 2>&1 && ok "WAN DNS resolves api.snapcraft.io." || xf "WAN DNS cannot resolve api.snapcraft.io."
  getent ahostsv4 portal.domotz.com >/dev/null 2>&1 && ok "WAN DNS resolves portal.domotz.com." || xf "WAN DNS cannot resolve portal.domotz.com."
  tcp_open portal.domotz.com 443 && ok "Domotz TCP 443 reachable through WAN." || xf "Domotz TCP 443 unreachable through WAN."
  tcp_open messaging-us-east-1-cell-1.domotz.com 5671 && ok "Domotz TCP 5671 reachable through WAN." || xf "Domotz TCP 5671 unreachable through WAN."
else
  pend "WAN DNS/Domotz connectivity checks deferred until eth0 has carrier, IPv4 and the WAN default route."
fi

configuration_result="PASS"
connectivity_result="PASS"
result="PASS"
failure_category="NONE"
if (( ${#CONFIG_FAILS[@]} > 0 )); then
  configuration_result="FAIL"
  result="FAIL"
  failure_category="CONFIGURATION"
fi
if (( ${#CONNECT_FAILS[@]} > 0 )); then
  connectivity_result="FAIL"
  result="FAIL"
  if [[ "$failure_category" == "CONFIGURATION" ]]; then
    failure_category="BOTH"
  else
    failure_category="CONNECTIVITY"
  fi
elif (( ${#PENDING[@]} > 0 )); then
  connectivity_result="PENDING"
  if [[ "$configuration_result" == "PASS" ]]; then
    result="PENDING"
    failure_category="PENDING"
  fi
fi

{
  echo "result=${result}"
  echo "revision=${REVISION}"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "configuration_result=${configuration_result}"
  echo "connectivity_result=${connectivity_result}"
  echo "failure_category=${failure_category}"
  echo "pending_checks=${#PENDING[@]}"
  echo "wan_interface=${WAN}"
  echo "wan_carrier=$(carrier "$WAN" && echo UP || echo DOWN)"
  echo "wan_ipv4=$(ip4 "$WAN")"
  echo "wan_gateway=$(default_gateway "$WAN")"
  echo "default_route_interface=$(default_iface)"
  echo "lan_interface=${LAN}"
  echo "lan_carrier=$(carrier "$LAN" && echo UP || echo DOWN)"
  echo "lan_ipv4=$(ip4 "$LAN")"
  echo "ip_forward=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || true)"
  echo
  echo "CONFIGURATION_FAILURES:"
  if (( ${#CONFIG_FAILS[@]} > 0 )); then printf -- '- %s\n' "${CONFIG_FAILS[@]}"; else echo '- none'; fi
  echo
  echo "CONNECTIVITY_FAILURES:"
  if (( ${#CONNECT_FAILS[@]} > 0 )); then printf -- '- %s\n' "${CONNECT_FAILS[@]}"; else echo '- none'; fi
  echo
  echo "PENDING_CHECKS:"
  if (( ${#PENDING[@]} > 0 )); then printf -- '- %s\n' "${PENDING[@]}"; else echo '- none'; fi
} > "$RESULT" || exit 1
chmod 640 "$RESULT" || exit 1

[[ "$configuration_result" == "FAIL" ]] && exit 10
[[ "$connectivity_result" == "FAIL" ]] && exit 20
[[ "$connectivity_result" == "PENDING" ]] && exit 30
exit 0
NETVALIDATOR
  chmod 750 "${NETWORK_VALIDATOR}"
  chown root:root "${NETWORK_VALIDATOR}"
}

backup_network_transaction_main() {
  local reason="${1:-engineering_setup}" txid txdir

  # Always create a transaction, even on a new factory unit where the prior
  # Solutionz Netplan/profile are absent. The absent markers make a failed
  # commit reversible without guessing whether files existed before Setup.
  install -d -m 750 "${NETWORK_TRANSACTION_DIR}"
  txid="$(date -u +%Y%m%dT%H%M%SZ)-setup-$$-$(date +%N)"
  txdir="${NETWORK_TRANSACTION_DIR}/${txid}"
  install -d -m 700 "${txdir}"

  if [[ -f "${NETPLAN_FILE}" ]]; then
    cp -a "${NETPLAN_FILE}" "${txdir}/netplan.yaml"
  else
    : > "${txdir}/netplan.absent"
  fi
  if [[ -f "${NETWORK_PROFILE_FILE}" ]]; then
    cp -a "${NETWORK_PROFILE_FILE}" "${txdir}/profile.json"
  else
    : > "${txdir}/profile.absent"
  fi

  {
    echo "transaction_id=${txid}"
    echo "revision=${REVISION}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "reason=${reason}"
    echo "source=engineering_setup"
    echo "setup_context=${SETUP_CONTEXT}"
  } > "${txdir}/metadata"

  (
    cd "${txdir}"
    sha256sum netplan.* profile.* > manifest.sha256
  )
  chmod 600 "${txdir}"/* 2>/dev/null || true
  SETUP_NETWORK_TRANSACTION="${txdir}"
  progress_message "Saved previous network configuration as transaction ${txid}."
}

verify_network_transaction_main() {
  local tx="$1"
  [[ -d "${tx}" && -f "${tx}/manifest.sha256" ]] || return 1
  [[ -f "${tx}/netplan.yaml" || -f "${tx}/netplan.absent" ]] || return 1
  [[ -f "${tx}/profile.json" || -f "${tx}/profile.absent" ]] || return 1
  if [[ -s "${tx}/manifest.sha256" ]]; then
    (cd "${tx}" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || return 1
  fi
}

restore_network_transaction_main() {
  local tx="$1"
  [[ -n "${tx}" ]] || return 0
  verify_network_transaction_main "${tx}" || return 1
  if [[ -f "${tx}/netplan.yaml" ]]; then cp -a "${tx}/netplan.yaml" "${NETPLAN_FILE}"; else rm -f "${NETPLAN_FILE}"; fi
  if [[ -f "${tx}/profile.json" ]]; then cp -a "${tx}/profile.json" "${NETWORK_PROFILE_FILE}"; else rm -f "${NETWORK_PROFILE_FILE}"; fi
}

prepare_production_network_candidate() {
  install_network_profile_tool
  install_live_network_discovery_tool
  install_network_validator

  CANDIDATE_DIR="$(mktemp -d /tmp/solutionz-rmm-network-candidate.XXXXXX)"
  CANDIDATE_PROFILE="${CANDIDATE_DIR}/network-profile.json"
  CANDIDATE_NETPLAN="${CANDIDATE_DIR}/00-installer-config.yaml"
  CANDIDATE_RESULT="${CANDIDATE_DIR}/network-profile.result"

  if [[ -n "${NETWORK_PROFILE_SOURCE}" ]]; then
    [[ -r "${NETWORK_PROFILE_SOURCE}" ]] || error_exit "Network profile is not readable: ${NETWORK_PROFILE_SOURCE}"
    cp -f "${NETWORK_PROFILE_SOURCE}" "${CANDIDATE_PROFILE}"
    progress_message "Validating supplied dual-homed WAN/LAN network profile before commit: ${NETWORK_PROFILE_SOURCE}"
  elif (( PRESERVE_EXISTING_NETWORK_PROFILE )) && [[ -s "${NETWORK_PROFILE_FILE}" ]]; then
    "${NETWORK_PROFILE_TOOL}" validate "${NETWORK_PROFILE_FILE}" >/dev/null 2>&1 || \
      error_exit "Existing network profile is present but invalid; preserve mode refuses to replace it. Supply --network-profile <json> or repair ${NETWORK_PROFILE_FILE}."
    cp -f "${NETWORK_PROFILE_FILE}" "${CANDIDATE_PROFILE}"
    progress_message "Preserve-existing mode: staging the current valid customer network profile without altering its values."
  else
    write_default_network_profile "${CANDIDATE_PROFILE}"
    progress_message "Preparing default WAN eth0 DHCP + LAN eth1 DHCP profile in staging before commit."
  fi
  chmod 600 "${CANDIDATE_PROFILE}"

  "${NETWORK_PROFILE_TOOL}" validate "${CANDIDATE_PROFILE}" >/dev/null ||     error_exit "Candidate WAN/LAN/VLAN profile validation failed; active network configuration was not changed."
  "${NETWORK_PROFILE_TOOL}" render "${CANDIDATE_PROFILE}" "${CANDIDATE_NETPLAN}" "${CANDIDATE_RESULT}" ||     error_exit "Candidate WAN/LAN/VLAN profile rendering failed; active network configuration was not changed."
  chmod 600 "${CANDIDATE_NETPLAN}"
  chmod 640 "${CANDIDATE_RESULT}"

  # Validate the rendered candidate with Netplan in an isolated temporary root
  # when supported. The real /etc/netplan tree is not touched by this check.
  local candidate_root
  candidate_root="${CANDIDATE_DIR}/root"
  install -d -m 700 "${candidate_root}/etc/netplan"
  cp -a "${CANDIDATE_NETPLAN}" "${candidate_root}/etc/netplan/00-installer-config.yaml"
  if netplan generate --help 2>&1 | grep -q -- '--root-dir'; then
    netplan generate --root-dir "${candidate_root}" >/dev/null 2>&1 ||       error_exit "Candidate Netplan generation failed in staging; active network configuration was not changed."
    progress_message "Candidate profile and Netplan passed isolated pre-commit validation."
  else
    warning_message "Installed Netplan does not advertise --root-dir; candidate profile/render validation passed and final netplan generate will run immediately after commit."
  fi
}

archive_conflicting_netplans_main() {
  local f base archive_id archive_dir found=0 netplan_dir
  netplan_dir="$(dirname "${NETPLAN_FILE}")"
  shopt -s nullglob
  local files=("${netplan_dir}"/*.yaml "${netplan_dir}"/*.yml)
  shopt -u nullglob

  for f in "${files[@]}"; do
    [[ "${f}" == "${NETPLAN_FILE}" ]] && continue
    found=1
    break
  done
  (( found )) || { SETUP_NETPLAN_ARCHIVE=""; return 0; }

  install -d -m 750 "${NETPLAN_ARCHIVE_DIR}"
  archive_id="$(date -u +%Y%m%dT%H%M%SZ)-setup-$$-$(date +%N)"
  archive_dir="${NETPLAN_ARCHIVE_DIR}/${archive_id}"
  install -d -m 700 "${archive_dir}"

  {
    echo "archive_id=${archive_id}"
    echo "revision=${REVISION}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "setup_context=${SETUP_CONTEXT}"
    echo "reason=remove_conflicting_netplan_files_before_solutionz_commit"
  } > "${archive_dir}/metadata"
  : > "${archive_dir}/manifest.sha256"

  for f in "${files[@]}"; do
    [[ "${f}" == "${NETPLAN_FILE}" ]] && continue
    [[ -e "${f}" || -L "${f}" ]] || continue
    base="$(basename "${f}")"
    sha256sum "${f}" | awk -v b="${base}" '{print $1 "  " b}' >> "${archive_dir}/manifest.sha256" 2>/dev/null || true
    mv "${f}" "${archive_dir}/${base}"
    progress_message "Archived conflicting Netplan file for ${SETUP_CONTEXT}: ${f}"
  done
  chmod 600 "${archive_dir}"/* 2>/dev/null || true
  SETUP_NETPLAN_ARCHIVE="${archive_dir}"
  progress_message "Conflicting Netplan files archived at ${archive_dir}; the Solutionz Netplan will be the active /etc/netplan configuration."
}

restore_archived_netplans_main() {
  local archive_dir="${1:-${SETUP_NETPLAN_ARCHIVE:-}}" f netplan_dir
  [[ -n "${archive_dir}" && -d "${archive_dir}" ]] || return 0
  netplan_dir="$(dirname "${NETPLAN_FILE}")"
  install -d -m 755 "${netplan_dir}"
  shopt -s nullglob
  for f in "${archive_dir}"/*.yaml "${archive_dir}"/*.yml; do
    [[ -e "${f}" || -L "${f}" ]] || continue
    mv "${f}" "${netplan_dir}/$(basename "${f}")"
  done
  shopt -u nullglob
}

commit_production_network_candidate() {
  install -d -m 750 "${NETWORK_PROFILE_DIR}"
  cp -f "${CANDIDATE_PROFILE}" "${NETWORK_PROFILE_FILE}"
  cp -f "${CANDIDATE_NETPLAN}" "${NETPLAN_FILE}"
  cp -f "${CANDIDATE_RESULT}" "${NETWORK_PROFILE_RESULT_FILE}"
  chmod 600 "${NETWORK_PROFILE_FILE}" "${NETPLAN_FILE}"
  chmod 640 "${NETWORK_PROFILE_RESULT_FILE}"
}

stage_network_config() {
  step_message 10 "Stage dual-homed WAN eth0 / LAN eth1 networking"
  local network_lock_fd
  install -d -m 755 "$(dirname "${NETWORK_LOCK_FILE}")"
  exec {network_lock_fd}>"${NETWORK_LOCK_FILE}"
  if ! flock -n "${network_lock_fd}"; then
    error_exit "Network configuration is already being modified by another Setup/USB-C/SSH session."
  fi

  # Factory mass production and refurbishment use the same candidate-first rule:
  # never replace the active profile/Netplan until the proposed configuration has
  # successfully validated and rendered in a temporary staging area.
  prepare_production_network_candidate

  if (( PREEXISTING_SOLUTIONZ_INSTALL )); then
    backup_network_transaction_main "refurbish_or_manual_setup_reset"
  else
    backup_network_transaction_main "factory_setup_existing_network_safeguard"
  fi

  # Recycled/older units may contain additional Netplan YAML. Archive any file
  # other than the Solutionz-controlled canonical file before committing the new
  # build. Fresh factory units normally have only the manufacturer/cloud-init
  # baseline; archiving remains harmless and auditable if such files are present.
  archive_conflicting_netplans_main
  commit_production_network_candidate

  mkdir -p /etc/cloud/cloud.cfg.d
  cat > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg <<'EOF'
network: {config: disabled}
EOF
  cat > "${IP_FORWARD_SYSCTL_FILE}" <<'EOF'
# Solutionz RMM SOC2-V07111226 - dual-homed collector, not a router.
net.ipv4.ip_forward=0
EOF
  chmod 644 "${IP_FORWARD_SYSCTL_FILE}"; sysctl -w net.ipv4.ip_forward=0 >/dev/null

  if ! netplan generate; then
    warning_message "Committed candidate failed final Netplan generation; restoring the pre-Setup network state."
    restore_network_transaction_main "${SETUP_NETWORK_TRANSACTION}" || true
    restore_archived_netplans_main "${SETUP_NETPLAN_ARCHIVE}" || true
    rm -rf "${CANDIDATE_DIR}" 2>/dev/null || true
    flock -u "${network_lock_fd}" || true
    eval "exec ${network_lock_fd}>&-" || true
    error_exit "Final Netplan generation failed after commit; previous network state was restored where available."
  fi

  rm -rf "${CANDIDATE_DIR}" 2>/dev/null || true
  CANDIDATE_DIR=""; CANDIDATE_PROFILE=""; CANDIDATE_NETPLAN=""; CANDIDATE_RESULT=""
  flock -u "${network_lock_fd}" || true
  eval "exec ${network_lock_fd}>&-" || true
  progress_message "Network staging complete for ${SETUP_CONTEXT}: candidate validated before commit, conflicting Netplan files archived, and final Netplan generation passed."
}

repair_resolv_conf() {
  step_message 11 "Repair and validate DNS resolver"

  systemctl enable --now systemd-resolved

  if [[ -L "${RESOLV_FILE}" ]]; then
    local current_target
    current_target="$(readlink -f "${RESOLV_FILE}" || true)"
    if [[ "${current_target}" != "${RESOLV_TARGET}" ]]; then
      rm -f "${RESOLV_FILE}"
      ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
    fi
  else
    rm -f "${RESOLV_FILE}"
    ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
  fi

  [[ "$(readlink -f "${RESOLV_FILE}")" == "${RESOLV_TARGET}" ]] || \
    error_exit "${RESOLV_FILE} does not resolve to ${RESOLV_TARGET}."

  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS validation failed: api.snapcraft.io did not return an IPv4 address."
  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS validation failed: archive.ubuntu.com did not return an IPv4 address."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS validation failed: security.ubuntu.com did not return an IPv4 address."

  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl query api.snapcraft.io >/dev/null 2>&1 || error_exit "systemd-resolved query failed for api.snapcraft.io."
  fi

  ls -l "${RESOLV_FILE}"
  progress_message "True DNS validation passed using configured system resolver."
}

normalize_host_entries() {
  step_message 12 "Normalize Solutionz hostname entries"

  local tmp
  tmp="$(mktemp)"
  awk '
    $0 !~ /(^|[[:space:]])solzrmm([[:space:]]|$)/ &&
    $0 !~ /(^|[[:space:]])solz-rmm([[:space:]]|$)/ {print}
  ' /etc/hosts > "${tmp}"

  printf '127.0.1.1\tsolz-rmm solzrmm\n' >> "${tmp}"
  cat "${tmp}" > /etc/hosts
  rm -f "${tmp}"

  grep -qxF $'127.0.1.1\tsolz-rmm solzrmm' /etc/hosts || \
    error_exit "Unable to normalize Solutionz hostname entry."
}

grub_get_value() {
  local variable="$1"
  local line
  line="$(grep -E "^${variable}=" "${GRUB_FILE}" | head -n1 || true)"
  line="${line#*=}"
  line="${line#\"}"
  line="${line%\"}"
  printf '%s' "${line}"
}

grub_set_value() {
  local variable="$1"
  local value="$2"

  if grep -qE "^${variable}=" "${GRUB_FILE}"; then
    sed -i -E "s|^${variable}=.*|${variable}=\"${value}\"|" "${GRUB_FILE}"
  else
    printf '%s="%s"\n' "${variable}" "${value}" >> "${GRUB_FILE}"
  fi
}

append_grub_param() {
  local variable="$1"
  local param="$2"
  local value
  value="$(grub_get_value "${variable}")"

  if [[ " ${value} " == *" ${param} "* ]]; then
    progress_message "${variable} already contains ${param}."
    return 0
  fi

  value="${value:+${value} }${param}"
  grub_set_value "${variable}" "${value}"
  progress_message "Added ${param} to ${variable}."
}

configure_grub_and_serial() {
  step_message 13 "Configure interface naming and V1210 USB-C COM console"

  cp -a "${GRUB_FILE}" "${GRUB_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"

  append_grub_param "GRUB_CMDLINE_LINUX" "net.ifnames=0"
  append_grub_param "GRUB_CMDLINE_LINUX" "biosdevname=0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=tty0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=ttyS0,115200n8"

  [[ -c "${SERIAL_DEVICE}" ]] || error_exit "${SERIAL_DEVICE} is not present."

  mkdir -p "${SERIAL_DROPIN_DIR}"
  cat > "${SERIAL_DROPIN_FILE}" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -- \\u' --keep-baud 115200,57600,38400,9600 ttyS0 vt220
EOF

  systemctl daemon-reload
  systemctl enable --now "${SERIAL_SERVICE}"
  systemctl is-enabled "${SERIAL_SERVICE}" >/dev/null 2>&1 || \
    error_exit "${SERIAL_SERVICE} is not enabled."
  systemctl is-active "${SERIAL_SERVICE}" >/dev/null 2>&1 || \
    error_exit "${SERIAL_SERVICE} is not active."

  # The systemd unit state is authoritative for the serial-console acceptance
  # check. An agetty process may be transient or respawn around login/session
  # changes, so pgrep is diagnostic only and must not fail the production build.
  if pgrep -a agetty 2>/dev/null | grep -q 'ttyS0'; then
    progress_message "agetty process currently visible on ttyS0."
  else
    warning_message "No persistent agetty process is currently visible on ttyS0; ${SERIAL_SERVICE} is enabled/active and remains the authoritative check."
  fi

  update-grub
  progress_message "V1210 USB-C COM console configured for 115200 8N1."
}

install_domotz_activation_helper() {
  progress_message "Installing controlled Domotz activation/deployment helper."
  install -d -m 755 /usr/local/sbin
  install -d -m 750 /etc/solutionz-rmm
  install -d -m 750 /var/lib/solutionz-domotz-activation

  if [[ -n "${DOMOTZ_COLLECTOR_ACTIVATION_KEY}" ]]; then
    local domotz_defaults_input
    umask 077
    domotz_defaults_input="$(mktemp /tmp/solutionz-domotz-defaults.XXXXXX)"
    printf '%s\n%s\n%s\n' \
      "${DOMOTZ_PUBLIC_ENDPOINT}" \
      "${DOMOTZ_COLLECTOR_ACTIVATION_KEY_NAME}" \
      "${DOMOTZ_COLLECTOR_ACTIVATION_KEY}" > "${domotz_defaults_input}"
    python3 - "${DOMOTZ_PROVISIONING_DEFAULTS}" "${domotz_defaults_input}" <<'PYDEFAULTS'
import json, os, sys, tempfile
p=sys.argv[1]; src=sys.argv[2]
with open(src,encoding='utf-8') as f:
    endpoint=f.readline().rstrip('\n'); key_name=f.readline().rstrip('\n'); key=f.readline().rstrip('\n')
d={'schema_version':1,'endpoint':endpoint,'activation_key_name':key_name,'activation_key':key}
os.makedirs(os.path.dirname(p),exist_ok=True)
fd,tmp=tempfile.mkstemp(prefix='.'+os.path.basename(p)+'.',dir=os.path.dirname(p))
with os.fdopen(fd,'w',encoding='utf-8') as f:
    json.dump(d,f,indent=2,sort_keys=True); f.write('\n'); f.flush(); os.fsync(f.fileno())
os.chmod(tmp,0o600); os.replace(tmp,p)
PYDEFAULTS
    rm -f "${domotz_defaults_input}"
    chown root:root "${DOMOTZ_PROVISIONING_DEFAULTS}"
    chmod 600 "${DOMOTZ_PROVISIONING_DEFAULTS}"
    progress_message "Domotz deployment credential staged root-only (${DOMOTZ_COLLECTOR_ACTIVATION_KEY_NAME}); secret value not logged."
  else
    rm -f "${DOMOTZ_PROVISIONING_DEFAULTS}"
    info_message "No embedded Domotz activation key is present; registration can use an Engineering-entered key or a build-time SOLUTIONZ_RMM_DOMOTZ_ACTIVATION_KEY override."
  fi

  cat > "${DOMOTZ_ACTIVATION_TOOL}" <<'PYACT'
#!/usr/bin/env python3
import argparse, fcntl, getpass, json, os, socket, sys, tempfile, time, urllib.parse, urllib.request
from pathlib import Path

CONFIG=Path('/etc/solutionz-rmm/domotz-activation.json')
RESULT=Path('/var/lib/solutionz-domotz-activation/result.json')
STATE=Path('/var/lib/rswsolutionz-rmm/install.state')
DEFAULTS=Path('/etc/solutionz-rmm/domotz-provisioning-defaults.json')
LOCAL_STATUS='http://127.0.0.1:3000/api/v1/status'
LOCAL_ACTIVATE='http://127.0.0.1:3000/api/v1/agent'
US_API_HOST='api-us-east-1-cell-1.domotz.com'
MIN_VERSION=(3,9,3)

def atomic_json(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.', dir=str(path.parent))
    try:
        with os.fdopen(fd,'w',encoding='utf-8') as f:
            json.dump(data,f,indent=2,sort_keys=True); f.write('\n'); f.flush(); os.fsync(f.fileno())
        os.chmod(tmp,mode); os.replace(tmp,path)
    finally:
        try: os.unlink(tmp)
        except FileNotFoundError: pass

def load_config(require_key=True):
    try: data=json.loads(CONFIG.read_text(encoding='utf-8'))
    except FileNotFoundError: raise RuntimeError('Domotz activation configuration is not staged.')
    except Exception as e: raise RuntimeError(f'Invalid activation configuration: {e}')
    name=str(data.get('name','')).strip(); endpoint=str(data.get('endpoint','')).strip(); key=str(data.get('activation_key','')).strip()
    deny=data.get('deny_all_interfaces',False); enabled=data.get('enabled',False)
    if not name: raise RuntimeError('Collector name is missing.')
    u=urllib.parse.urlparse(endpoint)
    if u.scheme!='https' or u.hostname!=US_API_HOST: raise RuntimeError(f'Endpoint must use the Solutionz US Domotz API host {US_API_HOST}.')
    if require_key and not key: raise RuntimeError('Collector activation key is missing. Stage registration settings again if upgrading a previously scrubbed configuration.')
    if not isinstance(deny,bool) or not isinstance(enabled,bool): raise RuntimeError('enabled and deny_all_interfaces must be JSON booleans.')
    return data

def local_status(timeout=10):
    req=urllib.request.Request(LOCAL_STATUS, method='GET')
    with urllib.request.urlopen(req,timeout=timeout) as r:
        return json.loads(r.read().decode('utf-8'))

def version_tuple(value):
    out=[]
    for part in str(value).split('.')[:3]:
        try: out.append(int(''.join(c for c in part if c.isdigit()) or '0'))
        except ValueError: out.append(0)
    return tuple((out+[0,0,0])[:3])

def write_result(status, **extra):
    data={'status':status,'timestamp_utc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime())}
    data.update(extra); atomic_json(RESULT,data,0o640)

def prior_result_status():
    try:
        return str(json.loads(RESULT.read_text(encoding='utf-8')).get('status',''))
    except FileNotFoundError:
        return ''
    except (OSError, ValueError, AttributeError) as e:
        raise RuntimeError('The prior registration result is unreadable. Inspect Collector state before retrying.') from e

def read_provisioning_defaults():
    if not DEFAULTS.exists(): return None
    try: d=json.loads(DEFAULTS.read_text(encoding='utf-8'))
    except Exception as e: raise RuntimeError(f'Invalid Domotz provisioning defaults: {e}')
    if not isinstance(d,dict): raise RuntimeError('Domotz provisioning defaults must be a JSON object.')
    endpoint=str(d.get('endpoint','')).strip(); key=str(d.get('activation_key','')).strip(); key_name=str(d.get('activation_key_name','')).strip()
    u=urllib.parse.urlparse(endpoint)
    if u.scheme!='https' or u.hostname!=US_API_HOST: raise RuntimeError(f'Provisioning endpoint must use {US_API_HOST}.')
    if not key: raise RuntimeError('Domotz provisioning defaults do not contain a Collector Activation Key.')
    return {'endpoint':endpoint,'activation_key':key,'activation_key_name':key_name or 'preconfigured'}

def preflight_new():
    try: st=local_status()
    except Exception as e:
        print(f'Local Domotz status unavailable: {e}',file=sys.stderr); return 75
    mode=str(st.get('mode','')).upper(); version=str(st.get('agent_version',''))
    print(f'Local collector mode: {mode or "unknown"}')
    print(f'Local collector version: {version or "unknown"}')
    if mode != 'RESTRICTED':
        print('ERROR: Collector is already configured/registered; NEW registration is blocked.',file=sys.stderr); return 3
    if version_tuple(version)<MIN_VERSION:
        print(f'ERROR: Domotz agent_version {version or "unknown"} is below required 3.9.3.',file=sys.stderr); return 2
    print('PASS: Collector is RESTRICTED and eligible for NEW registration.')
    return 0

def configure():
    defaults=read_provisioning_defaults()
    default_name=socket.gethostname().strip()
    name=input(f'Collector name [{default_name}]: ' if default_name else 'Collector name: ').strip() or default_name
    if defaults:
        endpoint=defaults['endpoint']; key=defaults['activation_key']
        print(f'Domotz API endpoint: {endpoint} (preconfigured)')
        print(f'Collector Activation Key: PRECONFIGURED ({defaults["activation_key_name"]})')
    else:
        endpoint=input(f'Domotz API endpoint [{"https://"+US_API_HOST+"/public-api/v1/"}]: ').strip() or f'https://{US_API_HOST}/public-api/v1/'
        key=getpass.getpass('Collector activation key: ').strip()
    # Solutionz policy requires discovery enabled for a new collector.
    data={'enabled':False,'name':name,'endpoint':endpoint,'activation_key':key,'deny_all_interfaces':False}
    parsed=urllib.parse.urlparse(endpoint)
    if parsed.scheme!='https' or parsed.hostname!=US_API_HOST or not key or not name:
        raise RuntimeError('Valid U.S. endpoint, Collector name, and activation key are required.')
    atomic_json(CONFIG,data)
    print(f'Activation configuration staged at {CONFIG}; activation remains disabled and network scanning is enabled by Solutionz policy.')

def check():
    d=load_config(False)
    print(json.dumps({'enabled':d.get('enabled',False),'name':d.get('name'),'endpoint':d.get('endpoint'),'activation_key_present':bool(d.get('activation_key')),'deny_all_interfaces':d.get('deny_all_interfaces',False)},indent=2))

def disarm():
    d=load_config(False); d['enabled']=False; atomic_json(CONFIG,d); print('Domotz activation disarmed.')

def preflight_cloud(endpoint):
    host=urllib.parse.urlparse(endpoint).hostname
    with socket.create_connection((host,443),timeout=10): pass

def activate():
    try:
        with STATE.open(encoding='utf-8') as state:
            validated=state.readline().strip() == 'phase2_system_validated'
    except OSError:
        validated=False
    if not validated:
        print('Registration requires a completed Phase 2 system validation.',file=sys.stderr)
        return 1
    with (RESULT.parent / 'submission.lock').open('a') as lock:
        try:
            fcntl.flock(lock,fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('A Domotz registration attempt is already in progress.',file=sys.stderr)
            return 1
        return submit_registration()

def submit_registration():
    d=load_config(True)
    try: st=local_status()
    except Exception as e:
        print(f'Local Domotz status unavailable: {e}',file=sys.stderr); return 75
    mode=str(st.get('mode','')).upper(); version=str(st.get('agent_version',''))
    if mode!='RESTRICTED':
        print(f'Collector mode is {mode or "unknown"}; registration requires RESTRICTED mode.',file=sys.stderr); return 1
    prior=prior_result_status()
    if prior:
        print(f'Activation is paused because durable result status is {prior}; inspect the Domotz portal/local state before any retry.',file=sys.stderr)
        return 1
    if version_tuple(version)<MIN_VERSION:
        print(f'Domotz agent_version {version or "unknown"} is below required 3.9.3.',file=sys.stderr); return 1
    try: preflight_cloud(d['endpoint'])
    except Exception as e:
        print(f'Domotz US API TCP 443 preflight failed: {e}',file=sys.stderr); return 75
    payload=json.dumps({'name':d['name'],'endpoint':d['endpoint'],'deny_all_interfaces':d.get('deny_all_interfaces',False)}).encode()
    write_result('submission_started',name=d['name'])
    req=urllib.request.Request(LOCAL_ACTIVATE,data=payload,headers={'Content-Type':'application/json','x-api-key':d['activation_key']},method='POST')
    try:
        with urllib.request.urlopen(req,timeout=30) as r:
            code=r.status
    except Exception as e:
        write_result('review_required',reason='activation_post_uncertain',error_type=type(e).__name__)
        print('Activation request failed or became uncertain. Verify Collector status before retrying.',file=sys.stderr); return 1
    if not 200 <= code < 300:
        write_result('review_required',reason='activation_http_status',http_status=code); return 1
    for _ in range(24):
        time.sleep(5)
        try: st=local_status()
        except Exception: continue
        mode=str(st.get('mode','')).upper()
        if mode and mode!='RESTRICTED':
            d['enabled']=False; atomic_json(CONFIG,d)
            write_result('registration_verified',mode=mode,name=d['name'],agent_version=st.get('agent_version',''))
            print(f'Domotz registration verified locally; mode={mode}. Activation settings retained.')
            return 0
    write_result('review_required',reason='accepted_but_restricted_after_wait')
    print('Activation POST was accepted but Collector remained RESTRICTED; engineering review required.',file=sys.stderr)
    return 1

def show_status():
    try:
        st=local_status(); print('LOCAL_DOMOTZ_STATUS='+json.dumps(st,sort_keys=True))
    except Exception as e: print(f'LOCAL_DOMOTZ_STATUS_UNAVAILABLE={e}')
    if CONFIG.exists():
        try: check()
        except Exception as e: print(f'ACTIVATION_CONFIG_ERROR={e}')
    else: print('ACTIVATION_CONFIG=not_staged')
    if RESULT.exists(): print('ACTIVATION_RESULT='+RESULT.read_text(encoding='utf-8').strip())
    else: print('ACTIVATION_RESULT=none')

def main():
    ap=argparse.ArgumentParser()
    g=ap.add_mutually_exclusive_group(required=True)
    g.add_argument('--configure',action='store_true'); g.add_argument('--check',action='store_true')
    g.add_argument('--disarm',action='store_true'); g.add_argument('--preflight-new',action='store_true')
    g.add_argument('--attempt',action='store_true'); g.add_argument('--register-now',action='store_true'); g.add_argument('--status',action='store_true')
    a=ap.parse_args()
    try:
        if a.configure: configure(); return 0
        if a.check: check(); return 0
        if a.disarm: disarm(); return 0
        if a.preflight_new: return preflight_new()
        if a.attempt: print('Automatic registration is disabled. Submit explicitly after physical installation.'); return 0
        if a.register_now: return activate()
        if a.status: show_status(); return 0
    except RuntimeError as e:
        print(f'ERROR: {e}',file=sys.stderr); return 2
    return 2
if __name__=='__main__': raise SystemExit(main())
PYACT
  chmod 750 "${DOMOTZ_ACTIVATION_TOOL}"
  chown root:root "${DOMOTZ_ACTIVATION_TOOL}"

  cat > "${DOMOTZ_ACTIVATION_SERVICE}" <<EOF_SERVICE
[Unit]
Description=Solutionz Domotz Collector Activation Attempt
After=network-online.target snapd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${DOMOTZ_ACTIVATION_TOOL} --attempt
SuccessExitStatus=0 75
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/solutionz-domotz-activation /etc/solutionz-rmm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
EOF_SERVICE

  cat > "${DOMOTZ_ACTIVATION_TIMER}" <<'EOF_TIMER'
[Unit]
Description=Solutionz Domotz Collector Activation Retry Timer

[Timer]
OnBootSec=90s
OnUnitInactiveSec=2min
AccuracySec=10s
Unit=solutionz-domotz-activate.service
Persistent=true

[Install]
WantedBy=timers.target
EOF_TIMER
  chmod 644 "${DOMOTZ_ACTIVATION_SERVICE}" "${DOMOTZ_ACTIVATION_TIMER}"
  systemctl daemon-reload
  systemctl disable --now solutionz-domotz-activate.timer >/dev/null 2>&1 || error_exit "Unable to disable the legacy Domotz activation timer."
  systemctl stop solutionz-domotz-activate.service >/dev/null 2>&1 || true
  progress_message "Domotz activation helper installed for explicit registration after physical installation."
}

install_local_serial_config_tool() {
  step_message 14 "Install field WAN/LAN/VLAN configuration utility"
  cat > "${LOCAL_CONFIG_TOOL}" <<'LOCALCFG'
#!/usr/bin/env bash
set -Eeuo pipefail

REVISION="SOC2-V07111226"
NETPLAN="/etc/netplan/00-installer-config.yaml"
PROFILE="/etc/solutionz-rmm/network-profile.json"
TOOL="/usr/local/sbin/solutionz-rmm-network-profile"
VALIDATOR="/usr/local/sbin/solutionz-rmm-network-validate"
LIVE="/usr/local/sbin/solutionz-rmm-live-network-discovery"
LIVE_RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-SOC2-V07111226.result"
POSTVALIDATOR="/usr/local/sbin/rswsolutionz-rmm-postreboot-validate"
RESULT="/var/lib/rswsolutionz-rmm/network-validation-SOC2-V07111226.result"
CHANGE="/var/lib/rswsolutionz-rmm/network-change-SOC2-V07111226.result"
PROFILE_RESULT="/var/lib/rswsolutionz-rmm/network-profile-SOC2-V07111226.result"
POST_RESULT="/var/lib/rswsolutionz-rmm/postreboot-validation-SOC2-V07111226.result"
SECURITY_RESULT="/var/lib/rswsolutionz-rmm/security-validation-SOC2-V07111226.result"
INTEGRITY="/usr/local/sbin/solutionz-rmm-integrity-baseline"
SECURITY_BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-SOC2-V07111226.sha256"
STATE="/var/lib/rswsolutionz-rmm/install.state"
ENGINEERING_USER="solz_eng"
ENGINEERING_GROUP="solutionz-rmm-engineering"
ENGINEERING_PASSWORD_MARKER="/var/lib/rswsolutionz-rmm/engineering-password-provisioned"
ENGINEERING_KEY_FINGERPRINT_FILE="/var/lib/rswsolutionz-rmm/engineering-ssh-key-SOC2-V07111226.fingerprint"
ENGINEERING_KEY_FINGERPRINT_EXPECTED="SHA256:F8aZDgPAP4X7ofp2wjQSed9rWzhs7xcCLMas39JFWa0"
SETUP_CMD="/usr/local/sbin/solutionz-rmm-setup"
ENGINEERING_SHELL="/usr/local/sbin/solutionz-rmm-engineering-shell"
ENGINEERING_PASSWORD_TOOL="/usr/local/sbin/solutionz-rmm-engineering-password"
ACTIVATION_TOOL="/usr/local/sbin/solutionz-domotz-activate"
ACTIVATION_CONFIG="/etc/solutionz-rmm/domotz-activation.json"
ACTIVATION_RESULT="/var/lib/solutionz-domotz-activation/result.json"
ACTIVATION_DEFAULTS="/etc/solutionz-rmm/domotz-provisioning-defaults.json"
TRANSACTION_DIR="/var/lib/rswsolutionz-rmm/network-transactions/field"
# Field Restore reads only this namespace. Engineering/factory Setup transactions
# live under network-transactions/engineering and are never exposed to technicians.
LOCK_FILE="/run/lock/solutionz-rmm-network.lock"
AUTO=0
ENGINEERING_MODE=0
DIRECT_ACTION=""
PRODUCTION_VALIDATION_RESULT="NOT_RUN"
PRE_NETPLAN_SHA256=""
PRE_PROFILE_SHA256=""
CURRENT_TRANSACTION=""
STAGED_NETWORK=""
CHANGE_IN_PROGRESS=0
CALLER_USER="${SUDO_USER:-${USER:-unknown}}"

case "${1:-}" in
  --serial-auto|--restricted-login) AUTO=1 ;;
  --engineering-auto|--engineering-login) ENGINEERING_MODE=1 ;;
  --engineering-tools) ENGINEERING_MODE=1; DIRECT_ACTION="engineering_tools" ;;
  --register-new-domotz) DIRECT_ACTION="register_new_domotz" ;;
  "") ;;
  *) echo "Usage: $(basename "$0") [--serial-auto|--restricted-login|--engineering-auto|--engineering-login|--engineering-tools|--register-new-domotz]"; exit 2 ;;
esac
[[ $# -le 1 ]] || { echo "Usage: $(basename "$0") [--serial-auto|--restricted-login|--engineering-auto|--engineering-login|--engineering-tools|--register-new-domotz]"; exit 2; }
[[ $EUID -eq 0 ]] || { echo "Run with sudo."; exit 1; }

is_engineering_caller() {
  [[ "$CALLER_USER" == "$ENGINEERING_USER" ]] && id -nG "$ENGINEERING_USER" 2>/dev/null | tr ' ' '\n' | grep -qx "$ENGINEERING_GROUP"
}
if is_engineering_caller; then ENGINEERING_MODE=1; fi
if [[ "${ENGINEERING_MODE}" == 1 ]] && ! is_engineering_caller; then
  echo "Engineering mode requires an authenticated ${ENGINEERING_USER} session."
  exit 77
fi

[[ -d "$(dirname "$LOCK_FILE")" ]] || { echo "System lock directory unavailable."; exit 1; }
exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "NETWORK CONFIGURATION BUSY"
  echo "Another Setup, USB-C, or SSH network-configuration session currently owns the configuration lock."
  echo "No network files were changed by this session."
  exit 75
fi

clear_staged_network() {
  [[ -z "$STAGED_NETWORK" ]] || rm -rf -- "$STAGED_NETWORK"
  STAGED_NETWORK=""
}
finish_network_session() {
  if (( CHANGE_IN_PROGRESS )); then
    CHANGE_IN_PROGRESS=0
    if rollback_and_validate; then
      discard_failed_transaction || true
    else
      echo "Interrupted change could not be revalidated. Recovery snapshot retained: $CURRENT_TRANSACTION" >&2
    fi
  fi
  clear_staged_network
}
trap finish_network_session EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

sha_file() { [[ -f "$1" ]] && sha256sum "$1" | awk '{print $1}' || true; }
latest_transaction() { ls -1dt "$TRANSACTION_DIR"/* 2>/dev/null | head -n1 || true; }

create_transaction() {
  local reason="${1:-field_network_change}" txid txdir
  install -d -m 750 "$TRANSACTION_DIR" || return 1
  PRE_NETPLAN_SHA256="$(sha_file "$NETPLAN")"
  PRE_PROFILE_SHA256="$(sha_file "$PROFILE")"
  txid="$(date -u +%Y%m%dT%H%M%SZ)-field-$$-$(date +%N)"
  txdir="$(mktemp -d "$TRANSACTION_DIR/.snapshot.XXXXXX")" || return 1

  if ! (
    if [[ -f "$NETPLAN" ]]; then cp -a "$NETPLAN" "$txdir/netplan.yaml"; else : > "$txdir/netplan.absent"; fi || exit 1
    if [[ -f "$PROFILE" ]]; then cp -a "$PROFILE" "$txdir/profile.json"; else : > "$txdir/profile.absent"; fi || exit 1
    {
      echo "transaction_id=$txid"
      echo "revision=$REVISION"
      echo "timestamp_utc=$(date -u +%FT%TZ)"
      echo "reason=$reason"
      echo "user=${SUDO_USER:-${USER:-unknown}}"
      echo "tty=$(tty 2>/dev/null || echo none)"
      echo "ssh_connection=${SSH_CONNECTION:-none}"
      echo "netplan_sha256=$PRE_NETPLAN_SHA256"
      echo "profile_sha256=$PRE_PROFILE_SHA256"
    } > "$txdir/metadata" || exit 1
    if [[ -f "$PROFILE_RESULT" ]]; then
      cp -a "$PROFILE_RESULT" "$txdir/profile.result" || exit 1
    fi
    cd "$txdir" || exit 1
    sha256sum netplan.* profile.* > manifest.sha256 || exit 1
    chmod 600 ./*
  ); then
    rm -rf -- "$txdir"
    return 1
  fi
  CURRENT_TRANSACTION="$TRANSACTION_DIR/$txid"
  mv -T -- "$txdir" "$CURRENT_TRANSACTION" || { rm -rf -- "$txdir"; CURRENT_TRANSACTION=""; return 1; }
  echo "Saved network transaction: $txid"
}

verify_transaction() {
  local tx="$1"
  [[ -d "$tx" && -f "$tx/manifest.sha256" ]] || return 1
  [[ -f "$tx/netplan.yaml" || -f "$tx/netplan.absent" ]] || return 1
  [[ -f "$tx/profile.json" || -f "$tx/profile.absent" ]] || return 1
  if [[ -s "$tx/manifest.sha256" ]]; then
    (cd "$tx" && sha256sum -c manifest.sha256 >/dev/null 2>&1) || return 1
  fi
  return 0
}

restore_transaction_files() {
  local tx="$1"
  verify_transaction "$tx" || { echo "ERROR - Transaction integrity validation failed: $tx"; return 1; }
  if [[ -f "$tx/netplan.yaml" ]]; then cp -a "$tx/netplan.yaml" "$NETPLAN" || return 1; else rm -f "$NETPLAN" || return 1; fi
  if [[ -f "$tx/profile.json" ]]; then cp -a "$tx/profile.json" "$PROFILE" || return 1; else rm -f "$PROFILE" || return 1; fi
  if [[ -f "$tx/profile.result" ]]; then
    cp -a "$tx/profile.result" "$PROFILE_RESULT" || return 1
  fi
  return 0
}
prechange_integrity_verify() {
  if [[ ! -x "$INTEGRITY" || ! -s "$SECURITY_BASELINE" ]]; then
    echo "SECURITY CHECK FAILED: integrity tool/baseline is missing. Network changes are blocked."
    return 1
  fi
  if ! "$INTEGRITY" --verify >/dev/null 2>&1; then
    echo "SECURITY CHECK FAILED: current appliance integrity does not match the approved baseline."
    echo "Network changes are blocked until RMM Engineering reviews the integrity failure."
    return 1
  fi
  return 0
}
ip4() { ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {print $4}'; }
def() { ip -4 route show default 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}'; }
gw() { ip -4 route show default 2>/dev/null | awk -v i="$1" '$0 ~ (" dev " i "( |$)") {print $3; exit}'; }

active_ssh_iface() {
  local client=""
  if [[ -n "${SSH_CONNECTION:-}" ]]; then client="${SSH_CONNECTION%% *}"; fi
  if [[ -z "$client" && -n "${SSH_CLIENT:-}" ]]; then client="${SSH_CLIENT%% *}"; fi
  [[ -n "$client" ]] || return 0
  ip route get "$client" 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}'
}

guard_change() {
  local scope="$1" sif
  sif="$(active_ssh_iface)"
  [[ -n "$sif" ]] || return 0
  case "$scope" in
    wan) [[ "$sif" == "eth0" ]] || return 0 ;;
    lan) [[ "$sif" == "eth1" || "$sif" == vlan* ]] || return 0 ;;
    all) ;;
  esac
  echo
  echo "NETWORK CHANGE BLOCKED FOR SESSION SAFETY"
  echo "This SSH session is using ${sif}. Changing that network could terminate the session before rollback can complete."
  echo "Use the V1210 USB-C COM console (115200 8N1), or connect through the opposite network when changing only one side."
  return 1
}

change() {
  mkdir -p /var/lib/rswsolutionz-rmm
  {
    echo "result=$1"
    echo "revision=$REVISION"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "user=${SUDO_USER:-${USER:-unknown}}"
    echo "tty=$(tty 2>/dev/null || echo none)"
    echo "ssh_connection=${SSH_CONNECTION:-none}"
    echo "active_session_interface=$(active_ssh_iface)"
    echo "change_type=$2"
    echo "reason=$3"
    echo "wan_ipv4=$(ip4 eth0)"
    echo "wan_gateway=$(gw eth0)"
    echo "default_route_interface=$(def)"
    echo "lan_ipv4=$(ip4 eth1)"
    echo "previous_netplan_sha256=$PRE_NETPLAN_SHA256"
    echo "current_netplan_sha256=$(sha_file "$NETPLAN")"
    echo "previous_profile_sha256=$PRE_PROFILE_SHA256"
    echo "current_profile_sha256=$(sha_file "$PROFILE")"
    echo "source_transaction=${CURRENT_TRANSACTION:-none}"
    echo "network_validation_result=$RESULT"
    echo "production_validation_result=$PRODUCTION_VALIDATION_RESULT"
    echo "production_validation_file=$POST_RESULT"
    echo "security_validation_file=$SECURITY_RESULT"
    echo "security_baseline=$SECURITY_BASELINE"
    [[ -s "$SECURITY_BASELINE" ]] && echo "security_baseline_sha256=$(sha256sum "$SECURITY_BASELINE" | awk '{print $1}')"
  } > "$CHANGE"
  chmod 640 "$CHANGE"
}

restore_prev() {
  local tx="${1:-${CURRENT_TRANSACTION:-}}"
  [[ -n "$tx" ]] || tx="$(latest_transaction)"
  [[ -n "$tx" ]] || { echo "ERROR - No network transaction is available to restore."; return 1; }
  restore_transaction_files "$tx" || return 1
  netplan generate >/dev/null 2>&1 || return 1
  netplan apply >/dev/null 2>&1 || return 1
}

rollback_and_validate() {
  CHANGE_IN_PROGRESS=0
  local tx="${1:-${CURRENT_TRANSACTION:-}}"
  restore_prev "$tx" || return 1
  set +e
  "$VALIDATOR" >/dev/null 2>&1
  local rc=$?
  set -e
  # Exit 30 means the restored configuration is valid but physical connectivity
  # is still pending; that is acceptable for USB-C/offline recovery.
  [[ $rc -eq 0 || $rc -eq 20 || $rc -eq 30 ]]
}

discard_failed_transaction() {
  local tx="${1:-${CURRENT_TRANSACTION:-}}"
  [[ -n "$tx" && -d "$tx" ]] || { CURRENT_TRANSACTION=""; return 0; }
  rm -rf -- "$tx" || return 1
  [[ "${CURRENT_TRANSACTION:-}" == "$tx" ]] && CURRENT_TRANSACTION=""
  echo "Failed candidate transaction removed after confirmed rollback; Restore history still points to the previous successful configuration."
}

stage() {
  local src="$1" origin="${2:-internal}" candidate_netplan
  [[ -f "$src" && -r "$src" ]] || { echo "Profile must be a readable regular file."; return 1; }
  prechange_integrity_verify || return 1
  clear_staged_network
  STAGED_NETWORK="$(mktemp -d)" || return 1
  candidate_netplan="$STAGED_NETWORK/etc/netplan/00-installer-config.yaml"
  if [[ "$origin" == "field_file" ]]; then
    runuser -u "$CALLER_USER" -- cat -- "$src" > "$STAGED_NETWORK/profile.json" || { clear_staged_network; return 1; }
  else
    cp -- "$src" "$STAGED_NETWORK/profile.json" || { clear_staged_network; return 1; }
  fi
  if ! mkdir -p "$STAGED_NETWORK/etc/netplan" ||
     ! "$TOOL" render "$STAGED_NETWORK/profile.json" "$candidate_netplan" "$STAGED_NETWORK/profile.result" ||
     ! netplan generate --root-dir "$STAGED_NETWORK"; then
    echo "Candidate profile or Netplan generation failed; the active configuration was left intact."
    clear_staged_network
    return 1
  fi
}

refresh_integrity_baseline() {
  [[ -x "$INTEGRITY" ]] || { echo "ERROR - Security integrity tool is not installed: $INTEGRITY"; return 1; }
  "$INTEGRITY" --refresh
}

run_production_validation() {
  PRODUCTION_VALIDATION_RESULT="NOT_AVAILABLE"
  [[ -x "$POSTVALIDATOR" ]] || { echo "WARN - Production validator is not installed."; return 0; }
  echo
  echo "Running automatic full production validation..."
  set +e
  "$POSTVALIDATOR" --force
  local rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    PRODUCTION_VALIDATION_RESULT="PASS"
    echo "FULL PRODUCTION VALIDATION: PASS"
  else
    PRODUCTION_VALIDATION_RESULT="FAIL"
    echo "FULL PRODUCTION VALIDATION: FAIL"
    echo "Network configuration remains committed because local network validation passed."
    echo "Review: $POST_RESULT"
  fi
  return 0
}

apply() {
  local type="$1" rc a
  [[ -n "$STAGED_NETWORK" ]] || { echo "No validated network configuration is staged."; return 1; }
  echo
  echo "Proposed Solutionz network profile:"
  cat "$STAGED_NETWORK/profile.json"
  echo
  echo "Generated Netplan:"
  cat "$STAGED_NETWORK/etc/netplan/00-installer-config.yaml"
  echo
  if ! read -r -p "Apply now? Type 'yes': " a || [[ "$a" != "yes" ]]; then
    clear_staged_network
    echo "Change cancelled."
    return 0
  fi

  create_transaction "field_network_change" || { clear_staged_network; return 1; }
  CHANGE_IN_PROGRESS=1
  if ! install -m 600 "$STAGED_NETWORK/profile.json" "$PROFILE" ||
     ! install -m 600 "$STAGED_NETWORK/etc/netplan/00-installer-config.yaml" "$NETPLAN"; then
    clear_staged_network
    if rollback_and_validate; then
      change FAIL "$type" PERSISTENT_WRITE_FAILED_ROLLBACK_COMPLETED
      discard_failed_transaction
    else
      change FAIL "$type" PERSISTENT_WRITE_FAILED_ROLLBACK_FAILED
    fi
    return 1
  fi

  if ! netplan generate; then
    echo "Netplan generation failed; rolling back."
    clear_staged_network
    if rollback_and_validate; then
      change FAIL "$type" NETPLAN_GENERATE_FAILED_ROLLBACK_COMPLETED
      discard_failed_transaction || echo "WARN - Rollback succeeded but failed candidate transaction could not be removed."
    else
      change FAIL "$type" NETPLAN_GENERATE_FAILED_ROLLBACK_FAILED
    fi
    return 1
  fi

  if ! netplan apply; then
    echo "Netplan apply failed; rolling back."
    clear_staged_network
    if rollback_and_validate; then
      change FAIL "$type" NETPLAN_APPLY_FAILED_ROLLBACK_COMPLETED
      discard_failed_transaction || echo "WARN - Rollback succeeded but failed candidate transaction could not be removed."
    else
      change FAIL "$type" NETPLAN_APPLY_FAILED_ROLLBACK_FAILED
    fi
    return 1
  fi

  echo
  echo "Refreshing detected live NIC state after network apply..."
  [[ -x "$LIVE" ]] && "$LIVE" || true

  echo
  echo "Running automatic post-change WAN/LAN/VLAN validation..."
  set +e
  "$VALIDATOR"
  rc=$?
  set -e

  if [[ $rc -ne 0 && $rc -ne 20 && $rc -ne 30 ]]; then
    clear_staged_network
    echo
    echo "LOCAL NETWORK CONFIGURATION VALIDATION: FAIL (validator exit $rc)"
    echo "Restoring the previous working Netplan/profile automatically..."
    if rollback_and_validate; then
      change FAIL "$type" CONFIGURATION_FAILED_ROLLBACK_COMPLETED
      discard_failed_transaction || echo "WARN - Rollback succeeded but failed candidate transaction could not be removed."
      echo "ROLLBACK COMPLETED AND LOCAL CONFIGURATION REVALIDATED."
    else
      change FAIL "$type" CONFIGURATION_FAILED_ROLLBACK_FAILED
      echo "ROLLBACK FAILED OR COULD NOT BE REVALIDATED. Use USB-C COM recovery."
    fi
    return 1
  fi

  if ! install -m 640 "$STAGED_NETWORK/profile.result" "$PROFILE_RESULT"; then
    clear_staged_network
    if rollback_and_validate; then
      change FAIL "$type" RESULT_WRITE_FAILED_ROLLBACK_COMPLETED
      discard_failed_transaction
    else
      change FAIL "$type" RESULT_WRITE_FAILED_ROLLBACK_FAILED
    fi
    return 1
  fi
  CHANGE_IN_PROGRESS=0
  clear_staged_network

  if [[ $rc -eq 30 ]]; then
    echo
    echo "LOCAL NETWORK CONFIGURATION: PASS"
    echo "PHYSICAL/CONNECTIVITY VALIDATION: PENDING"
    echo "Configuration is saved for offline USB-C preload. No rollback is required."
    echo "Connect the Ethernet interface(s) later and run validation again."
    if ! refresh_integrity_baseline; then
      change FAIL "$type" SECURITY_BASELINE_REFRESH_FAILED
      echo "SECURITY BASELINE REFRESH: FAIL. Network configuration remains applied for recovery."
      return 1
    fi
    PRODUCTION_VALIDATION_RESULT="NOT_RUN_CONNECTIVITY_PENDING"
    change PASS "$type" CONFIGURATION_SAVED_CONNECTIVITY_PENDING
    return 0
  fi

  if [[ $rc -eq 20 ]]; then
    echo
    echo "LOCAL NETWORK CONFIGURATION: PASS"
    echo "WAN CONNECTIVITY VALIDATION: FAIL"
    echo "Addressing is retained because the local Netplan is valid. Review upstream DNS/firewall/WAN access."
    if ! refresh_integrity_baseline; then
      change FAIL "$type" SECURITY_BASELINE_REFRESH_FAILED
      echo "SECURITY BASELINE REFRESH: FAIL. Network configuration remains applied for recovery."
      return 1
    fi
    run_production_validation
    if [[ "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]; then
      change PASS "$type" LOCAL_CONFIGURATION_VALID_CONNECTIVITY_FAILED_BUT_PRODUCTION_VALIDATION_PASSED
    else
      change FAIL "$type" PRODUCTION_VALIDATION_FAILED_CONFIGURATION_RETAINED
    fi
    return 0
  fi

  echo
  echo "AUTOMATIC NETWORK VALIDATION: PASS"
  if ! refresh_integrity_baseline; then
    change FAIL "$type" SECURITY_BASELINE_REFRESH_FAILED
    echo "SECURITY BASELINE REFRESH: FAIL. Network configuration remains applied for recovery."
    return 1
  fi
  run_production_validation
  if [[ "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]; then
    change PASS "$type" AUTOMATIC_NETWORK_AND_SECURITY_VALIDATION_PASSED
  else
    change FAIL "$type" PRODUCTION_VALIDATION_FAILED_CONFIGURATION_RETAINED
  fi
  return 0
}

modify() {
  local section="$1" mode="$2" addr="${3:-}" g="${4:-}" dns="${5:-}" tmp
  tmp="$(mktemp)"
  python3 - "$PROFILE" "$tmp" "$section" "$mode" "$addr" "$g" "$dns" <<'MODIFYPY'
import json,sys
src,out,sec,mode,addr,gw,dns=sys.argv[1:]
try:
    p=json.load(open(src))
except Exception:
    p={"revision":"SOC2-V07111226","wan":{"interface":"eth0","mode":"dhcp","dns":[]},"lan":{"interface":"eth1","mode":"dhcp"},"vlans":[]}
if sec=='wan':
    p['wan']={'interface':'eth0','mode':mode,'dns':[]}
    if mode=='static':
        p['wan'].update(address=addr,gateway=gw,dns=[x.strip() for x in dns.split(',') if x.strip()])
else:
    p['lan']={'interface':'eth1','mode':mode}
    if mode=='static': p['lan']['address']=addr
json.dump(p,open(out,'w'),indent=2)
open(out,'a').write('\n')
MODIFYPY
  if ! stage "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  return 0
}

wan() {
  guard_change wan || return 1
  local m a g d
  read -r -p "WAN mode [dhcp/static]: " m
  m="${m:-dhcp}"
  if [[ "$m" == "static" ]]; then
    read -r -p "WAN IPv4/CIDR: " a
    read -r -p "Gateway: " g
    read -r -p "DNS comma separated: " d
    modify wan "$m" "$a" "$g" "$d" || return 1
  elif [[ "$m" == "dhcp" ]]; then
    modify wan dhcp || return 1
  else
    echo "Invalid WAN mode."
    return 1
  fi
  apply wan
}

lan() {
  guard_change lan || return 1
  local m a
  read -r -p "LAN native mode [dhcp/static/none/unused]: " m
  m="${m:-dhcp}"
  if [[ "$m" == "static" ]]; then
    read -r -p "LAN IPv4/CIDR (no gateway): " a
    modify lan "$m" "$a" || return 1
  elif [[ "$m" == "dhcp" || "$m" == "none" || "$m" == "unused" ]]; then
    modify lan "$m" || return 1
  else
    echo "Invalid LAN mode."
    return 1
  fi
  apply lan
}

wizard() {
  guard_change all || return 1
  local t rc=0
  t="$(mktemp)" || return 1
  "$TOOL" wizard "$t" && stage "$t" && apply wan_lan_vlan || rc=$?
  rm -f "$t"
  return "$rc"
}

saved() {
  guard_change all || return 1
  local p
  read -r -p "JSON profile path: " p
  stage "$p" field_file && apply saved_profile
}

profile_iface_info() {
  local iface="$1"
  python3 - "$PROFILE" "$iface" <<'PYPROFILEINFO'
import ipaddress,json,sys
from pathlib import Path
path=Path(sys.argv[1]); iface=sys.argv[2]
if not path.exists():
    print('unconfigured||'); raise SystemExit(0)
try:
    data=json.loads(path.read_text(encoding='utf-8'))
    section=data.get('wan',{}) if iface=='eth0' else data.get('lan',{})
    mode=str(section.get('mode','unconfigured')).strip().lower() or 'unconfigured'
    address=str(section.get('address','')).strip(); network=''
    if address: network=str(ipaddress.ip_interface(address).network)
    print(f'{mode}|{address}|{network}')
except Exception:
    print('invalid||')
PYPROFILEINFO
}

nic_status_line() {
  local iface="$1" role="$2"
  local carrier="unknown" operstate="unknown" speed="unknown" duplex="unknown"
  local live_cidr="" live_network="" gateway="" mac="unknown"
  local profile_mode="unconfigured" expected_cidr="" expected_network="" profile_info=""
  local link_text="UNKNOWN" speed_text="n/a" profile_text="UNCONFIGURED" match_text=""

  if [[ ! -e "/sys/class/net/${iface}" ]]; then
    printf '%-4s %-3s | LINK: MISSING INTERFACE\n' "$iface" "$role"
    printf '     LIVE IPv4: NONE | SUBNET: NONE | GATEWAY: NONE\n'
    printf '     PROFILE: unavailable | STATUS: INTERFACE NOT DETECTED\n'
    return 0
  fi

  carrier="$(cat "/sys/class/net/${iface}/carrier" 2>/dev/null || echo unknown)"
  operstate="$(cat "/sys/class/net/${iface}/operstate" 2>/dev/null || echo unknown)"
  speed="$(cat "/sys/class/net/${iface}/speed" 2>/dev/null || echo unknown)"
  duplex="$(cat "/sys/class/net/${iface}/duplex" 2>/dev/null || echo unknown)"
  mac="$(cat "/sys/class/net/${iface}/address" 2>/dev/null || echo unknown)"
  live_cidr="$(ip -4 -o addr show dev "$iface" scope global 2>/dev/null | awk 'NR==1 {print $4}')"
  live_network="$(ip -4 route show dev "$iface" scope link 2>/dev/null | awk '$1 ~ /^[0-9]+\./ && $1 != "default" {print $1; exit}')"
  gateway="$(ip -4 route show default dev "$iface" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") {print $(i+1); exit}}')"
  [[ -n "$live_cidr" ]] || live_cidr="NONE"
  [[ -n "$live_network" ]] || live_network="NONE"
  [[ -n "$gateway" ]] || gateway="NONE"

  case "${carrier}:${operstate}" in
    1:up|1:unknown) link_text="CONNECTED" ;;
    1:*) link_text="CONNECTED (${operstate})" ;;
    0:*) link_text="NO CARRIER - CHECK CABLE/PORT" ;;
    *) link_text="${operstate^^} / CARRIER ${carrier}" ;;
  esac
  if [[ "$speed" =~ ^[0-9]+$ ]] && (( speed > 0 )); then speed_text="${speed} Mb/s ${duplex^}"; fi

  profile_info="$(profile_iface_info "$iface")"
  IFS='|' read -r profile_mode expected_cidr expected_network <<<"$profile_info"
  case "$profile_mode" in
    static)
      profile_text="STATIC ${expected_cidr:-UNKNOWN}"
      if [[ "$live_cidr" == NONE ]]; then match_text="NO LIVE IPv4 - CHECK LINK/CONFIG"
      elif [[ "$live_cidr" == "$expected_cidr" ]]; then match_text="IP MATCH"
      elif [[ -n "$expected_network" && "$live_network" == "$expected_network" ]]; then match_text="SUBNET MATCH / IP DIFFERENT"
      else match_text="SUBNET MISMATCH"; fi ;;
    dhcp)
      profile_text="DHCP"
      if [[ "$carrier" == 0 ]]; then match_text="NO CARRIER"
      elif [[ "$live_cidr" == NONE ]]; then match_text="LINK UP / NO IPv4 LEASE"
      else match_text="IPv4 ASSIGNED"; fi ;;
    none)
      profile_text="UNNUMBERED/TRUNK"
      [[ "$carrier" == 0 ]] && match_text="NO CARRIER" || match_text="LINK PRESENT" ;;
    unused)
      profile_text="UNUSED / SINGLE-PORT"
      [[ "$live_cidr" == NONE ]] && match_text="INTENTIONALLY UNUSED" || match_text="UNEXPECTED IPv4 PRESENT" ;;
    invalid)
      profile_text="INVALID PROFILE"; match_text="PROFILE REVIEW REQUIRED" ;;
    *)
      profile_text="UNCONFIGURED"
      if [[ "$carrier" == 0 ]]; then match_text="NO CARRIER"
      elif [[ "$live_cidr" == NONE ]]; then match_text="LINK UP / NO IPv4"
      else match_text="LIVE ADDRESS DETECTED"; fi ;;
  esac

  printf '%-4s %-3s | LINK: %s | SPEED: %s\n' "$iface" "$role" "$link_text" "$speed_text"
  printf '     LIVE IPv4: %s | SUBNET: %s | GATEWAY: %s\n' "$live_cidr" "$live_network" "$gateway"
  printf '     PROFILE: %s | STATUS: %s | MAC: %s\n' "$profile_text" "$match_text" "$mac"
}

show_nic_banner() {
  echo
  echo "============================================================"
  echo "LIVE NIC / CABLING STATUS"
  echo "============================================================"
  nic_status_line eth0 WAN
  nic_status_line eth1 LAN
  echo "------------------------------------------------------------"
  echo "Carrier/speed confirm Ethernet link negotiation; they do not replace cable certification."
  echo "Static STATUS compares the live address/subnet with the saved Solutionz network profile."
  echo "============================================================"
}

show_live() {
  echo
  echo "Scanning live network interfaces..."
  if [[ -x "$LIVE" ]]; then
    "$LIVE" || true
  else
    echo "WARN - Live network discovery utility is not installed: $LIVE"
  fi
}

show() {
  show_live
  echo
  echo "PERSISTENT SOLUTIONZ NETWORK CONFIGURATION"
  echo "------------------------------------------------"
  if [[ -s "$PROFILE" ]]; then
    cat "$PROFILE"
  else
    echo "No Solutionz network profile found."
  fi
  echo
  echo "SECURITY / ROUTING STATE"
  echo "------------------------------------------------"
  echo "IPv4 forwarding: $(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo unknown)"
  [[ -s "$RESULT" ]] && { echo; echo "LAST NETWORK VALIDATION"; echo "------------------------------------------------"; cat "$RESULT"; }
}

validate() {
  set +e
  "$VALIDATOR"
  local rc=$?
  set -e
  cat "$RESULT" 2>/dev/null || true
  return $rc
}

validate_full() {
  local rc
  set +e
  "$VALIDATOR"
  rc=$?
  set -e
  cat "$RESULT" 2>/dev/null || true
  if [[ $rc -eq 30 ]]; then
    echo
    echo "FULL VALIDATION DEFERRED: network configuration is valid but physical/connectivity checks are pending."
    echo "No production validation is run until required Ethernet connectivity is available."
    return 0
  fi
  if [[ $rc -eq 10 ]]; then
    echo "LOCAL NETWORK CONFIGURATION VALIDATION: FAIL"
    return 1
  fi
  run_production_validation
  [[ -s "$SECURITY_RESULT" ]] && { echo; cat "$SECURITY_RESULT"; }
  [[ $rc -eq 0 && "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]
}

restore() {
  guard_change all || return 1
  prechange_integrity_verify || return 1
  local target rescue a rc
  target="$(latest_transaction)"
  [[ -n "$target" ]] || { echo "No previous network transaction is available."; return 1; }
  echo "Previous transaction: $target"
  [[ -f "$target/metadata" ]] && cat "$target/metadata"
  read -r -p "Restore this exact Netplan/profile transaction? Type yes: " a
  [[ "$a" == "yes" ]] || return 0

  # Preserve the currently committed pair first so a failed manual restore can
  # itself be rolled back as one exact transaction.
  create_transaction "manual_restore_prechange" || return 1
  rescue="$CURRENT_TRANSACTION"

  if ! restore_transaction_files "$target"; then
    echo "RESTORE RESULT: FAIL - transaction files could not be restored/verified."
    change FAIL manual_restore TRANSACTION_INTEGRITY_FAILED
    return 1
  fi

  if ! netplan generate; then
    echo "RESTORE RESULT: FAIL - restored Netplan did not generate. Reverting to the pre-restore transaction."
    restore_transaction_files "$rescue" || true
    netplan generate >/dev/null 2>&1 && netplan apply >/dev/null 2>&1 || true
    change FAIL manual_restore RESTORE_NETPLAN_GENERATE_FAILED_REVERTED
    return 1
  fi
  echo "RESTORE NETPLAN GENERATE: PASS"

  if ! netplan apply; then
    echo "RESTORE RESULT: FAIL - restored Netplan did not apply. Reverting to the pre-restore transaction."
    restore_transaction_files "$rescue" || true
    netplan generate >/dev/null 2>&1 && netplan apply >/dev/null 2>&1 || true
    change FAIL manual_restore RESTORE_NETPLAN_APPLY_FAILED_REVERTED
    return 1
  fi
  echo "RESTORE NETPLAN APPLY: PASS"

  [[ -x "$LIVE" ]] && "$LIVE" || true
  set +e
  "$VALIDATOR"
  rc=$?
  set -e
  cat "$RESULT" 2>/dev/null || true

  if [[ $rc -ne 0 && $rc -ne 20 && $rc -ne 30 ]]; then
    echo "RESTORE VALIDATION: FAIL - local configuration is invalid. Reverting to the pre-restore transaction."
    restore_transaction_files "$rescue" || true
    netplan generate >/dev/null 2>&1 && netplan apply >/dev/null 2>&1 || true
    change FAIL manual_restore RESTORE_LOCAL_VALIDATION_FAILED_REVERTED
    return 1
  fi

  CURRENT_TRANSACTION="$target"
  if ! refresh_integrity_baseline; then
    echo "RESTORE RESULT: FAIL - configuration restored but security integrity baseline could not be refreshed."
    change FAIL manual_restore RESTORE_SECURITY_BASELINE_REFRESH_FAILED
    return 1
  fi

  if [[ $rc -eq 30 ]]; then
    PRODUCTION_VALIDATION_RESULT="NOT_RUN_CONNECTIVITY_PENDING"
    echo "RESTORE RESULT: PASS - configuration generated/applied successfully; Ethernet/connectivity is PENDING."
    change PASS manual_restore RESTORE_APPLIED_CONNECTIVITY_PENDING
    return 0
  fi

  if [[ $rc -eq 20 ]]; then
    echo "RESTORE LOCAL CONFIGURATION: PASS"
    echo "RESTORE CONNECTIVITY: FAIL - restored configuration is retained; review upstream network/firewall/DNS."
    run_production_validation
    change PASS manual_restore RESTORE_APPLIED_CONNECTIVITY_FAILED
    return 0
  fi

  run_production_validation
  if [[ "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]; then
    echo "RESTORE RESULT: PASS - restored configuration generated, applied, and validated successfully."
    change PASS manual_restore RESTORE_APPLIED_AND_VALIDATED
    return 0
  fi

  echo "RESTORE RESULT: PARTIAL - network restore passed, but full production validation failed."
  change FAIL manual_restore RESTORE_NETWORK_PASS_PRODUCTION_VALIDATION_FAILED
  return 1
}

engineering_password_setup() {
  local state_first
  if is_engineering_caller; then
    state_first="$(head -n1 "$STATE" 2>/dev/null || true)"
    if [[ ! -e "$ENGINEERING_PASSWORD_MARKER" && "$state_first" != "phase2_system_validated" ]]; then
      echo "FIRST-TIME ENGINEERING PASSWORD SETUP BLOCKED"
      echo "Phase 2 must be phase2_system_validated before the first local ${ENGINEERING_USER} password is created."
      return 1
    fi
    echo "Authenticated engineering session: ${ENGINEERING_USER}"
    echo "SSH remains public-key only; this password is for local USB-C console and sudo authentication."
    [[ -x "$ENGINEERING_PASSWORD_TOOL" ]] || { echo "Engineering password helper missing: $ENGINEERING_PASSWORD_TOOL"; return 1; }
    "$ENGINEERING_PASSWORD_TOOL" || return 1
    install -o root -g root -m 640 /dev/null "$ENGINEERING_PASSWORD_MARKER"
    {
      echo "provisioned_by=$CALLER_USER"
      echo "timestamp_utc=$(date -u +%FT%TZ)"
      echo "engineering_key_fingerprint=$(cat "$ENGINEERING_KEY_FINGERPRINT_FILE" 2>/dev/null || echo unknown)"
    } > "$ENGINEERING_PASSWORD_MARKER"
    echo "Engineering local password provisioning: PASS"
    return 0
  fi

  echo "Engineering authentication required. Log in directly as ${ENGINEERING_USER}."
  return 77
}

engineering_setup_command() {
  is_engineering_caller || { echo "Engineering authentication required."; return 1; }
  [[ -x "$SETUP_CMD" ]] || { echo "Setup command missing: $SETUP_CMD"; return 1; }
  runuser -u "$ENGINEERING_USER" -- sudo -n "$SETUP_CMD" "$@"
}

show_domotz_registration_status() {
  if [[ -x "$ACTIVATION_TOOL" ]]; then
    "$ACTIVATION_TOOL" --status || true
  else
    echo "Domotz activation helper missing: $ACTIVATION_TOOL"
  fi
  systemctl status solutionz-domotz-activate.service --no-pager 2>/dev/null || true
  systemctl status solutionz-domotz-activate.timer --no-pager 2>/dev/null || true
}

register_domotz_now() {
  local state_first confirm rc
  state_first="$(head -n1 "$STATE" 2>/dev/null || true)"
  [[ "$state_first" == "phase2_system_validated" ]] || {
    echo "DOMOTZ REGISTRATION BLOCKED"
    echo "Phase 2 must be phase2_system_validated before a NEW Collector is registered."
    return 1
  }
  [[ -x "$ACTIVATION_TOOL" ]] || { echo "Domotz activation helper missing: $ACTIVATION_TOOL"; return 1; }

  "$ACTIVATION_TOOL" --preflight-new || return $?

  if [[ ! -s "$ACTIVATION_CONFIG" ]]; then
    if [[ -s "$ACTIVATION_DEFAULTS" ]]; then
      echo "Protected mass-production Domotz registration defaults are available."
      "$ACTIVATION_TOOL" --configure || return $?
    elif is_engineering_caller; then
      echo "No preconfigured activation credential is staged. Engineering will configure registration interactively."
      "$ACTIVATION_TOOL" --configure || return $?
    else
      echo "DOMOTZ REGISTRATION CONFIGURATION REQUIRED"
      echo "No protected factory activation credential is staged. RMM Engineering must configure registration before a technician can submit it."
      return 1
    fi
  else
    "$ACTIVATION_TOOL" --check || return 1
  fi

  echo "Submit only after physical installation of this new Collector."
  read -r -p "Type REGISTER to submit the staged NEW Collector registration: " confirm
  [[ "$confirm" == "REGISTER" ]] || { echo "Registration cancelled."; return 0; }

  set +e
  "$ACTIVATION_TOOL" --register-now
  rc=$?
  set -e
  [[ -s "$ACTIVATION_RESULT" ]] && cat "$ACTIVATION_RESULT"
  if (( rc == 75 )); then
    echo "Domotz is not ready or reachable. Retry registration explicitly when the installed Collector is reachable."
  fi
  return $rc
}

setup_deployment_submenu() {
  is_engineering_caller || { echo "Engineering authentication required."; return 1; }
  while true; do
    cat <<'SETUPMENU'

Solutionz RMM Setup / Deployment Script
1) Show Setup help / supported modes
2) Show build + Domotz registration status
3) Prepare deployment / stage Domotz registration (keep powered on)
4) Prepare deployment / stage Domotz registration and power off
5) Return to Engineering Session
SETUPMENU
    read -r -p "Selection: " sc
    case "$sc" in
      1) engineering_setup_command --help || true ;;
      2) engineering_setup_command --activation-status || true ;;
      3) engineering_setup_command --prepare-deployment --no-poweroff || true ;;
      4) engineering_setup_command --prepare-deployment || true ;;
      5) return 0 ;;
      *) echo "Invalid selection." ;;
    esac
  done
}

open_engineering_shell() {
  is_engineering_caller || {
    echo "ENGINEERING AUTHENTICATION REQUIRED"
    echo "The Engineering shell is available only to an authenticated ${ENGINEERING_USER} session."
    echo "Use Engineering Login / Password Setup or SSH directly as ${ENGINEERING_USER} with the approved private key."
    return 77
  }
  [[ -x "$ENGINEERING_SHELL" ]] || { echo "Engineering shell helper missing: $ENGINEERING_SHELL"; return 1; }
  echo "Opening AppArmor-confined Engineering shell as ${ENGINEERING_USER}. Type exit to return to the RMM menu."
  echo "The network configuration lock is released while the Engineering shell is active so authorized Setup/refurbishment can run."
  flock -u 9 || true
  runuser -u "$ENGINEERING_USER" -- "$ENGINEERING_SHELL" || true
  if ! flock -n 9; then
    echo "NETWORK CONFIGURATION BUSY - another session acquired the network lock while Engineering shell was open."
    return 75
  fi
  return 0
}

engineering_session() {
  is_engineering_caller || {
    echo "ENGINEERING AUTHENTICATION REQUIRED"
    echo "Option 10 is available only to an authenticated ${ENGINEERING_USER} session."
    echo "Use Option 9 for the controlled engineering authentication transition."
    return 1
  }
  while true; do
    cat <<'ENGMENU'

Engineering Session
1) Open engineering shell
2) Change solz_eng password
3) Configure Domotz registration settings for on-site submission
4) Show Domotz registration status
5) Register NEW Domotz Collector Now
6) Open Solutionz RMM Setup / Deployment Script
7) Return to Solutionz RMM configuration menu
ENGMENU
    read -r -p "Selection: " ec
    case "$ec" in
      1) open_engineering_shell || true ;;
      2) engineering_password_setup || true ;;
      3)
        [[ -x "$ACTIVATION_TOOL" ]] || { echo "Domotz activation helper missing."; continue; }
        "$ACTIVATION_TOOL" --configure || continue
        engineering_setup_command --prepare-deployment --no-poweroff || true
        ;;
      4) show_domotz_registration_status ;;
      5) register_domotz_now || true ;;
      6) setup_deployment_submenu ;;
      7) return 0 ;;
      *) echo "Invalid selection." ;;
    esac
  done
}

if [[ "$DIRECT_ACTION" == "engineering_tools" ]]; then
  engineering_session
  exit $?
elif [[ "$DIRECT_ACTION" == "register_new_domotz" ]]; then
  register_domotz_now
  exit $?
fi

echo
echo "AUTO-DETECT CURRENT NETWORK"
echo "------------------------------------------------"
show_live

while true; do
  show_nic_banner
  cat <<'MENU'

Solutionz RMM Dual-Homed Network Configuration - Revision SOC2-V07111226
1) Configure WAN / eth0 (DHCP or static; default route/DNS)
2) Configure LAN / eth1 (DHCP, static, unnumbered trunk, or explicitly unused)
3) Guided WAN + LAN + 802.1Q VLAN configuration (VLANs on eth1)
4) Apply saved WAN/LAN/VLAN JSON profile
5) Show live + persistent network status
6) Refresh detected live network information
7) Run automatic network + security validation
8) Restore previous network configuration
MENU
  if is_engineering_caller; then
    cat <<'MENU'
9) Engineering Login / Password Setup
10) Engineering Tools / Setup Script
11) Open Engineering Shell (solz_eng only)
MENU
  fi
  cat <<'MENU'
12) Register NEW Domotz Collector Now
13) Log out

eth0 = WAN/cloud | eth1 = AV/control LAN | VLANs on eth1 | forwarding disabled
Live detected state comes from the running Linux network stack, not Netplan.
Netplan remains the persistent configuration mechanism across reboot.
USB-C COM = independent recovery/configuration path
Offline USB-C preload is retained with connectivity PENDING; eth1 mode=unused is accepted without carrier; true local configuration failures roll back.
MENU
  read -r -p "Selection: " c || exit 0
  case "$c" in
    1) wan || true ;;
    2) lan || true ;;
    3) wizard || true ;;
    4) saved || true ;;
    5) show ;;
    6) show_live ;;
    7) validate_full || true ;;
    8) restore || true ;;
    9) if is_engineering_caller; then engineering_password_setup || true; else exit 0; fi ;;
    10) is_engineering_caller && engineering_session || true ;;
    11) is_engineering_caller && open_engineering_shell || true ;;
    12) register_domotz_now || true ;;
    13) if (( AUTO )); then exit 90; else exit 0; fi ;;
    *) echo "Invalid selection." ;;
  esac
done
LOCALCFG
  chmod 750 "${LOCAL_CONFIG_TOOL}"
  chown root:root "${LOCAL_CONFIG_TOOL}"

  cat > "${LOCAL_CONFIG_SUDOERS_FILE}" <<EOF
${TECHNICIAN_USER} ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL} "", ${LOCAL_CONFIG_TOOL} --serial-auto
%${FIELD_TECH_GROUP} ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL} "", ${LOCAL_CONFIG_TOOL} --serial-auto
%${ENGINEERING_GROUP} ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL}, ${INSTALLED_SETUP_COMMAND}, ${DOMOTZ_ACTIVATION_TOOL}
%sudo ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL}
EOF
  chmod 440 "${LOCAL_CONFIG_SUDOERS_FILE}"
  visudo -cf "${LOCAL_CONFIG_SUDOERS_FILE}" >/dev/null || error_exit "Local config sudoers validation failed."

  cat > "${SERIAL_PROFILE_FILE}" <<EOF
# Solutionz RMM all-interactive-login access policy.
# - solz_rmm always enters the controlled technician menu and is logged out when
#   the menu exits.
# - solz_eng always enters the authenticated Engineering menu. The Engineering
#   shell is entered only through an explicit menu selection.
# - SSH is independently protected with sshd ForceCommand and solz_eng remains
#   public-key-only for remote authentication.

case "\$-" in
  *i*) ;;
  *) return 0 2>/dev/null || exit 0 ;;
esac

if [[ "\${SOLUTIONZ_RMM_MENU_ACTIVE:-0}" != 1 && "\${SOLUTIONZ_RMM_SERIAL_MENU_ACTIVE:-0}" != 1 ]]; then
  _solutionz_user="\$(id -un 2>/dev/null || true)"
  _solutionz_tty="\$(tty 2>/dev/null || true)"

  if [[ "\${_solutionz_user}" == "${ENGINEERING_USER}" ]]; then
    export SOLUTIONZ_RMM_MENU_ACTIVE=1
    echo
    echo "Solutionz Engineering session detected; launching RMM configuration menu."
    _rc=0
    if [[ \${EUID:-\$(id -u)} -eq 0 ]]; then
      "${LOCAL_CONFIG_TOOL}" --engineering-auto || _rc=\$?
    else
      sudo -n "${LOCAL_CONFIG_TOOL}" --engineering-auto || _rc=\$?
    fi
    unset SOLUTIONZ_RMM_MENU_ACTIVE
    unset _solutionz_user _solutionz_tty _rc
    exit
  fi

  if [[ "\${_solutionz_user}" == "${TECHNICIAN_USER}" ]]; then
    export SOLUTIONZ_RMM_MENU_ACTIVE=1
    echo "Solutionz technician session detected; launching WAN/LAN/VLAN menu."
    exec sudo -n "${LOCAL_CONFIG_TOOL}" --serial-auto
    exit 1
  fi

  # Any other authenticated account reaching the physical USB-C COM console is
  # still placed into the controlled menu. Only the exact solz_eng identity can
  # enter Engineering mode or open the Engineering shell.
  if [[ "\${_solutionz_tty}" == /dev/ttyS0 ]]; then
    export SOLUTIONZ_RMM_MENU_ACTIVE=1
    echo
    echo "Solutionz USB-C COM session detected; launching WAN/LAN/VLAN menu."
    _rc=0
    if [[ \${EUID:-\$(id -u)} -eq 0 ]]; then
      "${LOCAL_CONFIG_TOOL}" --serial-auto || _rc=\$?
    else
      sudo -n "${LOCAL_CONFIG_TOOL}" --serial-auto || _rc=\$?
    fi
    unset SOLUTIONZ_RMM_MENU_ACTIVE
    unset _solutionz_user _solutionz_tty _rc
    exit
  fi
  unset _solutionz_user _solutionz_tty
fi
EOF
  chmod 644 "${SERIAL_PROFILE_FILE}"
  progress_message "Field WAN/LAN/VLAN utility installed; live NIC discovery runs automatically before configuration, unrestricted field-menu shell access is removed, and USB-C COM/session-safety/automatic validation/rollback remain enabled."
}

