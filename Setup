}

install_postreboot_validation() {
  step_message 16 "Install post-reboot production validation"

  cat > "${POSTREBOOT_VALIDATOR}" <<'POSTVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail

REVISION="5091126"
SUPPORTED_OS_ID="ubuntu"
SUPPORTED_UBUNTU_VERSION_ID="24.04"
SUPPORTED_UBUNTU_CODENAME="noble"
SUPPORTED_VENDOR="Protectli"
SUPPORTED_MODEL="V1210"

STATE_FILE="/var/lib/rswsolutionz-rmm/install.state"
PACKAGE_BASELINE_FILE="/var/lib/rswsolutionz-rmm/package-baseline-5091126.tsv"
OS_BASELINE_FILE="/var/lib/rswsolutionz-rmm/os-baseline-5091126.txt"
MANUFACTURER_BASELINE_FILE="/var/lib/rswsolutionz-rmm/manufacturer-baseline-5091126.txt"
MANUFACTURER_PACKAGE_BASELINE_FILE="/var/lib/rswsolutionz-rmm/manufacturer-packages-5091126.tsv"
MANUFACTURER_PACKAGE_VALIDATION_FILE="/var/lib/rswsolutionz-rmm/manufacturer-package-validation-5091126.txt"
MANUFACTURER_BASELINE_SHA256_FILE="/var/lib/rswsolutionz-rmm/manufacturer-baseline-5091126.sha256"
SNAP_BASELINE_FILE="/var/lib/rswsolutionz-rmm/snap-baseline-5091126.txt"
NETWORK_REQUIREMENTS_FILE="/var/lib/rswsolutionz-rmm/network-requirements-5091126.txt"
LOG_DIR="/var/log/solutionz-rmm/setup"
LOG_FILE="${LOG_DIR}/postreboot-validation.log"
DOMOTZ_SNAP_NAME="domotzpro-agent-publicstore"
SERIAL_SERVICE="serial-getty@ttyS0.service"
SERIAL_DEVICE="/dev/ttyS0"
LOCAL_CONFIG_TOOL="/usr/local/sbin/solutionz-rmm-local-config"
NETPLAN_FILE="/etc/netplan/00-installer-config.yaml"
GRUB_FILE="/etc/default/grub"

REQUIRED_PACKAGES=(
  net-tools
  openvswitch-switch
  traceroute
  dnsutils
  curl
  openssl
  netcat-openbsd
  nano
  iputils-ping
  ufw
  snapd
  openssh-server
  sudo
  python3
)

mkdir -p "${LOG_DIR}"
exec >> "${LOG_FILE}" 2>&1

status="$(head -n1 "${STATE_FILE}" 2>/dev/null || true)"
case "${status}" in
  phase1_complete|phase2_validation_failed)
    ;;
  *)
    exit 0
    ;;
esac

echo "============================================================"
echo "Solutionz RMM production post-reboot validation"
echo "Revision: ${REVISION}"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"

failures=0
warnings=0

pass() { echo "PASS - $*"; }
warn() { echo "WARN - $*"; warnings=$((warnings + 1)); }
fail() { echo "FAIL - $*"; failures=$((failures + 1)); }

check() {
  local description="$1"
  shift
  if "$@" >/dev/null 2>&1; then
    pass "${description}"
  else
    fail "${description}"
  fi
}

dns_resolves_ipv4() {
  local host="$1"
  getent ahostsv4 "${host}" 2>/dev/null | awk '{print $1}' | grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

state_value() {
  local key="$1"
  awk -F= -v key="${key}" '$1 == key {print substr($0, index($0,"=")+1); exit}' "${STATE_FILE}" 2>/dev/null || true
}

# Platform baseline. Any Ubuntu 24.04.x Noble point release is supported,
# including Ubuntu 24.04.4 LTS.
if [[ -r /etc/os-release ]]; then
  # shellcheck disable=SC1091
  . /etc/os-release
  [[ "${ID:-}" == "${SUPPORTED_OS_ID}" ]] && pass "Operating system is Ubuntu." || fail "Operating system ID is ${ID:-unknown}; expected Ubuntu."
  [[ "${VERSION_ID:-}" == "${SUPPORTED_UBUNTU_VERSION_ID}" ]] && pass "Ubuntu LTS family is ${SUPPORTED_UBUNTU_VERSION_ID}." || fail "Ubuntu VERSION_ID is ${VERSION_ID:-unknown}; expected ${SUPPORTED_UBUNTU_VERSION_ID}."
  if [[ -n "${VERSION_CODENAME:-}" && "${VERSION_CODENAME}" != "${SUPPORTED_UBUNTU_CODENAME}" ]]; then
    fail "Ubuntu codename is ${VERSION_CODENAME}; expected ${SUPPORTED_UBUNTU_CODENAME}."
  else
    pass "Ubuntu runtime release is supported: ${PRETTY_NAME:-${VERSION:-unknown}}"
  fi
else
  fail "/etc/os-release is unavailable."
fi

vendor="$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null | xargs || true)"
model="$(cat /sys/class/dmi/id/product_name 2>/dev/null | xargs || true)"
[[ "${vendor,,}" == *"${SUPPORTED_VENDOR,,}"* ]] && pass "Hardware vendor is Protectli." || fail "Hardware vendor is ${vendor:-unknown}; expected Protectli."
[[ "${model}" == "${SUPPORTED_MODEL}" ]] && pass "Hardware model is V1210." || fail "Hardware model is ${model:-unknown}; expected V1210."

[[ "$(state_value revision)" == "${REVISION}" ]] && pass "State-file revision matches ${REVISION}." || fail "State-file revision does not match ${REVISION}."
[[ -s "${PACKAGE_BASELINE_FILE}" ]] && pass "Final required-package baseline record exists." || fail "Final required-package baseline record is missing."
[[ -s "${OS_BASELINE_FILE}" ]] && pass "Initial OS runtime baseline record exists." || fail "Initial OS runtime baseline record is missing."
[[ -s "${MANUFACTURER_BASELINE_FILE}" ]] && pass "Manufacturer system baseline record exists." || fail "Manufacturer system baseline record is missing."
[[ -s "${MANUFACTURER_PACKAGE_BASELINE_FILE}" ]] && pass "Manufacturer package inventory exists." || fail "Manufacturer package inventory is missing."
[[ -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" ]] && pass "Manufacturer required-package validation exists." || fail "Manufacturer required-package validation is missing."
[[ -s "${MANUFACTURER_BASELINE_SHA256_FILE}" ]] && pass "Manufacturer baseline checksum record exists." || fail "Manufacturer baseline checksum record is missing."
[[ -s "${NETWORK_REQUIREMENTS_FILE}" ]] && pass "Network requirements record exists." || fail "Network requirements record is missing."
if [[ -s "${MANUFACTURER_BASELINE_SHA256_FILE}" ]]; then
  if sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" >/dev/null 2>&1; then
    pass "Manufacturer baseline integrity validation passed."
  else
    fail "Manufacturer baseline integrity validation failed."
  fi
fi
if [[ -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" ]]; then
  if grep -q '^manufacturer_package_validation=PASS$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"; then
    pass "Manufacturer-delivered required-package set was complete at baseline capture."
  elif grep -q '^manufacturer_package_validation=DEVIATION$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"; then
    warn "Manufacturer-delivered package baseline had one or more missing required packages; the original deviation is preserved in the baseline report."
  else
    fail "Manufacturer required-package validation record does not contain a recognized PASS/DEVIATION result."
  fi
fi
[[ -s "${SNAP_BASELINE_FILE}" ]] && pass "Domotz Snap audit record exists." || fail "Domotz Snap audit record is missing."

for pkg in "${REQUIRED_PACKAGES[@]}"; do
  if dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null | grep -q '^ii'; then
    pass "Final required package installed: ${pkg}"
  else
    fail "Final required package missing: ${pkg}"
  fi
done

# Network baseline
check "eth0 exists" ip link show eth0
if ip -4 addr show dev eth0 2>/dev/null | grep -q 'inet '; then pass "eth0 has an IPv4 address."; else fail "eth0 has no IPv4 address."; fi
if ip -4 route show default | grep -q ' dev eth0 '; then pass "Default IPv4 route uses eth0."; else fail "Default IPv4 route does not use eth0."; fi
if ip -4 route show default | grep -q ' dev eth1 '; then fail "eth1 has an IPv4 default route."; else pass "eth1 has no IPv4 default route."; fi
check "Netplan configuration generates successfully" netplan generate
[[ -s "${NETPLAN_FILE}" ]] && pass "Solutionz Netplan file exists." || fail "Solutionz Netplan file is missing."

# DNS and time
if dns_resolves_ipv4 api.snapcraft.io; then pass "DNS resolves api.snapcraft.io to IPv4."; else fail "DNS does not resolve api.snapcraft.io to IPv4."; fi
if dns_resolves_ipv4 archive.ubuntu.com; then pass "DNS resolves archive.ubuntu.com to IPv4."; else fail "DNS does not resolve archive.ubuntu.com to IPv4."; fi
if dns_resolves_ipv4 security.ubuntu.com; then pass "DNS resolves security.ubuntu.com to IPv4."; else fail "DNS does not resolve security.ubuntu.com to IPv4."; fi
ntp_sync="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
[[ "${ntp_sync}" == "yes" ]] && pass "System clock is NTP synchronized." || fail "System clock is not NTP synchronized."

# SSH and firewall
check "SSH service is active" systemctl is-active --quiet ssh
check "SSH service is enabled" systemctl is-enabled --quiet ssh
if ss -lnt 2>/dev/null | awk '$4 ~ /:22$/ {found=1} END {exit found?0:1}'; then pass "TCP 22 is listening locally."; else fail "TCP 22 is not listening locally."; fi
if ufw status | grep -q 'Status: active'; then pass "UFW is active."; else fail "UFW is not active."; fi
if ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW'; then pass "UFW globally permits inbound TCP 22."; else fail "UFW global TCP 22 rule is missing."; fi
if ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW'; then pass "UFW globally permits inbound TCP 3000."; else fail "UFW global TCP 3000 rule is missing."; fi
if ufw status verbose | grep -Eq '^Default: deny \(incoming\), allow \(outgoing\)'; then pass "UFW default outbound policy is allow."; else fail "UFW default outbound policy is not allow."; fi
if ss -lnt 2>/dev/null | awk '$4 ~ /:3000$/ {found=1} END {exit found?0:1}'; then pass "TCP 3000 is listening locally."; else warn "TCP 3000 is not currently listening; Domotz local service may require activation/startup state review."; fi

# TUN and Domotz local state
[[ -c /dev/net/tun ]] && pass "TUN device is available." || fail "TUN device is unavailable."
if snap list "${DOMOTZ_SNAP_NAME}" >/dev/null 2>&1; then pass "Domotz Snap is installed."; else fail "Domotz Snap is not installed."; fi
for permission in firewall-control network-observe raw-usb shutdown system-observe; do
  if snap connections "${DOMOTZ_SNAP_NAME}" 2>/dev/null | awk -v p="${permission}" '$1 == p && $3 != "-" {found=1} END {exit found ? 0 : 1}'; then
    pass "Domotz permission ${permission} is connected."
  else
    fail "Domotz permission ${permission} is not connected."
  fi
done

# Serial/COM recovery path
[[ -c "${SERIAL_DEVICE}" ]] && pass "V1210 ttyS0 serial device is present." || fail "V1210 ttyS0 serial device is missing."
check "Serial console service is active" systemctl is-active --quiet "${SERIAL_SERVICE}"
check "Serial console service is enabled" systemctl is-enabled --quiet "${SERIAL_SERVICE}"
pgrep -a agetty 2>/dev/null | grep -q 'ttyS0' && pass "agetty is running on ttyS0." || fail "agetty is not running on ttyS0."
[[ -x "${LOCAL_CONFIG_TOOL}" ]] && pass "USB-C COM local configuration utility is installed." || fail "USB-C COM local configuration utility is missing."
if grep -Eq '^GRUB_CMDLINE_LINUX=.*net\.ifnames=0' "${GRUB_FILE}" && grep -Eq '^GRUB_CMDLINE_LINUX=.*biosdevname=0' "${GRUB_FILE}"; then pass "GRUB interface-naming parameters are present."; else fail "Required GRUB interface-naming parameters are missing."; fi
if grep -Eq '^GRUB_CMDLINE_LINUX_DEFAULT=.*console=ttyS0,115200n8' "${GRUB_FILE}"; then pass "GRUB serial-console parameter is present."; else fail "GRUB serial-console parameter is missing."; fi

echo "------------------------------------------------------------"
echo "Production validation failures: ${failures}"
echo "Production validation warnings: ${warnings}"
echo "Log: ${LOG_FILE}"
echo "============================================================"

if (( failures == 0 )); then
  {
    echo "phase2_system_validated"
    echo "revision=${REVISION}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "failures=0"
    echo "warnings=${warnings}"
  } > "${STATE_FILE}"
  chmod 640 "${STATE_FILE}"
  echo "POST-REBOOT PRODUCTION VALIDATION PASSED"
  exit 0
fi

{
  echo "phase2_validation_failed"
  echo "revision=${REVISION}"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "failures=${failures}"
  echo "warnings=${warnings}"
} > "${STATE_FILE}"
chmod 640 "${STATE_FILE}"
echo "POST-REBOOT PRODUCTION VALIDATION FAILED: ${failures} check(s)"
exit 1
POSTVALIDATOR

  chmod 750 "${POSTREBOOT_VALIDATOR}"
  chown root:root "${POSTREBOOT_VALIDATOR}"

  cat > "${POSTREBOOT_SERVICE}" <<EOF
[Unit]
Description=Solutionz RMM Post-Reboot Production Validation
After=network-online.target ssh.service snapd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=${POSTREBOOT_VALIDATOR}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable rswsolutionz-rmm-postreboot-validation.service
}

check_final_requirement() {
  local description="$1"
  shift
  if "$@"; then
    echo "PASS - ${description}"
    return 0
  fi
  echo "FAIL - ${description}"
  return 1
}

final_summary_check() {
  step_message 17 "Run mandatory pre-reboot validation"

  local failures=0

  echo
  echo "============================================================"
  echo "FINAL PRE-REBOOT VALIDATION - REVISION ${REVISION}"
  echo "============================================================"

  check_final_requirement "Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS OS family" \
    bash -c ". /etc/os-release; [[ \"\$ID\" == ubuntu && \"\$VERSION_ID\" == ${SUPPORTED_UBUNTU_VERSION_ID} && ( -z \"\${VERSION_CODENAME:-}\" || \"\$VERSION_CODENAME\" == ${SUPPORTED_UBUNTU_CODENAME} ) ]]" || failures=$((failures + 1))

  check_final_requirement "V1210 ttyS0 serial device present" test -c "${SERIAL_DEVICE}" || failures=$((failures + 1))
  check_final_requirement "serial getty active" systemctl is-active --quiet "${SERIAL_SERVICE}" || failures=$((failures + 1))
  check_final_requirement "USB-C COM local config utility installed" test -x "${LOCAL_CONFIG_TOOL}" || failures=$((failures + 1))
  check_final_requirement "Protectli V1210 hardware" bash -c 'vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null); model=$(cat /sys/class/dmi/id/product_name 2>/dev/null); [[ "${vendor,,}" == *protectli* && "$model" == "V1210" ]]' || failures=$((failures + 1))
  check_final_requirement "SSH active" systemctl is-active --quiet ssh || failures=$((failures + 1))
  check_final_requirement "UFW active" bash -c "ufw status | grep -q 'Status: active'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 22" bash -c "ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "UFW globally permits TCP 3000" bash -c "ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW'" || failures=$((failures + 1))
  check_final_requirement "DNS resolves api.snapcraft.io to IPv4" dns_resolves_ipv4 api.snapcraft.io || failures=$((failures + 1))
  check_final_requirement "DNS resolves archive.ubuntu.com to IPv4" dns_resolves_ipv4 archive.ubuntu.com || failures=$((failures + 1))
  check_final_requirement "NTP synchronization active" bash -c "[[ \"$(timedatectl show -p NTPSynchronized --value 2>/dev/null)\" == yes ]]" || failures=$((failures + 1))
  check_final_requirement "Initial OS runtime baseline record exists" test -s "${OS_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer system baseline record exists" test -s "${MANUFACTURER_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer package inventory exists" test -s "${MANUFACTURER_PACKAGE_BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer required-package validation exists" test -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer baseline checksum record exists" test -s "${MANUFACTURER_BASELINE_SHA256_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer baseline integrity is valid" \
    sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" || failures=$((failures + 1))
  check_final_requirement "Manufacturer package validation has a recognized result" \
    grep -Eq '^manufacturer_package_validation=(PASS|DEVIATION)$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || failures=$((failures + 1))
  if grep -q '^manufacturer_package_validation=DEVIATION$' "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" 2>/dev/null; then
    warning_message "Manufacturer package baseline contained a recorded deviation. Final required-package state is validated separately and must pass."
  fi
  check_final_requirement "Final required-package baseline record exists" test -s "${BASELINE_FILE}" || failures=$((failures + 1))
  check_final_requirement "Network requirements record exists" test -s "${NETWORK_REQUIREMENTS_FILE}" || failures=$((failures + 1))
  check_final_requirement "Netplan generates successfully" netplan generate || failures=$((failures + 1))
  check_final_requirement "Domotz installed" snap list "${DOMOTZ_SNAP_NAME}" || failures=$((failures + 1))
  check_final_requirement "Post-reboot production validator installed" test -x "${POSTREBOOT_VALIDATOR}" || failures=$((failures + 1))

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    if snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      echo "PASS - Domotz permission ${permission} connected"
    else
      echo "FAIL - Domotz permission ${permission} not connected"
      failures=$((failures + 1))
    fi
  done

  progress_message "Domotz is intentionally not revision-pinned; installed revision is recorded for audit."

  echo "------------------------------------------------------------"
  echo "Pre-reboot mandatory failures: ${failures}"
  echo "============================================================"

  (( failures == 0 ))
}

main() {
  parse_args "$@"
  require_root
  init_logging

  echo "Solutionz RMM Agent build starting."
  echo "Script: ${SCRIPT_NAME}"
  echo "Revision: ${REVISION}"
  echo "Release date: ${RELEASE_DATE}"
  echo "Log: ${LOG_FILE}"

  backup_previous_state
  write_state "phase1_in_progress"
  record_network_requirements

  prompt_confirmation
  preflight_checks
  capture_manufacturer_baseline
  install_required_packages
  verify_required_packages
  verify_ssh_service
  configure_tun
  ensure_snapd
  install_domotz
  configure_domotz_permissions
  configure_ufw
  stage_network_config
  repair_resolv_conf
  normalize_host_entries
  configure_grub_and_serial
  install_local_serial_config_tool
  update_banner
  install_postreboot_validation

  if ! final_summary_check; then
    error_exit "Mandatory pre-reboot validation failed."
  fi

  write_state "phase1_complete" \
    "reboot_required=1" \
    "postreboot_validator=${POSTREBOOT_VALIDATOR}" \
    "log=${LOG_FILE}"

  echo
  echo "------------------------------------------------------------"
  echo " [+] Phase 1 completed successfully."
  echo " [+] Completion Time: $(date -u +%FT%TZ)"
  echo " [+] Hostname: $(hostname)"
  echo " [+] Script Revision: ${REVISION}"
  echo " [+] State File: ${STATE_FILE}"
  echo " [+] Log File: ${LOG_FILE}"
  echo "------------------------------------------------------------"
  echo "Manual reboot is required."
  echo "After reboot, systemd will run the post-reboot validation automatically."
  echo
  echo "V1210 direct laptop configuration:"
  echo "  1. Connect the laptop to the V1210 USB-C port labeled COM."
  echo "  2. Open a serial terminal at 115200 baud, 8 data bits, no parity, 1 stop bit."
  echo "  3. Log in with an authorized local account."
  echo "  4. Run: sudo ${LOCAL_CONFIG_TOOL}"
  echo "Domotz update policy: not revision-pinned; installed revision recorded in ${SNAP_BASELINE_FILE}."
}

main "$@"

