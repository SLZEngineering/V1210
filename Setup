[[ "$(head -n1 "$STATE" 2>/dev/null || true)" == "phase2_system_validated" ]] || { echo "Phase 2 must be validated before local engineering password provisioning." >&2; exit 78; }
exec /usr/bin/passwd "$ENGINEERING_USER"
