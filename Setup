# Solutionz RMM traffic model:
# - Monitoring traffic originates from this RMM Agent toward monitored AV devices.
# - Domotz/RMM cloud connections are outbound-initiated by this Agent.
# - No unsolicited Internet-initiated inbound connection is required.
# - Host UFW permits inbound TCP 22 and TCP 3000 from any reachable source, per
#   the requested Solutionz baseline. Perimeter/network policy remains responsible
#   for preventing unsolicited Internet exposure.
# - UFW uses "default allow outgoing". Therefore outbound TCP and UDP traffic is
#   permitted without separate per-port UFW allow rules. Network/perimeter firewalls
#   must still permit the required traffic described below.
# - Required outbound TCP: 443, 5671, 32700-57699, 4505-4506, 55022, 11371.
# - Required/expected UDP: 53 for DNS when UDP transport is used; 123 for NTP;
#   67/68 for DHCP when eth0 obtains addressing by DHCP; and UDP 161 from the RMM
#   Agent to monitored devices when SNMP polling is configured.
# - DNS may also use TCP 53 for fallback/large responses.
# - Additional TCP/UDP ports may be required by specific monitored AV devices or
#   manufacturer protocols. ICMP is used for monitoring/reachability where allowed.

usage() {
  cat <<EOF
Usage:
  sudo ./${SCRIPT_NAME} [options]

Options:
  --non-interactive             Skip the two manual confirmation prompts.
  --network-profile <json>      Generate dual-homed WAN/LAN/VLAN Netplan
                                from the supplied validated JSON profile.
  --prepare-deployment          After Phase 2 passes, configure/arm Domotz
                                activation for the next boot and power off.
  --activation-status           Show build state and Domotz activation status.
  --no-poweroff                 With --prepare-deployment, arm for the next
                                boot but leave the appliance powered on.
  -h, --help                    Show this help.

One-file deployment flow:
  1) Run Setup normally to build and validate Phase 1.
  2) Reboot once; Phase 2 validation runs automatically.
  3) Run: sudo solutionz-rmm-setup --prepare-deployment
     The same Setup source configures and arms activation, then powers off.
  4) On the customer network, power on. Activation is attempted locally through
     127.0.0.1:3000 only after the collector and network are ready.

Domotz update model:
  Domotz is not revision-pinned by this script. New installations use the
  Snap Store stable/default release and the installed revision is logged.
EOF
}

parse_args() {
  while (($#)); do
    case "$1" in
      --non-interactive)
        NON_INTERACTIVE=1
        ;;
      --network-profile)
        shift
        [[ $# -gt 0 ]] || { echo "--network-profile requires a JSON file path." >&2; exit 2; }
        NETWORK_PROFILE_SOURCE="$1"
        ;;
      --network-profile=*)
        NETWORK_PROFILE_SOURCE="${1#*=}"
        ;;
      --prepare-deployment)
        RUN_MODE="prepare_deployment"
        ;;
      --activation-status)
        RUN_MODE="activation_status"
        ;;
      --no-poweroff)
        NO_POWEROFF=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "ERROR: Run this script with sudo or as root." >&2
    exit 1
  fi
}

init_logging() {
  mkdir -p "${LOG_DIR}" "${STATE_DIR}"
  chmod 750 "${LOG_DIR}" "${STATE_DIR}"
  touch "${LOG_FILE}"
  chmod 640 "${LOG_FILE}"

  # Display command output normally while also preserving a plain-text copy in
  # the installation log. Nothing is intentionally hidden from the console.
  exec > >(tee -i >(sed -u 's/\x1B\[[0-9;]*[mK]//g' >> "${LOG_FILE}")) 2>&1
}

info_message() {
  printf ' %s[i] %s%s\n' "${COLOR_CYAN}" "$1" "${COLOR_RESET}"
}

progress_message() {
  printf ' %s[+] %s%s\n' "${COLOR_GREEN}" "$1" "${COLOR_RESET}"
}

warning_message() {
  printf ' %s[!] WARNING: %s%s\n' "${COLOR_YELLOW}" "$1" "${COLOR_RESET}"
}

step_message() {
  local step="$1"
  local description="$2"
  local percent=$(( (step - 1) * 100 / TOTAL_INSTALL_STEPS ))
  CURRENT_STEP="${step} - ${description}"

  printf '\n%s[%3d%%] Step %02d/%02d | %s%s\n' \
    "${COLOR_CYAN}" "${percent}" "${step}" "${TOTAL_INSTALL_STEPS}" \
    "${description}" "${COLOR_RESET}"
}

completion_message() {
  printf '\n%s[100%%] Installation phase complete%s\n' "${COLOR_GREEN}" "${COLOR_RESET}"
}

write_state() {
  local status="$1"
  shift || true
  local tmp="${STATE_FILE}.tmp.$$"

  {
    printf '%s\n' "${status}"
    printf 'revision=%s\n' "${REVISION}"
    printf 'script=%s\n' "${SCRIPT_NAME}"
    printf 'timestamp_utc=%s\n' "$(date -u +%FT%TZ)"
    printf 'step=%s\n' "${CURRENT_STEP}"
    for line in "$@"; do
      printf '%s\n' "${line}"
    done
  } > "${tmp}"

  chmod 640 "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
}

backup_previous_state() {
  if [[ -f "${STATE_FILE}" ]]; then
    cp -a "${STATE_FILE}" "${STATE_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
}


record_network_requirements() {
  cat > "${NETWORK_REQUIREMENTS_FILE}" <<'EOF'
Solutionz RMM Agent Network Requirements - Revision V06.100626N

Dual-homed interface model
- eth0 = WAN/cloud uplink. eth0 is the only interface allowed to own the IPv4
  default route and system DNS.
- eth1 = AV/control LAN. eth1 has no default route. Tagged AV/control VLANs are
  created on eth1 and likewise have no default route.
- IPv4 forwarding between WAN and LAN is disabled. The collector is not a router.
- USB-C COM is the independent recovery/configuration path.

Traffic model
- Domotz/RMM cloud sessions originate outbound through WAN/eth0.
- Monitoring traffic originates locally from the RMM Agent through LAN/eth1 or
  an eth1 VLAN toward monitored AV devices.
- No unsolicited Internet-initiated inbound connection is required for normal
  RMM/Domotz cloud communication.

Outbound TCP - WAN/cloud
- TCP 443          Domotz portal/API/orchestration and Ubuntu/Canonical/Snap HTTPS
- TCP 5671         Domotz secure messaging/orchestration
- TCP 32700-57699  Domotz remote relay/secure remote connectivity
- TCP 4505-4506    Domotz provisioning
- TCP 55022        Domotz tunnel/remote support
- TCP 11371        Key-server/package provisioning or maintenance where required
- TCP 53           DNS fallback/large responses when the resolver requires TCP

Outbound/local UDP
- UDP 53           DNS queries when UDP transport is used
- UDP 123          NTP/time synchronization
- UDP 67/68        DHCP on eth0 and/or eth1/VLANs when DHCP is selected
- UDP 161          SNMP polling from LAN/eth1 or an eth1 VLAN to monitored devices
- Additional UDP   As required by manufacturer-specific monitored-device protocols

Other required traffic
- ICMP             Device heartbeat/reachability, latency and packet-loss testing
                   where the customer security policy permits ICMP

Local monitored-device traffic - LAN side
- HTTP/HTTPS       TCP 80/443 when used by monitored devices
- SSH              TCP 22 when used for device monitoring/management
- SNMP             UDP 161 when SNMP polling is configured
- Manufacturer-specific TCP/UDP ports as required by each monitored device
- LAN/VLAN ACLs must permit the RMM Agent to reach each monitored device on the
  protocol/port required for that device.

Agent host firewall inbound allowances
- TCP 22           SSH administration
- TCP 3000         Local Domotz Agent service

UFW baseline
- Default incoming: deny
- Default outgoing: allow
- Default routed/forwarded traffic: deny
- TCP 22: allow from any reachable source because Domotz/SSH requires it
- TCP 3000: allow from any reachable source because the Domotz Agent service requires it
- Host UFW allowances do not publish either service through Internet NAT.
- UFW logging is enabled at a low level for host-firewall audit visibility.

Host security baseline
- IPv4 forwarding is disabled and eth0/eth1 are not permitted to become bridge members.
- ICMP redirects and source routing are disabled; martian packet logging is enabled.
- SSH root login is disabled; MaxAuthTries=3; LoginGraceTime=30; X11 forwarding is disabled.
- Domotz-sensitive global SSH tunneling/authentication settings are not disabled until regression tested.
- Dedicated solutionz-rmm-tech and solutionz-rmm-engineering groups separate controlled field configuration from engineering administration.
- The field configuration menu does not expose an unrestricted Linux shell option.
- auditd records changes to Solutionz-controlled network, SSH, firewall, sysctl, systemd, utility and state paths.
- AppArmor remains enabled as an OS mandatory-access-control layer.
- A SHA-256 integrity baseline protects Solutionz scripts and security/network configuration files.
- The security validator flags unexpected network-reachable TCP listeners beyond approved TCP 22/3000.
- Security updates use a controlled maintenance policy: unattended installation and automatic reboot are disabled.

Automatic WAN/LAN/VLAN behavior
- Netplan is generated from /etc/solutionz-rmm/network-profile.json.
- Default profile: WAN eth0 DHCP; LAN eth1 DHCP with DHCP routes and DNS ignored.
- WAN eth0 supports DHCP or true static IPv4. Static WAN requires gateway and DNS.
- LAN eth1 supports DHCP, static IPv4, or unnumbered trunk-parent mode.
- eth1 is optional when the profile uses the default DHCP LAN mode with no VLANs.
  If no cable is connected, validation reports OPTIONAL_NOT_CONNECTED instead of failing.
  If carrier is present, the configured LAN is validated normally. Static LAN addressing
  or configured VLANs make eth1 an explicitly required deployment interface.
- Tagged VLANs are IEEE 802.1Q subinterfaces linked to eth1, not eth0.
- VLANs support DHCP or static IPv4, but may not own a default route or DNS.
- VLAN IDs are never guessed; customer/engineering values must be supplied.
- Exactly one IPv4 default route is allowed and it must use eth0.
- DHCP on eth1/VLAN interfaces suppresses DHCP-provided routes and DNS.
- IPv4 forwarding must remain disabled (net.ipv4.ip_forward=0).
- After every network change, automatic validation verifies the active WAN/LAN
  profile. Local configuration failures trigger rollback to the previous Netplan.
- DNS/Domotz reachability failures are reported separately so a valid customer
  static configuration is not discarded merely because an upstream firewall is
  still blocking a required service.

Security boundary note
- Global TCP 22/TCP 3000 allowance on the RMM Agent host does not mean either port
  should be exposed through Internet NAT. Perimeter policy remains responsible.
- Upstream firewalls must allow required WAN/cloud traffic and LAN monitoring
  traffic for the monitored AV devices.
EOF
  chmod 640 "${NETWORK_REQUIREMENTS_FILE}"
  progress_message "Recorded dual-homed WAN/LAN network requirements: ${NETWORK_REQUIREMENTS_FILE}"
}

record_failure_and_exit() {
  local rc="$1"
  local line="$2"
  local command="$3"
  trap - ERR
  set +e

  {
    echo "result=FAIL"
    echo "phase=phase1_installation"
    echo "revision=${REVISION}"
    echo "script=${SCRIPT_NAME}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "step=${CURRENT_STEP}"
    echo "line=${line}"
    echo "exit_code=${rc}"
    echo "command=${command}"
    echo "log=${LOG_FILE}"
  } > "${PHASE1_FAILURE_RESULT_FILE}"
  chmod 640 "${PHASE1_FAILURE_RESULT_FILE}"

  write_state "phase1_failed" \
    "exit_code=${rc}" \
    "line=${line}" \
    "command=${command}" \
    "result_file=${PHASE1_FAILURE_RESULT_FILE}" \
    "log=${LOG_FILE}"

  printf ' %s[!] INSTALLATION FAILED%s\n' "${COLOR_RED}" "${COLOR_RESET}"
  printf ' %s[!] Step: %s%s\n' "${COLOR_RED}" "${CURRENT_STEP}" "${COLOR_RESET}"
  printf ' %s[!] Line: %s%s\n' "${COLOR_RED}" "${line}" "${COLOR_RESET}"
  printf ' %s[!] Exit code: %s%s\n' "${COLOR_RED}" "${rc}" "${COLOR_RESET}"
  printf ' %s[!] Command: %s%s\n' "${COLOR_RED}" "${command}" "${COLOR_RESET}"
  printf ' %s[!] Failure result: %s%s\n' "${COLOR_RED}" "${PHASE1_FAILURE_RESULT_FILE}" "${COLOR_RESET}"
  printf ' %s[!] Log: %s%s\n' "${COLOR_RED}" "${LOG_FILE}" "${COLOR_RESET}"
  exit "${rc}"
}

on_error() {
  local rc=$?
  local line="$1"
  local command="$2"
  record_failure_and_exit "${rc}" "${line}" "${command}"
}

error_exit() {
  local message="$1"
  trap - ERR
  set +e

  {
    echo "result=FAIL"
    echo "phase=phase1_installation"
    echo "revision=${REVISION}"
    echo "script=${SCRIPT_NAME}"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "step=${CURRENT_STEP}"
    echo "error=${message}"
    echo "log=${LOG_FILE}"
  } > "${PHASE1_FAILURE_RESULT_FILE}"
  chmod 640 "${PHASE1_FAILURE_RESULT_FILE}"

  printf ' %s[!] ERROR: %s%s\n' "${COLOR_RED}" "${message}" "${COLOR_RESET}"
  printf ' %s[!] Step: %s%s\n' "${COLOR_RED}" "${CURRENT_STEP}" "${COLOR_RESET}"
  printf ' %s[!] Failure result: %s%s\n' "${COLOR_RED}" "${PHASE1_FAILURE_RESULT_FILE}" "${COLOR_RESET}"
  printf ' %s[!] Log: %s%s\n' "${COLOR_RED}" "${LOG_FILE}" "${COLOR_RESET}"

  write_state "phase1_failed" \
    "error=${message}" \
    "result_file=${PHASE1_FAILURE_RESULT_FILE}" \
    "log=${LOG_FILE}"
  exit 1
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

prompt_confirmation() {
  if (( NON_INTERACTIVE == 1 )); then
    progress_message "Non-interactive mode selected; confirmation prompts skipped."
    return 0
  fi

  echo -e "\e[36m
  _____   ____    _      _    _   _____   _    ____   _     _
 / ____| / __ \  | |    | |  | | |_   _| | |  / __ \ | \   | |  _____
| (___  | |  | | | |    | |  | |   | |   | | | |  | ||  \  | | |___ /
 \___ \ | |  | | | |    | |  | |   | |   | | | |  | || |\ \| |   / /
 ____) || |__| | | |___ | |__| |   | |   | | | |__| || |  \  |  / /__
|_____/  \____/  |_____| \____/    |_|   |_|  \____/ |_|   \_| /_____|

Solutionz RMM Agent Build - Revision ${REVISION}
Created by Reiko Seneathia Williams
\e[0m"

  cat <<EOF
This script will:
  1. Validate the Ubuntu 24.04 LTS OS family and Protectli V1210 hardware.
  2. Record the manufacturer-delivered OS/package state before modification.
  3. Install only missing required packages; no general apt upgrade is performed.
  4. Verify SSH, TUN, Snap, Domotz, and required Domotz permissions.
  5. Configure UFW with inbound TCP 22/TCP 3000 permitted and default-allow outbound TCP/UDP traffic.
  6. Stage dual-homed networking: eth0 WAN/cloud default route and eth1 AV/control LAN with no default route.
  7. Generate optional 802.1Q LAN VLANs on eth1 from a guided or saved profile.
  8. Disable IPv4 forwarding so the collector does not route between WAN and LAN.
  9. Repair and validate system DNS behavior.
 10. Normalize Solutionz hostname entries.
 11. Configure GRUB interface naming and the V1210 USB-C COM serial console.
 12. Install the USB-C COM WAN/LAN/VLAN utility with automatic post-change validation and rollback.
 13. Install post-reboot production validation.
 14. Stage all changes without automatically rebooting.

Technician and engineering access:
  Default technician login: ${TECHNICIAN_USER}
  Default engineering login: ${ENGINEERING_USER}
  Members of solutionz-rmm-tech automatically enter the Solutionz RMM local
  configuration menu on interactive SSH, local console, or USB-C COM login.
  Members of solutionz-rmm-engineering are exempt and retain a normal shell.
  The default engineering account is created with a Bash shell and sudo access.
  Setup intentionally does not embed the engineering password.
  The engineering account is initially reachable only with the configured
  Solutionz engineering SSH key. After reboot and successful Phase 2 validation,
  the first authenticated ${ENGINEERING_USER} interactive login is forced to
  create its password before the engineering shell opens. Technician accounts
  cannot perform or bypass this engineering credential step.
  USB-C COM remains available at 115200 baud, 8 data bits, no parity, 1 stop bit.

Domotz note:
  Domotz is intentionally not revision-pinned. The installed Snap revision is
  recorded for audit and support.
EOF

  printf "Type 'yes' to proceed: "
  read -r confirmation1
  [[ "${confirmation1}" == "yes" ]] || error_exit "Confirmation not received."

  printf "Type 'yes' again to confirm production configuration changes: "
  read -r confirmation2
  [[ "${confirmation2}" == "yes" ]] || error_exit "Second confirmation not received."
}

read_dmi_value() {
  local path="$1"
  if [[ -r "${path}" ]]; then
    tr -d '\0' < "${path}" | xargs
  else
    printf 'unknown'
  fi
}


dns_resolves_ipv4() {
  local host="$1"
  getent ahostsv4 "${host}" 2>/dev/null | awk '{print $1}' | grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

ntp_is_synchronized() {
  local synced=""
  synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"

  # systemd-timesyncd creates this runtime marker only after a successful sync.
  # /run is recreated at boot, so this is fresh evidence for the current boot.
  if [[ "${synced}" == "yes" || -e /run/systemd/timesync/synchronized ]]; then
    return 0
  fi

  return 1
}

wait_for_ntp_sync() {
  local attempts="${1:-36}"
  local delay_seconds="${2:-5}"
  local attempt

  for ((attempt=1; attempt<=attempts; attempt++)); do
    if ntp_is_synchronized; then
      return 0
    fi

    if (( attempt < attempts )); then
      sleep "${delay_seconds}"
    fi
  done

  return 1
}

report_ntp_diagnostics() {
  echo "INFO - NTP diagnostics:"
  timedatectl status 2>/dev/null | sed -n '1,20p' || true
  timedatectl timesync-status --no-pager 2>/dev/null | sed -n '1,40p' || true
  systemctl status systemd-timesyncd.service --no-pager -l 2>/dev/null | sed -n '1,40p' || true
}

validate_engineering_ssh_key_preflight() {
  local key="${ENGINEERING_SSH_PUBLIC_KEY}"

  [[ -n "${key}" ]] || error_exit "Solutionz engineering SSH public key is not configured. Before production use, paste the complete Solutionz RMM Engineering .pub line into ENGINEERING_SSH_PUBLIC_KEY_DEFAULT near the top of Setup, or provide SOLUTIONZ_RMM_ENGINEERING_SSH_PUBLIC_KEY for a controlled test build."
  [[ "${key}" == ssh-ed25519\ * ]] || \
    error_exit "Engineering SSH key must be a single OpenSSH ED25519 public-key line beginning with 'ssh-ed25519 '."
  [[ "${key}" != *$'\n'* && "${key}" != *$'\r'* ]] || \
    error_exit "Engineering SSH public key must be a single line."
  [[ "${key}" != *"PRIVATE KEY"* ]] || \
    error_exit "A private SSH key was supplied where a public key is required. Never place the engineering private key in Setup."

  local key_blob
  key_blob="$(awk '{print $2}' <<<"${key}")"
  [[ -n "${key_blob}" ]] || error_exit "Engineering SSH public key is missing its key data."
  printf '%s' "${key_blob}" | base64 -d >/dev/null 2>&1 || \
    error_exit "Engineering SSH public key data is not valid base64/OpenSSH key material."

  progress_message "Engineering SSH public-key configuration is present and structurally valid."
}

preflight_checks() {
  step_message 1 "Preflight validation"

  [[ -r /etc/os-release ]] || error_exit "/etc/os-release not found."
  # shellcheck disable=SC1091
  source /etc/os-release

  [[ "${ID:-}" == "${SUPPORTED_OS_ID}" ]] || \
    error_exit "Unsupported OS ID '${ID:-unknown}'. Expected ${SUPPORTED_OS_ID}."
  [[ "${VERSION_ID:-}" == "${SUPPORTED_UBUNTU_VERSION_ID}" ]] || \
    error_exit "Unsupported Ubuntu VERSION_ID '${VERSION_ID:-unknown}'. Expected the Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS family."

  if [[ -n "${VERSION_CODENAME:-}" && "${VERSION_CODENAME}" != "${SUPPORTED_UBUNTU_CODENAME}" ]]; then
    error_exit "Unsupported Ubuntu codename '${VERSION_CODENAME}'. Expected ${SUPPORTED_UBUNTU_CODENAME}."
  fi

  progress_message "Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS OS family verified (Ubuntu 24.04.x Noble point releases, including 24.04.4 LTS, are supported)."
  progress_message "Detected runtime release: ${PRETTY_NAME:-${VERSION:-unknown}}"
  # /etc/os-release is commonly a relative symlink to /usr/lib/os-release.
  # Never copy or redirect directly onto the final baseline path because an
  # older run may have left that path as a dangling symlink. Build a regular
  # temporary file first, then atomically replace the destination itself.
  local os_baseline_tmp
  os_baseline_tmp="$(mktemp "${STATE_DIR}/.os-baseline-${REVISION}.XXXXXX")"
  cat /etc/os-release > "${os_baseline_tmp}"
  chmod 640 "${os_baseline_tmp}"
  chown root:root "${os_baseline_tmp}"
  mv -Tf "${os_baseline_tmp}" "${OS_BASELINE_FILE}"
  [[ -f "${OS_BASELINE_FILE}" && ! -L "${OS_BASELINE_FILE}" && -s "${OS_BASELINE_FILE}" ]] || \
    error_exit "Unable to create regular OS baseline record at ${OS_BASELINE_FILE}."
  progress_message "OS runtime baseline recorded as a regular file: ${OS_BASELINE_FILE}"

  local sys_vendor product_name
  sys_vendor="$(read_dmi_value /sys/class/dmi/id/sys_vendor)"
  product_name="$(read_dmi_value /sys/class/dmi/id/product_name)"

  progress_message "Detected hardware vendor: ${sys_vendor}"
  progress_message "Detected hardware model: ${product_name}"

  if [[ "${sys_vendor,,}" != *"${SUPPORTED_VENDOR,,}"* || "${product_name}" != "${SUPPORTED_MODEL}" ]]; then
    error_exit "Unsupported hardware. Production revision ${REVISION} is approved only for ${SUPPORTED_VENDOR} ${SUPPORTED_MODEL}; detected '${sys_vendor} ${product_name}'."
  fi
  progress_message "Protectli V1210 hardware preflight passed."

  if [[ ! -c "${SERIAL_DEVICE}" ]]; then
    error_exit "Required V1210 serial device ${SERIAL_DEVICE} was not detected."
  fi
  progress_message "Detected V1210 serial device ${SERIAL_DEVICE}."

  validate_engineering_ssh_key_preflight

  local free_kb
  free_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
  if [[ -z "${free_kb}" || "${free_kb}" -lt 2097152 ]]; then
    error_exit "Less than 2 GB free space is available on the root filesystem."
  fi
  progress_message "Disk-space preflight passed."

  local default_iface default_gateway current_cidr
  default_iface="$(ip -4 route show default | awk 'NR==1 {print $5}')"
  default_gateway="$(ip -4 route show default | awk 'NR==1 {print $3}')"
  [[ -n "${default_iface}" ]] || error_exit "No IPv4 default route is present."
  current_cidr="$(ip -o -4 addr show dev "${default_iface}" scope global | awk 'NR==1 {print $4}')"
  [[ -n "${current_cidr}" ]] || error_exit "Default-route interface ${default_iface} has no global IPv4 address."
  progress_message "Network preflight: ${default_iface} ${current_cidr}, gateway ${default_gateway:-not-reported}."

  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS cannot resolve archive.ubuntu.com to IPv4."
  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS cannot resolve api.snapcraft.io to IPv4."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS cannot resolve security.ubuntu.com to IPv4."

  timeout 8 bash -c '</dev/tcp/archive.ubuntu.com/80' || \
    error_exit "Cannot establish TCP connectivity to archive.ubuntu.com:80 for package bootstrap."
  timeout 8 bash -c '</dev/tcp/api.snapcraft.io/443' || \
    error_exit "Cannot establish TCP connectivity to api.snapcraft.io:443."
  timeout 8 bash -c '</dev/tcp/security.ubuntu.com/443' || \
    warning_message "TCP 443 to security.ubuntu.com could not be confirmed; apt source configuration may use another transport/mirror."

  if command -v timedatectl >/dev/null 2>&1; then
    local synced
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    if [[ "${synced}" != "yes" ]]; then
      warning_message "System time is not currently reported as NTP synchronized."
    else
      progress_message "System time synchronization verified."
    fi
  fi
}

capture_manufacturer_baseline() {
  CURRENT_STEP="1A - Capture manufacturer-delivered baseline"
  echo "------------------------------------------------------------"
  echo "Step 1A: Capture manufacturer-delivered baseline"
  echo "------------------------------------------------------------"

  progress_message "Recording manufacturer-delivered system state before package modification."

  # Preserve the first manufacturer baseline across retries/reruns. Once the
  # baseline exists, validate its checksum rather than replacing it with an
  # already-modified system state.
  if [[ -s "${MANUFACTURER_BASELINE_FILE}" && \
        -s "${MANUFACTURER_PACKAGE_BASELINE_FILE}" && \
        -s "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" ]]; then
    if [[ ! -s "${MANUFACTURER_BASELINE_SHA256_FILE}" ]]; then
      sha256sum \
        "${MANUFACTURER_BASELINE_FILE}" \
        "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
        "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
        > "${MANUFACTURER_BASELINE_SHA256_FILE}"
      chmod 640 "${MANUFACTURER_BASELINE_SHA256_FILE}"
      warning_message "Existing manufacturer baseline had no checksum record; checksum created without replacing the preserved baseline."
    fi

    if ! sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" >/dev/null 2>&1; then
      error_exit "Existing manufacturer baseline integrity validation failed. Do not overwrite the original baseline; investigate ${STATE_DIR}."
    fi

    progress_message "Existing manufacturer baseline is intact and will be preserved."
    return 0
  fi

  # If a partial prior baseline exists, preserve it for investigation before
  # creating a complete baseline set.
  local partial_backup_dir=""
  if [[ -e "${MANUFACTURER_BASELINE_FILE}" || \
        -e "${MANUFACTURER_PACKAGE_BASELINE_FILE}" || \
        -e "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" || \
        -e "${MANUFACTURER_BASELINE_SHA256_FILE}" ]]; then
    partial_backup_dir="${STATE_DIR}/manufacturer-baseline-partial-$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "${partial_backup_dir}"
    for existing in \
      "${MANUFACTURER_BASELINE_FILE}" \
      "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
      "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
      "${MANUFACTURER_BASELINE_SHA256_FILE}"; do
      [[ -e "${existing}" ]] && cp -a "${existing}" "${partial_backup_dir}/"
    done
    warning_message "Partial manufacturer baseline records were preserved at ${partial_backup_dir} before recapture."
  fi

  {
    echo "Solutionz RMM Manufacturer Baseline"
    echo "Revision: ${REVISION}"
    echo "Captured UTC: $(date -u +%FT%TZ)"
    echo
    echo "===== Operating System ====="
    cat /etc/os-release 2>/dev/null || true
    echo "Kernel: $(uname -r)"
    echo "Architecture: $(uname -m)"
    echo
    echo "===== Protectli / DMI ====="
    for field in sys_vendor product_name product_version board_name board_vendor bios_vendor bios_version bios_date; do
      path="/sys/class/dmi/id/${field}"
      if [[ -r "${path}" ]]; then
        printf '%s: %s\n' "${field}" "$(tr -d '\0' < "${path}" | xargs)"
      fi
    done
    echo
    echo "===== Storage ====="
    lsblk -o NAME,TYPE,SIZE,FSTYPE,MOUNTPOINTS,MODEL,SERIAL 2>/dev/null || true
    echo
    echo "===== Network Interfaces ====="
    ip -br link 2>/dev/null || true
    ip -br addr 2>/dev/null || true
    ip route 2>/dev/null || true
    echo
    echo "===== Snap Inventory ====="
    if command -v snap >/dev/null 2>&1; then
      snap list 2>/dev/null || true
    else
      echo "snap command not present at manufacturer-baseline capture"
    fi
  } > "${MANUFACTURER_BASELINE_FILE}"
  chmod 640 "${MANUFACTURER_BASELINE_FILE}"

  # Record every dpkg package exactly as received before this setup script
  # performs apt-get update or installs anything.
  dpkg-query -W -f='${Package}\t${Version}\t${db:Status-Abbrev}\n' 2>/dev/null \
    | LC_ALL=C sort > "${MANUFACTURER_PACKAGE_BASELINE_FILE}"
  chmod 640 "${MANUFACTURER_PACKAGE_BASELINE_FILE}"

  local installed_count=0
  local missing_count=0
  local pkg version
  {
    echo "Solutionz RMM Manufacturer Required-Package Validation"
    echo "Revision: ${REVISION}"
    echo "Captured UTC: $(date -u +%FT%TZ)"
    echo "Supported OS family: Ubuntu ${SUPPORTED_UBUNTU_VERSION_ID} LTS"
    echo
    for pkg in "${REQUIRED_PACKAGES[@]}"; do
      if dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null | grep -q '^ii'; then
        version="$(dpkg-query -W -f='${Version}' "${pkg}" 2>/dev/null || true)"
        printf 'PASS\t%s\t%s\n' "${pkg}" "${version:-unknown}"
        installed_count=$((installed_count + 1))
      else
        printf 'MISSING\t%s\t-\n' "${pkg}"
        missing_count=$((missing_count + 1))
      fi
    done
    echo
    echo "installed_required_packages=${installed_count}"
    echo "missing_required_packages=${missing_count}"
    if (( missing_count == 0 )); then
      echo "manufacturer_package_validation=PASS"
    else
      echo "manufacturer_package_validation=DEVIATION"
    fi
  } > "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"
  chmod 640 "${MANUFACTURER_PACKAGE_VALIDATION_FILE}"

  sha256sum \
    "${MANUFACTURER_BASELINE_FILE}" \
    "${MANUFACTURER_PACKAGE_BASELINE_FILE}" \
    "${MANUFACTURER_PACKAGE_VALIDATION_FILE}" \
    > "${MANUFACTURER_BASELINE_SHA256_FILE}"
  chmod 640 "${MANUFACTURER_BASELINE_SHA256_FILE}"

  if ! sha256sum -c "${MANUFACTURER_BASELINE_SHA256_FILE}" >/dev/null 2>&1; then
    error_exit "Manufacturer baseline checksum validation failed immediately after capture."
  fi

  if (( missing_count == 0 )); then
    progress_message "Manufacturer package validation passed: all required packages were already present."
  else
    warning_message "Manufacturer package validation found ${missing_count} missing required package(s). The deviation is recorded; the setup script will install only the missing packages."
  fi

  progress_message "Manufacturer baseline: ${MANUFACTURER_BASELINE_FILE}"
  progress_message "Manufacturer package inventory: ${MANUFACTURER_PACKAGE_BASELINE_FILE}"
  progress_message "Manufacturer package validation: ${MANUFACTURER_PACKAGE_VALIDATION_FILE}"
  progress_message "Manufacturer baseline checksums: ${MANUFACTURER_BASELINE_SHA256_FILE}"
}

install_required_packages() {
  step_message 2 "Validate/install missing required packages without a general system upgrade"

  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a

  local -a missing_packages=()
  local pkg
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${db:Status-Abbrev}' "${pkg}" 2>/dev/null | grep -q '^ii'; then
      missing_packages+=("${pkg}")
    fi
  done

  if (( ${#missing_packages[@]} == 0 )); then
    progress_message "All required packages were supplied by the manufacturer; apt package installation is not required."
  else
    warning_message "${#missing_packages[@]} required package(s) are missing from the manufacturer baseline: ${missing_packages[*]}"
    progress_message "Updating package indexes only because required packages are missing..."
    if ! apt-get update; then
      error_exit "apt-get update failed. Review ${LOG_FILE} for repository, DNS, or network errors."
    fi
    progress_message "Package index update completed successfully."

    progress_message "Installing only the missing approved package(s)..."
    if ! apt-get install -y --no-install-recommends "${missing_packages[@]}"; then
      error_exit "Required package installation failed. Review ${LOG_FILE} for the package that failed and the apt/dpkg error."
    fi
    progress_message "Missing required package installation completed successfully."
  fi

  progress_message "Recording final required-package versions after setup package handling..."
  : > "${BASELINE_FILE}"
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    if ! dpkg-query -W -f='${Package}\t${Version}\n' "${pkg}" >> "${BASELINE_FILE}" 2>/dev/null; then
      error_exit "Required package ${pkg} is still missing after package handling."
    fi
  done
  chmod 640 "${BASELINE_FILE}"
}

verify_required_packages() {
  step_message 3 "Verify final required-package state"

  local pkg
  for pkg in "${REQUIRED_PACKAGES[@]}"; do
    dpkg -s "${pkg}" >/dev/null 2>&1 || error_exit "Required package missing after setup package handling: ${pkg}"
    progress_message "Verified: ${pkg}"
  done

  command -v nano >/dev/null 2>&1 || error_exit "nano command not found."
  command -v ping >/dev/null 2>&1 || error_exit "ping command not found."
  command -v ufw >/dev/null 2>&1 || error_exit "ufw command not found."
  command -v python3 >/dev/null 2>&1 || error_exit "python3 command not found."
}

verify_ssh_service() {
  step_message 4 "Enable and verify SSH service"

  systemctl enable --now ssh
  systemctl is-enabled ssh >/dev/null 2>&1 || error_exit "SSH service is not enabled."
  systemctl is-active ssh >/dev/null 2>&1 || error_exit "SSH service is not active."
  progress_message "SSH service is enabled and active."
}

configure_time_sync() {
  CURRENT_STEP="4A - Enable and verify NTP time synchronization"
  echo "------------------------------------------------------------"
  echo "Step 4A: Enable and verify NTP time synchronization"
  echo "------------------------------------------------------------"

  command -v timedatectl >/dev/null 2>&1 || error_exit "timedatectl is unavailable; NTP synchronization cannot be managed."
  systemctl list-unit-files systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service is unavailable; the required systemd-timesyncd package is not installed correctly."

  # Revision V06.100626N standardizes Ubuntu time synchronization on
  # systemd-timesyncd. timedatectl enables network time, while the explicit
  # service commands make the runtime/startup state deterministic.
  timedatectl set-ntp true >/dev/null 2>&1 || \
    error_exit "Unable to enable network time synchronization with timedatectl."
  systemctl enable systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service could not be enabled."
  systemctl restart systemd-timesyncd.service >/dev/null 2>&1 || \
    error_exit "systemd-timesyncd.service could not be started/restarted."

  # Phase 2 must never be blocked behind time-sync.target. On networks where
  # UDP/123 is delayed or blocked, systemd-time-wait-sync can hold time-sync.target
  # indefinitely and prevent the post-reboot validator from running at all.
  # Revision V06.100626N therefore lets the validator start after network-online and
  # systemd-timesyncd, then performs its own bounded 180-second synchronization
  # wait and records a PASS/FAIL result in install.state.
  systemctl is-enabled --quiet systemd-timesyncd.service || \
    error_exit "systemd-timesyncd.service is not enabled after configuration."
  systemctl is-active --quiet systemd-timesyncd.service || \
    error_exit "systemd-timesyncd.service is not active after configuration."

  progress_message "NTP service configured. Waiting up to 180 seconds for initial synchronization."
  if wait_for_ntp_sync 36 5; then
    progress_message "System clock is synchronized to a network time source."
  else
    report_ntp_diagnostics
    warning_message "System clock has not synchronized within 180 seconds. Final pre-reboot validation will retry; UDP 123, DNS, DHCP-provided NTP, and upstream firewall policy should be reviewed if it remains unsynchronized."
  fi
}

configure_tun() {
  step_message 5 "Load and validate TUN support"

  modprobe tun
  grep -qxF 'tun' /etc/modules || echo 'tun' >> /etc/modules
  [[ -c /dev/net/tun ]] || error_exit "/dev/net/tun is not available after loading the tun module."
  progress_message "TUN support validated."
}

ensure_snapd() {
  step_message 6 "Enable and verify Snap service"

  systemctl enable --now snapd.socket
  systemctl start snapd.service
  systemctl is-active snapd.service >/dev/null 2>&1 || error_exit "snapd service is not active."

  snap version >/dev/null 2>&1 || error_exit "snap command is not operational."
  progress_message "Snap service is operational."
}

install_domotz() {
  step_message 7 "Install and validate Domotz Pro Agent"

  local installed=0
  if snap list "${DOMOTZ_SNAP_NAME}" >/dev/null 2>&1; then
    installed=1
    progress_message "Domotz is already installed. Revision pinning is not used by policy."
  fi

  if (( installed == 0 )); then
    if ! snap install "${DOMOTZ_SNAP_NAME}"; then
error_exit "Domotz Snap installation failed."
    fi
  fi

  if ! snap list "${DOMOTZ_SNAP_NAME}" > "${SNAP_BASELINE_FILE}"; then
    error_exit "Domotz installation could not be verified after snap install."
  fi
  chmod 640 "${SNAP_BASELINE_FILE}"
  progress_message "Domotz installation verified; installed revision recorded at ${SNAP_BASELINE_FILE}."
  cat "${SNAP_BASELINE_FILE}"
}

configure_domotz_permissions() {
  step_message 8 "Connect and verify required Domotz permissions"

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    progress_message "Connecting Domotz permission: ${permission}"
    if ! snap connect "${DOMOTZ_SNAP_NAME}:${permission}"; then
      error_exit "Failed to connect required Domotz permission: ${permission}"
    fi

    if ! snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      error_exit "Required Domotz permission is not connected: ${permission}"
    fi
  done
}

configure_ufw() {
  step_message 9 "Configure firewall and host security baseline"

  if ! ufw default deny incoming; then
    error_exit "Unable to set UFW default incoming policy."
  fi
  if ! ufw default allow outgoing; then
    error_exit "Unable to set UFW default outgoing policy. RMM/Domotz and monitoring traffic must be able to originate from the Agent."
  fi
  if ! ufw default deny routed; then
    error_exit "Unable to set UFW default routed/forwarded policy to deny."
  fi
  ufw logging low >/dev/null 2>&1 || warning_message "Unable to set UFW logging level to low; continuing with existing UFW logging policy."

  # Production requirement supplied by Solutionz: SSH and local Domotz service
  # ports are permitted globally on the Agent host firewall. This does not mean
  # unsolicited Internet inbound traffic is required; upstream/perimeter controls
  # remain responsible for Internet exposure.
  if ! ufw allow 22/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 22 (SSH)."
  fi
  if ! ufw allow 3000/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 3000 (local Domotz Agent service)."
  fi
  if ! ufw --force enable; then
    error_exit "UFW could not be enabled."
  fi

  ufw status | grep -q "Status: active" || error_exit "UFW did not become active."
  ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW' || error_exit "Expected global SSH UFW rule was not found."
  ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW' || error_exit "Expected global TCP 3000 UFW rule was not found."
  grep -Eq '^DEFAULT_FORWARD_POLICY="?DROP"?$' /etc/default/ufw || error_exit "UFW routed/forwarded default policy is not DROP."

  progress_message "UFW validated: inbound TCP 22/TCP 3000 are permitted, routed traffic is denied, and outbound TCP/UDP traffic is allowed by default."
  ufw status verbose
}

install_security_integrity_tool() {
  install -d -m 755 /usr/local/sbin
  install -d -m 750 /usr/local/share/solutionz-rmm
  cat > "${INTEGRITY_TOOL}" <<'INTEGRITYTOOL'
#!/usr/bin/env bash
set -Eeuo pipefail
REVISION="V06.100626N"
BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-V06.100626N.sha256"
FILES=(
  "/usr/local/share/solutionz-rmm/V06.100626N"
  "/usr/local/sbin/solutionz-rmm-network-profile"
  "/usr/local/sbin/solutionz-rmm-network-validate"
  "/usr/local/sbin/solutionz-rmm-live-network-discovery"
  "/usr/local/sbin/solutionz-rmm-security-validate"
  "/usr/local/sbin/solutionz-rmm-integrity-baseline"
  "/usr/local/sbin/solutionz-rmm-local-config"
  "/usr/local/sbin/solutionz-rmm-engineering-password-setup"
  "/usr/local/sbin/rswsolutionz-rmm-postreboot-validate"
  "/etc/solutionz-rmm/network-profile.json"
  "/etc/netplan/00-installer-config.yaml"
  "/etc/ssh/sshd_config.d/99-solutionz-rmm-hardening.conf"
  "/etc/sysctl.d/90-solutionz-rmm-no-forwarding.conf"
  "/etc/sysctl.d/91-solutionz-rmm-security.conf"
  "/etc/audit/rules.d/99-solutionz-rmm.rules"
  "/etc/apt/apt.conf.d/52solutionz-rmm-security-updates"
  "/etc/default/ufw"
  "/etc/ufw/sysctl.conf"
  "/etc/ufw/user.rules"
  "/etc/profile.d/solutionz-rmm-access.sh"
  "/etc/sudoers.d/solutionz-rmm-local-config"
  "/etc/sudoers.d/solutionz-rmm-engineering-password-setup"
  "/home/solz_eng/.ssh/authorized_keys"
  "/var/lib/rswsolutionz-rmm/engineering-ssh-key-V06.100626N.fingerprint"
)
usage(){ echo "Usage: $(basename "$0") --refresh|--verify"; }
case "${1:-}" in
  --refresh)
    install -d -m 750 "$(dirname "$BASELINE")"
    tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT
    for f in "${FILES[@]}"; do
      [[ -e "$f" ]] || { echo "ERROR - Required integrity target missing: $f" >&2; exit 1; }
      sha256sum "$f" >> "$tmp"
    done
    install -o root -g root -m 640 "$tmp" "$BASELINE"
    echo "Security integrity baseline refreshed: $BASELINE"
    ;;
  --verify)
    [[ -s "$BASELINE" ]] || { echo "ERROR - Security integrity baseline missing: $BASELINE" >&2; exit 1; }
    sha256sum -c "$BASELINE"
    ;;
  *) usage; exit 2 ;;
esac
INTEGRITYTOOL
  chmod 750 "${INTEGRITY_TOOL}"
  chown root:root "${INTEGRITY_TOOL}"
}

install_security_validator() {
  install -d -m 755 /usr/local/sbin
  cat > "${SECURITY_VALIDATOR}" <<'SECURITYVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail
REVISION="V06.100626N"
RESULT="/var/lib/rswsolutionz-rmm/security-validation-V06.100626N.result"
SYSCTL_FILE="/etc/sysctl.d/91-solutionz-rmm-security.conf"
SSH_FILE="/etc/ssh/sshd_config.d/99-solutionz-rmm-hardening.conf"
AUDIT_FILE="/etc/audit/rules.d/99-solutionz-rmm.rules"
APT_POLICY="/etc/apt/apt.conf.d/52solutionz-rmm-security-updates"
INTEGRITY="/usr/local/sbin/solutionz-rmm-integrity-baseline"
BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-V06.100626N.sha256"
TECH_GROUP="solutionz-rmm-tech"
ENG_GROUP="solutionz-rmm-engineering"
TECH_USER="solz_rmm"
ENG_USER="solz_eng"
LOCALCFG="/usr/local/sbin/solutionz-rmm-local-config"
ENGPASS="/usr/local/sbin/solutionz-rmm-engineering-password-setup"
ENGPASS_SUDOERS="/etc/sudoers.d/solutionz-rmm-engineering-password-setup"
ENGKEY_FP="/var/lib/rswsolutionz-rmm/engineering-ssh-key-V06.100626N.fingerprint"
LIVE="/usr/local/sbin/solutionz-rmm-live-network-discovery"
LIVE_RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-V06.100626N.result"
F=(); W=()
pass(){ echo "PASS - $*"; }
fail(){ echo "FAIL - $*"; F+=("$*"); }
warn(){ echo "WARN - $*"; W+=("$*"); }
check_sysctl(){ local k="$1" v="$2" a; a="$(sysctl -n "$k" 2>/dev/null || true)"; [[ "$a" == "$v" ]] && pass "$k=$v" || fail "$k is '${a:-missing}', expected '$v'"; }
mkdir -p "$(dirname "$RESULT")"

echo "============================================================"
echo "Solutionz RMM Security Validation"
echo "Revision: $REVISION"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"

[[ -s "$SYSCTL_FILE" ]] && pass "Security sysctl policy installed." || fail "Security sysctl policy missing."
check_sysctl net.ipv4.ip_forward 0
check_sysctl net.ipv4.conf.all.accept_redirects 0
check_sysctl net.ipv4.conf.default.accept_redirects 0
check_sysctl net.ipv4.conf.all.send_redirects 0
check_sysctl net.ipv4.conf.default.send_redirects 0
check_sysctl net.ipv4.conf.all.accept_source_route 0
check_sysctl net.ipv4.conf.default.accept_source_route 0
check_sysctl net.ipv4.icmp_echo_ignore_broadcasts 1
check_sysctl net.ipv4.conf.all.log_martians 1
check_sysctl net.ipv4.conf.default.log_martians 1
check_sysctl net.ipv4.conf.all.proxy_arp 0
check_sysctl net.ipv4.conf.default.proxy_arp 0
check_sysctl net.ipv6.conf.all.forwarding 0
check_sysctl net.ipv6.conf.default.forwarding 0
check_sysctl net.ipv6.conf.all.accept_redirects 0
check_sysctl net.ipv6.conf.default.accept_redirects 0
check_sysctl net.ipv6.conf.all.accept_source_route 0
check_sysctl net.ipv6.conf.default.accept_source_route 0

for iface in eth0 eth1; do
  if ip -o link show dev "$iface" 2>/dev/null | grep -q ' master '; then
    fail "$iface is enslaved to a bridge/bond/master; WAN/LAN bridging is prohibited."
  else
    pass "$iface is not attached to a bridge/bond/master."
  fi
done

ufw status 2>/dev/null | grep -q 'Status: active' && pass "UFW active." || fail "UFW inactive."
ufw status 2>/dev/null | grep -Eq '^22/tcp[[:space:]]+ALLOW' && pass "Domotz-required TCP 22 permitted." || fail "Required UFW TCP 22 rule missing."
ufw status 2>/dev/null | grep -Eq '^3000/tcp[[:space:]]+ALLOW' && pass "Domotz-required TCP 3000 permitted." || fail "Required UFW TCP 3000 rule missing."
grep -Eq '^DEFAULT_INPUT_POLICY="?DROP"?$' /etc/default/ufw 2>/dev/null && pass "UFW default inbound policy is DROP." || fail "UFW default inbound policy is not DROP."
grep -Eq '^DEFAULT_OUTPUT_POLICY="?ACCEPT"?$' /etc/default/ufw 2>/dev/null && pass "UFW default outbound policy is ACCEPT." || fail "UFW default outbound policy is not ACCEPT."
grep -Eq '^DEFAULT_FORWARD_POLICY="?DROP"?$' /etc/default/ufw 2>/dev/null && pass "UFW forwarded/routed policy is DROP." || fail "UFW forwarded/routed policy is not DROP."

if command -v sshd >/dev/null 2>&1 && sshd -t >/dev/null 2>&1; then
  pass "sshd configuration parses successfully."
  SSH_EFFECTIVE="$(sshd -T 2>/dev/null || true)"
  grep -q '^permitrootlogin no$' <<<"$SSH_EFFECTIVE" && pass "SSH root login disabled." || fail "SSH PermitRootLogin is not 'no'."
  grep -q '^pubkeyauthentication yes$' <<<"$SSH_EFFECTIVE" && pass "SSH public-key authentication enabled." || fail "SSH PubkeyAuthentication is not enabled."
  grep -q '^maxauthtries 3$' <<<"$SSH_EFFECTIVE" && pass "SSH MaxAuthTries=3." || fail "SSH MaxAuthTries is not 3."
  grep -q '^logingracetime 30$' <<<"$SSH_EFFECTIVE" && pass "SSH LoginGraceTime=30." || fail "SSH LoginGraceTime is not 30 seconds."
  grep -q '^x11forwarding no$' <<<"$SSH_EFFECTIVE" && pass "SSH X11 forwarding disabled." || fail "SSH X11Forwarding is not disabled."
else
  fail "sshd configuration validation failed."
fi
getent group "$TECH_GROUP" >/dev/null 2>&1 && pass "Restricted field-tech group exists." || fail "Field-tech group missing."
getent group "$ENG_GROUP" >/dev/null 2>&1 && pass "Engineering group exists." || fail "Engineering group missing."
if [[ -s "$SSH_FILE" ]] && grep -q '^Match Group solutionz-rmm-tech,!solutionz-rmm-engineering$' "$SSH_FILE" && grep -q -- '--restricted-login' "$SSH_FILE"; then
  pass "SSH technician sessions are forced to the menu with an engineering-group exception."
else
  fail "SSH technician restriction/engineering exception policy missing or invalid."
fi
if id "$TECH_USER" >/dev/null 2>&1; then
  id -nG "$TECH_USER" | tr ' ' '\n' | grep -qx "$TECH_GROUP" && pass "$TECH_USER is assigned to the field-tech group." || fail "$TECH_USER is not assigned to the field-tech group."
  if id -nG "$TECH_USER" | tr ' ' '\n' | grep -qx "$ENG_GROUP"; then
    fail "$TECH_USER is also in the engineering group; engineering membership would bypass the technician menu."
  else
    pass "$TECH_USER is not in the engineering group."
  fi
  if id -nG "$TECH_USER" | tr ' ' '
' | grep -qx sudo; then
    fail "$TECH_USER has unrestricted sudo-group membership."
  else
    pass "$TECH_USER has no unrestricted sudo-group membership."
  fi
else
  warn "Default technician account $TECH_USER does not exist on this appliance."
fi
if id "$ENG_USER" >/dev/null 2>&1; then
  id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx "$ENG_GROUP" && pass "$ENG_USER is assigned to the engineering group." || fail "$ENG_USER is not assigned to the engineering group."
  id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx 'sudo' && pass "$ENG_USER has sudo-group membership." || fail "$ENG_USER is missing sudo-group membership."
  if id -nG "$ENG_USER" | tr ' ' '\n' | grep -qx "$TECH_GROUP"; then
    fail "$ENG_USER is also in the field-tech group; default engineering account should not be classified as a technician."
  else
    pass "$ENG_USER is not in the field-tech group."
  fi
  [[ "$(getent passwd "$ENG_USER" | awk -F: '{print $7}')" == "/bin/bash" ]] && pass "$ENG_USER uses /bin/bash." || fail "$ENG_USER does not use /bin/bash."
  ENG_HOME="$(getent passwd "$ENG_USER" | awk -F: '{print $6}')"
  if [[ -s "$ENG_HOME/.ssh/authorized_keys" ]]; then
    pass "$ENG_USER authorized_keys installed."
    if [[ -s "$ENGKEY_FP" ]]; then
      EXPECTED_FP="$(awk -F= '$1=="fingerprint" {print $2}' "$ENGKEY_FP" | head -n1)"
      ACTUAL_FP="$(ssh-keygen -lf "$ENG_HOME/.ssh/authorized_keys" -E sha256 2>/dev/null | awk 'NR==1 {print $2}')"
      [[ -n "$EXPECTED_FP" && "$ACTUAL_FP" == "$EXPECTED_FP" ]] && pass "$ENG_USER engineering SSH key fingerprint matches production record." || fail "$ENG_USER engineering SSH key fingerprint does not match production record."
    else
      fail "Engineering SSH key fingerprint record missing."
    fi
  else
    fail "$ENG_USER authorized_keys missing."
  fi
else
  fail "Default engineering account $ENG_USER does not exist."
fi
[[ -x "$ENGPASS" ]] && pass "Engineering password provisioning helper installed." || fail "Engineering password provisioning helper missing."
[[ -s "$ENGPASS_SUDOERS" ]] && visudo -cf "$ENGPASS_SUDOERS" >/dev/null 2>&1 && pass "Engineering password provisioning sudoers policy valid." || fail "Engineering password provisioning sudoers policy invalid."
if [[ -x "$LOCALCFG" ]] && ! grep -q 'Open Linux shell' "$LOCALCFG"; then
  pass "Field configuration menu does not expose an unrestricted Linux shell option."
else
  fail "Field configuration menu exposes or cannot verify Linux shell access."
fi
[[ -x "$LIVE" ]] && pass "Live network discovery utility installed." || fail "Live network discovery utility missing."
[[ -s "$LIVE_RESULT" ]] && pass "Live network discovery result record exists." || warn "Live network discovery result record is not present yet."

systemctl is-active --quiet auditd 2>/dev/null && pass "auditd active." || fail "auditd inactive."
[[ -s "$AUDIT_FILE" ]] && pass "Solutionz audit rules installed." || fail "Solutionz audit rules missing."
if command -v auditctl >/dev/null 2>&1; then
  auditctl -l 2>/dev/null | grep -q 'solutionz_netplan' && pass "Solutionz audit rules loaded." || warn "Solutionz audit rules are not visible in auditctl output; verify after reboot."
fi
systemctl is-active --quiet apparmor 2>/dev/null && pass "AppArmor service active." || fail "AppArmor service inactive."
[[ -s "$APT_POLICY" ]] && grep -q 'Automatic-Reboot "false"' "$APT_POLICY" && pass "Controlled security-update policy installed with automatic reboot disabled." || fail "Controlled security-update policy missing/invalid."
grep -q 'APT::Periodic::Unattended-Upgrade "0"' "$APT_POLICY" 2>/dev/null && pass "Unattended package installation disabled; security updates require an approved maintenance action." || fail "Unattended package installation is not disabled by Solutionz policy."

if [[ -x "$INTEGRITY" && -s "$BASELINE" ]]; then
  "$INTEGRITY" --verify >/dev/null 2>&1 && pass "Security integrity baseline validates." || fail "Security integrity baseline validation failed."
else
  fail "Security integrity baseline/tool missing."
fi

ss -lntH 2>/dev/null | while read -r state recvq sendq local peer rest; do
  port="${local##*:}"; addr="${local%:*}"
  [[ "$port" =~ ^[0-9]+$ ]] || continue
  case "$addr" in 127.*|'[::1]'|'::1') continue ;; esac
  case "$port" in 22|3000) ;; *) echo "UNAPPROVED_LISTENER|$local" ;; esac
done > /tmp/solutionz-rmm-listeners.$$
if [[ -s /tmp/solutionz-rmm-listeners.$$ ]]; then
  while IFS='|' read -r _ l; do warn "Unexpected network-reachable TCP listener detected: $l"; done < /tmp/solutionz-rmm-listeners.$$
else
  pass "No unexpected network-reachable TCP listeners detected beyond approved TCP 22/3000."
fi
rm -f /tmp/solutionz-rmm-listeners.$$
ss -lntH 2>/dev/null | awk '$4 ~ /:22$/ {f=1} END{exit f?0:1}' && pass "TCP 22 is listening." || fail "TCP 22 is not listening."
ss -lntH 2>/dev/null | awk '$4 ~ /:3000$/ {f=1} END{exit f?0:1}' && pass "TCP 3000 is listening." || warn "TCP 3000 is not currently listening; Domotz activation/service state may not yet expose it."

if command -v nft >/dev/null 2>&1 && nft list ruleset 2>/dev/null | grep -Eiq '\b(masquerade|snat|dnat)\b'; then
  warn "NAT rule detected. IPv4 forwarding remains the enforcement boundary; review rule ownership before production acceptance."
else
  pass "No NAT action detected in the active nftables ruleset."
fi

[[ -e /dev/tpmrm0 || -e /dev/tpm0 ]] && pass "TPM device present for future measured-boot/attestation use." || warn "TPM device not visible; hardware-backed security remains a future-phase item."
if command -v mokutil >/dev/null 2>&1; then
  mokutil --sb-state 2>/dev/null | grep -qi 'SecureBoot enabled' && pass "Secure Boot enabled." || warn "Secure Boot is not enabled; enable only after V1210 regression validation."
else
  warn "Secure Boot state not evaluated because mokutil is not installed."
fi

f=${#F[@]}; w=${#W[@]}; r=PASS; (( f > 0 )) && r=FAIL
{
  echo "result=$r"
  echo "revision=$REVISION"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "failures=$f"
  echo "warnings=$w"
  echo "security_baseline=$BASELINE"
  echo
  echo "FAILED_CHECKS:"
  (( f > 0 )) && printf -- '- %s\n' "${F[@]}" || echo '- none'
  echo
  echo "WARNING_CHECKS:"
  (( w > 0 )) && printf -- '- %s\n' "${W[@]}" || echo '- none'
} > "$RESULT"
chmod 640 "$RESULT"
(( f == 0 ))
SECURITYVALIDATOR
  chmod 750 "${SECURITY_VALIDATOR}"
  chown root:root "${SECURITY_VALIDATOR}"
}

configure_security_hardening() {
  progress_message "Applying Solutionz host security hardening baseline."

  install -d -m 750 /usr/local/share/solutionz-rmm
  if [[ -r "$0" ]]; then
    install -o root -g root -m 640 "$0" "${INSTALLED_SCRIPT_COPY}"
  else
    warning_message "Unable to preserve an installed copy of the setup script for integrity validation."
  fi

  groupadd -f "${FIELD_TECH_GROUP}"
  groupadd -f "${ENGINEERING_GROUP}"

  # The default field account is a restricted technician account. Do not
  # automatically grant it engineering-shell membership merely because it ran
  # Setup with sudo. Engineering access is an explicit group assignment.
  if id "${TECHNICIAN_USER}" >/dev/null 2>&1; then
    usermod -aG "${FIELD_TECH_GROUP}" "${TECHNICIAN_USER}" || \
      error_exit "Unable to add ${TECHNICIAN_USER} to ${FIELD_TECH_GROUP}."
    if id -nG "${TECHNICIAN_USER}" 2>/dev/null | tr ' ' '\n' | grep -qx "${ENGINEERING_GROUP}"; then
      gpasswd -d "${TECHNICIAN_USER}" "${ENGINEERING_GROUP}" >/dev/null 2>&1 || \
        error_exit "Unable to remove technician account ${TECHNICIAN_USER} from ${ENGINEERING_GROUP}."
    fi
    progress_message "Technician account ${TECHNICIAN_USER} assigned to ${FIELD_TECH_GROUP}; unrestricted engineering shell access removed."
  else
    warning_message "Default technician account ${TECHNICIAN_USER} does not exist; technician menu enforcement will apply to any account later added to ${FIELD_TECH_GROUP}."
  fi

  # The default engineering account is explicit and repeatable. Setup never
  # promotes the account that happened to invoke sudo into engineering access.
  if id "${ENGINEERING_USER}" >/dev/null 2>&1; then
    usermod -s /bin/bash -aG "${ENGINEERING_GROUP},sudo" "${ENGINEERING_USER}" || \
      error_exit "Unable to configure engineering account ${ENGINEERING_USER}."
  else
    useradd --create-home --shell /bin/bash "${ENGINEERING_USER}" || \
      error_exit "Unable to create default engineering account ${ENGINEERING_USER}."
    usermod -aG "${ENGINEERING_GROUP},sudo" "${ENGINEERING_USER}" || \
      error_exit "Unable to assign ${ENGINEERING_USER} to engineering/sudo groups."
    progress_message "Created default engineering account ${ENGINEERING_USER}."
  fi

  # Engineering membership wins in the login policy, but the default engineering
  # account must never also be classified as a field technician.
  if id -nG "${ENGINEERING_USER}" 2>/dev/null | tr ' ' '\n' | grep -qx "${FIELD_TECH_GROUP}"; then
    gpasswd -d "${ENGINEERING_USER}" "${FIELD_TECH_GROUP}" >/dev/null 2>&1 || \
      error_exit "Unable to remove ${ENGINEERING_USER} from ${FIELD_TECH_GROUP}."
  fi

  # The restricted technician account must not retain general sudo membership.
  # It receives NOPASSWD permission only for the controlled local-config tool.
  if id "${TECHNICIAN_USER}" >/dev/null 2>&1 && id -nG "${TECHNICIAN_USER}" 2>/dev/null | tr ' ' '\n' | grep -qx sudo; then
    gpasswd -d "${TECHNICIAN_USER}" sudo >/dev/null 2>&1 || \
      error_exit "Unable to remove technician account ${TECHNICIAN_USER} from sudo."
    progress_message "Removed unrestricted sudo membership from technician account ${TECHNICIAN_USER}."
  fi

  # First engineering access is authenticated with a Solutionz-held SSH private
  # key. Only the public key is installed on the appliance and may safely reside
  # in this Setup source. This creates the trusted distinction between an
  # engineer and a technician before the engineering password exists.
  local engineering_home engineering_key_to_install engineering_password_state
  engineering_home="$(getent passwd "${ENGINEERING_USER}" | awk -F: '{print $6}')"
  [[ -n "${engineering_home}" ]] || error_exit "Unable to determine home directory for ${ENGINEERING_USER}."
  install -d -o "${ENGINEERING_USER}" -g "${ENGINEERING_USER}" -m 700 "${engineering_home}/.ssh"

  engineering_key_to_install="${ENGINEERING_SSH_PUBLIC_KEY}"
  printf '%s\n' "${engineering_key_to_install}" > "${engineering_home}/.ssh/authorized_keys"
  chown "${ENGINEERING_USER}:${ENGINEERING_USER}" "${engineering_home}/.ssh/authorized_keys"
  chmod 600 "${engineering_home}/.ssh/authorized_keys"

  local engineering_key_fingerprint
  engineering_key_fingerprint="$(ssh-keygen -lf "${engineering_home}/.ssh/authorized_keys" -E sha256 2>/dev/null | awk 'NR==1 {print $2}')"
  [[ -n "${engineering_key_fingerprint}" ]] || \
    error_exit "Configured engineering authorized_keys file is not a valid ED25519 SSH public key file."
  {
    echo "engineering_login=${ENGINEERING_USER}"
    echo "key_type=ssh-ed25519"
    echo "fingerprint=${engineering_key_fingerprint}"
    echo "installed_utc=$(date -u +%FT%TZ)"
  } > "${ENGINEERING_SSH_FINGERPRINT_FILE}"
  chmod 640 "${ENGINEERING_SSH_FINGERPRINT_FILE}"
  chown root:root "${ENGINEERING_SSH_FINGERPRINT_FILE}"
  progress_message "Engineering SSH public-key access configured for ${ENGINEERING_USER}; fingerprint ${engineering_key_fingerprint}."

  # Existing explicitly provisioned passwords are preserved. A new/unprovisioned
  # engineering account receives a high-entropy discarded password hash so the
  # account is not OS-locked (and can authenticate by public key), while password
  # authentication remains computationally unusable until the engineer replaces
  # it after Phase 2. The random secret is never logged or retained.
  engineering_password_state="$(passwd -S "${ENGINEERING_USER}" 2>/dev/null | awk '{print $2}' || true)"
  if [[ -s "${ENGINEERING_PASSWORD_MARKER}" && "${engineering_password_state}" == "P" ]]; then
    progress_message "Engineering password was previously provisioned; Setup preserved it unchanged."
  else
    local _eng_bootstrap_secret _eng_bootstrap_hash
    _eng_bootstrap_secret="$(openssl rand -base64 48 | tr -d '\n')"
    _eng_bootstrap_hash="$(printf '%s' "${_eng_bootstrap_secret}" | openssl passwd -6 -stdin)"
    usermod -p "${_eng_bootstrap_hash}" "${ENGINEERING_USER}" || \
      error_exit "Unable to establish key-only bootstrap state for ${ENGINEERING_USER}."
    unset _eng_bootstrap_secret _eng_bootstrap_hash
    rm -f "${ENGINEERING_PASSWORD_MARKER}"
    info_message "Engineering password is pending. After Phase 2, the first SSH-key-authenticated ${ENGINEERING_USER} interactive login will be forced to create it."
  fi

  progress_message "Engineering login ${ENGINEERING_USER} assigned to ${ENGINEERING_GROUP} with sudo and unrestricted Bash shell access after credential provisioning."

  cat > "${SECURITY_SYSCTL_FILE}" <<'EOF'
# Solutionz RMM host-network hardening. Do not enable IP forwarding on the dual-homed collector.
net.ipv4.ip_forward=0
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.default.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
net.ipv4.conf.default.send_redirects=0
net.ipv4.conf.all.accept_source_route=0
net.ipv4.conf.default.accept_source_route=0
net.ipv4.icmp_echo_ignore_broadcasts=1
net.ipv4.conf.all.log_martians=1
net.ipv4.conf.default.log_martians=1
net.ipv4.conf.all.proxy_arp=0
net.ipv4.conf.default.proxy_arp=0
net.ipv6.conf.all.forwarding=0
net.ipv6.conf.default.forwarding=0
net.ipv6.conf.all.accept_redirects=0
net.ipv6.conf.default.accept_redirects=0
net.ipv6.conf.all.accept_source_route=0
net.ipv6.conf.default.accept_source_route=0
EOF
  chmod 644 "${SECURITY_SYSCTL_FILE}"

  # UFW loads /etc/ufw/sysctl.conf when the firewall starts and can therefore
  # override values loaded earlier from /etc/sysctl.d. Keep the Solutionz
  # martian-packet logging requirement in both locations so it persists after
  # reboot and after a future UFW reload/restart.
  install -d -m 755 /etc/ufw
  if [[ -f "${UFW_SYSCTL_FILE}" && ! -f "${UFW_SYSCTL_FILE}.pre-solutionz" ]]; then
    cp -a "${UFW_SYSCTL_FILE}" "${UFW_SYSCTL_FILE}.pre-solutionz"
  fi
  touch "${UFW_SYSCTL_FILE}"
  sed -i -E \
    -e '/^[[:space:]]*net[.\/]ipv4[.\/]conf[.\/]all[.\/]log_martians[[:space:]]*=/d' \
    -e '/^[[:space:]]*net[.\/]ipv4[.\/]conf[.\/]default[.\/]log_martians[[:space:]]*=/d' \
    "${UFW_SYSCTL_FILE}"
  cat >> "${UFW_SYSCTL_FILE}" <<'EOF'

# Solutionz RMM persistent UFW sysctl overrides.
net/ipv4/conf/all/log_martians=1
net/ipv4/conf/default/log_martians=1
EOF
  chmod 644 "${UFW_SYSCTL_FILE}"

  sysctl --system >/dev/null || error_exit "Failed to apply Solutionz kernel/network hardening sysctl policy."
  sysctl -w net.ipv4.conf.all.log_martians=1 >/dev/null || error_exit "Failed to enable runtime martian logging for all interfaces."
  sysctl -w net.ipv4.conf.default.log_martians=1 >/dev/null || error_exit "Failed to enable runtime default martian logging."

  install -d -m 755 /etc/ssh/sshd_config.d
  cat > "${SSH_HARDENING_FILE}" <<'EOF'
# Solutionz RMM SSH hardening. Domotz-sensitive global tunneling/authentication
# controls are intentionally not changed until V1210/Domotz regression testing.
PermitRootLogin no
PubkeyAuthentication yes
MaxAuthTries 3
LoginGraceTime 30
X11Forwarding no

# Dedicated field technicians are forced into the controlled configuration
# menu for SSH sessions. Membership in the engineering group is an explicit
# exception and preserves an unrestricted administrative shell.
Match Group solutionz-rmm-tech,!solutionz-rmm-engineering
    ForceCommand sudo -n /usr/local/sbin/solutionz-rmm-local-config --restricted-login
    DisableForwarding yes
    X11Forwarding no
    PermitTunnel no
Match all
EOF
  chmod 644 "${SSH_HARDENING_FILE}"
  sshd -t || error_exit "SSH hardening configuration failed sshd syntax validation."
  systemctl reload ssh || error_exit "Unable to reload SSH after hardening."

  cat > "${SECURITY_APT_POLICY_FILE}" <<'EOF'
// Solutionz RMM controlled security-update policy.
// Security packages are installed only during an approved maintenance action.
APT::Periodic::Unattended-Upgrade "0";
Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-security";
};
EOF
  chmod 644 "${SECURITY_APT_POLICY_FILE}"

  install -d -m 750 /etc/audit/rules.d
  cat > "${AUDIT_RULES_FILE}" <<'EOF'
-w /etc/netplan/ -p wa -k solutionz_netplan
-w /etc/solutionz-rmm/ -p wa -k solutionz_rmm_config
-w /etc/ssh/ -p wa -k solutionz_ssh
-w /etc/ufw/ -p wa -k solutionz_ufw
-w /etc/sysctl.d/ -p wa -k solutionz_sysctl
-w /etc/systemd/system/ -p wa -k solutionz_systemd
-w /usr/local/sbin/ -p wa -k solutionz_sbin
-w /var/lib/rswsolutionz-rmm/ -p wa -k solutionz_state
EOF
  chmod 640 "${AUDIT_RULES_FILE}"
  systemctl enable --now auditd >/dev/null 2>&1 || error_exit "Unable to enable/start auditd."
  augenrules --load >/dev/null 2>&1 || warning_message "auditd rules could not be reloaded immediately; they will be loaded at reboot."

  systemctl enable --now apparmor >/dev/null 2>&1 || error_exit "Unable to enable/start AppArmor."
  install_security_integrity_tool
  install_security_validator

  progress_message "Security hardening installed: forwarding/redirect/source-route protections, SSH hardening, auditd, AppArmor, integrity tooling, and security validation."
}

write_default_network_profile() {
  install -d -m 750 "${NETWORK_PROFILE_DIR}"
  cat > "${NETWORK_PROFILE_FILE}" <<'JSON'
{
  "revision": "V06.100626N",
  "wan": {"interface": "eth0", "mode": "dhcp", "dns": []},
  "lan": {"interface": "eth1", "mode": "dhcp"},
  "vlans": []
}
JSON
  chmod 600 "${NETWORK_PROFILE_FILE}"
}

install_network_profile_tool() {
  install -d -m 755 /usr/local/sbin
  cat > "${NETWORK_PROFILE_TOOL}" <<'PYNETPROFILE'
#!/usr/bin/env python3
import argparse, ipaddress, json, os, sys
from pathlib import Path
REVISION="V06.100626N"; WAN_IFACE="eth0"; LAN_IFACE="eth1"; MAX_VLANS=32
class ProfileError(ValueError): pass
def fail(msg): raise ProfileError(msg)
def normalize_dns(values,label):
    if values is None:return []
    if not isinstance(values,list):fail(f"{label} dns must be a JSON array.")
    out=[]
    for value in values:
        try: ip=ipaddress.ip_address(str(value).strip())
        except ValueError: fail(f"{label} contains invalid DNS address: {value}")
        if ip.version!=4:fail(f"{label} DNS must be IPv4: {value}")
        out.append(str(ip))
    return out
def parse_static(entry,label):
    address=str(entry.get("address","")).strip()
    if not address:fail(f"{label} static mode requires address in CIDR notation.")
    try:iface=ipaddress.ip_interface(address)
    except ValueError:fail(f"{label} has invalid address/CIDR: {address}")
    if iface.version!=4:fail(f"{label} must use IPv4.")
    if iface.ip in (iface.network.network_address,iface.network.broadcast_address):fail(f"{label} host address cannot be network/broadcast.")
    return iface
def validate_profile(raw):
    if not isinstance(raw,dict):fail("Profile root must be a JSON object.")
    rev=raw.get("revision")
    if rev not in (None,"",REVISION):fail(f"Profile revision {rev!r} does not match {REVISION}.")
    wan=raw.get("wan");lan=raw.get("lan")
    if not isinstance(wan,dict):fail("wan must be a JSON object.")
    if not isinstance(lan,dict):fail("lan must be a JSON object.")
    if str(wan.get("interface",WAN_IFACE)).strip()!=WAN_IFACE:fail("wan.interface must be eth0.")
    if str(lan.get("interface",LAN_IFACE)).strip()!=LAN_IFACE:fail("lan.interface must be eth1.")
    wm=str(wan.get("mode","dhcp")).strip().lower(); wd=normalize_dns(wan.get("dns",[]),"wan"); wi=None; wg=str(wan.get("gateway","")).strip()
    if wm not in {"dhcp","static"}:fail("wan.mode must be dhcp or static.")
    if wm=="static":
        wi=parse_static(wan,"wan")
        if not wg:fail("wan static mode requires gateway.")
        try:g=ipaddress.ip_address(wg)
        except ValueError:fail(f"wan has invalid gateway: {wg}")
        if g.version!=4 or g not in wi.network:fail("wan gateway must be inside WAN subnet.")
        if not wd:fail("wan static mode requires at least one DNS server.")
    elif wan.get("address") or wg:fail("wan DHCP mode cannot define address or gateway.")
    lm=str(lan.get("mode","dhcp")).strip().lower(); li=None
    if lm not in {"dhcp","static","none"}:fail("lan.mode must be dhcp, static, or none.")
    if lan.get("gateway") or lan.get("default_route"):fail("LAN eth1 may not define gateway/default route.")
    if lan.get("dns"):fail("LAN eth1 may not define system DNS.")
    if lm=="static":li=parse_static(lan,"lan")
    elif lan.get("address"):fail(f"lan address invalid when mode={lm}.")
    vlans=raw.get("vlans",[])
    if not isinstance(vlans,list):fail("vlans must be a JSON array.")
    if len(vlans)>MAX_VLANS:fail(f"Maximum {MAX_VLANS} VLANs supported.")
    if lm=="none" and not vlans:fail("lan.mode=none requires at least one VLAN.")
    nets=[]
    if wi:nets.append(("wan/eth0",wi.network))
    if li:nets.append(("lan/eth1",li.network))
    if wi and li and wi.network.overlaps(li.network):fail(f"WAN subnet {wi.network} overlaps LAN subnet {li.network}.")
    seen=set();nv=[]
    for idx,item in enumerate(vlans,1):
        if not isinstance(item,dict):fail(f"vlan entry {idx} must be object.")
        try:vid=int(item.get("id"))
        except Exception:fail(f"vlan entry {idx} id must be integer.")
        if not 1<=vid<=4094:fail(f"VLAN {vid} id must be 1-4094.")
        if vid in seen:fail(f"Duplicate VLAN ID {vid}.")
        seen.add(vid);mode=str(item.get("mode","static")).strip().lower()
        if mode not in {"dhcp","static"}:fail(f"VLAN {vid} mode must be dhcp or static.")
        if item.get("gateway") or item.get("default_route"):fail(f"VLAN {vid} may not define gateway/default route.")
        if item.get("dns"):fail(f"VLAN {vid} may not define system DNS.")
        vi=None
        if mode=="static":
            vi=parse_static(item,f"VLAN {vid}")
            for label,net in nets:
                if vi.network.overlaps(net):fail(f"VLAN {vid} subnet {vi.network} overlaps {label} subnet {net}.")
            nets.append((f"vlan{vid}",vi.network))
        elif item.get("address"):fail(f"VLAN {vid} address invalid for DHCP mode.")
        nv.append({"id":vid,"mode":mode,"address":str(vi) if vi else ""})
    return {"revision":REVISION,"wan":{"interface":"eth0","mode":wm,"address":str(wi) if wi else "","gateway":wg,"dns":wd},"lan":{"interface":"eth1","mode":lm,"address":str(li) if li else ""},"vlans":nv,"default_interface":"eth0"}
def load_profile(path):
    try:raw=json.loads(Path(path).read_text())
    except FileNotFoundError:fail(f"Profile not found: {path}")
    except json.JSONDecodeError as e:fail(f"Invalid JSON line {e.lineno}: {e.msg}")
    return validate_profile(raw)
def common(lines,p):lines += [f"{p}dhcp6: false",f"{p}accept-ra: false",f"{p}optional: true"]
def render(pf):
    L=["network:","  version: 2","  renderer: networkd","  ethernets:"]
    w=pf["wan"];L.append("    eth0:");p="      "
    if w["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  route-metric: 100"];common(L,p)
    else:L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {w['address']}",p+"routes:",p+"  - to: default",p+f"    via: {w['gateway']}",p+"nameservers:",p+f"  addresses: [{', '.join(w['dns'])}]" ]
    l=pf["lan"];L.append("    eth1:");p="      "
    if l["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  use-routes: false",p+"  use-dns: false"];common(L,p)
    elif l["mode"]=="static":L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {l['address']}" ]
    else:L += [p+"dhcp4: false",p+"link-local: []"];common(L,p)
    if pf["vlans"]:
        L.append("  vlans:")
        for v in pf["vlans"]:
            p="      ";L += [f"    vlan{v['id']}:",p+f"id: {v['id']}",p+"link: eth1"]
            if v["mode"]=="dhcp":L += [p+"dhcp4: true",p+"dhcp-identifier: mac",p+"dhcp4-overrides:",p+"  use-routes: false",p+"  use-dns: false"];common(L,p)
            else:L.append(p+"dhcp4: false");common(L,p);L += [p+"addresses:",p+f"  - {v['address']}" ]
    return "\n".join(L)+"\n"
def atomic(path,content,mode=0o600):
    p=Path(path);p.parent.mkdir(parents=True,exist_ok=True);t=p.with_name(p.name+".tmp");t.write_text(content);os.chmod(t,mode);os.replace(t,p)
def result(path,res,reason,pfpath=None,pf=None,np=None):
    L=[f"result={res}",f"revision={REVISION}",f"reason={reason}"]
    if pfpath:L.append(f"profile={pfpath}")
    if pf:L += [f"wan_mode={pf['wan']['mode']}",f"lan_mode={pf['lan']['mode']}","default_interface=eth0","vlans="+",".join(str(v["id"]) for v in pf["vlans"])]
    if np:L.append(f"netplan={np}")
    atomic(path,"\n".join(L)+"\n",0o640)
def choice(prompt,opts,default):
    while True:
        v=input(f"{prompt} [{'/' .join(opts)}] (default {default}): ").strip().lower() or default
        if v in opts:return v
        print("Invalid choice.")
def cidr(prompt):
    while True:
        v=input(prompt+": ").strip()
        try:i=ipaddress.ip_interface(v);assert i.version==4 and i.ip not in (i.network.network_address,i.network.broadcast_address);return str(i)
        except Exception:print("Enter valid IPv4/CIDR.")
def ipv4(prompt):
    while True:
        v=input(prompt+": ").strip()
        try:i=ipaddress.ip_address(v);assert i.version==4;return str(i)
        except Exception:print("Enter valid IPv4 address.")
def wizard(path):
    print("Solutionz dual-homed profile builder - eth0 WAN / eth1 AV LAN")
    wm=choice("WAN eth0 mode",["dhcp","static"],"dhcp");wan={"interface":"eth0","mode":wm,"dns":[]}
    if wm=="static":wan.update(address=cidr("WAN IPv4/CIDR"),gateway=ipv4("WAN gateway"),dns=[x.strip() for x in input("WAN DNS comma separated: ").split(',') if x.strip()])
    lm=choice("LAN eth1 native mode",["dhcp","static","none"],"dhcp");lan={"interface":"eth1","mode":lm}
    if lm=="static":lan["address"]=cidr("LAN eth1 IPv4/CIDR")
    while True:
        try:n=int(input(f"Tagged VLAN count 0-{MAX_VLANS}: ").strip() or 0);assert 0<=n<=MAX_VLANS;break
        except Exception:print("Invalid count.")
    vs=[];seen=set()
    for x in range(n):
        while True:
            try:vid=int(input(f"VLAN #{x+1} ID: "));assert 1<=vid<=4094 and vid not in seen;seen.add(vid);break
            except Exception:print("Invalid/duplicate VLAN ID.")
        m=choice(f"VLAN {vid} mode",["dhcp","static"],"static");v={"id":vid,"mode":m}
        if m=="static":v["address"]=cidr(f"VLAN {vid} IPv4/CIDR")
        vs.append(v)
    pf=validate_profile({"revision":REVISION,"wan":wan,"lan":lan,"vlans":vs});atomic(path,json.dumps({"revision":REVISION,"wan":pf["wan"],"lan":pf["lan"],"vlans":pf["vlans"]},indent=2)+"\n");print("Profile written; WAN eth0 owns the only default route.")
def main():
    a=argparse.ArgumentParser();sub=a.add_subparsers(dest="cmd",required=True)
    for c in ("validate","default-interface","summary"):q=sub.add_parser(c);q.add_argument("profile")
    q=sub.add_parser("render");q.add_argument("profile");q.add_argument("netplan");q.add_argument("result")
    q=sub.add_parser("wizard");q.add_argument("profile");args=a.parse_args()
    try:
        if args.cmd=="wizard":wizard(args.profile);return 0
        pf=load_profile(args.profile)
        if args.cmd=="validate":print("PASS");return 0
        if args.cmd=="default-interface":print("eth0");return 0
        if args.cmd=="summary":print(json.dumps(pf,indent=2));return 0
        atomic(args.netplan,render(pf));result(args.result,"PASS","PROFILE_RENDERED",args.profile,pf,args.netplan);print("eth0");return 0
    except ProfileError as e:
        if getattr(args,"cmd",None)=="render":
            try:result(args.result,"FAIL",str(e),getattr(args,"profile",None))
            except Exception:pass
        print("ERROR:",e,file=sys.stderr);return 1
if __name__=="__main__":raise SystemExit(main())
PYNETPROFILE
  chmod 750 "${NETWORK_PROFILE_TOOL}"; chown root:root "${NETWORK_PROFILE_TOOL}"
}

install_live_network_discovery_tool() {
  install -d -m 755 /usr/local/sbin
  cat > "${LIVE_DISCOVERY_TOOL}" <<'LIVEDISCOVERY'
#!/usr/bin/env bash
set -uo pipefail

REVISION="V06.100626N"
WAN="eth0"
LAN="eth1"
RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-V06.100626N.result"

mkdir -p "$(dirname "$RESULT")"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

record(){ printf '%s=%s\n' "$1" "$2" >> "$tmp"; }
upper(){ tr '[:lower:]' '[:upper:]'; }

iface_exists(){ ip link show dev "$1" >/dev/null 2>&1; }
iface_mac(){ cat "/sys/class/net/$1/address" 2>/dev/null || echo "UNKNOWN"; }
iface_operstate(){ cat "/sys/class/net/$1/operstate" 2>/dev/null | upper || echo "UNKNOWN"; }
iface_carrier(){
  local c
  c="$(cat "/sys/class/net/$1/carrier" 2>/dev/null || true)"
  case "$c" in 1) echo "YES";; 0) echo "NO";; *) echo "UNKNOWN";; esac
}
iface_speed(){
  local sp
  sp="$(cat "/sys/class/net/$1/speed" 2>/dev/null || true)"
  if [[ "$sp" =~ ^[0-9]+$ ]] && (( sp > 0 )); then echo "${sp} Mb/s"; else echo "UNKNOWN"; fi
}
iface_ipv4_all(){
  ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk '{print $4}' | paste -sd, - || true
}
iface_assignment(){
  local iface="$1" lines idx lease
  lines="$(ip -o -4 addr show dev "$iface" scope global 2>/dev/null || true)"
  if [[ -z "$lines" ]]; then
    echo "NONE"
    return
  fi
  if grep -qw dynamic <<<"$lines"; then
    echo "DHCP"
    return
  fi
  idx="$(cat "/sys/class/net/$iface/ifindex" 2>/dev/null || true)"
  lease="/run/systemd/netif/leases/${idx}"
  if [[ -n "$idx" && -s "$lease" ]] && grep -q '^ADDRESS=' "$lease" 2>/dev/null; then
    echo "DHCP"
    return
  fi
  echo "STATIC_OR_MANUAL"
}
iface_default(){
  if ip -4 route show default 2>/dev/null | grep -Eq " dev $1( |$)"; then echo "YES"; else echo "NO"; fi
}
iface_gateway(){
  ip -4 route show default 2>/dev/null | awk -v i="$1" '$0 ~ (" dev " i "( |$)") {print $3; exit}'
}
iface_dns(){
  if command -v resolvectl >/dev/null 2>&1; then
    local d
    d="$(resolvectl dns "$1" 2>/dev/null | sed -n 's/^[^:]*:[[:space:]]*//p' | head -n1)"
    [[ -n "$d" ]] && echo "$d" || echo "NONE"
  else
    echo "UNKNOWN"
  fi
}

show_iface(){
  local iface="$1" role="$2"
  echo
  echo "${role} / ${iface}"
  echo "------------------------------------------------"
  if ! iface_exists "$iface"; then
    echo "Interface:            NOT FOUND"
    record "${iface}_present" "NO"
    return
  fi
  local mac link carrier speed ipv4 source gateway def dns
  mac="$(iface_mac "$iface")"
  link="$(iface_operstate "$iface")"
  carrier="$(iface_carrier "$iface")"
  speed="$(iface_speed "$iface")"
  ipv4="$(iface_ipv4_all "$iface")"
  source="$(iface_assignment "$iface")"
  gateway="$(iface_gateway "$iface")"
  def="$(iface_default "$iface")"
  dns="$(iface_dns "$iface")"
  [[ -n "$ipv4" ]] || ipv4="NONE"
  [[ -n "$gateway" ]] || gateway="NONE"

  printf '%-22s %s\n' "MAC Address:" "$mac"
  printf '%-22s %s\n' "Link:" "$link"
  printf '%-22s %s\n' "Carrier:" "$carrier"
  printf '%-22s %s\n' "Negotiated Speed:" "$speed"
  printf '%-22s %s\n' "Detected IPv4:" "$ipv4"
  printf '%-22s %s\n' "Assignment:" "$source"
  printf '%-22s %s\n' "Gateway:" "$gateway"
  printf '%-22s %s\n' "Default Route:" "$def"
  printf '%-22s %s\n' "DNS:" "$dns"
  case "$source" in
    DHCP) printf '%-22s %s\n' "Status:" "ADDRESS DETECTED AUTOMATICALLY" ;;
    STATIC_OR_MANUAL) printf '%-22s %s\n' "Status:" "ACTIVE ADDRESS DETECTED" ;;
    NONE)
      if [[ "$carrier" == "YES" ]]; then
        printf '%-22s %s\n' "Status:" "NO ACTIVE IPv4 - DHCP OR STATIC CONFIGURATION REQUIRED"
      else
        printf '%-22s %s\n' "Status:" "NO PHYSICAL LINK / NO ACTIVE IPv4"
      fi
      ;;
  esac

  record "${iface}_present" "YES"
  record "${iface}_mac" "$mac"
  record "${iface}_link" "$link"
  record "${iface}_carrier" "$carrier"
  record "${iface}_speed" "$speed"
  record "${iface}_ipv4" "$ipv4"
  record "${iface}_assignment" "$source"
  record "${iface}_gateway" "$gateway"
  record "${iface}_default_route" "$def"
  record "${iface}_dns" "$dns"
}

show_vlans(){
  local count=0 line raw name parent vid addr source
  echo
  echo "LIVE DETECTED VLANs"
  echo "------------------------------------------------"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    raw="$(awk -F': ' '{print $2}' <<<"$line" | awk '{print $1}')"
    name="${raw%%@*}"
    if [[ "$raw" == *"@"* ]]; then parent="${raw#*@}"; else parent="UNKNOWN"; fi
    vid="$(sed -n 's/.* vlan protocol [^ ]* id \([0-9]\+\).*/\1/p' <<<"$line")"
    [[ -n "$vid" ]] || vid="UNKNOWN"
    addr="$(iface_ipv4_all "$name")"; [[ -n "$addr" ]] || addr="NONE"
    source="$(iface_assignment "$name")"
    printf 'VLAN %-5s %-16s parent=%-8s IPv4=%-20s source=%s\n' "$vid" "$name" "$parent" "$addr" "$source"
    count=$((count+1))
    record "vlan_${count}_id" "$vid"
    record "vlan_${count}_name" "$name"
    record "vlan_${count}_parent" "$parent"
    record "vlan_${count}_ipv4" "$addr"
    record "vlan_${count}_assignment" "$source"
  done < <(ip -d -o link show type vlan 2>/dev/null || true)
  if (( count == 0 )); then echo "None detected."; fi
  record "vlan_count" "$count"
}

echo "============================================================"
echo "Solutionz RMM Live Network Discovery"
echo "Revision: $REVISION"
echo "Time: $(date -u +%FT%TZ)"
echo "============================================================"
echo "Observed state is read from the running Linux network stack."
echo "Netplan is not used to determine the live addresses shown below."

record "revision" "$REVISION"
record "timestamp_utc" "$(date -u +%FT%TZ)"
show_iface "$WAN" "WAN"
show_iface "$LAN" "LAN"
show_vlans

echo
echo "LIVE IPv4 ROUTE TABLE"
echo "------------------------------------------------"
ip -4 route 2>/dev/null || true

echo
echo "SYSTEM DNS"
echo "------------------------------------------------"
if command -v resolvectl >/dev/null 2>&1; then
  resolvectl dns 2>/dev/null || true
else
  cat /etc/resolv.conf 2>/dev/null || true
fi

if [[ $EUID -eq 0 ]]; then
  install -o root -g root -m 640 "$tmp" "$RESULT"
  echo
  echo "Live discovery result: $RESULT"
else
  echo
  echo "Live state displayed read-only. Run with sudo to persist the discovery result."
fi
LIVEDISCOVERY
  chmod 750 "${LIVE_DISCOVERY_TOOL}"
  chown root:root "${LIVE_DISCOVERY_TOOL}"
}

install_network_validator() {
  install -d -m 755 /usr/local/sbin
  cat > "${NETWORK_VALIDATOR}" <<'NETVALIDATOR'
#!/usr/bin/env bash
set -uo pipefail

REVISION="V06.100626N"
PROFILE="/etc/solutionz-rmm/network-profile.json"
PROFILE_TOOL="/usr/local/sbin/solutionz-rmm-network-profile"
RESULT="/var/lib/rswsolutionz-rmm/network-validation-V06.100626N.result"
WAN="eth0"
LAN="eth1"
WAIT_SECONDS="${SOLUTIONZ_NETWORK_VALIDATION_WAIT_SECONDS:-30}"

CONFIG_FAILS=()
CONNECT_FAILS=()

cf() { CONFIG_FAILS+=("$*"); echo "FAIL - $*"; }
xf() { CONNECT_FAILS+=("$*"); echo "FAIL - $*"; }
ok() { echo "PASS - $*"; }
info() { echo "INFO - $*"; }

ip4() {
  ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {print $4}'
}

default_iface() {
  ip -4 route show default 2>/dev/null | awk 'NR==1 {for (i=1;i<=NF;i++) if ($i=="dev") {print $(i+1); exit}}'
}

default_gateway() {
  ip -4 route show default 2>/dev/null | awk -v iface="$1" '$0 ~ (" dev " iface "( |$)") {print $3; exit}'
}

carrier() {
  [[ "$(cat "/sys/class/net/$1/carrier" 2>/dev/null || echo 0)" == "1" ]]
}

tcp_open() {
  timeout 8 bash -c "</dev/tcp/$1/$2" >/dev/null 2>&1
}

profile_meta() {
  python3 - "$PROFILE" <<'PROFILEPY'
import json, sys
p=json.load(open(sys.argv[1]))
w=p.get('wan',{})
l=p.get('lan',{})
print(w.get('mode',''))
print(w.get('address',''))
print(w.get('gateway',''))
print(l.get('mode',''))
print(l.get('address',''))
PROFILEPY
}

profile_vlans() {
  python3 - "$PROFILE" <<'VLANPY'
import json, sys
for v in json.load(open(sys.argv[1])).get('vlans',[]):
    print(f"{v['id']}|{v.get('mode','')}|{v.get('address','')}")
VLANPY
}

PROFILE_VALID=0
WAN_MODE=""
WAN_EXPECTED=""
WAN_GATEWAY_EXPECTED=""
LAN_MODE=""
LAN_EXPECTED=""
LAN_VLAN_COUNT=0
LAN_REQUIRED=0
LAN_STATUS="UNKNOWN"

mkdir -p "$(dirname "$RESULT")"

if [[ -x "$PROFILE_TOOL" ]]; then
  ok "Network profile helper installed."
else
  cf "Network profile helper missing."
fi

if [[ -s "$PROFILE" ]]; then
  ok "Network profile present."
else
  cf "Network profile missing."
fi

if [[ -x "$PROFILE_TOOL" && -s "$PROFILE" ]] && "$PROFILE_TOOL" validate "$PROFILE" >/dev/null 2>&1; then
  PROFILE_VALID=1
  ok "Network profile validates."
  mapfile -t META < <(profile_meta)
  WAN_MODE="${META[0]:-}"
  WAN_EXPECTED="${META[1]:-}"
  WAN_GATEWAY_EXPECTED="${META[2]:-}"
  LAN_MODE="${META[3]:-}"
  LAN_EXPECTED="${META[4]:-}"
  LAN_VLAN_COUNT="$(profile_vlans | awk 'NF {c++} END {print c+0}')"
  # Default DHCP LAN with no VLANs is optional. An explicitly static LAN or any
  # configured VLAN means the deployment expects eth1 to be available.
  if [[ "$LAN_MODE" == "static" || "$LAN_VLAN_COUNT" -gt 0 ]]; then
    LAN_REQUIRED=1
  fi
else
  cf "Network profile validation failed."
fi

if netplan generate >/dev/null 2>&1; then
  ok "Netplan generates successfully."
else
  cf "Netplan generation failed."
fi

# Give systemd-networkd a bounded opportunity to obtain DHCP leases and create VLANs.
if command -v networkctl >/dev/null 2>&1; then
  networkctl reconfigure "$WAN" >/dev/null 2>&1 || true
  networkctl reconfigure "$LAN" >/dev/null 2>&1 || true
  [[ "$WAN_MODE" == "dhcp" ]] && networkctl renew "$WAN" >/dev/null 2>&1 || true
  [[ "$LAN_MODE" == "dhcp" ]] && networkctl renew "$LAN" >/dev/null 2>&1 || true
  if (( PROFILE_VALID )); then
    while IFS='|' read -r vid vmode vaddr; do
      [[ -n "$vid" ]] || continue
      [[ "$vmode" == "dhcp" ]] && networkctl renew "vlan${vid}" >/dev/null 2>&1 || true
    done < <(profile_vlans)
  fi
fi

ready_now() {
  carrier "$WAN" || return 1
  [[ -n "$(ip4 "$WAN")" ]] || return 1
  mapfile -t defaults < <(ip -4 route show default 2>/dev/null)
  [[ ${#defaults[@]} -eq 1 && "$(default_iface)" == "$WAN" ]] || return 1

  if (( PROFILE_VALID )); then
    # An unused default DHCP eth1 is allowed to remain physically disconnected.
    # Once carrier is present, or the profile explicitly requires LAN/VLAN use,
    # normal LAN validation becomes mandatory.
    if (( LAN_REQUIRED )) || carrier "$LAN"; then
      carrier "$LAN" || return 1
      if [[ "$LAN_MODE" == "dhcp" || "$LAN_MODE" == "static" ]]; then
        [[ -n "$(ip4 "$LAN")" ]] || return 1
        [[ "$LAN_MODE" != "static" || "$(ip4 "$LAN")" == "$LAN_EXPECTED" ]] || return 1
      fi
      while IFS='|' read -r vid vmode vaddr; do
        [[ -n "$vid" ]] || continue
        local vname="vlan${vid}"
        ip link show "$vname" >/dev/null 2>&1 || return 1
        [[ -n "$(ip4 "$vname")" ]] || return 1
        [[ "$vmode" != "static" || "$(ip4 "$vname")" == "$vaddr" ]] || return 1
      done < <(profile_vlans)
    fi
  fi
  return 0
}

attempts=$(( (WAIT_SECONDS + 1) / 2 ))
(( attempts < 1 )) && attempts=1
for ((i=1; i<=attempts; i++)); do
  ready_now && break
  (( i < attempts )) && sleep 2
done

ip link show "$WAN" >/dev/null 2>&1 && ok "WAN eth0 exists." || cf "WAN eth0 missing."
ip link show "$LAN" >/dev/null 2>&1 && ok "LAN eth1 exists." || cf "LAN eth1 missing."
carrier "$WAN" && ok "WAN eth0 carrier UP." || cf "WAN eth0 carrier DOWN."
if carrier "$LAN"; then
  LAN_STATUS="CONNECTED"
  ok "LAN eth1 carrier UP."
elif (( LAN_REQUIRED )); then
  LAN_STATUS="REQUIRED_NOT_CONNECTED"
  cf "LAN eth1 is required by the configured static LAN/VLAN profile but has no carrier."
else
  LAN_STATUS="OPTIONAL_NOT_CONNECTED"
  info "LAN eth1 is not connected. eth1 is optional for this profile; LAN validation is skipped until a cable is connected."
fi

wan_addr="$(ip4 "$WAN")"
if [[ -n "$wan_addr" ]]; then
  ok "WAN eth0 IPv4 ${wan_addr}."
else
  cf "WAN eth0 has no IPv4 address."
fi
if [[ "$WAN_MODE" == "static" && -n "$WAN_EXPECTED" && "$wan_addr" != "$WAN_EXPECTED" ]]; then
  cf "WAN eth0 IPv4 ${wan_addr:-none}; expected ${WAN_EXPECTED}."
fi

mapfile -t DEFAULTS < <(ip -4 route show default 2>/dev/null)
if [[ ${#DEFAULTS[@]} -eq 1 ]]; then
  ok "Exactly one IPv4 default route is installed."
else
  cf "Expected exactly one IPv4 default route; found ${#DEFAULTS[@]}."
fi

if [[ "$(default_iface)" == "$WAN" ]]; then
  ok "Default route uses WAN eth0."
else
  cf "Default route does not use WAN eth0."
fi

if ip -4 route show default 2>/dev/null | grep -Eq ' dev (eth1|vlan[0-9]+)( |$)'; then
  cf "LAN eth1 or an eth1 VLAN has a prohibited default route."
else
  ok "LAN eth1 and LAN VLANs have no default route."
fi

if [[ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 1)" == "0" ]]; then
  ok "IPv4 forwarding disabled; collector is not routing WAN to LAN."
else
  cf "IPv4 forwarding enabled."
fi

if (( PROFILE_VALID )); then
  if [[ "$WAN_MODE" == "static" && -n "$WAN_GATEWAY_EXPECTED" ]]; then
    actual_gateway="$(default_gateway "$WAN")"
    [[ "$actual_gateway" == "$WAN_GATEWAY_EXPECTED" ]] && \
      ok "WAN gateway ${actual_gateway} matches profile." || \
      cf "WAN gateway ${actual_gateway:-none}; expected ${WAN_GATEWAY_EXPECTED}."
  fi

  if [[ "$LAN_MODE" == "none" ]]; then
    if carrier "$LAN" || (( LAN_REQUIRED )); then
      ok "LAN eth1 is configured as an unnumbered VLAN trunk parent."
    else
      info "LAN eth1 unnumbered trunk parent is not connected and is not required by the current profile."
    fi
  elif [[ "$LAN_MODE" == "dhcp" || "$LAN_MODE" == "static" ]]; then
    lan_addr="$(ip4 "$LAN")"
    if carrier "$LAN"; then
      [[ -n "$lan_addr" ]] && ok "LAN eth1 IPv4 ${lan_addr}." || cf "LAN eth1 has carrier but no IPv4 address."
      if [[ "$LAN_MODE" == "static" && -n "$LAN_EXPECTED" && "$lan_addr" != "$LAN_EXPECTED" ]]; then
        cf "LAN eth1 IPv4 ${lan_addr:-none}; expected ${LAN_EXPECTED}."
      fi
    elif (( LAN_REQUIRED )); then
      cf "LAN eth1 has no IPv4 address because the required LAN interface is not connected."
    else
      info "LAN eth1 has no IPv4 address because the optional LAN interface is not connected."
    fi
  fi

  while IFS='|' read -r vid vmode vexpected; do
    [[ -n "$vid" ]] || continue
    vname="vlan${vid}"
    if ip -d link show "$vname" 2>/dev/null | grep -Eq "vlan protocol 802\\.1Q id ${vid}( |$)"; then
      ok "${vname} VLAN ID ${vid} active on LAN eth1."
    else
      cf "${vname} missing or has the wrong 802.1Q VLAN ID."
    fi
    vaddr="$(ip4 "$vname")"
    [[ -n "$vaddr" ]] && ok "${vname} IPv4 ${vaddr}." || cf "${vname} has no IPv4 address."
    if [[ "$vmode" == "static" && -n "$vexpected" && "$vaddr" != "$vexpected" ]]; then
      cf "${vname} IPv4 ${vaddr:-none}; expected ${vexpected}."
    fi
  done < <(profile_vlans)
fi

# WAN/cloud checks. These do not cause rollback of a locally valid Netplan.
# NTP is intentionally excluded from the network validator. Time synchronization
# is validated by the dedicated Phase 1 and Phase 2 NTP checks with bounded retry.
getent ahostsv4 api.snapcraft.io >/dev/null 2>&1 && ok "WAN DNS resolves api.snapcraft.io." || xf "WAN DNS cannot resolve api.snapcraft.io."
getent ahostsv4 portal.domotz.com >/dev/null 2>&1 && ok "WAN DNS resolves portal.domotz.com." || xf "WAN DNS cannot resolve portal.domotz.com."
tcp_open portal.domotz.com 443 && ok "Domotz TCP 443 reachable through WAN." || xf "Domotz TCP 443 unreachable through WAN."
tcp_open messaging-us-east-1-cell-1.domotz.com 5671 && ok "Domotz TCP 5671 reachable through WAN." || xf "Domotz TCP 5671 unreachable through WAN."
configuration_result="PASS"
connectivity_result="PASS"
result="PASS"
failure_category="NONE"
if (( ${#CONFIG_FAILS[@]} > 0 )); then
  configuration_result="FAIL"
  result="FAIL"
  failure_category="CONFIGURATION"
fi
if (( ${#CONNECT_FAILS[@]} > 0 )); then
  connectivity_result="FAIL"
  result="FAIL"
  if [[ "$failure_category" == "CONFIGURATION" ]]; then
    failure_category="BOTH"
  else
    failure_category="CONNECTIVITY"
  fi
fi

{
  echo "result=${result}"
  echo "revision=${REVISION}"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  echo "configuration_result=${configuration_result}"
  echo "connectivity_result=${connectivity_result}"
  echo "failure_category=${failure_category}"
echo "wan_interface=${WAN}"
  echo "wan_carrier=$(carrier "$WAN" && echo UP || echo DOWN)"
  echo "wan_ipv4=$(ip4 "$WAN")"
  echo "wan_gateway=$(default_gateway "$WAN")"
  echo "default_route_interface=$(default_iface)"
  echo "lan_interface=${LAN}"
  echo "lan_required=${LAN_REQUIRED}"
  echo "lan_status=${LAN_STATUS}"
  echo "lan_carrier=$(carrier "$LAN" && echo UP || echo DOWN)"
  echo "lan_ipv4=$(ip4 "$LAN")"
  echo "ip_forward=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || true)"
  echo
  echo "CONFIGURATION_FAILURES:"
  if (( ${#CONFIG_FAILS[@]} > 0 )); then printf -- '- %s\n' "${CONFIG_FAILS[@]}"; else echo '- none'; fi
  echo
  echo "CONNECTIVITY_FAILURES:"
  if (( ${#CONNECT_FAILS[@]} > 0 )); then printf -- '- %s\n' "${CONNECT_FAILS[@]}"; else echo '- none'; fi
} > "$RESULT"
chmod 640 "$RESULT"

[[ "$configuration_result" == "FAIL" ]] && exit 10
[[ "$connectivity_result" == "FAIL" ]] && exit 20
exit 0
NETVALIDATOR
  chmod 750 "${NETWORK_VALIDATOR}"
  chown root:root "${NETWORK_VALIDATOR}"
}

stage_production_network_profile() {
  install_network_profile_tool
  install_live_network_discovery_tool
  install_network_validator
  install -d -m 750 "${NETWORK_PROFILE_DIR}"
  if [[ -n "${NETWORK_PROFILE_SOURCE}" ]]; then
    [[ -r "${NETWORK_PROFILE_SOURCE}" ]] || error_exit "Network profile is not readable: ${NETWORK_PROFILE_SOURCE}"
    cp -f "${NETWORK_PROFILE_SOURCE}" "${NETWORK_PROFILE_FILE}"; chmod 600 "${NETWORK_PROFILE_FILE}"
    progress_message "Using supplied dual-homed WAN/LAN network profile: ${NETWORK_PROFILE_SOURCE}"
  else
    write_default_network_profile
    progress_message "No network profile supplied; using default WAN eth0 DHCP + LAN eth1 DHCP profile."
  fi
  "${NETWORK_PROFILE_TOOL}" render "${NETWORK_PROFILE_FILE}" "${NETPLAN_FILE}" "${NETWORK_PROFILE_RESULT_FILE}" || error_exit "WAN/LAN/VLAN profile rendering failed. Review ${NETWORK_PROFILE_RESULT_FILE}."
  chmod 600 "${NETPLAN_FILE}"
}

remove_stale_cloud_init_netplans() {
  shopt -s nullglob
  local files=(/etc/netplan/50-cloud-init*)
  if (( ${#files[@]} > 0 )); then
    rm -f "${files[@]}"
    progress_message "Removed stale cloud-init Netplan files."
  fi
  shopt -u nullglob
}

stage_network_config() {
  step_message 10 "Stage dual-homed WAN eth0 / LAN eth1 networking"
  [[ -f "${NETPLAN_FILE}" ]] && cp -a "${NETPLAN_FILE}" "${NETPLAN_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  [[ -f "${NETWORK_PROFILE_FILE}" ]] && cp -a "${NETWORK_PROFILE_FILE}" "${NETWORK_PROFILE_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  stage_production_network_profile
  remove_stale_cloud_init_netplans
  mkdir -p /etc/cloud/cloud.cfg.d
  cat > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg <<'EOF'
network: {config: disabled}
EOF
  cat > "${IP_FORWARD_SYSCTL_FILE}" <<'EOF'
# Solutionz RMM V06.100626N - dual-homed collector, not a router.
net.ipv4.ip_forward=0
EOF
  chmod 644 "${IP_FORWARD_SYSCTL_FILE}"; sysctl -w net.ipv4.ip_forward=0 >/dev/null
  netplan generate
  progress_message "Netplan validated: eth0 WAN owns the only default route; eth1/VLANs are AV LAN paths with no default route; IPv4 forwarding is disabled."
}

repair_resolv_conf() {
  step_message 11 "Repair and validate DNS resolver"

  systemctl enable --now systemd-resolved

  if [[ -L "${RESOLV_FILE}" ]]; then
    local current_target
    current_target="$(readlink -f "${RESOLV_FILE}" || true)"
    if [[ "${current_target}" != "${RESOLV_TARGET}" ]]; then
      rm -f "${RESOLV_FILE}"
      ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
    fi
  else
    rm -f "${RESOLV_FILE}"
    ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
  fi

  [[ "$(readlink -f "${RESOLV_FILE}")" == "${RESOLV_TARGET}" ]] || \
    error_exit "${RESOLV_FILE} does not resolve to ${RESOLV_TARGET}."

  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS validation failed: api.snapcraft.io did not return an IPv4 address."
  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS validation failed: archive.ubuntu.com did not return an IPv4 address."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS validation failed: security.ubuntu.com did not return an IPv4 address."

  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl query api.snapcraft.io >/dev/null 2>&1 || error_exit "systemd-resolved query failed for api.snapcraft.io."
  fi

  ls -l "${RESOLV_FILE}"
  progress_message "True DNS validation passed using configured system resolver."
}

normalize_host_entries() {
  step_message 12 "Normalize Solutionz hostname entries"

  local tmp
  tmp="$(mktemp)"
  awk '
    $0 !~ /(^|[[:space:]])solzrmm([[:space:]]|$)/ &&
    $0 !~ /(^|[[:space:]])solz-rmm([[:space:]]|$)/ {print}
  ' /etc/hosts > "${tmp}"

  printf '127.0.1.1\tsolz-rmm solzrmm\n' >> "${tmp}"
  cat "${tmp}" > /etc/hosts
  rm -f "${tmp}"

  grep -qxF $'127.0.1.1\tsolz-rmm solzrmm' /etc/hosts || \
    error_exit "Unable to normalize Solutionz hostname entry."
}

grub_get_value() {
  local variable="$1"
  local line
  line="$(grep -E "^${variable}=" "${GRUB_FILE}" | head -n1 || true)"
  line="${line#*=}"
  line="${line#\"}"
  line="${line%\"}"
  printf '%s' "${line}"
}

grub_set_value() {
  local variable="$1"
  local value="$2"

  if grep -qE "^${variable}=" "${GRUB_FILE}"; then
    sed -i -E "s|^${variable}=.*|${variable}=\"${value}\"|" "${GRUB_FILE}"
  else
    printf '%s="%s"\n' "${variable}" "${value}" >> "${GRUB_FILE}"
  fi
}

append_grub_param() {
  local variable="$1"
  local param="$2"
  local value
  value="$(grub_get_value "${variable}")"

  if [[ " ${value} " == *" ${param} "* ]]; then
    progress_message "${variable} already contains ${param}."
    return 0
  fi

  value="${value:+${value} }${param}"
  grub_set_value "${variable}" "${value}"
  progress_message "Added ${param} to ${variable}."
}

configure_grub_and_serial() {
  step_message 13 "Configure interface naming and V1210 USB-C COM console"

  cp -a "${GRUB_FILE}" "${GRUB_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"

  append_grub_param "GRUB_CMDLINE_LINUX" "net.ifnames=0"
  append_grub_param "GRUB_CMDLINE_LINUX" "biosdevname=0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=tty0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=ttyS0,115200n8"

  [[ -c "${SERIAL_DEVICE}" ]] || error_exit "${SERIAL_DEVICE} is not present."

  mkdir -p "${SERIAL_DROPIN_DIR}"
  cat > "${SERIAL_DROPIN_FILE}" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -- \u' --keep-baud 115200,57600,38400,9600 ttyS0 vt220
EOF

  systemctl daemon-reload
  systemctl enable --now "${SERIAL_SERVICE}"
  systemctl is-enabled "${SERIAL_SERVICE}" >/dev/null 2>&1 || \
    error_exit "${SERIAL_SERVICE} is not enabled."
  systemctl is-active "${SERIAL_SERVICE}" >/dev/null 2>&1 || \
    error_exit "${SERIAL_SERVICE} is not active."

  # The systemd unit state is authoritative for the serial-console acceptance
  # check. An agetty process may be transient or respawn around login/session
  # changes, so pgrep is diagnostic only and must not fail the production build.
  if pgrep -a agetty 2>/dev/null | grep -q 'ttyS0'; then
    progress_message "agetty process currently visible on ttyS0."
  else
    warning_message "No persistent agetty process is currently visible on ttyS0; ${SERIAL_SERVICE} is enabled/active and remains the authoritative check."
  fi

  update-grub
  progress_message "V1210 USB-C COM console configured for 115200 8N1."
}

install_local_serial_config_tool() {
  step_message 14 "Install field WAN/LAN/VLAN configuration utility"
  cat > "${LOCAL_CONFIG_TOOL}" <<'LOCALCFG'
#!/usr/bin/env bash
set -Eeuo pipefail

REVISION="V06.100626N"
NETPLAN="/etc/netplan/00-installer-config.yaml"
PROFILE="/etc/solutionz-rmm/network-profile.json"
TOOL="/usr/local/sbin/solutionz-rmm-network-profile"
VALIDATOR="/usr/local/sbin/solutionz-rmm-network-validate"
LIVE="/usr/local/sbin/solutionz-rmm-live-network-discovery"
LIVE_RESULT="/var/lib/rswsolutionz-rmm/network-live-discovery-V06.100626N.result"
POSTVALIDATOR="/usr/local/sbin/rswsolutionz-rmm-postreboot-validate"
RESULT="/var/lib/rswsolutionz-rmm/network-validation-V06.100626N.result"
CHANGE="/var/lib/rswsolutionz-rmm/network-change-V06.100626N.result"
PROFILE_RESULT="/var/lib/rswsolutionz-rmm/network-profile-V06.100626N.result"
POST_RESULT="/var/lib/rswsolutionz-rmm/postreboot-validation-V06.100626N.result"
SECURITY_RESULT="/var/lib/rswsolutionz-rmm/security-validation-V06.100626N.result"
INTEGRITY="/usr/local/sbin/solutionz-rmm-integrity-baseline"
SECURITY_BASELINE="/var/lib/rswsolutionz-rmm/security-baseline-V06.100626N.sha256"
INSTALL_STATE="/var/lib/rswsolutionz-rmm/install.state"
ENGINEERING_USER="solz_eng"
ENGINEERING_GROUP="solutionz-rmm-engineering"
ENGINEERING_PASSWORD_TOOL="/usr/local/sbin/solutionz-rmm-engineering-password-setup"
ENGINEERING_PASSWORD_MARKER="/var/lib/rswsolutionz-rmm/engineering-password-provisioned"
AUTO=0
SESSION_MODE="manual"
PRODUCTION_VALIDATION_RESULT="NOT_RUN"
PRE_NETPLAN_SHA256=""
PRE_PROFILE_SHA256=""

case "${1:-}" in
  --restricted-login|--serial-auto)
    # --serial-auto is retained as a backwards-compatible alias.
    AUTO=1
    SESSION_MODE="technician"
    ;;
  --engineering-login)
    AUTO=1
    SESSION_MODE="engineering"
    ;;
  "")
    ;;
  *)
    echo "Usage: $(basename "$0") [--restricted-login|--engineering-login]"
    exit 2
    ;;
esac
[[ $# -le 1 ]] || { echo "Usage: $(basename "$0") [--restricted-login|--engineering-login]"; exit 2; }
[[ $EUID -eq 0 ]] || { echo "Run with sudo."; exit 1; }


sha_file() { [[ -f "$1" ]] && sha256sum "$1" | awk '{print $1}' || true; }
bak() { [[ -f "$1" ]] && cp -a "$1" "$1.networkcfg.bak.$(date -u +%Y%m%dT%H%M%SZ)"; }
latest() { ls -1t "$1".networkcfg.bak.* 2>/dev/null | head -n1 || true; }
backup() {
  PRE_NETPLAN_SHA256="$(sha_file "$NETPLAN")"
  PRE_PROFILE_SHA256="$(sha_file "$PROFILE")"
  bak "$NETPLAN"; bak "$PROFILE"
}
prechange_integrity_verify() {
  if [[ ! -x "$INTEGRITY" || ! -s "$SECURITY_BASELINE" ]]; then
    echo "SECURITY CHECK FAILED: integrity tool/baseline is missing. Network changes are blocked."
    return 1
  fi
  if ! "$INTEGRITY" --verify >/dev/null 2>&1; then
    echo "SECURITY CHECK FAILED: current appliance integrity does not match the approved baseline."
    echo "Network changes are blocked until RMM Engineering reviews the integrity failure."
    return 1
  fi
  return 0
}
ip4() { ip -o -4 addr show dev "$1" scope global 2>/dev/null | awk 'NR==1 {print $4}'; }
def() { ip -4 route show default 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}'; }
gw() { ip -4 route show default 2>/dev/null | awk -v i="$1" '$0 ~ (" dev " i "( |$)") {print $3; exit}'; }

active_ssh_iface() {
  local client=""
  if [[ -n "${SSH_CONNECTION:-}" ]]; then client="${SSH_CONNECTION%% *}"; fi
  if [[ -z "$client" && -n "${SSH_CLIENT:-}" ]]; then client="${SSH_CLIENT%% *}"; fi
  [[ -n "$client" ]] || return 0
  ip route get "$client" 2>/dev/null | awk 'NR==1 {for(i=1;i<=NF;i++) if($i=="dev") {print $(i+1); exit}}'
}

guard_change() {
  local scope="$1" sif
  sif="$(active_ssh_iface)"
  [[ -n "$sif" ]] || return 0
  case "$scope" in
    wan) [[ "$sif" == "eth0" ]] || return 0 ;;
    lan) [[ "$sif" == "eth1" || "$sif" == vlan* ]] || return 0 ;;
    all) ;;
  esac
  echo
  echo "NETWORK CHANGE BLOCKED FOR SESSION SAFETY"
  echo "This SSH session is using ${sif}. Changing that network could terminate the session before rollback can complete."
  echo "Use the V1210 USB-C COM console (115200 8N1), or connect through the opposite network when changing only one side."
  return 1
}

change() {
  mkdir -p /var/lib/rswsolutionz-rmm
  {
    echo "result=$1"
    echo "revision=$REVISION"
    echo "timestamp_utc=$(date -u +%FT%TZ)"
    echo "user=${SUDO_USER:-${USER:-unknown}}"
    echo "tty=$(tty 2>/dev/null || echo none)"
    echo "ssh_connection=${SSH_CONNECTION:-none}"
    echo "active_session_interface=$(active_ssh_iface)"
    echo "change_type=$2"
    echo "reason=$3"
    echo "wan_ipv4=$(ip4 eth0)"
    echo "wan_gateway=$(gw eth0)"
    echo "default_route_interface=$(def)"
    echo "lan_ipv4=$(ip4 eth1)"
    echo "previous_netplan_sha256=$PRE_NETPLAN_SHA256"
    echo "current_netplan_sha256=$(sha_file "$NETPLAN")"
    echo "previous_profile_sha256=$PRE_PROFILE_SHA256"
    echo "current_profile_sha256=$(sha_file "$PROFILE")"
    echo "network_validation_result=$RESULT"
    echo "production_validation_result=$PRODUCTION_VALIDATION_RESULT"
    echo "production_validation_file=$POST_RESULT"
    echo "security_validation_file=$SECURITY_RESULT"
    echo "security_baseline=$SECURITY_BASELINE"
    [[ -s "$SECURITY_BASELINE" ]] && echo "security_baseline_sha256=$(sha256sum "$SECURITY_BASELINE" | awk '{print $1}')"
  } > "$CHANGE"
  chmod 640 "$CHANGE"
}

restore_prev() {
  local n p
  n="$(latest "$NETPLAN")"
  p="$(latest "$PROFILE")"
  [[ -n "$n" ]] && cp -a "$n" "$NETPLAN"
  [[ -n "$p" ]] && cp -a "$p" "$PROFILE"
  netplan generate >/dev/null 2>&1 && netplan apply >/dev/null 2>&1
}

rollback_and_validate() {
  restore_prev || return 1
  set +e
  "$VALIDATOR" >/dev/null 2>&1
  local rc=$?
  set -e
  [[ $rc -ne 10 ]]
}

stage() {
  local src="$1" t r
  [[ -r "$src" ]] || { echo "Profile not readable."; return 1; }
  prechange_integrity_verify || return 1
  backup
  t="$(mktemp)"
  r="$(mktemp)"
  "$TOOL" render "$src" "$t" "$r" || { cat "$r" 2>/dev/null || true; rm -f "$t" "$r"; return 1; }
  mkdir -p /etc/solutionz-rmm
  cp -f "$src" "$PROFILE"
  cp -f "$t" "$NETPLAN"
  cp -f "$r" "$PROFILE_RESULT"
  chmod 600 "$PROFILE" "$NETPLAN"
  chmod 640 "$PROFILE_RESULT"
  rm -f "$t" "$r"
}

refresh_integrity_baseline() {
  [[ -x "$INTEGRITY" ]] || { echo "ERROR - Security integrity tool is not installed: $INTEGRITY"; return 1; }
  "$INTEGRITY" --refresh
}

run_production_validation() {
  PRODUCTION_VALIDATION_RESULT="NOT_AVAILABLE"
  [[ -x "$POSTVALIDATOR" ]] || { echo "WARN - Production validator is not installed."; return 0; }
  echo
  echo "Running automatic full production validation..."
  set +e
  "$POSTVALIDATOR" --force
  local rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    PRODUCTION_VALIDATION_RESULT="PASS"
    echo "FULL PRODUCTION VALIDATION: PASS"
  else
    PRODUCTION_VALIDATION_RESULT="FAIL"
    echo "FULL PRODUCTION VALIDATION: FAIL"
    echo "Network configuration remains committed because local network validation passed."
    echo "Review: $POST_RESULT"
  fi
  return 0
}

apply() {
  local type="$1" rc
  echo
  echo "Proposed Solutionz network profile:"
  cat "$PROFILE"
  echo
  echo "Generated Netplan:"
  cat "$NETPLAN"
  echo
  read -r -p "Apply now? Type 'yes': " a
  if [[ "$a" != "yes" ]]; then
    echo "Change cancelled; restoring the previously committed Netplan/profile."
    restore_prev || true
    return 0
  fi

  if ! netplan generate; then
    echo "Netplan generation failed; rolling back."
    rollback_and_validate || true
    change FAIL "$type" NETPLAN_GENERATE_FAILED
    return 1
  fi

  if ! netplan apply; then
    echo "Netplan apply failed; rolling back."
    rollback_and_validate || true
    change FAIL "$type" NETPLAN_APPLY_FAILED
    return 1
  fi

  echo
  echo "Refreshing detected live NIC state after network apply..."
  [[ -x "$LIVE" ]] && "$LIVE" || true

  echo
  echo "Running automatic post-change WAN/LAN/VLAN validation..."
  set +e
  "$VALIDATOR"
  rc=$?
  set -e

  if [[ $rc -eq 10 ]]; then
    echo
    echo "LOCAL NETWORK CONFIGURATION VALIDATION: FAIL"
    echo "Restoring the previous working Netplan/profile automatically..."
    if rollback_and_validate; then
      change FAIL "$type" CONFIGURATION_FAILED_ROLLBACK_COMPLETED
      echo "ROLLBACK COMPLETED AND LOCAL CONFIGURATION REVALIDATED."
    else
      change FAIL "$type" CONFIGURATION_FAILED_ROLLBACK_FAILED
      echo "ROLLBACK FAILED OR COULD NOT BE REVALIDATED. Use USB-C COM recovery."
    fi
    return 1
  fi

  if [[ $rc -eq 20 ]]; then
    echo
    echo "LOCAL NETWORK CONFIGURATION: PASS"
    echo "WAN CONNECTIVITY VALIDATION: FAIL"
    echo "Addressing is retained because the local Netplan is valid. Review upstream DNS/firewall/WAN access."
    if ! refresh_integrity_baseline; then
      change FAIL "$type" SECURITY_BASELINE_REFRESH_FAILED
      echo "SECURITY BASELINE REFRESH: FAIL. Network configuration remains applied for recovery."
      return 1
    fi
    run_production_validation
    if [[ "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]; then
      change PASS "$type" LOCAL_CONFIGURATION_VALID_CONNECTIVITY_FAILED_BUT_PRODUCTION_VALIDATION_PASSED
    else
      change FAIL "$type" PRODUCTION_VALIDATION_FAILED_CONFIGURATION_RETAINED
    fi
    return 0
  fi

  echo
  echo "AUTOMATIC NETWORK VALIDATION: PASS"
  if ! refresh_integrity_baseline; then
    change FAIL "$type" SECURITY_BASELINE_REFRESH_FAILED
    echo "SECURITY BASELINE REFRESH: FAIL. Network configuration remains applied for recovery."
    return 1
  fi
  run_production_validation
  if [[ "$PRODUCTION_VALIDATION_RESULT" == "PASS" ]]; then
    change PASS "$type" AUTOMATIC_NETWORK_AND_SECURITY_VALIDATION_PASSED
  else
    change FAIL "$type" PRODUCTION_VALIDATION_FAILED_CONFIGURATION_RETAINED
  fi
  return 0
}

modify() {
  local section="$1" mode="$2" addr="${3:-}" g="${4:-}" dns="${5:-}" tmp
  tmp="$(mktemp)"
  python3 - "$PROFILE" "$tmp" "$section" "$mode" "$addr" "$g" "$dns" <<'MODIFYPY'
import json,sys
src,out,sec,mode,addr,gw,dns=sys.argv[1:]
try:
    p=json.load(open(src))
except Exception:
    p={"revision":"V06.100626N","wan":{"interface":"eth0","mode":"dhcp","dns":[]},"lan":{"interface":"eth1","mode":"dhcp"},"vlans":[]}
if sec=='wan':
    p['wan']={'interface':'eth0','mode':mode,'dns':[]}
    if mode=='static':
        p['wan'].update(address=addr,gateway=gw,dns=[x.strip() for x in dns.split(',') if x.strip()])
else:
    p['lan']={'interface':'eth1','mode':mode}
    if mode=='static': p['lan']['address']=addr
json.dump(p,open(out,'w'),indent=2)
open(out,'a').write('\n')
MODIFYPY
  stage "$tmp"
  rm -f "$tmp"
}

wan() {
  guard_change wan || return 1
  local m a g d
  read -r -p "WAN mode [dhcp/static]: " m
  m="${m:-dhcp}"
  if [[ "$m" == "static" ]]; then
    read -r -p "WAN IPv4/CIDR: " a
    read -r -p "Gateway: " g
    read -r -p "DNS comma separated: " d
    modify wan "$m" "$a" "$g" "$d"
  elif [[ "$m" == "dhcp" ]]; then
    modify wan dhcp
  else
    echo "Invalid WAN mode."
    return 1
  fi
  apply wan
}

lan() {
  guard_change lan || return 1
  local m a
  read -r -p "LAN native mode [dhcp/static/none]: " m
  m="${m:-dhcp}"
  if [[ "$m" == "static" ]]; then
    read -r -p "LAN IPv4/CIDR (no gateway): " a
    modify lan "$m" "$a"
  elif [[ "$m" == "dhcp" || "$m" == "none" ]]; then
    modify lan "$m"
  else
    echo "Invalid LAN mode."
    return 1
  fi
  apply lan
}

wizard() {
  guard_change all || return 1
  local t
  t="$(mktemp)"
  "$TOOL" wizard "$t" && stage "$t" && apply wan_lan_vlan
  rm -f "$t"
}

saved() {
  guard_change all || return 1
  local p
  read -r -p "JSON profile path: " p
  stage "$p" && apply saved_profile
}

show_live() {
  echo
  echo "Scanning live network interfaces..."
  if [[ -x "$LIVE" ]]; then
    "$LIVE" || true
  else
    echo "WARN - Live network discovery utility is not installed: $LIVE"
  fi
}

show() {
  show_live
  echo
  echo "PERSISTENT SOLUTIONZ NETWORK CONFIGURATION"
  echo "------------------------------------------------"
  if [[ -s "$PROFILE" ]]; then
    cat "$PROFILE"
  else
    echo "No Solutionz network profile found."
  fi
  echo
  echo "SECURITY / ROUTING STATE"
  echo "------------------------------------------------"
  echo "IPv4 forwarding: $(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo unknown)"
  [[ -s "$RESULT" ]] && { echo; echo "LAST NETWORK VALIDATION"; echo "------------------------------------------------"; cat "$RESULT"; }
}

validate() {
  set +e
  "$VALIDATOR"
  local rc=$?
  set -e
  cat "$RESULT" 2>/dev/null || true
  return $rc
}

validate_full() {
  validate || true
  run_production_validation
  [[ -s "$SECURITY_RESULT" ]] && { echo; cat "$SECURITY_RESULT"; }
}

restore() {
  guard_change all || return 1
  prechange_integrity_verify || return 1
  local n p a
  n="$(latest "$NETPLAN")"
  p="$(latest "$PROFILE")"
  echo "Netplan: ${n:-none}"
  echo "Profile: ${p:-none}"
  read -r -p "Restore? Type yes: " a
  [[ "$a" == "yes" ]] || return 0
  [[ -n "$n" ]] && cp -a "$n" "$NETPLAN"
  [[ -n "$p" ]] && cp -a "$p" "$PROFILE"
  netplan generate && netplan apply
  [[ -x "$LIVE" ]] && "$LIVE" || true
  validate || true
  refresh_integrity_baseline || true
  run_production_validation
}

engineering_session_authenticated() {
  [[ "${SUDO_USER:-}" == "${ENGINEERING_USER}" ]] || return 1
  id -nG "${ENGINEERING_USER}" 2>/dev/null | tr ' ' '\n' | grep -qx "${ENGINEERING_GROUP}"
}

engineering_access() {
  echo
  echo "============================================================"
  echo "ENGINEERING LOGIN / PASSWORD SETUP"
  echo "============================================================"

  if ! engineering_session_authenticated; then
    if [[ -s "${ENGINEERING_PASSWORD_MARKER}" ]]; then
      echo "Engineering password is already provisioned."
      echo "Enter the engineering password to open an authenticated engineering session."
      echo
      /usr/bin/ssh -tt         -o PreferredAuthentications=password         -o PubkeyAuthentication=no         -o NumberOfPasswordPrompts=3         -o StrictHostKeyChecking=no         -o UserKnownHostsFile=/dev/null         "${ENGINEERING_USER}@127.0.0.1" || true
    else
      local wan_ip
      wan_ip="$(ip -4 -o addr show dev eth0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)"
      echo "First-time engineering password creation is blocked from technician sessions."
      echo "An engineer must authenticate as ${ENGINEERING_USER} using the approved Solutionz engineering SSH private key."
      echo
      if [[ -n "${wan_ip}" ]]; then
        echo "From the engineering workstation:"
        echo "  ssh -i <Solutionz-engineering-private-key> ${ENGINEERING_USER}@${wan_ip}"
      else
        echo "From the engineering workstation:"
        echo "  ssh -i <Solutionz-engineering-private-key> ${ENGINEERING_USER}@<RMM-IP>"
      fi
      echo
      echo "That authenticated engineering login opens this same menu in engineering mode."
      echo "Select option 9 again to create the local ${ENGINEERING_USER} password."
    fi
    return 0
  fi

  if [[ "$(head -n1 "${INSTALL_STATE}" 2>/dev/null || true)" != "phase2_system_validated" ]]; then
    echo "Engineering password setup is unavailable until Phase 2 reports phase2_system_validated."
    return 1
  fi

  if [[ ! -s "${ENGINEERING_PASSWORD_MARKER}" ]]; then
    echo "First-time engineering setup detected."
    echo "The current session is authenticated as ${ENGINEERING_USER}."
    echo
    "${ENGINEERING_PASSWORD_TOOL}" || return $?
  else
    echo "Engineering password is already provisioned."
  fi

  while true; do
    cat <<'ENGMENU'

Engineering Session
1) Open engineering shell
2) Change solz_eng password
3) Return to Solutionz RMM configuration menu
ENGMENU
    read -r -p "Engineering selection: " ec
    case "${ec}" in
      1)
        local eng_home
        eng_home="$(getent passwd "${ENGINEERING_USER}" | awk -F: '{print $6}')"
        echo "Opening engineering shell. Type 'exit' to return to the RMM menu."
        runuser -u "${ENGINEERING_USER}" -- env           HOME="${eng_home}" USER="${ENGINEERING_USER}" LOGNAME="${ENGINEERING_USER}"           SHELL=/bin/bash TERM="${TERM:-xterm}"           PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin           /bin/bash --noprofile --norc -i
        ;;
      2)
        "${ENGINEERING_PASSWORD_TOOL}" --change || true
        ;;
      3)
        return 0
        ;;
      *)
        echo "Invalid engineering selection."
        ;;
    esac
  done
}

echo
echo "AUTO-DETECT CURRENT NETWORK"
echo "------------------------------------------------"
show_live

while true; do
  cat <<'MENU'

Solutionz RMM Dual-Homed Network Configuration - Revision V06.100626N
1) Configure WAN / eth0 (DHCP or static; default route/DNS)
2) Configure LAN / eth1 native network (DHCP, static, or unnumbered trunk)
3) Guided WAN + LAN + 802.1Q VLAN configuration (VLANs on eth1)
4) Apply saved WAN/LAN/VLAN JSON profile
5) Show live + persistent network status
6) Refresh detected live network information
7) Run automatic network + security validation
8) Restore previous network configuration
9) Engineering Login / Password Setup
10) Log out

eth0 = WAN/cloud | eth1 = AV/control LAN | VLANs on eth1 | forwarding disabled
Live detected state comes from the running Linux network stack, not Netplan.
Netplan remains the persistent configuration mechanism across reboot.
USB-C COM = independent recovery/configuration path
Every applied network change is automatically rediscovered and validated; local configuration failures roll back.
MENU
  if [[ "${SESSION_MODE}" == "engineering" ]]; then
    echo "Session: ENGINEERING (${ENGINEERING_USER})"
  elif [[ "${SESSION_MODE}" == "technician" ]]; then
    echo "Session: TECHNICIAN"
  fi
  read -r -p "Selection: " c
  case "$c" in
    1) wan ;;
    2) lan ;;
    3) wizard ;;
    4) saved ;;
    5) show ;;
    6) show_live ;;
    7) validate_full || true ;;
    8) restore ;;
    9) engineering_access ;;
    10) if (( AUTO )); then exit 90; else exit 0; fi ;;
    *) echo "Invalid selection." ;;
  esac
done
LOCALCFG
  chmod 750 "${LOCAL_CONFIG_TOOL}"
  chown root:root "${LOCAL_CONFIG_TOOL}"

  cat > "${ENGINEERING_PASSWORD_TOOL}" <<'ENGPASS'
#!/usr/bin/env bash
set -Eeuo pipefail
ENGINEERING_USER="solz_eng"
STATE_FILE="/var/lib/rswsolutionz-rmm/install.state"
MARKER="/var/lib/rswsolutionz-rmm/engineering-password-provisioned"
MODE="${1:-initial}"

case "${MODE}" in
  initial|--change) ;;
  *)
    echo "Usage: $(basename "$0") [--change]" >&2
    exit 79
    ;;
esac

[[ ${EUID} -eq 0 ]] || { echo "ERROR: engineering password setup must run through its authorized sudo rule." >&2; exit 80; }
[[ "${SUDO_USER:-}" == "${ENGINEERING_USER}" ]] || { echo "ERROR: only ${ENGINEERING_USER} may provision the engineering password." >&2; exit 81; }
[[ -t 0 && -t 1 ]] || { echo "ERROR: an interactive terminal is required." >&2; exit 82; }
[[ "$(head -n1 "${STATE_FILE}" 2>/dev/null || true)" == "phase2_system_validated" ]] || {
  echo "ERROR: engineering password provisioning is blocked until Phase 2 system validation passes." >&2
  exit 83
}

if [[ -s "${MARKER}" && "${MODE}" == "initial" ]]; then
  exit 0
fi

id "${ENGINEERING_USER}" >/dev/null 2>&1 || { echo "ERROR: ${ENGINEERING_USER} account is missing." >&2; exit 84; }

echo
echo "============================================================"
if [[ "${MODE}" == "--change" ]]; then
  echo "Solutionz RMM Engineering Password Change"
else
  echo "Solutionz RMM Engineering Credential Setup"
fi
echo "============================================================"
echo "Engineering identity is authenticated as ${ENGINEERING_USER}."
if [[ "${MODE}" == "--change" ]]; then
  echo "Create the replacement local password for ${ENGINEERING_USER}."
else
  echo "Create the local password for ${ENGINEERING_USER}."
fi
echo "This password is not written to Setup, logs, or the provisioning marker."
echo

/usr/bin/passwd "${ENGINEERING_USER}" || { echo "Engineering password was not configured." >&2; exit 85; }

mkdir -p "$(dirname "${MARKER}")"
{
  echo "engineering_login=${ENGINEERING_USER}"
  echo "status=configured"
  echo "timestamp_utc=$(date -u +%FT%TZ)"
  if [[ "${MODE}" == "--change" ]]; then
    echo "source=authenticated_engineering_menu_password_change"
  else
    echo "source=authenticated_engineering_menu_first_time_setup"
  fi
} > "${MARKER}"
chmod 640 "${MARKER}"

echo
echo "Engineering password configured successfully."
ENGPASS
  chmod 750 "${ENGINEERING_PASSWORD_TOOL}"
  chown root:root "${ENGINEERING_PASSWORD_TOOL}"

  cat > "${ENGINEERING_PASSWORD_SUDOERS_FILE}" <<EOF
${ENGINEERING_USER} ALL=(root) NOPASSWD: ${ENGINEERING_PASSWORD_TOOL}
EOF
  chmod 440 "${ENGINEERING_PASSWORD_SUDOERS_FILE}"
  visudo -cf "${ENGINEERING_PASSWORD_SUDOERS_FILE}" >/dev/null || error_exit "Engineering password provisioning sudoers validation failed."

  cat > "${LOCAL_CONFIG_SUDOERS_FILE}" <<EOF
%${FIELD_TECH_GROUP} ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL}
%${ENGINEERING_GROUP} ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL}
%sudo ALL=(root) NOPASSWD: ${LOCAL_CONFIG_TOOL}
EOF
  chmod 440 "${LOCAL_CONFIG_SUDOERS_FILE}"
  visudo -cf "${LOCAL_CONFIG_SUDOERS_FILE}" >/dev/null || error_exit "Local config sudoers validation failed."

  # Remove the old serial-only launcher so it cannot compete with the new
  # all-interactive-login access policy.
  rm -f "${LEGACY_SERIAL_PROFILE_FILE}"

  cat > "${ACCESS_PROFILE_FILE}" <<EOF
# Solutionz RMM interactive access policy. This file is sourced by login shells.
# Engineering membership always wins. A technician who is not an engineer is
# placed directly into the controlled RMM configuration menu and is logged out
# when the menu exits. SSH is independently protected by sshd ForceCommand.

case "\$-" in
  *i*) ;;
  *) return 0 2>/dev/null || exit 0 ;;
esac

if [ "\${SOLUTIONZ_RMM_MENU_ACTIVE:-0}" != "1" ]; then
  _solutionz_user="\$(id -un 2>/dev/null || true)"
  _solutionz_groups="\$(id -nG "\${_solutionz_user}" 2>/dev/null || true)"

  if printf '%s\n' "\${_solutionz_groups}" | tr ' ' '\n' | grep -qx '${ENGINEERING_GROUP}'; then
    export SOLUTIONZ_RMM_MENU_ACTIVE=1
    echo
    echo "Solutionz engineering session detected; launching RMM configuration menu."
    if [ "\${EUID:-\$(id -u)}" -eq 0 ]; then
      "${LOCAL_CONFIG_TOOL}" --engineering-login || true
    else
      sudo -n "${LOCAL_CONFIG_TOOL}" --engineering-login || {
        echo "ERROR: Unable to launch the Solutionz engineering menu." >&2
      }
    fi
    unset SOLUTIONZ_RMM_MENU_ACTIVE _solutionz_user _solutionz_groups
    exit 0
  elif printf '%s\n' "\${_solutionz_groups}" | tr ' ' '\n' | grep -qx '${FIELD_TECH_GROUP}'; then
    export SOLUTIONZ_RMM_MENU_ACTIVE=1
    echo
    echo "Solutionz technician session detected; launching RMM configuration menu."
    if [ "\${EUID:-\$(id -u)}" -eq 0 ]; then
      "${LOCAL_CONFIG_TOOL}" --restricted-login || true
    else
      sudo -n "${LOCAL_CONFIG_TOOL}" --restricted-login || {
        echo "ERROR: Unable to launch the Solutionz technician menu." >&2
      }
    fi
    unset SOLUTIONZ_RMM_MENU_ACTIVE _solutionz_user _solutionz_groups
    exit 0
  fi

  unset _solutionz_user _solutionz_groups
fi
EOF
  chmod 644 "${ACCESS_PROFILE_FILE}"
  progress_message "Interactive access policy installed: technician and engineering interactive logins both enter the Solutionz RMM menu; authenticated solz_eng sessions receive engineering-mode password setup and shell options."
}

