#!/usr/bin/env bash
set -Eeuo pipefail

###############################################################################
# Script: rswsolutionz_domotz_setup_rev5091126_with_xio_collector.sh
# Company: Solutionz INC / RSW
# Revision: 5091126
# Release Date: 2026-09-11
#
# Purpose:
#   Build and harden the Solutionz RMM Agent on the approved Protectli V1210
#   Ubuntu 24.04.3 LTS build-image baseline, install Domotz, deploy the Crestron 4-Series
#   XiO-style pull collector, configure the V1210 USB-C COM serial console,
#   and install a serial-console local network configuration utility.
#
# Important:
#   - General "apt upgrade -y" is intentionally NOT used.
#   - Domotz is intentionally not revision-pinned. The installed Snap revision
#     is recorded for audit, and updates are governed by operating policy.
#   - The V1210 USB-C port labeled COM is a serial console, not USB Ethernet.
#     This script exposes a login shell on ttyS0 and installs
#     /usr/local/sbin/solutionz-rmm-local-config for direct laptop configuration.
#   - Network changes are staged and take effect after manual reboot.
###############################################################################

REVISION="5091126"
SCRIPT_NAME="rswsolutionz_domotz_setup_rev5091126_with_xio_collector.sh"
RELEASE_DATE="2026-09-11"

SUPPORTED_OS_ID="ubuntu"
SUPPORTED_UBUNTU_VERSION_ID="24.04"
SUPPORTED_UBUNTU_POINT_RELEASE="24.04.3"
SUPPORTED_UBUNTU_PRETTY_FRAGMENT="24.04.3 LTS"
SUPPORTED_VENDOR="Protectli"
SUPPORTED_MODEL="V1210"

# Domotz is intentionally NOT revision-pinned.
# Production installs track the Snap Store stable/default channel and the
# installed revision is recorded for audit/troubleshooting. Update timing is
# governed operationally rather than by hard-coding a revision in this script.
DOMOTZ_SNAP_NAME="domotzpro-agent-publicstore"

LOG_DIR="/var/log/solutionz-rmm/setup"
RUN_TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_FILE="${LOG_DIR}/install-${REVISION}-${RUN_TIMESTAMP}.log"

STATE_DIR="/var/lib/rswsolutionz-rmm"
STATE_FILE="${STATE_DIR}/install.state"
BASELINE_FILE="${STATE_DIR}/package-baseline-${REVISION}.tsv"
OS_BASELINE_FILE="${STATE_DIR}/os-baseline-${REVISION}.txt"
SNAP_BASELINE_FILE="${STATE_DIR}/snap-baseline-${REVISION}.txt"
NETWORK_REQUIREMENTS_FILE="${STATE_DIR}/network-requirements-${REVISION}.txt"

NETPLAN_FILE="/etc/netplan/00-installer-config.yaml"
GRUB_FILE="/etc/default/grub"
MOTD_FILE="/etc/update-motd.d/slz-rsw-login"
SERIAL_PROFILE_FILE="/etc/profile.d/solutionz-rmm-serial.sh"
LOCAL_CONFIG_TOOL="/usr/local/sbin/solutionz-rmm-local-config"

SERIAL_DEVICE="/dev/ttyS0"
SERIAL_SERVICE="serial-getty@ttyS0.service"
SERIAL_DROPIN_DIR="/etc/systemd/system/serial-getty@ttyS0.service.d"
SERIAL_DROPIN_FILE="${SERIAL_DROPIN_DIR}/override.conf"

RESOLV_TARGET="/run/systemd/resolve/resolv.conf"
RESOLV_FILE="/etc/resolv.conf"

POSTREBOOT_VALIDATOR="/usr/local/sbin/rswsolutionz-rmm-postreboot-validate"
POSTREBOOT_SERVICE="/etc/systemd/system/rswsolutionz-rmm-postreboot-validation.service"
POSTREBOOT_LOG="${LOG_DIR}/postreboot-validation.log"

RMM_ROOT="/opt/solutionz-rmm"
RMM_OUTPUT_DIR="${RMM_ROOT}/output"
RMM_STATE_DIR="${RMM_ROOT}/state"
RMM_LOG_DIR="${RMM_ROOT}/logs"
RMM_BACKUP_DIR="${RMM_ROOT}/backups"
RMM_COLLECTOR="${RMM_ROOT}/crestron_4series_xio_style_collector.py"
RMM_CONFIG="${RMM_ROOT}/config.json"
RMM_CONFIG_SCHEMA_FILE="${RMM_ROOT}/config.schema.version"
RMM_CONFIG_SCHEMA_VERSION="1"
RMM_HISTORY="${RMM_STATE_DIR}/crestron_event_history.json"
RMM_COLLECTOR_LOG="${RMM_LOG_DIR}/crestron_4series_xio_style_collector.log"

COLLECTOR_USER="solutionz-rmm"
COLLECTOR_GROUP="solutionz-rmm"
OPERATOR_GROUP="solutionz-rmm-operators"
OPERATOR_USER="${OPERATOR_USER:-solz_rmm}"
COLLECTOR_HOME="/var/lib/solutionz-rmm"
COLLECTOR_SSH_DIR="${COLLECTOR_HOME}/.ssh"
COLLECTOR_SSH_KEY="${COLLECTOR_SSH_DIR}/id_rsa"
COLLECTOR_WRAPPER="/usr/local/bin/solutionz-rmm-collector"
COLLECTOR_SUDOERS="/etc/sudoers.d/solutionz-rmm-collector"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUNDLED_COLLECTOR="${SCRIPT_DIR}/crestron_4series_xio_style_collector.py"
BUNDLED_CONFIG="${SCRIPT_DIR}/config.4series.xio.example.json"

NON_INTERACTIVE=0
CURRENT_STEP="startup"

REQUIRED_DOMOTZ_PERMISSIONS=(
  "firewall-control"
  "network-observe"
  "raw-usb"
  "shutdown"
  "system-observe"
)

# Solutionz RMM traffic model:
# - Monitoring traffic originates from this collector toward monitored AV devices.
# - Domotz/RMM cloud connections are outbound-initiated by this Agent.
# - No unsolicited Internet-initiated inbound connection is required.
# - Host UFW permits inbound TCP 22 and TCP 3000 from any reachable source, per
#   the requested Solutionz baseline. Perimeter/network policy remains responsible
#   for preventing unsolicited Internet exposure.
# - Outbound requirements include TCP 443, 5671, 32700-57699, 4505-4506,
#   55022, 11371; UDP 123; DNS; and ICMP as required for monitoring/reachability.

usage() {
  cat <<EOF
Usage:
  sudo ./${SCRIPT_NAME} [options]

Options:
  --non-interactive             Skip the two manual confirmation prompts.
  -h, --help                    Show this help.

Domotz update model:
  Domotz is not revision-pinned by this script. New installations use the
  Snap Store stable/default release and the installed revision is logged.
EOF
}

parse_args() {
  while (($#)); do
    case "$1" in
      --non-interactive)
        NON_INTERACTIVE=1
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
    shift
  done
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "ERROR: Run this script with sudo or as root." >&2
    exit 1
  fi
}

init_logging() {
  mkdir -p "${LOG_DIR}" "${STATE_DIR}"
  chmod 750 "${LOG_DIR}" "${STATE_DIR}"
  touch "${LOG_FILE}"
  chmod 640 "${LOG_FILE}"
  exec > >(tee -ia "${LOG_FILE}") 2>&1
}

progress_message() {
  echo " [+] $1"
}

warning_message() {
  echo " [!] WARNING: $1"
}

step_message() {
  CURRENT_STEP="$1 - $2"
  echo "------------------------------------------------------------"
  echo "Step $1: $2"
  echo "------------------------------------------------------------"
}

write_state() {
  local status="$1"
  shift || true
  local tmp="${STATE_FILE}.tmp.$$"

  {
    printf '%s\n' "${status}"
    printf 'revision=%s\n' "${REVISION}"
    printf 'script=%s\n' "${SCRIPT_NAME}"
    printf 'timestamp_utc=%s\n' "$(date -u +%FT%TZ)"
    printf 'step=%s\n' "${CURRENT_STEP}"
    for line in "$@"; do
      printf '%s\n' "${line}"
    done
  } > "${tmp}"

  chmod 640 "${tmp}"
  mv -f "${tmp}" "${STATE_FILE}"
}

backup_previous_state() {
  if [[ -f "${STATE_FILE}" ]]; then
    cp -a "${STATE_FILE}" "${STATE_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
}


record_network_requirements() {
  cat > "${NETWORK_REQUIREMENTS_FILE}" <<'EOF'
Solutionz RMM Agent Network Requirements - Revision 5091126

Traffic model
- Monitoring traffic originates from the RMM Agent to monitored AV devices.
- RMM/Domotz cloud sessions are initiated outbound by the RMM Agent.
- No unsolicited Internet-initiated inbound connection is required.

Outbound/cloud and platform requirements
- TCP 443
- TCP 5671
- TCP 32700-57699
- TCP 4505-4506
- TCP 55022
- TCP 11371
- UDP 123
- DNS
- ICMP as required for monitoring/reachability

Local monitoring traffic
- ICMP to monitored AV device addresses
- TCP/UDP as required by each monitored device and protocol, including HTTP/HTTPS,
  SNMP, SSH, and manufacturer-specific services.

Agent host firewall inbound allowances
- TCP 22 - SSH administration
- TCP 3000 - Local Domotz Agent service

UFW baseline
- Default incoming: deny
- Default outgoing: allow
- TCP 22: allow from any reachable source
- TCP 3000: allow from any reachable source

Note: Global host-firewall allowance does not mean these ports should be exposed
through an Internet perimeter firewall or NAT. No unsolicited Internet inbound
connection is required for normal RMM/Domotz cloud communication.
EOF
  chmod 640 "${NETWORK_REQUIREMENTS_FILE}"
  progress_message "Recorded network requirements: ${NETWORK_REQUIREMENTS_FILE}"
}

record_failure_and_exit() {
  local rc="$1"
  local line="$2"
  local command="$3"
  trap - ERR
  set +e
  write_state "phase1_failed" \
    "exit_code=${rc}" \
    "line=${line}" \
    "command=${command}"
  echo " [!] INSTALLATION FAILED"
  echo " [!] Step: ${CURRENT_STEP}"
  echo " [!] Line: ${line}"
  echo " [!] Exit code: ${rc}"
  echo " [!] Command: ${command}"
  echo " [!] Log: ${LOG_FILE}"
  exit "${rc}"
}

on_error() {
  local rc=$?
  local line="$1"
  local command="$2"
  record_failure_and_exit "${rc}" "${line}" "${command}"
}

error_exit() {
  local message="$1"
  trap - ERR
  set +e
  echo " [!] ERROR: ${message}"
  write_state "phase1_failed" "error=${message}"
  exit 1
}

trap 'on_error "${LINENO}" "${BASH_COMMAND}"' ERR

prompt_confirmation() {
  if (( NON_INTERACTIVE == 1 )); then
    progress_message "Non-interactive mode selected; confirmation prompts skipped."
    return 0
  fi

  echo -e "\e[36m
  _____   ____    _      _    _   _____   _    ____   _     _
 / ____| / __ \  | |    | |  | | |_   _| | |  / __ \ | \   | |  _____
| (___  | |  | | | |    | |  | |   | |   | | | |  | ||  \  | | |___ /
 \___ \ | |  | | | |    | |  | |   | |   | | | |  | || |\ \| |   / /
 ____) || |__| | | |___ | |__| |   | |   | | | |__| || |  \  |  / /__
|_____/  \____/  |_____| \____/    |_|   |_|  \____/ |_|   \_| /_____|

Solutionz RMM Agent Build - Revision ${REVISION}
\e[0m"

  cat <<EOF
This script will:
  1. Validate Ubuntu 24.04.3 LTS and Protectli V1210 hardware.
  2. Run preflight checks before modifying the system.
  3. Install only required packages; no general apt upgrade is performed.
  4. Verify SSH, TUN, Snap, Domotz, and required Domotz permissions.
  5. Configure UFW with inbound TCP 22 and TCP 3000 globally permitted on the Agent host firewall.
  6. Stage Netplan with eth0 as the RMM network interface and eth1 disabled.
  7. Repair and validate system DNS behavior.
  8. Normalize Solutionz hostname entries.
  9. Configure GRUB interface naming and the V1210 USB-C COM serial console.
 10. Install a direct serial-console network configuration utility.
 11. Deploy the XiO-style collector under a dedicated service account.
 12. Create a dedicated collector SSH key and restricted operator wrapper.
 13. Validate collector configuration and runtime.
 14. Install post-reboot validation.
 15. Stage all changes without automatically rebooting.

USB-C COM direct laptop configuration:
  After reboot, connect a laptop to the V1210 USB-C port labeled COM.
  Use 115200 baud, 8 data bits, no parity, 1 stop bit (8N1).
  Log in normally, then run:
      sudo ${LOCAL_CONFIG_TOOL}

Domotz note:
  Domotz is intentionally not revision-pinned. The installed Snap revision is
  recorded for audit and support.
EOF

  read -r -p "Type 'yes' to proceed: " confirmation1
  [[ "${confirmation1}" == "yes" ]] || error_exit "Confirmation not received."

  read -r -p "Type 'yes' again to confirm production configuration changes: " confirmation2
  [[ "${confirmation2}" == "yes" ]] || error_exit "Second confirmation not received."
}

read_dmi_value() {
  local path="$1"
  if [[ -r "${path}" ]]; then
    tr -d '\0' < "${path}" | xargs
  else
    printf 'unknown'
  fi
}


dns_resolves_ipv4() {
  local host="$1"
  getent ahostsv4 "${host}" 2>/dev/null | awk '{print $1}' | grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

preflight_checks() {
  step_message 1 "Preflight validation"

  [[ -r /etc/os-release ]] || error_exit "/etc/os-release not found."
  # shellcheck disable=SC1091
  source /etc/os-release

  [[ "${ID:-}" == "${SUPPORTED_OS_ID}" ]] || \
    error_exit "Unsupported OS ID '${ID:-unknown}'. Expected ${SUPPORTED_OS_ID}."
  [[ "${VERSION_ID:-}" == "${SUPPORTED_UBUNTU_VERSION_ID}" ]] || \
    error_exit "Unsupported Ubuntu VERSION_ID '${VERSION_ID:-unknown}'. Expected ${SUPPORTED_UBUNTU_VERSION_ID}."
  [[ "${VERSION:-}" == *"${SUPPORTED_UBUNTU_PRETTY_FRAGMENT}"* ]] || \
    error_exit "Unsupported Ubuntu point release '${VERSION:-unknown}'. Approved build image is Ubuntu ${SUPPORTED_UBUNTU_POINT_RELEASE} LTS."
  progress_message "Ubuntu ${SUPPORTED_UBUNTU_POINT_RELEASE} LTS build-image baseline verified."
  cp -a /etc/os-release "${OS_BASELINE_FILE}"
  chmod 640 "${OS_BASELINE_FILE}"

  local sys_vendor product_name
  sys_vendor="$(read_dmi_value /sys/class/dmi/id/sys_vendor)"
  product_name="$(read_dmi_value /sys/class/dmi/id/product_name)"

  progress_message "Detected hardware vendor: ${sys_vendor}"
  progress_message "Detected hardware model: ${product_name}"

  if [[ "${sys_vendor,,}" != *"${SUPPORTED_VENDOR,,}"* || "${product_name}" != "${SUPPORTED_MODEL}" ]]; then
    error_exit "Unsupported hardware. Production revision ${REVISION} is approved only for ${SUPPORTED_VENDOR} ${SUPPORTED_MODEL}; detected '${sys_vendor} ${product_name}'."
  fi
  progress_message "Protectli V1210 hardware preflight passed."

  if [[ ! -c "${SERIAL_DEVICE}" ]]; then
    error_exit "Required V1210 serial device ${SERIAL_DEVICE} was not detected."
  fi
  progress_message "Detected V1210 serial device ${SERIAL_DEVICE}."

  local free_kb
  free_kb="$(df -Pk / | awk 'NR==2 {print $4}')"
  if [[ -z "${free_kb}" || "${free_kb}" -lt 2097152 ]]; then
    error_exit "Less than 2 GB free space is available on the root filesystem."
  fi
  progress_message "Disk-space preflight passed."

  local default_iface default_gateway current_cidr
  default_iface="$(ip -4 route show default | awk 'NR==1 {print $5}')"
  default_gateway="$(ip -4 route show default | awk 'NR==1 {print $3}')"
  [[ -n "${default_iface}" ]] || error_exit "No IPv4 default route is present."
  current_cidr="$(ip -o -4 addr show dev "${default_iface}" scope global | awk 'NR==1 {print $4}')"
  [[ -n "${current_cidr}" ]] || error_exit "Default-route interface ${default_iface} has no global IPv4 address."
  progress_message "Network preflight: ${default_iface} ${current_cidr}, gateway ${default_gateway:-not-reported}."

  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS cannot resolve archive.ubuntu.com to IPv4."
  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS cannot resolve api.snapcraft.io to IPv4."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS cannot resolve security.ubuntu.com to IPv4."

  timeout 8 bash -c '</dev/tcp/archive.ubuntu.com/80' || \
    error_exit "Cannot establish TCP connectivity to archive.ubuntu.com:80 for package bootstrap."
  timeout 8 bash -c '</dev/tcp/api.snapcraft.io/443' || \
    error_exit "Cannot establish TCP connectivity to api.snapcraft.io:443."
  timeout 8 bash -c '</dev/tcp/security.ubuntu.com/443' || \
    warning_message "TCP 443 to security.ubuntu.com could not be confirmed; apt source configuration may use another transport/mirror."

  if command -v timedatectl >/dev/null 2>&1; then
    local synced
    synced="$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)"
    if [[ "${synced}" != "yes" ]]; then
      warning_message "System time is not currently reported as NTP synchronized."
    else
      progress_message "System time synchronization verified."
    fi
  fi
}

install_required_packages() {
  step_message 2 "Install required packages without a general system upgrade"

  export DEBIAN_FRONTEND=noninteractive
  export NEEDRESTART_MODE=a

  progress_message "Updating package indexes..."
  if ! apt-get update; then
    error_exit "apt-get update failed. Review ${LOG_FILE} for repository, DNS, or network errors."
  fi
  progress_message "Package index update completed successfully."

  local packages=(
    net-tools
    openvswitch-switch
    traceroute
    dnsutils
    curl
    openssl
    netcat-openbsd
    nano
    iputils-ping
    ufw
    snapd
    openssh-server
    sudo
    python3
    python3-pip
    python3-requests
    python3-psutil
    python3-urllib3
  )

  # openvswitch-switch is retained from the established Solutionz RMM baseline.
  # Its long-term dependency should remain documented/revalidated as the platform evolves.
  progress_message "Installing approved dependency set..."
  if ! apt-get install -y --no-install-recommends "${packages[@]}"; then
    error_exit "Required package installation failed. Review ${LOG_FILE} for the package that failed and the apt/dpkg error."
  fi
  progress_message "Required package installation completed successfully."

  progress_message "Recording installed package versions..."
  : > "${BASELINE_FILE}"
  for pkg in "${packages[@]}"; do
    dpkg-query -W -f='${Package}\t${Version}\n' "${pkg}" >> "${BASELINE_FILE}"
  done
  chmod 640 "${BASELINE_FILE}"
}

verify_required_packages() {
  step_message 3 "Verify required packages"

  local required=(
    nano
    iputils-ping
    ufw
    openssh-server
    snapd
    python3
    python3-requests
    python3-psutil
    python3-urllib3
  )

  local pkg
  for pkg in "${required[@]}"; do
    dpkg -s "${pkg}" >/dev/null 2>&1 || error_exit "Required package missing after installation: ${pkg}"
    progress_message "Verified: ${pkg}"
  done

  command -v nano >/dev/null 2>&1 || error_exit "nano command not found."
  command -v ping >/dev/null 2>&1 || error_exit "ping command not found."
  command -v ufw >/dev/null 2>&1 || error_exit "ufw command not found."
  command -v python3 >/dev/null 2>&1 || error_exit "python3 command not found."
}

verify_ssh_service() {
  step_message 4 "Enable and verify SSH service"

  systemctl enable --now ssh
  systemctl is-enabled ssh >/dev/null 2>&1 || error_exit "SSH service is not enabled."
  systemctl is-active ssh >/dev/null 2>&1 || error_exit "SSH service is not active."
  progress_message "SSH service is enabled and active."
}

configure_tun() {
  step_message 5 "Load and validate TUN support"

  modprobe tun
  grep -qxF 'tun' /etc/modules || echo 'tun' >> /etc/modules
  [[ -c /dev/net/tun ]] || error_exit "/dev/net/tun is not available after loading the tun module."
  progress_message "TUN support validated."
}

ensure_snapd() {
  step_message 6 "Enable and verify Snap service"

  systemctl enable --now snapd.socket
  systemctl start snapd.service
  systemctl is-active snapd.service >/dev/null 2>&1 || error_exit "snapd service is not active."

  snap version >/dev/null 2>&1 || error_exit "snap command is not operational."
  progress_message "Snap service is operational."
}

install_domotz() {
  step_message 7 "Install and validate Domotz Pro Agent"

  local installed=0
  if snap list "${DOMOTZ_SNAP_NAME}" >/dev/null 2>&1; then
    installed=1
    progress_message "Domotz is already installed. Revision pinning is not used by policy."
  fi

  if (( installed == 0 )); then
    if ! snap install "${DOMOTZ_SNAP_NAME}"; then
      error_exit "Domotz Snap installation failed."
    fi
  fi

  if ! snap list "${DOMOTZ_SNAP_NAME}" > "${SNAP_BASELINE_FILE}"; then
    error_exit "Domotz installation could not be verified after snap install."
  fi
  chmod 640 "${SNAP_BASELINE_FILE}"
  progress_message "Domotz installation verified; installed revision recorded at ${SNAP_BASELINE_FILE}."
  cat "${SNAP_BASELINE_FILE}"
}

configure_domotz_permissions() {
  step_message 8 "Connect and verify required Domotz permissions"

  local permission
  for permission in "${REQUIRED_DOMOTZ_PERMISSIONS[@]}"; do
    progress_message "Connecting Domotz permission: ${permission}"
    if ! snap connect "${DOMOTZ_SNAP_NAME}:${permission}"; then
      error_exit "Failed to connect required Domotz permission: ${permission}"
    fi

    if ! snap connections "${DOMOTZ_SNAP_NAME}" | awk -v p="${permission}" '
      $1 == p && $3 != "-" {found=1}
      END {exit found ? 0 : 1}
    '; then
      error_exit "Required Domotz permission is not connected: ${permission}"
    fi
  done
}

configure_ufw() {
  step_message 9 "Configure and verify UFW"

  if ! ufw default deny incoming; then
    error_exit "Unable to set UFW default incoming policy."
  fi
  if ! ufw default allow outgoing; then
    error_exit "Unable to set UFW default outgoing policy. RMM/Domotz and monitoring traffic must be able to originate from the Agent."
  fi

  # Production requirement supplied by Solutionz: SSH and local Domotz service
  # ports are permitted globally on the Agent host firewall. This does not mean
  # unsolicited Internet inbound traffic is required; upstream/perimeter controls
  # remain responsible for Internet exposure.
  if ! ufw allow 22/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 22 (SSH)."
  fi
  if ! ufw allow 3000/tcp; then
    error_exit "Failed to create global inbound UFW rule for TCP 3000 (local Domotz Agent service)."
  fi
  if ! ufw --force enable; then
    error_exit "UFW could not be enabled."
  fi

  ufw status | grep -q "Status: active" || error_exit "UFW did not become active."
  ufw status | grep -Eq '^22/tcp[[:space:]]+ALLOW' || error_exit "Expected global SSH UFW rule was not found."
  ufw status | grep -Eq '^3000/tcp[[:space:]]+ALLOW' || error_exit "Expected global TCP 3000 UFW rule was not found."

  progress_message "UFW validated: inbound TCP 22 and TCP 3000 are globally permitted; outbound traffic is allowed."
  ufw status verbose
}

write_netplan_config() {
  cat > "${NETPLAN_FILE}" <<'YAML'
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: false
      accept-ra: false

    eth1:
      dhcp4: false
      dhcp6: false
      accept-ra: false
      optional: true
YAML
  chmod 600 "${NETPLAN_FILE}"
}

remove_stale_cloud_init_netplans() {
  shopt -s nullglob
  local files=(/etc/netplan/50-cloud-init*)
  if (( ${#files[@]} > 0 )); then
    rm -f "${files[@]}"
    progress_message "Removed stale cloud-init Netplan files."
  fi
  shopt -u nullglob
}

stage_network_config() {
  step_message 10 "Stage Solutionz Netplan configuration"

  if [[ -f "${NETPLAN_FILE}" ]]; then
    cp -a "${NETPLAN_FILE}" "${NETPLAN_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi

  write_netplan_config
  remove_stale_cloud_init_netplans

  mkdir -p /etc/cloud/cloud.cfg.d
  cat > /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg <<'EOF'
network: {config: disabled}
EOF

  netplan generate
  progress_message "Netplan syntax validated. Configuration is staged but not applied during this remote session."
}

repair_resolv_conf() {
  step_message 11 "Repair and validate DNS resolver"

  systemctl enable --now systemd-resolved

  if [[ -L "${RESOLV_FILE}" ]]; then
    local current_target
    current_target="$(readlink -f "${RESOLV_FILE}" || true)"
    if [[ "${current_target}" != "${RESOLV_TARGET}" ]]; then
      rm -f "${RESOLV_FILE}"
      ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
    fi
  else
    rm -f "${RESOLV_FILE}"
    ln -s "${RESOLV_TARGET}" "${RESOLV_FILE}"
  fi

  [[ "$(readlink -f "${RESOLV_FILE}")" == "${RESOLV_TARGET}" ]] || \
    error_exit "${RESOLV_FILE} does not resolve to ${RESOLV_TARGET}."

  dns_resolves_ipv4 api.snapcraft.io || error_exit "DNS validation failed: api.snapcraft.io did not return an IPv4 address."
  dns_resolves_ipv4 archive.ubuntu.com || error_exit "DNS validation failed: archive.ubuntu.com did not return an IPv4 address."
  dns_resolves_ipv4 security.ubuntu.com || error_exit "DNS validation failed: security.ubuntu.com did not return an IPv4 address."

  if command -v resolvectl >/dev/null 2>&1; then
    resolvectl query api.snapcraft.io >/dev/null 2>&1 || error_exit "systemd-resolved query failed for api.snapcraft.io."
  fi

  ls -l "${RESOLV_FILE}"
  progress_message "True DNS validation passed using configured system resolver."
}

normalize_host_entries() {
  step_message 12 "Normalize Solutionz hostname entries"

  local tmp
  tmp="$(mktemp)"
  awk '
    $0 !~ /(^|[[:space:]])solzrmm([[:space:]]|$)/ &&
    $0 !~ /(^|[[:space:]])solz-rmm([[:space:]]|$)/ {print}
  ' /etc/hosts > "${tmp}"

  printf '127.0.1.1\tsolz-rmm solzrmm\n' >> "${tmp}"
  cat "${tmp}" > /etc/hosts
  rm -f "${tmp}"

  grep -qxF $'127.0.1.1\tsolz-rmm solzrmm' /etc/hosts || \
    error_exit "Unable to normalize Solutionz hostname entry."
}

grub_get_value() {
  local variable="$1"
  local line
  line="$(grep -E "^${variable}=" "${GRUB_FILE}" | head -n1 || true)"
  line="${line#*=}"
  line="${line#\"}"
  line="${line%\"}"
  printf '%s' "${line}"
}

grub_set_value() {
  local variable="$1"
  local value="$2"

  if grep -qE "^${variable}=" "${GRUB_FILE}"; then
    sed -i -E "s|^${variable}=.*|${variable}=\"${value}\"|" "${GRUB_FILE}"
  else
    printf '%s="%s"\n' "${variable}" "${value}" >> "${GRUB_FILE}"
  fi
}

append_grub_param() {
  local variable="$1"
  local param="$2"
  local value
  value="$(grub_get_value "${variable}")"

  if [[ " ${value} " == *" ${param} "* ]]; then
    progress_message "${variable} already contains ${param}."
    return 0
  fi

  value="${value:+${value} }${param}"
  grub_set_value "${variable}" "${value}"
  progress_message "Added ${param} to ${variable}."
}

configure_grub_and_serial() {
  step_message 13 "Configure interface naming and V1210 USB-C COM console"

  cp -a "${GRUB_FILE}" "${GRUB_FILE}.bak.$(date -u +%Y%m%dT%H%M%SZ)"

  append_grub_param "GRUB_CMDLINE_LINUX" "net.ifnames=0"
  append_grub_param "GRUB_CMDLINE_LINUX" "biosdevname=0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=tty0"
  append_grub_param "GRUB_CMDLINE_LINUX_DEFAULT" "console=ttyS0,115200n8"

  [[ -c "${SERIAL_DEVICE}" ]] || error_exit "${SERIAL_DEVICE} is not present."

  mkdir -p "${SERIAL_DROPIN_DIR}"
  cat > "${SERIAL_DROPIN_FILE}" <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -- \u' --keep-baud 115200,57600,38400,9600 ttyS0 vt220
EOF

  systemctl daemon-reload
  systemctl enable --now "${SERIAL_SERVICE}"
  systemctl is-active "${SERIAL_SERVICE}" >/dev/null 2>&1 || \
    error_exit "${SERIAL_SERVICE} is not active."

  pgrep -a agetty | grep -q 'ttyS0' || error_exit "agetty is not running on ttyS0."

  update-grub
  progress_message "V1210 USB-C COM console configured for 115200 8N1."
}

install_local_serial_config_tool() {
  step_message 14 "Install USB-C COM direct configuration utility"

  cat > "${LOCAL_CONFIG_TOOL}" <<'LOCALCFG'
#!/usr/bin/env bash
set -Eeuo pipefail

NETPLAN_FILE="/etc/netplan/00-installer-config.yaml"

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "Run this utility with sudo." >&2
    exit 1
  fi
}

backup_netplan() {
  if [[ -f "${NETPLAN_FILE}" ]]; then
    cp -a "${NETPLAN_FILE}" "${NETPLAN_FILE}.serialcfg.bak.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
}

validate_ipv4_cidr() {
  python3 - "$1" <<'PY'
import ipaddress, sys
ipaddress.ip_interface(sys.argv[1])
PY
}

validate_ipv4_address() {
  python3 - "$1" <<'PY'
import ipaddress, sys
ipaddress.ip_address(sys.argv[1])
PY
}

write_dhcp() {
  backup_netplan
  cat > "${NETPLAN_FILE}" <<'YAML'
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: true
      dhcp6: false
      accept-ra: false
    eth1:
      dhcp4: false
      dhcp6: false
      accept-ra: false
      optional: true
YAML
  chmod 600 "${NETPLAN_FILE}"
}

write_static() {
  local address gateway dns_input
  local -a dns_servers

  read -r -p "eth0 IPv4 address with CIDR (example 192.168.10.20/24): " address
  validate_ipv4_cidr "${address}" || { echo "Invalid IPv4/CIDR."; return 1; }

  read -r -p "Default gateway IPv4 address: " gateway
  validate_ipv4_address "${gateway}" || { echo "Invalid gateway."; return 1; }

  read -r -p "DNS servers, comma separated (example 192.168.10.1,8.8.8.8): " dns_input
  IFS=',' read -r -a dns_servers <<< "${dns_input}"

  local dns_yaml=""
  local dns
  for dns in "${dns_servers[@]}"; do
    dns="$(echo "${dns}" | xargs)"
    [[ -z "${dns}" ]] && continue
    validate_ipv4_address "${dns}" || { echo "Invalid DNS address: ${dns}"; return 1; }
    if [[ -n "${dns_yaml}" ]]; then
      dns_yaml+=", "
    fi
    dns_yaml+="${dns}"
  done

  backup_netplan

  cat > "${NETPLAN_FILE}" <<YAML
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: false
      dhcp6: false
      accept-ra: false
      addresses:
        - ${address}
      routes:
        - to: default
          via: ${gateway}
YAML

  if [[ -n "${dns_yaml}" ]]; then
    cat >> "${NETPLAN_FILE}" <<YAML
      nameservers:
        addresses: [${dns_yaml}]
YAML
  fi

  cat >> "${NETPLAN_FILE}" <<'YAML'
    eth1:
      dhcp4: false
      dhcp6: false
      accept-ra: false
      optional: true
YAML

  chmod 600 "${NETPLAN_FILE}"
}

show_status() {
  echo
  echo "===== Current Interface State ====="
  ip -br addr || true
  echo
  echo "===== Current Routes ====="
  ip route || true
  echo
  echo "===== Current Netplan ====="
  cat "${NETPLAN_FILE}" 2>/dev/null || true
  echo
  echo "===== DNS ====="
  resolvectl status 2>/dev/null | sed -n '1,80p' || true
  echo
}

sync_ufw_to_eth0_subnet() {
  # Revision 5091126 production policy keeps TCP 22 and TCP 3000 globally
  # permitted in UFW. Network changes therefore do not require source-subnet
  # firewall rewrites.
  return 0
}

apply_config() {
  netplan generate
  echo
  echo "Proposed Netplan:"
  cat "${NETPLAN_FILE}"
  echo
  read -r -p "Apply this network configuration now? Type 'yes': " answer
  if [[ "${answer}" != "yes" ]]; then
    echo "Configuration saved but not applied."
    return 0
  fi

  netplan apply
  sleep 2
  sync_ufw_to_eth0_subnet
  show_status
}

restore_backup() {
  local latest
  latest="$(ls -1t "${NETPLAN_FILE}".serialcfg.bak.* 2>/dev/null | head -n1 || true)"
  if [[ -z "${latest}" ]]; then
    echo "No serial configuration backup found."
    return 1
  fi
  cp -a "${latest}" "${NETPLAN_FILE}"
  chmod 600 "${NETPLAN_FILE}"
  echo "Restored ${latest}"
  apply_config
}

require_root

while true; do
  cat <<'MENU'

Solutionz RMM V1210 USB-C COM Local Configuration
-------------------------------------------------
1) Configure eth0 for DHCP
2) Configure eth0 with a static IPv4 address
3) Show current network status
4) Restore most recent serial-console Netplan backup
5) Exit
MENU

  read -r -p "Selection: " choice
  case "${choice}" in
    1)
      write_dhcp
      apply_config
      ;;
    2)
      write_static
      apply_config
      ;;
    3)
      show_status
      ;;
    4)
      restore_backup
      ;;
    5)
      exit 0
      ;;
    *)
      echo "Invalid selection."
      ;;
  esac
done
LOCALCFG

  chmod 750 "${LOCAL_CONFIG_TOOL}"
  chown root:root "${LOCAL_CONFIG_TOOL}"

  cat > "${SERIAL_PROFILE_FILE}" <<EOF
#!/usr/bin/env bash
case "\$(tty 2>/dev/null || true)" in
  /dev/ttyS0)
    echo
    echo "Solutionz RMM V1210 USB-C COM console detected."
    echo "For direct network configuration run:"
    echo "  sudo ${LOCAL_CONFIG_TOOL}"
    echo
    ;;
esac
EOF
  chmod 644 "${SERIAL_PROFILE_FILE}"

  progress_message "Direct laptop configuration is available through the V1210 USB-C COM console."
}

